{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        }
    },
    "ConnectionStrings": {
        "ClinicConnection": "{connection-string}"
    },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET_MUST_MATCH_AUTH_JWT_SECRETKEY",
    "Issuer": "ApplicationAuth",
    "Audience": "ApplicationAuthUsers"
  },
    "AuthApi": {
        "BaseUrl": "https://localhost:8081/"
    },
  "Email": {
    "Host": "",
    "Port": 587,
    "From": "",
    "Username": "",
    "Password": ""
  },
  "AzureServiceBus": {
    "ConnectionString": "",
    "QueueName": "email-notifications-queue"
  },
  "BlobStorage": {
    "ConnectionString": "",
    "ContainerName": "tenantcore"
  },
  "AppLogging": {
    "Provider": "TableStorage",
    "ConnectionString": "",
    "ApiErrorTable": "ApiErrorLogs",
    "FrontendErrorTable": "FrontendErrorLogs",
    "ActionLogTable": "ActionLogs",
    "RequestLogTable": "ApiRequestLogs",
    "QueueCapacity": 5000,
    "MinimumLevel": "Error",
    "SlowRequestMs": 2000,
    "LogMutatingRequests": true
  },
    "Subscription": {
        "GuardEnabled": true
    },
  "Razorpay": {
    "KeyId": "rzp_test_REPLACE_ME",
    "KeySecret": "",
    "WebhookSecret": "",
    "ApiBaseUrl": "https://api.razorpay.com/v1/",
    "Currency": "INR",
    "PaymentLinkExpiryDays": 7,
    "CallbackUrl": "https://localhost:REPLACE/clinic-requests",
    "NotifyByEmail": true,
    "NotifyBySms": true
  },
  "AuthInternalApi": {
    "BaseUrl": "https://localhost:8081/",
    "ServiceKey": ""
  },
  "InternalApi": {
    "AdminPortalKey": ""
  },
    "Onboarding": {
        "Mode": "Approval",
        "OpsNotificationEmail": "",
        "MinPaymentAmount": 1.00,
        "MaxPaymentAmount": 500000
    },
    "Workflow": {
        "Enabled": true,
        "PollIntervalSeconds": 10,
        "BatchSize": 20,
        "LeaseMinutes": 5,
        "MaxAttempts": 72,
        "ReconciliationIntervalMinutes": 15
    },
    "AllowedHosts": "*"
}
