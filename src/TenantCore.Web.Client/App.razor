@inject TenantCore.Web.Client.Services.AuthStateService AuthState

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(AuthLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(AuthLayout)">
                <div class="auth-brand">
                    <div style="width:32px;height:32px;border-radius:50%;background:#1565C0;
                                display:flex;align-items:center;justify-content:center;font-size:16px;">🏥</div>
                    <span style="font-weight:700;color:#1a56db;font-size:15px;">ClinicCore</span>
                </div>

                <div style="text-align:center;margin-bottom:20px;">
                    <div style="font-size:5rem;">🔍</div>
                </div>

                <div style="font-weight:700;color:#111827;font-size:1.2rem;margin-bottom:4px;">Page Not Found</div>
                <div style="color:#6B7280;margin-bottom:2rem;font-size:14px;">
                    The page you're looking for doesn't exist or has been moved.
                </div>

                <a href="/select-clinic"
                   style="display:block;width:100%;padding:13px;background:#1565C0;color:#fff;
                          border-radius:8px;font-weight:600;text-align:center;text-decoration:none;
                          font-size:14px;">
                    🏠 Go to Home
                </a>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
    }
}
