@inherits ErrorBoundary
@using Microsoft.AspNetCore.Components.Web
@using TenantCore.Shared.Dtos
@using TenantCore.Web.Client.Clients
@inject ILoggingApiClient LoggingApiClient

@if (CurrentException is null)
{
    @ChildContent
}
else
{
    <div style="padding:40px;text-align:center;">
        <div style="font-size:3rem;margin-bottom:12px;">⚠️</div>
        <div style="font-weight:700;color:#111827;font-size:1.1rem;margin-bottom:6px;">Something went wrong</div>
        <div style="color:#6B7280;font-size:14px;margin-bottom:20px;">
            The error has been logged. Please reload the page and try again.
        </div>
        <a href="/" style="display:inline-block;padding:10px 24px;background:#1565C0;color:#fff;
                            border-radius:8px;font-weight:600;text-decoration:none;font-size:14px;">
            Reload
        </a>
    </div>
}

@code {
    protected override async Task OnErrorAsync(Exception exception)
    {
        await LoggingApiClient.LogErrorAsync(new FrontendErrorLogRequest
        {
            Message = exception.Message,
            Source = "Frontend.ErrorBoundary",
            ExceptionType = exception.GetType().FullName ?? exception.GetType().Name,
            StackTrace = exception.ToString()
        });

        await base.OnErrorAsync(exception);
    }
}
