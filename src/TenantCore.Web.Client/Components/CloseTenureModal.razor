@using TenantCore.Shared.Dtos
@using TenantCore.Shared.Enums
@using TenantCore.Web.Client.Clients
@inject IPregnancyTenureApiClient TenureClient
@inject IToastService Toast

@if (Visible)
{
    <!-- Backdrop -->
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:900;" @onclick="Cancel"></div>

    <!-- Dialog -->
    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
                background:#fff;border-radius:14px;padding:28px 30px;width:420px;max-width:95vw;
                box-shadow:0 20px 60px rgba(0,0,0,0.2);z-index:901;">

        <div style="font-size:16px;font-weight:800;color:#0F172A;margin-bottom:6px;">Close Pregnancy Tenure</div>
        <div style="font-size:12px;color:#64748B;margin-bottom:20px;">
            EDD was <strong>@Tenure?.EffectiveEdd.ToString("dd MMM yyyy")</strong> — please record the outcome.
        </div>

        <!-- Outcome -->
        <div style="margin-bottom:16px;">
            <label style="font-size:11px;font-weight:700;color:#94A3B8;text-transform:uppercase;letter-spacing:.05em;display:block;margin-bottom:6px;">Outcome *</label>
            <select @bind="_outcome"
                    style="width:100%;padding:9px 12px;border:1.5px solid #E2E8F0;border-radius:8px;font-size:13px;color:#0F172A;outline:none;">
                <option value="">— Select outcome —</option>
                <option value="@PregnancyOutcome.Delivered">Delivered</option>
                <option value="@PregnancyOutcome.Abortion">Abortion</option>
                <option value="@PregnancyOutcome.Miscarriage">Miscarriage</option>
                <option value="@PregnancyOutcome.NotKnown">Not Known</option>
            </select>
        </div>

        <!-- Notes -->
        <div style="margin-bottom:22px;">
            <label style="font-size:11px;font-weight:700;color:#94A3B8;text-transform:uppercase;letter-spacing:.05em;display:block;margin-bottom:6px;">Notes (optional)</label>
            <textarea @bind="_notes" rows="3" maxlength="1000"
                      placeholder="Any additional notes…"
                      style="width:100%;padding:9px 12px;border:1.5px solid #E2E8F0;border-radius:8px;font-size:13px;font-family:inherit;resize:vertical;outline:none;box-sizing:border-box;"></textarea>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div style="background:#FEF2F2;border:1.5px solid #FECACA;border-radius:8px;padding:10px 14px;font-size:12px;color:#B91C1C;margin-bottom:16px;">
                @_error
            </div>
        }

        <div style="display:flex;gap:10px;justify-content:flex-end;">
            <button @onclick="Cancel" disabled="@_submitting"
                    style="padding:9px 20px;border-radius:8px;border:1.5px solid #E2E8F0;background:#fff;font-size:13px;font-weight:600;color:#64748B;cursor:pointer;">
                Cancel
            </button>
            <button @onclick="SubmitAsync" disabled="@(_submitting || string.IsNullOrEmpty(_outcome))"
                    style="padding:9px 22px;border-radius:8px;border:none;background:#DC2626;color:#fff;font-size:13px;font-weight:700;cursor:pointer;opacity:@(_submitting ? "0.6" : "1");">
                @(_submitting ? "Closing…" : "Close Tenure")
            </button>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public bool Visible { get; set; }
    [Parameter, EditorRequired] public PregnancyTenureDto? Tenure { get; set; }
    [Parameter] public EventCallback<PregnancyTenureDto?> OnClosed { get; set; }

    private string _outcome = string.Empty;
    private string _notes = string.Empty;
    private bool _submitting;
    private string? _error;

    protected override void OnParametersSet()
    {
        if (!Visible)
        {
            _outcome = string.Empty;
            _notes = string.Empty;
            _error = null;
            _submitting = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (Tenure is null || string.IsNullOrEmpty(_outcome)) return;

        if (!Enum.TryParse<PregnancyOutcome>(_outcome, out var outcome))
        {
            _error = "Please select a valid outcome.";
            return;
        }

        _submitting = true;
        _error = null;

        var request = new ClosePregnancyTenureRequest
        {
            Outcome = outcome,
            Notes = string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim()
        };

        var result = await TenureClient.CloseAsync(Tenure.Id, request);
        _submitting = false;

        if (result.Success)
        {
            Toast.ShowSuccess("Tenure closed successfully.");
            await OnClosed.InvokeAsync(result.Data);
        }
        else
        {
            _error = result.Message ?? "Failed to close tenure. Please try again.";
        }
    }

    private async Task Cancel() => await OnClosed.InvokeAsync(null);
}
