@inject IOpdParticularApiClient OpdParticularClient
@inject IParticularApiClient ParticularClient
@inject IOpdPaymentApiClient OpdPaymentClient
@inject ICounterSessionApiClient CounterSessionClient
@inject IToastService Toast
@using TenantCore.Shared.Enums

@if (Visible)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:900;" @onclick="Close"></div>

    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
                background:#fff;border-radius:14px;padding:0;width:700px;max-width:96vw;
                max-height:90vh;display:flex;flex-direction:column;
                box-shadow:0 20px 60px rgba(0,0,0,0.2);z-index:901;">

        <!-- Header -->
        <div style="padding:20px 24px 16px;border-bottom:1px solid #E2E8F0;display:flex;justify-content:space-between;align-items:center;flex-shrink:0;">
            <div style="font-size:16px;font-weight:800;color:#0F172A;">OPD Service Items</div>
            <button @onclick="Close"
                    style="background:none;border:none;font-size:18px;color:#94A3B8;cursor:pointer;padding:2px 6px;line-height:1;">×</button>
        </div>

        <!-- Body -->
        <div style="padding:20px 24px;overflow-y:auto;flex:1;">

            @if (_loadingParticulars)
            {
                <div style="display:flex;justify-content:center;padding:40px 0;">
                    <div class="auth-spinner" style="width:32px;height:32px;border-width:3px;"></div>
                </div>
            }
            else
            {
                @* Discount warning banner *@
                @if (_payment is not null && _payment.Discount > 0)
                {
                    <div style="background:#FFFBEB;border:1.5px solid #FDE68A;border-radius:8px;
                                padding:10px 14px;color:#92400E;font-size:13px;margin-bottom:16px;">
                        Discount of <strong>Rs. @_payment.Discount.ToString("N2")</strong> applied — use <strong>Collect Full Bill</strong> to collect all at once.
                    </div>
                }

                @* Collect All / Collect Full Bill action row *@
                @if (!ReadOnly && _payment is not null && _particulars.Any())
                {
                    var pendingItems = _particulars.Where(p => p.PaymentStatus == PaymentStatus.Pending).ToList();
                    var collectedItems = _particulars.Where(p => p.PaymentStatus == PaymentStatus.Received).ToList();
                    var pendingTotal = pendingItems.Sum(p => p.Amount);
                    var collectedTotal = collectedItems.Sum(p => p.Amount);

                    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:16px;">
                        @if (_payment.Discount > 0)
                        {
                            @if (_payment.PaymentStatus != PaymentStatus.Received)
                            {
                                <button @onclick="CollectFullBillAsync" disabled="@_collecting"
                                        style="padding:7px 16px;border-radius:8px;border:none;background:#16A34A;color:#fff;
                                               font-size:12px;font-weight:700;cursor:pointer;opacity:@(_collecting ? "0.6" : "1");">
                                    Collect Full Bill — Rs. @_payment.FinalAmount.ToString("N2")
                                </button>
                            }
                        }
                        else if (pendingItems.Any())
                        {
                            <button @onclick="CollectAllPendingAsync" disabled="@_collecting"
                                    style="padding:7px 16px;border-radius:8px;border:none;background:#16A34A;color:#fff;
                                           font-size:12px;font-weight:700;cursor:pointer;opacity:@(_collecting ? "0.6" : "1");">
                                Collect All Pending — Rs. @pendingTotal.ToString("N2")
                            </button>
                        }
                        <div style="flex:1;"></div>
                        @if (collectedTotal > 0)
                        {
                            <span style="background:#DCFCE7;color:#166534;border-radius:12px;padding:3px 10px;font-size:11px;font-weight:600;">
                                Collected: Rs. @collectedTotal.ToString("N2")
                            </span>
                        }
                        @if (pendingTotal > 0 && _payment.Discount == 0)
                        {
                            <span style="background:#FEF3C7;color:#92400E;border-radius:12px;padding:3px 10px;font-size:11px;font-weight:600;">
                                Pending: Rs. @pendingTotal.ToString("N2")
                            </span>
                        }
                    </div>
                }

                @* Service items table *@
                <div class="opd-table-card" style="margin-bottom:20px;">
                    <table class="opd-table">
                        <thead>
                            <tr>
                                <th>Service</th>
                                <th>Amount</th>
                                <th>Status</th>
                                @if (!ReadOnly)
                                {
                                    <th style="width:120px;">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (!_particulars.Any())
                            {
                                <tr><td colspan="4" class="opd-empty">No service items added yet.</td></tr>
                            }
                            @foreach (var item in _particulars)
                            {
                                <tr>
                                    <td>@item.ParticularName</td>
                                    <td>Rs. @item.Amount.ToString("N2")</td>
                                    <td>
                                        @if (item.PaymentStatus == PaymentStatus.Received)
                                        {
                                            <span style="background:#DCFCE7;color:#166534;border-radius:12px;padding:2px 10px;font-size:11px;font-weight:600;">Collected</span>
                                        }
                                        else
                                        {
                                            <span style="background:#FEF3C7;color:#92400E;border-radius:12px;padding:2px 10px;font-size:11px;font-weight:600;">Pending</span>
                                        }
                                    </td>
                                    @if (!ReadOnly)
                                    {
                                        <td style="display:flex;gap:6px;align-items:center;">
                                            @if (item.PaymentStatus == PaymentStatus.Pending && (_payment is null || _payment.Discount == 0))
                                            {
                                                <button @onclick="@(() => CollectItemAsync(item))" disabled="@_collecting"
                                                        style="padding:4px 10px;border-radius:6px;border:none;background:#16A34A;color:#fff;
                                                               font-size:11px;font-weight:700;cursor:pointer;opacity:@(_collecting ? "0.6" : "1");">
                                                    Collect
                                                </button>
                                            }
                                            @if (item.PaymentStatus == PaymentStatus.Pending)
                                            {
                                                <button @onclick="@(() => RemoveAsync(item.Id))"
                                                        style="padding:4px 10px;border-radius:6px;border:none;background:#FEE2E2;color:#991B1B;
                                                               font-size:11px;font-weight:700;cursor:pointer;">
                                                    Remove
                                                </button>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!ReadOnly)
                {
                    <div style="height:1px;background:#E2E8F0;margin-bottom:20px;"></div>

                    @* Add new service item *@
                    <div style="font-size:13px;font-weight:700;color:#1E293B;margin-bottom:12px;">Add Service Item</div>
                    <div style="display:grid;grid-template-columns:1fr 1fr auto;gap:10px;align-items:end;">
                        <div>
                            <label class="form-label">Select Service</label>
                            <select class="form-input" @onchange="OnParticularSelected">
                                <option value="">— Select service —</option>
                                @foreach (var p in _availableParticulars)
                                {
                                    <option value="@p.Id">@p.Name (Rs. @p.DefaultAmount.ToString("N2"))</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Amount (Rs.)</label>
                            <input type="number" class="form-input" value="@_addAmount" disabled />
                        </div>
                        <button @onclick="AddParticularAsync" disabled="@(_adding || _selectedParticularId is null)"
                                style="padding:9px 18px;border-radius:8px;border:none;background:#1565C0;color:#fff;
                                       font-size:13px;font-weight:700;cursor:pointer;white-space:nowrap;
                                       opacity:@(_adding || _selectedParticularId is null ? "0.6" : "1");">
                            + Add
                        </button>
                    </div>
                }

                @* Bill summary *@
                @if (_payment is not null)
                {
                    <div style="margin-top:20px;padding-top:16px;border-top:1px solid #E2E8F0;
                                display:flex;justify-content:space-between;align-items:flex-end;">
                        <div style="font-size:12px;color:#64748B;line-height:1.8;">
                            <div>Visit Fee: Rs. @_payment.VisitFee.ToString("N2")</div>
                            <div>Services: Rs. @_payment.ParticularsTotal.ToString("N2")</div>
                            @if (_payment.Discount > 0)
                            {
                                <div style="color:#D97706;">Discount: - Rs. @_payment.Discount.ToString("N2")</div>
                            }
                        </div>
                        <div style="font-size:16px;font-weight:800;color:#1565C0;">
                            Total: Rs. @_payment.FinalAmount.ToString("N2")
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Footer -->
        <div style="padding:14px 24px;border-top:1px solid #E2E8F0;display:flex;justify-content:flex-end;flex-shrink:0;">
            <button @onclick="Close"
                    style="padding:9px 22px;border-radius:8px;border:1.5px solid #E2E8F0;background:#fff;
                           font-size:13px;font-weight:600;color:#64748B;cursor:pointer;">
                Close
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public Guid OpdRegistrationId { get; set; }
    [Parameter] public EventCallback OnFeesChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    private bool _loadingParticulars = true;
    private bool _adding;
    private bool _collecting;
    private List<OpdParticularDto> _particulars = [];
    private List<ParticularSummaryDto> _availableParticulars = [];
    private OpdPaymentDto? _payment;
    private Guid? _activeSessionId;
    private Guid? _selectedParticularId;
    private decimal _addAmount;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && OpdRegistrationId != Guid.Empty)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadingParticulars = true;

        var parts = await OpdParticularClient.GetByOpdAsync(OpdRegistrationId);
        _particulars = parts.Success && parts.Data is not null ? parts.Data.ToList() : [];

        var payment = await OpdPaymentClient.GetByOpdAsync(OpdRegistrationId);
        _payment = payment.Success ? payment.Data : null;

        if (!ReadOnly)
        {
            var avail = await ParticularClient.GetAllAsync();
            _availableParticulars = avail.Success && avail.Data is not null
                ? avail.Data.Where(p => p.IsActive).ToList() : [];

            var session = await CounterSessionClient.GetActiveAsync();
            _activeSessionId = session.Success && session.Data is not null ? session.Data.Id : null;
        }

        _loadingParticulars = false;
    }

    private void OnParticularSelected(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _selectedParticularId = id;
            _addAmount = _availableParticulars.FirstOrDefault(p => p.Id == id)?.DefaultAmount ?? 0;
        }
        else
        {
            _selectedParticularId = null;
            _addAmount = 0;
        }
    }

    private async Task AddParticularAsync()
    {
        if (_selectedParticularId is null) return;
        _adding = true;
        var response = await OpdParticularClient.AddAsync(new AddOpdParticularRequest
        {
            OpdRegistrationId = OpdRegistrationId,
            ParticularId = _selectedParticularId.Value,
            Amount = _addAmount
        });
        if (response.Success)
        {
            await LoadAsync();
            _selectedParticularId = null;
            _addAmount = 0;
        }
        else Toast.ShowError(response.Message ?? "Failed to add service item.");
        _adding = false;
    }

    private async Task CollectItemAsync(OpdParticularDto item)
    {
        if (_activeSessionId is null)
        {
            Toast.ShowWarning("No active counter session — open a session first.", "Open counter session", "/counter-session");
            return;
        }
        _collecting = true;
        var resp = await OpdParticularClient.CollectAsync(item.Id,
            new CollectOpdParticularRequest { CounterSessionId = _activeSessionId });
        if (resp.Success)
        {
            Toast.ShowSuccess($"Rs. {item.Amount:N2} collected for {item.ParticularName}.");
            await LoadAsync();
            await OnFeesChanged.InvokeAsync();
        }
        else Toast.ShowError(resp.Message ?? "Failed to collect item.");
        _collecting = false;
    }

    private async Task CollectAllPendingAsync()
    {
        if (_activeSessionId is null)
        {
            Toast.ShowWarning("No active counter session — open a session first.", "Open counter session", "/counter-session");
            return;
        }
        _collecting = true;
        var pendingTotal = _particulars.Where(p => p.PaymentStatus == PaymentStatus.Pending).Sum(p => p.Amount);
        var resp = await OpdParticularClient.CollectAllAsync(OpdRegistrationId,
            new CollectAllOpdParticularsRequest { OpdRegistrationId = OpdRegistrationId, CounterSessionId = _activeSessionId });
        if (resp.Success)
        {
            Toast.ShowSuccess($"Rs. {pendingTotal:N2} collected for all pending services.");
            await LoadAsync();
            await OnFeesChanged.InvokeAsync();
        }
        else Toast.ShowError(resp.Message ?? "Failed to collect all.");
        _collecting = false;
    }

    private async Task CollectFullBillAsync()
    {
        if (_payment is null) return;
        if (_activeSessionId is null)
        {
            Toast.ShowWarning("No active counter session — open a session first.", "Open counter session", "/counter-session");
            return;
        }
        _collecting = true;
        var resp = await OpdPaymentClient.AcceptFullAsync(_payment.Id,
            new AcceptOpdPaymentFullRequest { OpdRegistrationId = OpdRegistrationId, CounterSessionId = _activeSessionId });
        if (resp.Success)
        {
            Toast.ShowSuccess($"Full bill of Rs. {_payment.FinalAmount:N2} collected (discount applied).");
            await LoadAsync();
            await OnFeesChanged.InvokeAsync();
        }
        else Toast.ShowError(resp.Message ?? "Failed to collect full bill.");
        _collecting = false;
    }

    private async Task RemoveAsync(Guid id)
    {
        var response = await OpdParticularClient.RemoveAsync(id);
        if (response.Success) await LoadAsync();
        else Toast.ShowError(response.Message ?? "Failed to remove service item.");
    }

    private async Task Close() => await VisibleChanged.InvokeAsync(false);
}
