@* Shared print-template picker — used both by the dedicated Settings → Print Template page
   and by the Prescription Settings modal, so a doctor can change their personal print layout
   from wherever they happen to be. Selection always saves immediately (no separate "Save"). *@
@using TenantCore.Shared.Enums

<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(200px, 1fr)); gap:14px;">
    @foreach (var t in _templates)
    {
        var tpl = t;
        var isSelected = Current == tpl.Value;
        <div style="background:#fff; border-radius:12px; border:2px solid @(isSelected ? "#2563EB" : "#E2E8F0"); overflow:hidden; position:relative;">
            @if (isSelected)
            {
                <div style="position:absolute; top:8px; right:8px; background:#2563EB; color:#fff; font-size:9px; font-weight:800; padding:2px 8px; border-radius:10px; z-index:2;">
                    ✓ IN USE
                </div>
            }
            <div style="padding:12px; background:#F8FAFC; border-bottom:1px solid #E2E8F0;">
                @RenderPreview(tpl.Value)
            </div>
            <div style="padding:10px 12px;">
                <div style="font-weight:700; font-size:13px; color:#0F172A;">@tpl.Name</div>
                <div style="font-size:10.5px; color:#64748B; margin-top:2px; line-height:1.4; min-height:28px;">@tpl.Description</div>
                <button @onclick="() => HandleSelect(tpl.Value)"
                        disabled="@(isSelected || Saving)"
                        style="width:100%; margin-top:8px; padding:7px; border-radius:7px; border:1.5px solid @(isSelected ? "#BFDBFE" : "#2563EB");
                               background:@(isSelected ? "#EFF6FF" : "#2563EB"); color:@(isSelected ? "#2563EB" : "#fff");
                               font-size:11px; font-weight:700; cursor:@(isSelected ? "default" : "pointer");">
                    @(isSelected ? "Currently Selected" : (Saving && PendingSelection == tpl.Value ? "Applying..." : "Use this template"))
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public PrescriptionTemplate Current { get; set; } = PrescriptionTemplate.Classic;
    [Parameter] public bool Saving { get; set; }
    [Parameter] public PrescriptionTemplate? PendingSelection { get; set; }
    [Parameter] public EventCallback<PrescriptionTemplate> OnSelect { get; set; }

    private async Task HandleSelect(PrescriptionTemplate template) => await OnSelect.InvokeAsync(template);

    private record TemplateOption(PrescriptionTemplate Value, string Name, string Description);

    private static readonly TemplateOption[] _templates =
    [
        new(PrescriptionTemplate.Classic,   "Classic",     "Traditional clinical letter — bordered vitals strip, tabulated medicines."),
        new(PrescriptionTemplate.Compact,   "Compact",     "Tighter spacing so more medicines fit on a single page."),
        new(PrescriptionTemplate.Modern,    "Modern",      "Rounded, color-accented section cards for a contemporary look."),
        new(PrescriptionTemplate.Minimal,   "Minimal",     "Borderless and understated — clean typography, no boxes."),
        new(PrescriptionTemplate.TwoColumn, "Two-Column",  "Medicines in the main column; vitals/history in a side column."),
    ];

    private static RenderFragment RenderPreview(PrescriptionTemplate template) => template switch
    {
        PrescriptionTemplate.Compact   => CompactPreview,
        PrescriptionTemplate.Modern    => ModernPreview,
        PrescriptionTemplate.Minimal   => MinimalPreview,
        PrescriptionTemplate.TwoColumn => TwoColumnPreview,
        _                               => ClassicPreview,
    };

    private static readonly RenderFragment ClassicPreview = @<div style="background:#fff; border-radius:4px; border:1px solid #E2E8F0; padding:8px; height:100px;">
        <div style="display:flex; justify-content:space-between; margin-bottom:5px;">
            <div style="width:50%; height:7px; background:#1E293B; border-radius:2px;"></div>
            <div style="width:22%; height:5px; background:#1565C0; border-radius:2px;"></div>
        </div>
        <div style="height:1.5px; background:#2563EB; margin-bottom:5px;"></div>
        <div style="display:flex; gap:4px; margin-bottom:5px;">
            <div style="flex:2; height:12px; background:#F1F5F9; border-radius:2px;"></div>
            <div style="flex:1; height:12px; background:#F1F5F9; border-radius:2px;"></div>
        </div>
        <div style="height:15px; border:1px solid #94A3B8; border-radius:4px; margin-bottom:5px;"></div>
        <div style="height:5px; width:40%; background:#1565C0; opacity:0.5; border-radius:2px; margin-bottom:3px;"></div>
        <div style="height:4px; background:#F1F5F9; border-radius:2px; margin-bottom:2px;"></div>
        <div style="height:4px; background:#F1F5F9; border-radius:2px; width:80%;"></div>
    </div>;

    private static readonly RenderFragment CompactPreview = @<div style="background:#fff; border-radius:4px; border:1px solid #E2E8F0; padding:6px; height:100px;">
        <div style="width:45%; height:5px; background:#1E293B; border-radius:2px; margin-bottom:3px;"></div>
        <div style="height:0.75px; background:#2563EB; margin-bottom:3px;"></div>
        <div style="height:8px; background:#F1F5F9; border-radius:2px; margin-bottom:3px;"></div>
        <div style="height:10px; border:1px solid #94A3B8; border-radius:3px; margin-bottom:3px;"></div>
        @for (var i = 0; i < 6; i++)
        {
            <div style="height:3px; background:#F1F5F9; border-radius:1px; margin-bottom:2px;"></div>
        }
    </div>;

    private static readonly RenderFragment ModernPreview = @<div style="background:#EFF6FF; border-radius:4px; padding:7px; height:100px;">
        <div style="width:50%; height:7px; background:#1E293B; border-radius:2px; margin-bottom:6px;"></div>
        <div style="background:#F8FAFC; border-left:3px solid #2563EB; border-radius:0 6px 6px 0; padding:4px 7px; margin-bottom:4px;">
            <div style="height:4px; width:60%; background:#94A3B8; border-radius:2px;"></div>
        </div>
        <div style="background:#fff; border-left:3px solid #059669; border-radius:0 6px 6px 0; padding:4px 7px; margin-bottom:4px;">
            <div style="height:4px; background:#F1F5F9; border-radius:2px; margin-bottom:2px;"></div>
            <div style="height:4px; background:#F1F5F9; border-radius:2px; width:70%;"></div>
        </div>
        <div style="background:#F8FAFC; border-left:3px solid #7C3AED; border-radius:0 6px 6px 0; padding:4px 7px;">
            <div style="height:4px; width:50%; background:#94A3B8; border-radius:2px;"></div>
        </div>
    </div>;

    private static readonly RenderFragment MinimalPreview = @<div style="background:#fff; border:1px solid #E5E7EB; padding:8px 10px; height:100px;">
        <div style="width:40%; height:6px; background:#1F2937; border-radius:1px; margin-bottom:8px;"></div>
        <div style="height:0.5px; background:#D1D5DB; margin-bottom:8px;"></div>
        <div style="display:flex; gap:12px; margin-bottom:8px;">
            <div style="height:4px; width:20px; background:#9CA3AF;"></div>
            <div style="height:4px; width:20px; background:#9CA3AF;"></div>
            <div style="height:4px; width:20px; background:#9CA3AF;"></div>
        </div>
        <div style="height:0.5px; background:#1F2937; margin-bottom:5px;"></div>
        <div style="height:3px; background:#F3F4F6; margin-bottom:3px;"></div>
        <div style="height:3px; background:#F3F4F6; margin-bottom:3px; width:85%;"></div>
        <div style="height:3px; background:#F3F4F6; width:70%;"></div>
    </div>;

    private static readonly RenderFragment TwoColumnPreview = @<div style="background:#fff; border-radius:4px; border:1px solid #E2E8F0; padding:6px; height:100px; display:flex; gap:5px;">
        <div style="flex:1; display:flex; flex-direction:column; gap:3px;">
            <div style="height:5px; width:70%; background:#1E293B; border-radius:2px;"></div>
            <div style="height:13px; border:1px solid #E2E8F0; border-radius:3px; margin-top:2px;"></div>
            <div style="height:3px; background:#F1F5F9; border-radius:1px;"></div>
            <div style="height:3px; background:#F1F5F9; border-radius:1px; width:80%;"></div>
        </div>
        <div style="width:34%; background:#FAFBFC; border-left:1px solid #F1F5F9; padding-left:4px; display:flex; flex-direction:column; gap:4px;">
            <div style="height:12px; border:1px solid #94A3B8; border-radius:3px;"></div>
            <div style="height:3px; background:#E2E8F0; border-radius:1px;"></div>
            <div style="height:3px; background:#E2E8F0; border-radius:1px;"></div>
        </div>
    </div>;
}
