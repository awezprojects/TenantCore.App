@inject IToastService ToastSvc
@implements IDisposable

@if (_toasts.Count > 0)
{
    <div class="toast-container">
        @foreach (var t in _toasts)
        {
            <div class="toast-item @LevelClass(t.Level)">
                <span>@t.Text</span>
                @if (!string.IsNullOrWhiteSpace(t.ActionUrl))
                {
                    <a class="toast-action" href="@t.ActionUrl">@(t.ActionText ?? "Click here")</a>
                }
            </div>
        }
    </div>
}

@code {
    private readonly List<ToastMessage> _toasts = new();

    protected override void OnInitialized()
    {
        ToastSvc.OnToast += HandleToast;
    }

    private void HandleToast(ToastMessage msg)
    {
        InvokeAsync(async () =>
        {
            _toasts.Add(msg);
            StateHasChanged();
            var duration = string.IsNullOrWhiteSpace(msg.ActionUrl) ? 3500 : 8000;
            await Task.Delay(duration);
            _toasts.Remove(msg);
            StateHasChanged();
        });
    }

    private static string LevelClass(ToastLevel level) => level switch
    {
        ToastLevel.Success => "toast-success",
        ToastLevel.Error   => "toast-error",
        ToastLevel.Warning => "toast-warning",
        _                  => "toast-success"
    };

    public void Dispose() => ToastSvc.OnToast -= HandleToast;
}
