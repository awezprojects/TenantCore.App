@using TenantCore.Shared.Dtos.UsageBilling
@using TenantCore.Shared.Enums

@* The wallet ledger: newest first, every movement with the balance it left behind, credit/debit styled.
   Usage:
     <WalletLedgerTable Transactions="_wallet.Transactions" Currency="_wallet.Currency" />
*@

<div style="background:#fff;border:1px solid #E2E8F0;border-radius:12px;padding:18px 20px;">
    <div style="font-size:14px;font-weight:800;color:#0F172A;margin-bottom:4px;">Wallet ledger</div>
    <div style="font-size:12px;color:#64748B;margin-bottom:12px;">
        Newest first. Every movement is listed with the balance it left behind, so the ledger reads
        top-to-bottom without replaying it.
    </div>

    @if (Transactions.Count == 0)
    {
        <AppEmptyState Icon="🧾" Title="No wallet movements yet"
                       Message="Top-ups, admin credits and metered charges will appear here." />
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="opd-table" style="width:100%;">
                <thead>
                    <tr>
                        <th style="text-align:left;">When</th>
                        <th style="text-align:left;">Type</th>
                        <th style="text-align:left;">Reference</th>
                        <th style="text-align:left;">Description</th>
                        <th style="text-align:right;">Amount</th>
                        <th style="text-align:right;">Balance after</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tx in Transactions)
                    {
                        <tr>
                            <td>@tx.OccurredAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                            <td>
                                <AppBadge Text="@(tx.Type == WalletTransactionType.Credit ? "Credit" : "Debit")"
                                          Variant="@(tx.Type == WalletTransactionType.Credit ? "success" : "danger")" />
                            </td>
                            <td>@ReferenceLabel(tx.ReferenceType)</td>
                            <td style="font-size:12px;color:#475569;">@tx.Description</td>
                            <td style="text-align:right;font-weight:700;
                                       color:@(tx.Type == WalletTransactionType.Credit ? "#166534" : "#991B1B");">
                                @(tx.Type == WalletTransactionType.Credit ? "+" : "−")@Money(tx.Amount)
                            </td>
                            <td style="text-align:right;font-weight:700;">@Money(tx.BalanceAfter)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<WalletTransactionDto> Transactions { get; set; } = [];
    [Parameter] public string Currency { get; set; } = "INR";

    private string Money(decimal value)
        => (Currency == "INR" ? "₹" : Currency + " ") + value.ToString("N2");

    private static string ReferenceLabel(WalletReferenceType referenceType) => referenceType switch
    {
        WalletReferenceType.TopUpPayment => "Top-up payment",
        WalletReferenceType.Usage => "Metered usage",
        WalletReferenceType.AdminCredit => "Admin credit",
        WalletReferenceType.Adjustment => "Adjustment",
        _ => referenceType.ToString()
    };
}
