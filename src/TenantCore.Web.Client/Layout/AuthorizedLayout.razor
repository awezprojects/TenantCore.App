@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject AuthStateService AuthState
@inject ClinicContextService ClinicContext
@implements IDisposable

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (_checkingAuth)
{
    <div style="display:flex;align-items:center;justify-content:center;min-height:100vh;background:#F4F6FA;">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
    </div>
}
else if (_isAuthenticated)
{
    <MudLayout>
        <!-- Sidebar / Drawer -->
        <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Never"
                   Variant="DrawerVariant.Mini" MiniWidth="68px" Width="230px"
                   Style="background:#0A1628;border-right:none;">
            <!-- Logo -->
            <div style="display:flex;align-items:center;gap:10px;padding:@(_drawerOpen ? "18px 20px" : "18px 0");
                        justify-content:@(_drawerOpen ? "flex-start" : "center");
                        border-bottom:1px solid rgba(255,255,255,0.08);min-height:68px;">
                <div style="width:36px;height:36px;border-radius:10px;
                            background:linear-gradient(135deg,#1976D2,#42A5F5);
                            display:flex;align-items:center;justify-content:center;
                            font-size:18px;flex-shrink:0;">🏥</div>
                @if (_drawerOpen)
                {
                    <div>
                        <div style="font-size:15px;font-weight:800;color:#fff;letter-spacing:-0.3px;">CloudClinic</div>
                        <div style="font-size:10px;color:rgba(255,255,255,0.4);letter-spacing:0.5px;">HMS v2.4</div>
                    </div>
                }
            </div>

            <!-- User info -->
            @if (_drawerOpen && AuthState.CurrentUser != null)
            {
                <div style="padding:14px 16px;border-bottom:1px solid rgba(255,255,255,0.08);">
                    <div style="display:flex;align-items:center;gap:10px;">
                        <div style="width:38px;height:38px;border-radius:10px;
                                    background:rgba(255,255,255,0.1);
                                    display:flex;align-items:center;justify-content:center;
                                    font-size:20px;flex-shrink:0;">👨‍⚕️</div>
                        <div style="overflow:hidden;">
                            <div style="font-size:13px;font-weight:700;color:#fff;
                                        white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                @AuthState.CurrentUser.FullName
                            </div>
                            <div style="font-size:10px;color:rgba(255,255,255,0.45);">
                                @_roleLabel
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Nav items -->
            <NavMenu DrawerOpen="_drawerOpen" />

            <!-- Bottom: collapse + logout -->
            <div style="margin-top:auto;padding:12px 8px;border-top:1px solid rgba(255,255,255,0.08);">
                <button class="cc-nav-btn" @onclick="ToggleDrawer" title="@(_drawerOpen ? "" : "Expand")">
                    <span style="font-size:16px;">@(_drawerOpen ? "←" : "→")</span>
                    @if (_drawerOpen) { <span>Collapse</span> }
                </button>
                <button class="cc-nav-btn cc-nav-logout" @onclick="Logout" title="@(_drawerOpen ? "" : "Sign Out")">
                    <span style="font-size:16px;">🚪</span>
                    @if (_drawerOpen) { <span>Sign Out</span> }
                </button>
            </div>
        </MudDrawer>

        <!-- Top AppBar -->
        <MudAppBar Elevation="0" Style="background:#ffffff;border-bottom:1px solid #E2E8F0;color:#1E293B;"
                   Dense="false">
            <div style="display:flex;align-items:center;gap:14px;flex:1;">
                <div>
                    <div style="font-size:17px;font-weight:700;color:#1E293B;">@_screenTitle</div>
                    <div style="font-size:11px;color:#94A3B8;">
                        @DateTime.Now.ToString("dddd, dd MMMM yyyy") &nbsp;·&nbsp; @_currentTime
                    </div>
                </div>
            </div>
            <div style="display:flex;align-items:center;gap:12px;">
                @if (_isDoctor && !string.IsNullOrEmpty(ClinicContext.SelectedApplicationName))
                {
                    <div style="display:flex;align-items:center;gap:6px;">
                        <div style="padding:5px 12px;background:#EFF6FF;border-radius:20px;
                                    font-size:12px;font-weight:700;color:#1565C0;
                                    border:1px solid #BFDBFE;white-space:nowrap;">
                            🏥 @ClinicContext.SelectedApplicationName
                        </div>
                        <button @onclick="SwitchClinic"
                                style="padding:5px 12px;background:transparent;border:1px solid #E2E8F0;
                                       border-radius:20px;font-size:11px;font-weight:600;color:#64748B;
                                       cursor:pointer;white-space:nowrap;">
                            Switch Clinic
                        </button>
                    </div>
                }
                <div style="padding:6px 14px;background:#EFF6FF;border-radius:20px;
                            font-size:12px;font-weight:600;color:#1565C0;">
                    🟢 Online
                </div>
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                               Style="color:#64748B;" OnClick="ToggleDarkMode" />
                <MudMenu Icon="@Icons.Material.Filled.AccountCircle"
                         Style="color:#64748B;"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ChildContent>
                        @if (_isDoctor)
                        {
                            <MudMenuItem Href="/doctor/profile" Icon="@Icons.Material.Filled.Person">My Profile</MudMenuItem>
                            <MudMenuItem Href="/doctor/change-password" Icon="@Icons.Material.Filled.Lock">Change Password</MudMenuItem>
                            <MudMenuItem OnClick="SwitchClinic" Icon="@Icons.Material.Filled.SwapHoriz">Switch Clinic</MudMenuItem>
                        }
                        else
                        {
                            <MudMenuItem Href="/auth/profile" Icon="@Icons.Material.Filled.Person">My Profile</MudMenuItem>
                        }
                        <MudDivider />
                        <MudMenuItem OnClick="Logout" Icon="@Icons.Material.Filled.Logout">Sign Out</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </div>
        </MudAppBar>

        <MudMainContent Style="background:#F4F6FA;min-height:100vh;">
            <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pt-5 pb-6">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}

@code {
    private bool _drawerOpen = true;
    private bool _checkingAuth = true;
    private bool _isAuthenticated;
    private bool _isDarkMode;
    private bool _isDoctor;
    private bool _isAdmin;
    private string _currentTime = DateTime.Now.ToString("hh:mm tt");
    private string _roleLabel = string.Empty;
    private string _screenTitle = "Dashboard";

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1565C0",
            PrimaryDarken = "#0D47A1",
            PrimaryLighten = "#42A5F5",
            Secondary = "#7C3AED",
            Background = "#F4F6FA",
            Surface = "#ffffff",
            AppbarBackground = "#ffffff",
            AppbarText = "#1E293B",
            DrawerBackground = "#0A1628",
            DrawerText = "rgba(255,255,255,0.7)",
            DrawerIcon = "rgba(255,255,255,0.7)",
            TextPrimary = "#1E293B",
            TextSecondary = "#64748B",
        },
    };

    private static readonly Dictionary<string, string> _titles = new()
    {
        ["/dashboard"]              = "Dashboard",
        ["/admin/dashboard"]        = "Admin Dashboard",
        ["/admin/wards"]            = "Ward & Room Management",
        ["/admin/users"]            = "User Management",
        ["/admin/usg-template"]     = "USG Appointment Template",
        ["/prescriptions"]          = "Prescriptions",
        ["/patients"]               = "Patient Registry",
        ["/opd"]                    = "My OPD Queue",
        ["/ipd"]                    = "IPD & Bed Management",
        ["/medicines"]              = "Medicine Management",
        ["/medicine-types"]         = "Medicine Types",
        ["/auth/profile"]           = "My Profile",
        ["/settings/preferences"]   = "Preferences",
        ["/settings/prescription"]  = "Prescription Settings",
        ["/settings/dosage-remarks"]= "Dosage Remarks",
    };

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdateScreenTitle(NavigationManager.Uri);
    }

    // Initialize auth + clinic context in OnInitializedAsync so every page's
    // OnParametersSetAsync / OnInitializedAsync already has SelectedApplicationId
    // populated before making any API calls.
    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        await ClinicContext.InitializeAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) CheckAuthAndRedirect();
        return Task.CompletedTask;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateScreenTitle(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void UpdateScreenTitle(string uri)
    {
        var path = "/" + uri.Replace(NavigationManager.BaseUri, "").TrimStart('/').Split('?')[0];
        _screenTitle = _titles.TryGetValue(path, out var t) ? t : "Dashboard";
    }

    private void CheckAuthAndRedirect()
    {
        try
        {
            // InitializeAsync already called in OnInitializedAsync — read current state
            _isAuthenticated = AuthState.IsAuthenticated;

            if (_isAuthenticated && AuthState.CurrentUser != null)
            {
                // Scope role display to the currently selected clinic so a user who is
                // "Clinic Admin" in Clinic A and "Doctor" in Clinic B sees the correct
                // label when inside Clinic B.  Falls back to all roles when no clinic is
                // selected (e.g. the /doctor/home landing page).
                var selectedAppId = ClinicContext.SelectedApplicationId;
                var clinicRoles = selectedAppId != Guid.Empty
                    ? AuthState.GetRolesForApplication(selectedAppId)
                    : AuthState.CurrentUser.UserRoles
                        .Where(r => r.IsActive)
                        .Select(r => r.RoleName)
                        .ToList();

                _isDoctor = clinicRoles.Any(r => r.Equals("Doctor", StringComparison.OrdinalIgnoreCase));
                _isAdmin  = clinicRoles.Any(r =>
                    r.Equals("Clinic Admin", StringComparison.OrdinalIgnoreCase) ||
                    r.Equals("System Admin", StringComparison.OrdinalIgnoreCase));

                _roleLabel = clinicRoles
                    .FirstOrDefault(r =>
                        r.Equals("Clinic Admin", StringComparison.OrdinalIgnoreCase) ||
                        r.Equals("System Admin", StringComparison.OrdinalIgnoreCase))
                    ?? clinicRoles.FirstOrDefault()
                    ?? "User";
            }
        }
        catch
        {
            _isAuthenticated = false;
        }

        _checkingAuth = false;

        var uri = NavigationManager.Uri;
        var baseUri = NavigationManager.BaseUri;
        var path = uri.Replace(baseUri, "/");

        // Guard: all users must select a clinic before accessing clinic-scoped pages.
        // /select-clinic and /doctor/* are exempt — they work without a selected clinic.
        if (_isAuthenticated && ClinicContext.SelectedApplicationId == Guid.Empty
            && !path.StartsWith("/select-clinic")
            && !path.StartsWith("/doctor/")
            && !path.StartsWith("/auth/"))
        {
            NavigationManager.NavigateTo("/select-clinic");
            return;
        }

        if (!_isAuthenticated)
        {
            if (!path.StartsWith("/auth/"))
            {
                var returnUrl = Uri.EscapeDataString(path);
                NavigationManager.NavigateTo($"/auth/login?returnUrl={returnUrl}", forceLoad: true);
                return;
            }
        }
        else
        {
            if (path.StartsWith("/auth/login"))
            {
                // Always go to clinic selection after login — users pick their clinic first.
                NavigationManager.NavigateTo("/select-clinic", forceLoad: true);
                return;
            }
        }

        StateHasChanged();
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void ToggleDarkMode() => _isDarkMode = !_isDarkMode;

    private async Task SwitchClinic()
    {
        await ClinicContext.ClearClinicAsync();
        NavigationManager.NavigateTo("/select-clinic");
    }

    private async Task Logout()
    {
        await ClinicContext.ClearClinicAsync();
        await AuthState.ClearAuthStateAsync();
        NavigationManager.NavigateTo("/auth/login", forceLoad: true);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
