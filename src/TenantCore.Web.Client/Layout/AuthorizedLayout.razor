@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject AuthStateService AuthState
@inject ClinicContextService ClinicContext
@inject SubscriptionContextService SubscriptionContext
@implements IDisposable

<ToastContainer />

@if (_checkingAuth)
{
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;
                min-height:100vh;background:#F4F6FA;gap:16px;">
        <div style="width:56px;height:56px;border-radius:16px;
                    background:linear-gradient(135deg,#1565C0,#42A5F5);
                    display:flex;align-items:center;justify-content:center;">
            <svg width="30" height="30" viewBox="0 0 40 40" fill="none">
                <rect x="15" y="4" width="10" height="32" rx="3" fill="white"/>
                <rect x="4" y="15" width="32" height="10" rx="3" fill="white"/>
            </svg>
        </div>
        <div class="auth-spinner" style="width:36px;height:36px;border-width:3px;"></div>
        <div style="font-size:13px;color:#94A3B8;font-weight:500;">Loading CloudClinic…</div>
    </div>
}
else if (_isAuthenticated)
{
    <div style="display:flex;height:100vh;overflow:hidden;background:#F4F6FA;">

        <!-- Sidebar -->
        <div style="width:@(_drawerOpen ? "230px" : "68px");flex-shrink:0;background:#0A1628;
                    display:flex;flex-direction:column;height:100vh;
                    transition:width 0.2s ease;overflow:hidden;">

            <!-- Logo -->
            <div style="display:flex;align-items:center;gap:10px;padding:@(_drawerOpen ? "18px 20px" : "18px 0");
                        justify-content:@(_drawerOpen ? "flex-start" : "center");
                        border-bottom:1px solid rgba(255,255,255,0.08);min-height:68px;flex-shrink:0;">
                <div style="width:36px;height:36px;border-radius:10px;
                            background:linear-gradient(135deg,#1976D2,#42A5F5);
                            display:flex;align-items:center;justify-content:center;
                            font-size:18px;flex-shrink:0;">🏥</div>
                @if (_drawerOpen)
                {
                    <div>
                        <div style="font-size:15px;font-weight:800;color:#fff;letter-spacing:-0.3px;">CloudClinic</div>
                        <div style="font-size:10px;color:rgba(255,255,255,0.4);letter-spacing:0.5px;">HMS v2.4</div>
                    </div>
                }
            </div>

            <!-- User info -->
            @if (_drawerOpen && AuthState.CurrentUser != null)
            {
                <div style="padding:14px 16px;border-bottom:1px solid rgba(255,255,255,0.08);flex-shrink:0;">
                    <div style="display:flex;align-items:center;gap:10px;">
                        <div style="width:38px;height:38px;border-radius:10px;
                                    background:rgba(255,255,255,0.1);
                                    display:flex;align-items:center;justify-content:center;
                                    font-size:20px;flex-shrink:0;">👨‍⚕️</div>
                        <div style="overflow:hidden;">
                            <div style="font-size:13px;font-weight:700;color:#fff;
                                        white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                @AuthState.CurrentUser.FullName
                            </div>
                            <div style="font-size:10px;color:rgba(255,255,255,0.45);">
                                @_roleLabel
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Nav items -->
            <NavMenu DrawerOpen="_drawerOpen" />

            <!-- Bottom: collapse + logout -->
            <div style="margin-top:auto;padding:12px 8px;border-top:1px solid rgba(255,255,255,0.08);flex-shrink:0;">
                <button class="cc-nav-btn" @onclick="ToggleDrawer" title="@(_drawerOpen ? "" : "Expand")">
                    <span style="font-size:16px;">@(_drawerOpen ? "←" : "→")</span>
                    @if (_drawerOpen) { <span>Collapse</span> }
                </button>
                <button class="cc-nav-btn cc-nav-logout" @onclick="Logout" title="@(_drawerOpen ? "" : "Sign Out")">
                    <span style="font-size:16px;">🚪</span>
                    @if (_drawerOpen) { <span>Sign Out</span> }
                </button>
            </div>
        </div>

        <!-- Main area -->
        <div style="flex:1;display:flex;flex-direction:column;min-width:0;height:100vh;overflow:hidden;">

            <!-- Top bar -->
            <div style="background:#ffffff;border-bottom:1px solid #E2E8F0;padding:14px 24px;
                        display:flex;align-items:center;justify-content:space-between;
                        position:sticky;top:0;z-index:50;box-shadow:0 1px 4px rgba(0,0,0,0.04);">
                <div>
                    <div style="font-size:17px;font-weight:700;color:#1E293B;">@_screenTitle</div>
                    <div style="font-size:11px;color:#94A3B8;">
                        @DateTime.Now.ToString("dddd, dd MMMM yyyy") &nbsp;·&nbsp; @_currentTime
                    </div>
                </div>
                <div style="display:flex;align-items:center;gap:12px;position:relative;">
                    @if (_isDoctor && !string.IsNullOrEmpty(ClinicContext.SelectedApplicationName))
                    {
                        <div style="display:flex;align-items:center;gap:6px;">
                            <div style="padding:5px 12px;background:#EFF6FF;border-radius:20px;
                                        font-size:12px;font-weight:700;color:#1565C0;
                                        border:1px solid #BFDBFE;white-space:nowrap;">
                                🏥 @ClinicContext.SelectedApplicationName
                            </div>
                            <button @onclick="SwitchClinic"
                                    style="padding:5px 12px;background:transparent;border:1px solid #E2E8F0;
                                           border-radius:20px;font-size:11px;font-weight:600;color:#64748B;
                                           cursor:pointer;white-space:nowrap;">
                                Switch Clinic
                            </button>
                        </div>
                    }
                    @if (NeedsSubscriptionGate)
                    {
                        <SubscriptionStatusPill />
                    }

                    <div style="padding:6px 14px;background:#EFF6FF;border-radius:20px;
                                font-size:12px;font-weight:600;color:#1565C0;">
                        🟢 Online
                    </div>

                    <!-- Account dropdown -->
                    <div style="position:relative;">
                        <button @onclick="ToggleUserMenu"
                                style="padding:6px 14px;background:#F1F5F9;border:1px solid #E2E8F0;
                                       border-radius:20px;font-size:12px;font-weight:600;color:#475569;
                                       cursor:pointer;white-space:nowrap;">
                            👤 Account ▾
                        </button>
                        @if (_userMenuOpen)
                        {
                            <div style="position:absolute;right:0;top:calc(100% + 6px);background:#fff;
                                        border:1px solid #E2E8F0;border-radius:10px;
                                        box-shadow:0 8px 24px rgba(0,0,0,0.1);min-width:180px;z-index:200;">
                                @if (_isDoctor)
                                {
                                    <a href="/doctor/profile" @onclick="CloseUserMenu"
                                       style="display:block;padding:10px 16px;font-size:13px;font-weight:600;
                                              color:#1E293B;text-decoration:none;">
                                        👤 My Profile
                                    </a>
                                    <a href="/doctor/change-password" @onclick="CloseUserMenu"
                                       style="display:block;padding:10px 16px;font-size:13px;font-weight:600;
                                              color:#1E293B;text-decoration:none;">
                                        🔒 Change Password
                                    </a>
                                    <button @onclick="SwitchClinicAndClose"
                                            style="display:block;width:100%;padding:10px 16px;font-size:13px;
                                                   font-weight:600;color:#1E293B;background:none;border:none;
                                                   cursor:pointer;text-align:left;">
                                        🔄 Switch Clinic
                                    </button>
                                }
                                else
                                {
                                    <a href="/auth/profile" @onclick="CloseUserMenu"
                                       style="display:block;padding:10px 16px;font-size:13px;font-weight:600;
                                              color:#1E293B;text-decoration:none;">
                                        👤 My Profile
                                    </a>
                                }
                                <div style="height:1px;background:#E2E8F0;margin:4px 0;"></div>
                                <button @onclick="Logout"
                                        style="display:block;width:100%;padding:10px 16px;font-size:13px;
                                               font-weight:600;color:#DC2626;background:none;border:none;
                                               cursor:pointer;text-align:left;">
                                    🚪 Sign Out
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Page content — only this div scrolls -->
            <div style="flex:1;padding:28px 32px;overflow-y:auto;min-height:0;">
                @if (NeedsSubscriptionGate && !SubscriptionContext.IsLoaded)
                {
                    <div style="display:flex;justify-content:center;padding:60px 0;">
                        <div class="auth-spinner" style="width:40px;height:40px;border-width:3px;"></div>
                    </div>
                }
                else if (NeedsSubscriptionGate && SubscriptionContext.IsLocked)
                {
                    @if (_isAdmin)
                    {
                        <SubscriptionPlans />
                    }
                    else
                    {
                        <ClinicLocked />
                    }
                }
                else
                {
                    @Body
                }
            </div>
        </div>
    </div>
}

@code {
    private bool _drawerOpen = true;
    private bool _checkingAuth = true;
    private bool _isAuthenticated;
    private bool _isDoctor;
    private bool _isAdmin;
    private bool _userMenuOpen;
    private string _currentTime = DateTime.Now.ToString("hh:mm tt");
    private string _roleLabel = string.Empty;
    private string _screenTitle = "Dashboard";

    private static readonly Dictionary<string, string> _titles = new()
    {
        ["/dashboard"]              = "Dashboard",
        ["/admin/dashboard"]        = "Admin Dashboard",
        ["/admin/wards"]            = "Ward & Room Management",
        ["/admin/users"]            = "User Management",
        ["/admin/usg-template"]     = "USG Appointment Template",
        ["/prescriptions"]          = "Prescriptions",
        ["/patients"]               = "Patient Registry",
        ["/opd"]                    = "My OPD Queue",
        ["/ipd"]                    = "IPD & Bed Management",
        ["/medicines"]              = "Medicine Management",
        ["/subscription"]           = "Subscription",

        ["/auth/profile"]           = "My Profile",

        ["/settings/prescription"]  = "Prescription Settings",
        ["/settings/dosage-remarks"]= "Dosage Remarks",
        ["/settings/feature-flags"] = "Feature Flags",
    };

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdateScreenTitle(NavigationManager.Uri);
    }

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        await ClinicContext.InitializeAsync();

        // Must run only after both awaits above truly complete — Blazor renders this
        // component (showing the _checkingAuth spinner) as soon as OnInitializedAsync
        // hits its first await, well before the localStorage reads finish. Calling this
        // from OnAfterRenderAsync(firstRender) races that first render and reads
        // ClinicContext.SelectedApplicationId as Guid.Empty even for an authenticated
        // user who does have a clinic selected, incorrectly bouncing to /select-clinic.
        CheckAuthAndRedirect();

        // Same reasoning applies here: OnAfterRenderAsync(firstRender: true) fires only
        // ONCE per component lifetime, and that one time is the premature render above,
        // before CheckAuthAndRedirect has set _isAuthenticated. Gating this refresh on
        // firstRender left NeedsSubscriptionGate reading false forever, so the refresh
        // never ran and the page was stuck on the subscription-loading spinner. Running
        // it here — after CheckAuthAndRedirect — guarantees the flags it depends on are
        // already resolved.
        if (NeedsSubscriptionGate)
        {
            await SubscriptionContext.RefreshAsync();
        }
    }

    // True once a clinic is selected and the user is authenticated — the only
    // state in which the subscription gate applies. False while on /select-clinic
    // or before login, matching the conditions CheckAuthAndRedirect already uses
    // to decide whether to redirect away instead of rendering @Body.
    private bool NeedsSubscriptionGate => _isAuthenticated && ClinicContext.SelectedApplicationId != Guid.Empty;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _userMenuOpen = false;
        UpdateScreenTitle(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void UpdateScreenTitle(string uri)
    {
        var path = "/" + uri.Replace(NavigationManager.BaseUri, "").TrimStart('/').Split('?')[0];
        _screenTitle = _titles.TryGetValue(path, out var t) ? t : "Dashboard";
    }

    private void CheckAuthAndRedirect()
    {
        try
        {
            _isAuthenticated = AuthState.IsAuthenticated;

            if (_isAuthenticated && AuthState.CurrentUser != null)
            {
                var selectedAppId = ClinicContext.SelectedApplicationId;
                var clinicRoles = selectedAppId != Guid.Empty
                    ? AuthState.GetRolesForApplication(selectedAppId)
                    : AuthState.CurrentUser.UserRoles
                        .Where(r => r.IsActive)
                        .Select(r => r.RoleName)
                        .ToList();

                _isDoctor = clinicRoles.Any(r => r.Equals("Doctor", StringComparison.OrdinalIgnoreCase));
                _isAdmin  = clinicRoles.Any(r =>
                    r.Equals("Clinic Admin", StringComparison.OrdinalIgnoreCase) ||
                    r.Equals("System Admin", StringComparison.OrdinalIgnoreCase));

                _roleLabel = clinicRoles
                    .FirstOrDefault(r =>
                        r.Equals("Clinic Admin", StringComparison.OrdinalIgnoreCase) ||
                        r.Equals("System Admin", StringComparison.OrdinalIgnoreCase))
                    ?? clinicRoles.FirstOrDefault()
                    ?? "User";
            }
        }
        catch
        {
            _isAuthenticated = false;
        }

        _checkingAuth = false;

        var uri = NavigationManager.Uri;
        var baseUri = NavigationManager.BaseUri;
        var path = uri.Replace(baseUri, "/");

        if (_isAuthenticated && ClinicContext.SelectedApplicationId == Guid.Empty
            && !path.StartsWith("/select-clinic")
            && !path.StartsWith("/doctor/")
            && !path.StartsWith("/auth/"))
        {
            NavigationManager.NavigateTo("/select-clinic");
            return;
        }

        if (!_isAuthenticated)
        {
            if (!path.StartsWith("/auth/"))
            {
                var returnUrl = Uri.EscapeDataString(path);
                NavigationManager.NavigateTo($"/auth/login?returnUrl={returnUrl}", forceLoad: true);
                return;
            }
        }
        else
        {
            if (path.StartsWith("/auth/login"))
            {
                NavigationManager.NavigateTo("/select-clinic", forceLoad: true);
                return;
            }
        }

        StateHasChanged();
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void ToggleUserMenu() => _userMenuOpen = !_userMenuOpen;
    private void CloseUserMenu() => _userMenuOpen = false;

    private async Task SwitchClinic()
    {
        SubscriptionContext.Clear();
        await ClinicContext.ClearClinicAsync();
        NavigationManager.NavigateTo("/select-clinic");
    }

    private async Task SwitchClinicAndClose()
    {
        _userMenuOpen = false;
        await SwitchClinic();
    }

    private async Task Logout()
    {
        _userMenuOpen = false;
        SubscriptionContext.Clear();
        await ClinicContext.ClearClinicAsync();
        await AuthState.ClearAuthStateAsync();
        NavigationManager.NavigateTo("/auth/login", forceLoad: true);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
