@inject NavigationManager Nav

<div style="position:relative;margin-bottom:2px;">
    @if (_isActive)
    {
        <div style="position:absolute;left:0;top:4px;bottom:4px;width:3px;
                    background:#42A5F5;border-radius:0 3px 3px 0;"></div>
    }
    <button @onclick="Navigate"
            style="width:100%;display:flex;align-items:center;gap:12px;
                   padding:@(SidebarOpen ? "10px 14px 10px 16px" : "10px 0");
                   justify-content:@(SidebarOpen ? "flex-start" : "center");
                   background:@(_isActive ? "rgba(255,255,255,0.1)" : "transparent");
                   border:none;border-radius:8px;cursor:pointer;
                   color:@(_isActive ? "#fff" : "rgba(255,255,255,0.6)");
                   font-size:13px;font-weight:@(_isActive ? "700" : "500");
                   transition:background 0.15s,color 0.15s;"
            title="@(SidebarOpen ? "" : Label)">
        <span style="font-size:16px;flex-shrink:0;">@Icon</span>
        @if (SidebarOpen)
        {
            <span>@Label</span>
        }
    </button>
</div>

@code {
    [Parameter] public string Href        { get; set; } = "/";
    [Parameter] public string Icon        { get; set; } = "•";
    [Parameter] public string Label       { get; set; } = string.Empty;
    [Parameter] public bool   SidebarOpen { get; set; }
    [Parameter] public string CurrentPath { get; set; } = "/";

    private bool _isActive => CurrentPath.Equals(Href, StringComparison.OrdinalIgnoreCase)
                           || (Href != "/doctor/home" && CurrentPath.StartsWith(Href, StringComparison.OrdinalIgnoreCase));

    private void Navigate() => Nav.NavigateTo(Href);
}
