@inject NavigationManager Nav

@{
    var isActive = CurrentPath == Href || (Href != "/dashboard" && CurrentPath.StartsWith(Href));
}

<button class="cc-nav-btn @(isActive ? "cc-nav-active" : "")"
        title="@(DrawerOpen ? "" : Label)"
        style="justify-content:@(DrawerOpen ? "flex-start" : "center");"
        @onclick="Navigate">
    @if (isActive)
    {
        <div style="position:absolute;left:0;top:20%;height:60%;width:3px;
                    background:#42A5F5;border-radius:2px;"></div>
    }
    <span style="font-size:16px;flex-shrink:0;">@Icon</span>
    @if (DrawerOpen)
    {
        <span>@Label</span>
    }
</button>

@code {
    [Parameter, EditorRequired] public string Href    { get; set; } = "/";
    [Parameter, EditorRequired] public string Icon    { get; set; } = "";
    [Parameter, EditorRequired] public string Label   { get; set; } = "";
    [Parameter] public bool DrawerOpen  { get; set; } = true;
    [Parameter] public string CurrentPath { get; set; } = "/";

    private void Navigate() => Nav.NavigateTo(Href);
}
