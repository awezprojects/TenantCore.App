@inject AuthStateService AuthState
@inject NavigationManager NavigationManager
@using TenantCore.Web.Client.Services
@implements IDisposable

<nav style="flex:1;padding:12px 8px;display:flex;flex-direction:column;gap:2px;overflow-y:auto;">
    <NavItem Href="/dashboard" Icon="▦" Label="Dashboard" DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />

    <div style="height:1px;background:rgba(255,255,255,0.08);margin:8px 4px;"></div>

    @if (_isDoctor)
    {
        <NavItem Href="/opd"           Icon="🩺" Label="My OPD Queue"   DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/prescriptions" Icon="📋" Label="Prescriptions"   DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/patients"         Icon="👥" Label="Patients"        DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/medicines"        Icon="💊" Label="Medicines"       DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />

        <div style="height:1px;background:rgba(255,255,255,0.08);margin:8px 4px;"></div>

        <NavItem Href="/settings/prescription"      Icon="🌐" Label="Rx Language"          DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/settings/dosage-remarks"    Icon="📝" Label="Dosage Remarks"       DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
    }
    else
    {
        <NavItem Href="/patients"  Icon="👥" Label="Patients"          DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/opd"       Icon="🩺" Label="OPD Registrations" DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/ipd"       Icon="🛏️" Label="IPD / Beds"        DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/medicines" Icon="💊" Label="Medicines"         DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />

        <div style="height:1px;background:rgba(255,255,255,0.08);margin:8px 4px;"></div>

        <NavItem Href="/auth/profile"        Icon="👤" Label="Profile"     DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/settings/preferences" Icon="⚙️" Label="Preferences" DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
    }
</nav>

@code {
    [Parameter] public bool DrawerOpen { get; set; } = true;

    private bool _isDoctor;
    private string _currentPath = "/dashboard";

    protected override void OnInitialized()
    {
        AuthState.OnAuthStateChanged += OnAuthChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
        RefreshState();
        UpdatePath(NavigationManager.Uri);
    }

    private void OnAuthChanged()
    {
        RefreshState();
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdatePath(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void UpdatePath(string uri)
    {
        _currentPath = "/" + uri.Replace(NavigationManager.BaseUri, "").TrimStart('/').Split('?')[0];
    }

    private void RefreshState()
    {
        _isDoctor = AuthState.CurrentUser?.UserRoles
            .Any(r => r.RoleName.Equals("Doctor", StringComparison.OrdinalIgnoreCase)) ?? false;
    }

    public void Dispose()
    {
        AuthState.OnAuthStateChanged -= OnAuthChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
