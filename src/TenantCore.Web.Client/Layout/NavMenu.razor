@inject AuthStateService AuthState
@inject NavigationManager NavigationManager
@inject ClinicContextService ClinicContext
@using TenantCore.Web.Client.Services
@implements IDisposable

<nav style="flex:1;padding:12px 8px;display:flex;flex-direction:column;gap:2px;overflow-y:auto;">

    @if (ClinicContext.ActivePanel == "Admin")
    {
        @* Clinic Admin panel — strict to admin role; no doctor-specific items *@
        <NavItem Href="/admin/dashboard" Icon="▦" Label="Dashboard" DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/subscription"    Icon="⚡" Label="Subscription" DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />

        <div style="height:1px;background:rgba(255,255,255,0.08);margin:8px 4px;"></div>

        <NavItem Href="/admin/wards"  Icon="🏨" Label="Wards & Rooms"  DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/admin/users"  Icon="👥" Label="User Management" DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/ipd"          Icon="🛏" Label="IPD & Beds"      DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/patients"     Icon="👥" Label="Patients"        DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/medicines"    Icon="💊" Label="Medicines"       DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/medicine-bundles" Icon="📦" Label="Medicine Bundles" DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />

        <div style="height:1px;background:rgba(255,255,255,0.08);margin:8px 4px;"></div>
        <NavItem Href="/admin/doctor-fee-configs"  Icon="💵" Label="Fee Configs"     DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/admin/particulars"         Icon="📦" Label="Particulars"     DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/admin/expense-categories"  Icon="📂" Label="Expense Cats"   DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/finance-dashboard"         Icon="📊" Label="Finance"         DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/counter-session"           Icon="🏧" Label="Counter"         DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/expense-records"           Icon="💸" Label="Expenses"        DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/amount-handovers"          Icon="🤝" Label="Handovers"       DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />

        <div style="height:1px;background:rgba(255,255,255,0.08);margin:8px 4px;"></div>
        <NavItem Href="/admin/usg-template"        Icon="🔬" Label="USG Template"   DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/settings/clinic-profile"   Icon="🏥" Label="Clinic Profile"  DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/settings/prescription"     Icon="🖨️" Label="Rx Settings"    DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/settings/feature-flags"    Icon="🚩" Label="Feature Flags"  DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/auth/profile" Icon="👤" Label="My Profile" DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
    }
    else if (ClinicContext.ActivePanel == "Doctor")
    {
        @* Doctor panel — no ward management, no IPD & beds *@
        <NavItem Href="/dashboard"     Icon="▦" Label="Dashboard"       DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />

        <div style="height:1px;background:rgba(255,255,255,0.08);margin:8px 4px;"></div>

        <NavItem Href="/opd"           Icon="🩺" Label="My OPD Queue"   DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/prescriptions" Icon="📋" Label="Prescriptions"   DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/patients"             Icon="👥" Label="Patients"        DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/patients/edd-overdue" Icon="⏰" Label="EDD Overdue"      DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/medicines"            Icon="💊" Label="Medicines"        DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/medicine-bundles"     Icon="📦" Label="Medicine Bundles" DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />

        <div style="height:1px;background:rgba(255,255,255,0.08);margin:8px 4px;"></div>

        <NavItem Href="/finance-dashboard"       Icon="📊" Label="My Finance"     DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/amount-handovers"        Icon="🤝" Label="Handovers"      DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />

        <div style="height:1px;background:rgba(255,255,255,0.08);margin:8px 4px;"></div>

        <NavItem Href="/settings/prescription"   Icon="🌐" Label="Rx Language"    DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/settings/dosage-remarks" Icon="📝" Label="Dosage Remarks" DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
    }
    else
    {
        <NavItem Href="/dashboard" Icon="▦" Label="Dashboard"    DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />

        <div style="height:1px;background:rgba(255,255,255,0.08);margin:8px 4px;"></div>

        <NavItem Href="/patients"             Icon="👥" Label="Patient Reg."   DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/patients/edd-overdue" Icon="⏰" Label="EDD Overdue"    DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/opd"                  Icon="🩺" Label="OPD Queue"      DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/ipd"      Icon="🛏" Label="IPD & Beds"    DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />

        <div style="height:1px;background:rgba(255,255,255,0.08);margin:8px 4px;"></div>

        <NavItem Href="/counter-session"  Icon="🏧" Label="Counter"        DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/expense-records"  Icon="💸" Label="Expenses"       DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
        <NavItem Href="/amount-handovers" Icon="🤝" Label="Handovers"      DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />

        <div style="height:1px;background:rgba(255,255,255,0.08);margin:8px 4px;"></div>

        <NavItem Href="/auth/profile" Icon="👤" Label="My Profile" DrawerOpen="DrawerOpen" CurrentPath="_currentPath" />
    }
</nav>

@code {
    [Parameter] public bool DrawerOpen { get; set; } = true;

    private string _currentPath = "/dashboard";

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        ClinicContext.OnClinicChanged += OnClinicContextChanged;
        UpdatePath(NavigationManager.Uri);
    }

    private void OnClinicContextChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdatePath(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void UpdatePath(string uri)
    {
        _currentPath = "/" + uri.Replace(NavigationManager.BaseUri, "").TrimStart('/').Split('?')[0];
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        ClinicContext.OnClinicChanged -= OnClinicContextChanged;
    }
}
