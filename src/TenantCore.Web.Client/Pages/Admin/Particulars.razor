@page "/admin/particulars"
@layout AuthorizedLayout
@inject IParticularApiClient ParticularClient
@inject IToastService Toast

<PageTitle>Particulars - TenantCore</PageTitle>

<div class="opd-header">
    <div>
        <div class="opd-header-title">Particulars (Service Items)</div>
    </div>
    <button class="opd-btn-primary" @onclick="OpenCreateDialog">+ Add Particular</button>
</div>

@if (_loading)
{
    <div style="display:flex;justify-content:center;padding:40px 0;">
        <div class="auth-spinner" style="width:32px;height:32px;border-width:3px;"></div>
    </div>
}
else
{
    <div class="opd-table-card">
        <table class="opd-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Default Amount</th>
                    <th>Status</th>
                    <th style="white-space:nowrap;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!_items.Any())
                {
                    <tr><td colspan="4" class="opd-empty">No particulars found.</td></tr>
                }
                @foreach (var item in _items)
                {
                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td>Rs. @item.DefaultAmount.ToString("N2")</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span style="background:#DCFCE7;color:#166534;border-radius:12px;padding:2px 10px;font-size:11px;font-weight:600;">Active</span>
                            }
                            else
                            {
                                <span style="background:#FEE2E2;color:#991B1B;border-radius:12px;padding:2px 10px;font-size:11px;font-weight:600;">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="opd-actions">
                                <button class="opd-btn edit-btn" @onclick="@(() => OpenEditDialog(item))">Edit</button>
                                <button class="opd-btn delete-btn" @onclick="@(() => DeleteAsync(item.Id))">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_dialogVisible)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:900;" @onclick="CloseDialog"></div>
    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
                background:#fff;border-radius:14px;padding:28px 30px;width:440px;max-width:95vw;
                box-shadow:0 20px 60px rgba(0,0,0,0.2);z-index:901;">
        <div style="font-size:16px;font-weight:800;color:#0F172A;margin-bottom:20px;">
            @(_editingId.HasValue ? "Edit Particular" : "Add Particular")
        </div>

        <div class="form-group">
            <label class="form-label">Name *</label>
            <input class="form-input" type="text" @bind="_name" placeholder="Service name" />
        </div>

        <div class="form-group">
            <label class="form-label">Default Amount</label>
            <input class="form-input" type="number" @bind="_defaultAmount" min="0" step="0.01" />
        </div>

        @if (_editingId.HasValue)
        {
            <label style="display:flex;align-items:center;gap:8px;margin-bottom:16px;font-size:13px;color:#374151;cursor:pointer;">
                <input type="checkbox" @bind="_isActive" style="width:16px;height:16px;" />
                Is Active
            </label>
        }

        <div style="display:flex;gap:10px;justify-content:flex-end;">
            <button @onclick="CloseDialog"
                    style="padding:9px 20px;border-radius:8px;border:1.5px solid #E2E8F0;background:#fff;
                           font-size:13px;font-weight:600;color:#64748B;cursor:pointer;">
                Cancel
            </button>
            <button @onclick="SaveAsync" disabled="@_saving"
                    style="padding:9px 22px;border-radius:8px;border:none;background:#1565C0;color:#fff;
                           font-size:13px;font-weight:700;cursor:pointer;opacity:@(_saving ? "0.7" : "1");">
                @(_saving ? "Saving..." : "Save")
            </button>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _dialogVisible;
    private bool _saving;
    private List<ParticularSummaryDto> _items = [];

    private Guid? _editingId;
    private string _name = string.Empty;
    private decimal _defaultAmount;
    private bool _isActive = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var response = await ParticularClient.GetAllAsync();
        if (response.Success && response.Data is not null)
            _items = response.Data.ToList();
        else if (!response.Success)
            Toast.ShowError(response.Message ?? "Failed to load particulars.");
        _loading = false;
    }

    private void OpenCreateDialog()
    {
        _editingId = null;
        _name = string.Empty;
        _defaultAmount = 0;
        _isActive = true;
        _dialogVisible = true;
    }

    private void OpenEditDialog(ParticularSummaryDto item)
    {
        _editingId = item.Id;
        _name = item.Name;
        _defaultAmount = item.DefaultAmount;
        _isActive = item.IsActive;
        _dialogVisible = true;
    }

    private void CloseDialog() => _dialogVisible = false;

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_name)) { Toast.ShowWarning("Name is required."); return; }
        _saving = true;
        if (_editingId.HasValue)
        {
            var response = await ParticularClient.UpdateAsync(_editingId.Value,
                new UpdateParticularRequest { Name = _name, DefaultAmount = _defaultAmount, IsActive = _isActive });
            if (response.Success) { Toast.ShowSuccess("Updated."); CloseDialog(); await LoadAsync(); }
            else Toast.ShowError(response.Message ?? "Failed to update.");
        }
        else
        {
            var response = await ParticularClient.CreateAsync(
                new CreateParticularRequest { Name = _name, DefaultAmount = _defaultAmount });
            if (response.Success) { Toast.ShowSuccess("Created."); CloseDialog(); await LoadAsync(); }
            else Toast.ShowError(response.Message ?? "Failed to create.");
        }
        _saving = false;
    }

    private async Task DeleteAsync(Guid id)
    {
        var response = await ParticularClient.DeleteAsync(id);
        if (response.Success) { Toast.ShowSuccess("Deleted."); await LoadAsync(); }
        else Toast.ShowError(response.Message ?? "Failed to delete.");
    }
}
