@page "/admin/users"
@layout AuthorizedLayout
@inject IApplicationApiClient AppClient
@inject IAuthApiClient AuthClient
@inject IToastService Toast
@inject AuthStateService AuthState
@inject ClinicContextService ClinicContext
@inject NavigationManager Navigation
@using TenantCore.Web.Client.Services
@using TenantCore.Shared.Dtos.Auth

<PageTitle>User Management - CloudClinic</PageTitle>

@if (_loading)
{
    <div style="display:flex;justify-content:center;align-items:center;padding:80px 0;">
        <div class="auth-spinner" style="width:48px;height:48px;border-width:4px;"></div>
    </div>
}
else if (_applicationId == Guid.Empty)
{
    <div style="background:#fff;border-radius:16px;padding:60px 24px;text-align:center;border:1px solid #E2E8F0;">
        <div style="font-size:48px;margin-bottom:16px;">🏥</div>
        <div style="font-size:17px;font-weight:700;color:#1E293B;margin-bottom:8px;">No clinic assigned</div>
        <div style="font-size:13px;color:#64748B;">Your account is not linked to any clinic application. Please contact a system administrator.</div>
    </div>
}
else
{
    <div class="cc-fade-in" style="display:flex;flex-direction:column;gap:20px;">

        <!-- Header -->
        <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:12px;">
            <div>
                <div style="font-size:20px;font-weight:800;color:#1E293B;">User Management</div>
                <div style="font-size:13px;color:#64748B;margin-top:3px;">
                    @_applicationName &nbsp;·&nbsp; Manage team members and access
                </div>
            </div>
            <button style="@BtnPrimary" @onclick="OpenInviteDialog">＋ Add Member</button>
        </div>

        <!-- Stat cards -->
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px;">
            <div style="background:#EFF6FF;border-radius:14px;padding:18px 20px;display:flex;justify-content:space-between;align-items:center;">
                <div>
                    <div style="font-size:11px;font-weight:700;color:#94A3B8;letter-spacing:0.6px;margin-bottom:4px;">TOTAL MEMBERS</div>
                    <div style="font-size:32px;font-weight:800;color:#1E293B;line-height:1;">@((_users?.Count ?? 0) + (_deactivatedUsers?.Count ?? 0))</div>
                </div>
                <div style="font-size:30px;opacity:0.6;">👥</div>
            </div>
            <div style="background:#ECFDF5;border-radius:14px;padding:18px 20px;display:flex;justify-content:space-between;align-items:center;">
                <div>
                    <div style="font-size:11px;font-weight:700;color:#94A3B8;letter-spacing:0.6px;margin-bottom:4px;">ACTIVE</div>
                    <div style="font-size:32px;font-weight:800;color:#16A34A;line-height:1;">@(_users?.Count ?? 0)</div>
                </div>
                <div style="font-size:30px;opacity:0.6;">✅</div>
            </div>
            <div style="background:#FEF2F2;border-radius:14px;padding:18px 20px;display:flex;justify-content:space-between;align-items:center;">
                <div>
                    <div style="font-size:11px;font-weight:700;color:#94A3B8;letter-spacing:0.6px;margin-bottom:4px;">DEACTIVATED</div>
                    <div style="font-size:32px;font-weight:800;color:#EF4444;line-height:1;">@(_deactivatedUsers?.Count ?? 0)</div>
                </div>
                <div style="font-size:30px;opacity:0.6;">🚫</div>
            </div>
            <div style="background:#FFFBEB;border-radius:14px;padding:18px 20px;display:flex;justify-content:space-between;align-items:center;">
                <div>
                    <div style="font-size:11px;font-weight:700;color:#94A3B8;letter-spacing:0.6px;margin-bottom:4px;">PENDING INVITES</div>
                    <div style="font-size:32px;font-weight:800;color:#D97706;line-height:1;">@(_invitations?.Count(i => !i.IsAccepted && !i.IsExpired) ?? 0)</div>
                </div>
                <div style="font-size:30px;opacity:0.6;">✉</div>
            </div>
        </div>

        <!-- Tabs -->
        <div style="background:#fff;border-radius:16px;border:1px solid #E2E8F0;overflow:hidden;">

            <!-- Tab bar -->
            <div style="display:flex;border-bottom:1px solid #E2E8F0;padding:0 4px;">
                <button style="@TabStyle(_activeTab == 0)" @onclick="@(() => _activeTab = 0)">
                    👤 Active Members (@(_users?.Count ?? 0))
                </button>
                <button style="@TabStyle(_activeTab == 1)" @onclick="@(() => _activeTab = 1)">
                    🚫 Deactivated (@(_deactivatedUsers?.Count ?? 0))
                </button>
                <button style="@TabStyle(_activeTab == 2)" @onclick="@(() => _activeTab = 2)">
                    ✉ Invitations
                    @{ var pendingCount = _invitations?.Count(i => !i.IsAccepted && !i.IsExpired) ?? 0; }
                    @if (pendingCount > 0)
                    {
                        <span style="margin-left:5px;background:#DBEAFE;color:#1D4ED8;font-size:10px;
                                     font-weight:800;padding:1px 6px;border-radius:20px;">@pendingCount</span>
                    }
                </button>
            </div>

            <!-- Tab content -->
            <div style="padding:16px 20px;">

                @if (_activeTab == 0)
                {
                    <div style="margin-bottom:16px;">
                        <div style="position:relative;max-width:360px;">
                            <span style="position:absolute;left:12px;top:50%;transform:translateY(-50%);font-size:14px;color:#94A3B8;">🔍</span>
                            <input type="text"
                                   placeholder="Search members by name or email..."
                                   value="@_searchQuery"
                                   @oninput="@(e => _searchQuery = e.Value?.ToString() ?? string.Empty)"
                                   style="width:100%;padding:9px 12px 9px 36px;border:1.5px solid #E2E8F0;border-radius:10px;
                                          font-size:13px;color:#1E293B;background:#F8FAFC;outline:none;" />
                        </div>
                    </div>

                    @if (_usersLoading)
                    {
                        <div style="padding:40px;text-align:center;">
                            <div class="auth-spinner" style="width:28px;height:28px;border-width:3px;display:inline-block;"></div>
                        </div>
                    }
                    else if (!FilteredUsers.Any())
                    {
                        <div style="padding:48px 24px;text-align:center;">
                            <div style="font-size:36px;margin-bottom:12px;">👤</div>
                            <div style="font-size:15px;font-weight:700;color:#1E293B;margin-bottom:6px;">No members found</div>
                            <div style="font-size:13px;color:#64748B;margin-bottom:20px;">
                                @if (string.IsNullOrWhiteSpace(_searchQuery))
                                {
                                    <span>No active members yet. Add your first team member.</span>
                                }
                                else
                                {
                                    <span>No results for "@_searchQuery"</span>
                                }
                            </div>
                            @if (string.IsNullOrWhiteSpace(_searchQuery))
                            {
                                <button style="@BtnPrimary" @onclick="OpenInviteDialog">＋ Add Member</button>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="overflow-x:auto;">
                            <table style="width:100%;border-collapse:collapse;">
                                <thead>
                                    <tr style="border-bottom:1.5px solid #E2E8F0;">
                                        <th style="@ThStyle;width:38%;">Member</th>
                                        <th style="@ThStyle;width:18%;">Role</th>
                                        <th style="@ThStyle;width:12%;">Status</th>
                                        <th style="@ThStyle;width:12%;">Joined</th>
                                        <th style="@ThStyle;width:20%;text-align:right;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in FilteredUsers)
                                    {
                                        var initials   = GetInitials(user.FirstName, user.LastName);
                                        var avatarColor = GetAvatarColor(user.UserId);

                                        <tr style="border-bottom:1px solid #F1F5F9;">
                                            <td style="@TdStyle;padding:14px 12px;">
                                                <div style="display:flex;align-items:center;gap:12px;">
                                                    <div style="width:40px;height:40px;border-radius:12px;flex-shrink:0;
                                                                background:@avatarColor;display:flex;align-items:center;
                                                                justify-content:center;font-size:14px;font-weight:800;
                                                                color:#fff;letter-spacing:-0.5px;">
                                                        @initials
                                                    </div>
                                                    <div>
                                                        <div style="font-size:14px;font-weight:700;color:#1E293B;">
                                                            @user.FullName
                                                            @if (user.IsOwner)
                                                            {
                                                                <span style="font-size:10px;font-weight:700;padding:2px 7px;
                                                                             border-radius:20px;background:#FEF3C7;color:#D97706;
                                                                             margin-left:6px;">OWNER</span>
                                                            }
                                                        </div>
                                                        <div style="font-size:12px;color:#94A3B8;margin-top:2px;">@user.EmailId</div>
                                                        @if (!string.IsNullOrEmpty(user.MobileNo))
                                                        {
                                                            <div style="font-size:11px;color:#CBD5E1;">📞 @user.MobileNo</div>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td style="@TdStyle">
                                                @if (!string.IsNullOrEmpty(user.RoleName))
                                                {
                                                    var roleColor = GetRoleColor(user.RoleName);
                                                    <span style="font-size:12px;font-weight:700;padding:4px 10px;
                                                                 border-radius:20px;color:@roleColor.fg;
                                                                 background:@roleColor.bg;white-space:nowrap;">
                                                        @user.RoleName
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span style="font-size:12px;color:#CBD5E1;">—</span>
                                                }
                                            </td>
                                            <td style="@TdStyle">
                                                <span style="font-size:12px;font-weight:700;padding:4px 10px;
                                                             border-radius:20px;
                                                             color:@(user.IsActive ? "#16A34A" : "#EF4444");
                                                             background:@(user.IsActive ? "#DCFCE7" : "#FEE2E2");">
                                                    @(user.IsActive ? "Active" : "Inactive")
                                                </span>
                                            </td>
                                            <td style="@TdStyle">
                                                <div style="font-size:12px;color:#64748B;">
                                                    @user.JoinedDate.ToString("dd MMM yyyy")
                                                </div>
                                            </td>
                                            <td style="@TdStyle;text-align:right;">
                                                @if (!user.IsOwner)
                                                {
                                                    <div class="opd-actions" style="justify-content:flex-end;">
                                                        <button class="opd-btn edit-btn" @onclick="() => OpenChangeRoleDialog(user)">Change Role</button>
                                                        <button class="opd-btn @(user.IsActive ? "delete-btn" : "edit-btn")"
                                                                @onclick="() => OpenToggleDialog(user)">
                                                            @(user.IsActive ? "Deactivate" : "Activate")
                                                        </button>
                                                        <button class="opd-btn delete-btn" @onclick="() => OpenRemoveDialog(user)">Remove</button>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                else if (_activeTab == 1)
                {
                    @if (_deactivatedLoading)
                    {
                        <div style="padding:40px;text-align:center;">
                            <div class="auth-spinner" style="width:28px;height:28px;border-width:3px;display:inline-block;"></div>
                        </div>
                    }
                    else if (!(_deactivatedUsers?.Any() ?? false))
                    {
                        <div style="padding:48px 24px;text-align:center;">
                            <div style="font-size:36px;margin-bottom:12px;">✅</div>
                            <div style="font-size:15px;font-weight:700;color:#1E293B;margin-bottom:6px;">No deactivated members</div>
                            <div style="font-size:13px;color:#64748B;">All team members are currently active.</div>
                        </div>
                    }
                    else
                    {
                        <div style="overflow-x:auto;">
                            <table style="width:100%;border-collapse:collapse;">
                                <thead>
                                    <tr style="border-bottom:1.5px solid #E2E8F0;">
                                        <th style="@ThStyle;width:45%;">Member</th>
                                        <th style="@ThStyle;width:25%;">Last Role</th>
                                        <th style="@ThStyle;width:20%;">Deactivated On</th>
                                        <th style="@ThStyle;width:10%;text-align:right;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in _deactivatedUsers!)
                                    {
                                        var initials = GetInitials(user.FirstName, user.LastName);
                                        <tr style="border-bottom:1px solid #F1F5F9;opacity:0.75;">
                                            <td style="@TdStyle;padding:14px 12px;">
                                                <div style="display:flex;align-items:center;gap:12px;">
                                                    <div style="width:40px;height:40px;border-radius:12px;flex-shrink:0;
                                                                background:#E2E8F0;display:flex;align-items:center;
                                                                justify-content:center;font-size:14px;font-weight:800;color:#94A3B8;">
                                                        @initials
                                                    </div>
                                                    <div>
                                                        <div style="font-size:14px;font-weight:700;color:#64748B;">@user.FullName</div>
                                                        <div style="font-size:12px;color:#94A3B8;margin-top:2px;">@user.EmailId</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td style="@TdStyle">
                                                @if (!string.IsNullOrEmpty(user.RoleName))
                                                {
                                                    <span style="font-size:12px;font-weight:600;padding:4px 10px;
                                                                 border-radius:20px;color:#64748B;background:#F1F5F9;">
                                                        @user.RoleName
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span style="font-size:12px;color:#CBD5E1;">—</span>
                                                }
                                            </td>
                                            <td style="@TdStyle">
                                                <div style="font-size:12px;color:#94A3B8;">@user.ModifiedDate.ToString("dd MMM yyyy")</div>
                                            </td>
                                            <td style="@TdStyle;text-align:right;">
                                                <button style="@BtnReactivate" @onclick="() => OpenReactivateDialog(user)">
                                                    ↩ Re-Activate
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                else
                {
                    @if (_invitationsLoading)
                    {
                        <div style="padding:40px;text-align:center;">
                            <div class="auth-spinner" style="width:28px;height:28px;border-width:3px;display:inline-block;"></div>
                        </div>
                    }
                    else if (!(_invitations?.Any() ?? false))
                    {
                        <div style="padding:48px 24px;text-align:center;">
                            <div style="font-size:36px;margin-bottom:12px;">✉</div>
                            <div style="font-size:15px;font-weight:700;color:#1E293B;margin-bottom:6px;">No invitations sent yet</div>
                            <div style="font-size:13px;color:#64748B;margin-bottom:20px;">Invitations will appear here once you add members.</div>
                            <button style="@BtnPrimary" @onclick="OpenInviteDialog">＋ Add Member</button>
                        </div>
                    }
                    else
                    {
                        <div style="overflow-x:auto;">
                            <table style="width:100%;border-collapse:collapse;">
                                <thead>
                                    <tr style="border-bottom:1.5px solid #E2E8F0;">
                                        <th style="@ThStyle;width:30%;">Invitee</th>
                                        <th style="@ThStyle;width:18%;">Role</th>
                                        <th style="@ThStyle;width:12%;">Type</th>
                                        <th style="@ThStyle;width:15%;">Status</th>
                                        <th style="@ThStyle;width:15%;">Expires</th>
                                        <th style="@ThStyle;width:10%;text-align:right;">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var inv in _invitations!.OrderByDescending(i => i.CreatedDate))
                                    {
                                        var (statusText, statusFg, statusBg) = GetInvitationStatus(inv);

                                        <tr style="border-bottom:1px solid #F1F5F9;">
                                            <td style="@TdStyle;padding:12px;">
                                                <div style="font-size:13px;font-weight:700;color:#1E293B;">@inv.FullName</div>
                                                <div style="font-size:11px;color:#94A3B8;margin-top:2px;">@inv.EmailId</div>
                                                <div style="font-size:10px;color:#CBD5E1;margin-top:1px;">
                                                    Sent @inv.CreatedDate.ToString("dd MMM yyyy")
                                                </div>
                                            </td>
                                            <td style="@TdStyle">
                                                @if (!string.IsNullOrEmpty(inv.RoleName))
                                                {
                                                    var rc = GetRoleColor(inv.RoleName);
                                                    <span style="font-size:11px;font-weight:700;padding:3px 8px;
                                                                 border-radius:20px;color:@rc.fg;background:@rc.bg;">
                                                        @inv.RoleName
                                                    </span>
                                                }
                                                else { <span style="font-size:12px;color:#CBD5E1;">—</span> }
                                            </td>
                                            <td style="@TdStyle">
                                                <span style="font-size:11px;font-weight:600;padding:3px 8px;
                                                             border-radius:20px;
                                                             color:@(inv.IsExistingUser ? "#0891B2" : "#7C3AED");
                                                             background:@(inv.IsExistingUser ? "#ECFEFF" : "#F5F3FF");">
                                                    @(inv.IsExistingUser ? "Existing" : "New")
                                                </span>
                                            </td>
                                            <td style="@TdStyle">
                                                <span style="font-size:11px;font-weight:700;padding:3px 8px;
                                                             border-radius:20px;color:@statusFg;background:@statusBg;">
                                                    @statusText
                                                </span>
                                            </td>
                                            <td style="@TdStyle">
                                                @if (inv.IsAccepted)
                                                {
                                                    <div style="font-size:11px;color:#94A3B8;">Accepted</div>
                                                }
                                                else
                                                {
                                                    var daysLeft = (int)(inv.ExpiresAt - DateTime.UtcNow).TotalDays;
                                                    <div style="font-size:11px;color:@(inv.IsExpired ? "#EF4444" : "#64748B");">
                                                        @if (inv.IsExpired)
                                                        {
                                                            <span>Expired @inv.ExpiresAt.ToString("dd MMM")</span>
                                                        }
                                                        else
                                                        {
                                                            <span>@daysLeft day@(daysLeft != 1 ? "s" : "") left</span>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                            <td style="@TdStyle;text-align:right;">
                                                <div class="opd-actions" style="justify-content:flex-end;">
                                                    @if (!inv.IsAccepted)
                                                    {
                                                        <button class="opd-btn edit-btn"
                                                                @onclick="() => OpenReinviteDialog(inv)"
                                                                disabled="@_reinviting">
                                                            @(inv.IsExpired ? "Re-invite" : "Resend")
                                                        </button>
                                                        <button class="opd-btn delete-btn"
                                                                @onclick="() => OpenDeleteInvitationDialog(inv)">Delete</button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        </div>

    </div>
}

<!-- Add Member Modal -->
@if (_inviteDialogVisible)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:900;" @onclick="CloseInviteDialog"></div>
    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
                background:#fff;border-radius:14px;width:500px;max-width:96vw;max-height:90vh;
                box-shadow:0 20px 60px rgba(0,0,0,0.2);z-index:901;overflow:hidden;display:flex;flex-direction:column;">
        <div style="padding:20px 24px 16px;border-bottom:1px solid #E2E8F0;flex-shrink:0;">
            <div style="display:flex;align-items:center;gap:10px;">
                <div style="width:36px;height:36px;border-radius:10px;background:#EFF6FF;
                            display:flex;align-items:center;justify-content:center;font-size:18px;">👤</div>
                <div>
                    <div style="font-size:16px;font-weight:800;color:#1E293B;">Add Team Member</div>
                    <div style="font-size:11px;color:#94A3B8;">Search for existing user or send a new invitation</div>
                </div>
            </div>
        </div>
        <div style="padding:20px 24px;overflow-y:auto;display:flex;flex-direction:column;gap:16px;">

            <!-- Mode toggle -->
            <div style="display:flex;gap:8px;background:#F8FAFC;border-radius:10px;padding:4px;">
                <button style="@ModeTabStyle(_inviteMode == 0)"
                        @onclick="@(() => { _inviteMode = 0; ResetInviteForm(); })">
                    🔍 Search Existing
                </button>
                <button style="@ModeTabStyle(_inviteMode == 1)"
                        @onclick="@(() => { _inviteMode = 1; ResetInviteForm(); })">
                    ✉ New Invitation
                </button>
            </div>

            @if (_inviteMode == 0)
            {
                <div>
                    <div style="font-size:12px;font-weight:600;color:#64748B;margin-bottom:6px;">Search by email address</div>
                    <input type="email" class="form-input"
                           placeholder="Type email to search..."
                           value="@_searchEmail"
                           @oninput="OnSearchEmailInput"
                           disabled="@_saving" />
                </div>

                @if (_searching)
                {
                    <div style="display:flex;align-items:center;gap:8px;padding:8px 0;color:#94A3B8;font-size:13px;">
                        <div class="auth-spinner" style="width:16px;height:16px;border-width:2px;flex-shrink:0;display:inline-block;"></div>
                        Searching...
                    </div>
                }
                else if (_searchResults != null && _searchResults.Count > 0 && _selectedExistingUser == null)
                {
                    <div style="border:1.5px solid #E2E8F0;border-radius:10px;overflow:hidden;max-height:220px;overflow-y:auto;">
                        @foreach (var u in _searchResults)
                        {
                            <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;cursor:pointer;
                                        border-bottom:1px solid #F1F5F9;"
                                 @onclick="() => SelectExistingUser(u)">
                                <div style="width:34px;height:34px;border-radius:9px;background:#EFF6FF;flex-shrink:0;
                                            display:flex;align-items:center;justify-content:center;
                                            font-size:13px;font-weight:800;color:#1565C0;">
                                    @GetInitials(u.FirstName, u.LastName)
                                </div>
                                <div style="flex:1;min-width:0;">
                                    <div style="font-size:13px;font-weight:700;color:#1E293B;">@u.FullName</div>
                                    <div style="font-size:11px;color:#94A3B8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@u.EmailId</div>
                                </div>
                                <span style="font-size:11px;font-weight:600;color:#1565C0;">Select →</span>
                            </div>
                        }
                    </div>
                }
                else if (_searchResults != null && _searchResults.Count == 0 && !string.IsNullOrWhiteSpace(_searchEmail) && _searchEmail.Length >= 3)
                {
                    <div style="padding:14px;background:#FFFBEB;border-radius:10px;border:1px solid #FDE68A;
                                font-size:13px;color:#92400E;display:flex;align-items:center;gap:8px;">
                        <span>⚠</span>
                        <span>No user found with that email. Switch to <b>New Invitation</b> to invite them.</span>
                    </div>
                }

                @if (_selectedExistingUser != null)
                {
                    <div style="background:#F0FDF4;border-radius:10px;border:1.5px solid #86EFAC;padding:12px 14px;">
                        <div style="display:flex;align-items:center;gap:10px;">
                            <div style="width:38px;height:38px;border-radius:10px;background:#16A34A;flex-shrink:0;
                                        display:flex;align-items:center;justify-content:center;
                                        font-size:14px;font-weight:800;color:#fff;">
                                @GetInitials(_selectedExistingUser.FirstName, _selectedExistingUser.LastName)
                            </div>
                            <div style="flex:1;">
                                <div style="font-size:13px;font-weight:700;color:#15803D;">@_selectedExistingUser.FullName</div>
                                <div style="font-size:11px;color:#4ADE80;">@_selectedExistingUser.EmailId</div>
