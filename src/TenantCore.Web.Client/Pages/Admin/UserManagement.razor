                Toast.ShowSuccess(result.Message ?? (newStatus ? $"{_userToToggle.FullName} activated." : $"{_userToToggle.FullName} deactivated."));
                _toggleDialogVisible = false;
                await Task.WhenAll(LoadUsersAsync(), LoadDeactivatedUsersAsync());
            }
            else { Toast.ShowError(result.Message ?? "Operation failed."); }
