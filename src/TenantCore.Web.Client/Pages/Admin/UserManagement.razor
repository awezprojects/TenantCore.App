@code {
    private const string BtnPrimary         = "background:#1565C0;color:#fff;border:none;border-radius:8px;padding:9px 20px;font-weight:700;font-size:13px;cursor:pointer;";
    private const string BtnPrimaryDisabled = "background:#93C5FD;color:#fff;border:none;border-radius:8px;padding:9px 20px;font-weight:700;font-size:13px;cursor:not-allowed;opacity:0.7;";
    private const string BtnGhost           = "background:transparent;color:#64748B;border:1.5px solid #E2E8F0;border-radius:8px;padding:8px 16px;font-weight:600;font-size:13px;cursor:pointer;";
    private const string BtnDanger          = "background:#EF4444;color:#fff;border:none;border-radius:8px;padding:9px 20px;font-weight:700;font-size:13px;cursor:pointer;";
    private const string BtnSuccess         = "background:#16A34A;color:#fff;border:none;border-radius:8px;padding:9px 20px;font-weight:700;font-size:13px;cursor:pointer;";
    private const string BtnReactivate      = "background:#ECFDF5;color:#16A34A;border:1.5px solid #86EFAC;border-radius:8px;padding:5px 12px;font-weight:700;font-size:12px;cursor:pointer;white-space:nowrap;";
    private const string ThStyle            = "padding:10px 12px;font-size:11px;font-weight:700;color:#94A3B8;letter-spacing:0.5px;text-align:left;";
    private const string TdStyle            = "padding:10px 12px;vertical-align:middle;";

    private static string TabStyle(bool active) =>
        active
        ? "flex:1;padding:8px;border:none;border-radius:8px;background:#fff;font-size:13px;font-weight:700;color:#1565C0;cursor:pointer;box-shadow:0 1px 4px rgba(0,0,0,0.08);"
        : "flex:1;padding:8px;border:none;border-radius:8px;background:transparent;font-size:13px;font-weight:600;color:#94A3B8;cursor:pointer;";

    private static string ModeTabStyle(bool active) =>
        active
        ? "flex:1;padding:7px;border:none;border-radius:7px;background:#1565C0;font-size:12px;font-weight:700;color:#fff;cursor:pointer;"
        : "flex:1;padding:7px;border:none;border-radius:7px;background:transparent;font-size:12px;font-weight:600;color:#64748B;cursor:pointer;";

    private static readonly string[] AvatarColors = ["#1565C0","#7C3AED","#DB2777","#D97706","#059669","#0891B2","#DC2626","#65A30D"];
    private static string GetAvatarColor(Guid id) => AvatarColors[Math.Abs(id.GetHashCode()) % AvatarColors.Length];
    private static string GetInitials(string first, string last) =>
        $"{(first.Length > 0 ? first[0] : '?')}{(last.Length > 0 ? last[0] : '?')}".ToUpper();

    private static (string fg, string bg) GetRoleColor(string role) => role.ToLowerInvariant() switch
    {
        "clinic admin"   => ("#7C3AED", "#F5F3FF"),
        "admin"          => ("#7C3AED", "#F5F3FF"),
        "doctor"         => ("#0891B2", "#ECFEFF"),
        "nurse"          => ("#059669", "#ECFDF5"),
        "reception"      => ("#D97706", "#FFFBEB"),
        _                => ("#64748B", "#F1F5F9")
    };

    // ── State ────────────────────────────────────────────────────────────────
    private bool _loading            = true;
    private bool _usersLoading       = true;
    private bool _deactivatedLoading;
    private bool _invitationsLoading;
    private bool _rolesLoading;
    private bool _saving;
    private bool _reinviting;

    private Guid   _applicationId   = Guid.Empty;
    private string _applicationName = string.Empty;

    private List<ApplicationUserResponseDto>? _users;
    private List<ApplicationUserResponseDto>? _deactivatedUsers;
    private List<InvitationResponseDto>? _invitations;
    private List<RoleResponseDto> _roles = [];

    private int    _activeTab   = 0;
    private string _searchQuery = string.Empty;

    private IEnumerable<ApplicationUserResponseDto> FilteredUsers =>
        (_users ?? []).Where(u =>
            string.IsNullOrWhiteSpace(_searchQuery) ||
            u.FullName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
            u.EmailId.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));

    // ── Invite dialog ────────────────────────────────────────────────────────
    private bool   _inviteDialogVisible;
    private int    _inviteMode = 0;
    private InviteUserRequestDto _inviteModel = new();
    private Guid   _selectedRoleId = Guid.Empty;

    private string? _searchEmail;
    private bool    _searching;
    private List<UserSearchResultDto>? _searchResults;
    private UserSearchResultDto? _selectedExistingUser;
    private CancellationTokenSource? _searchDebounce;

    // ── Change role dialog ───────────────────────────────────────────────────
    private bool   _changeRoleDialogVisible;
    private ApplicationUserResponseDto? _userToChangeRole;
    private Guid   _newRoleId = Guid.Empty;

    // ── Toggle dialog ────────────────────────────────────────────────────────
    private bool   _toggleDialogVisible;
    private ApplicationUserResponseDto? _userToToggle;

    // ── Remove dialog ────────────────────────────────────────────────────────
    private bool   _removeDialogVisible;
    private ApplicationUserResponseDto? _userToRemove;

    // ── Re-activate dialog ───────────────────────────────────────────────────
    private bool   _reactivateDialogVisible;
    private ApplicationUserResponseDto? _userToReactivate;

    // ── Re-invite dialog ─────────────────────────────────────────────────────
    private bool   _reinviteDialogVisible;
    private InvitationResponseDto? _invitationToReinvite;

    // ── Delete invitation dialog ──────────────────────────────────────────────
    private bool   _deleteInvitationDialogVisible;
    private InvitationResponseDto? _invitationToDelete;

    // ── Lifecycle ────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        await ClinicContext.InitializeAsync();

        if (!AuthState.IsClinicAdmin(ClinicContext.SelectedApplicationId))
        {
            Navigation.NavigateTo("/dashboard", replace: true);
            return;
        }

        ResolveApplicationId();

        _loading = false;

        if (_applicationId != Guid.Empty)
        {
            await Task.WhenAll(LoadUsersAsync(), LoadDeactivatedUsersAsync(), LoadRolesAsync(), LoadInvitationsAsync());
        }
    }

    private void ResolveApplicationId()
    {
        if (ClinicContext.SelectedApplicationId != Guid.Empty)
        {
            _applicationId   = ClinicContext.SelectedApplicationId;
            _applicationName = ClinicContext.SelectedApplicationName;
            return;
        }

        var app = AuthState.CurrentUser?.UserApplications.FirstOrDefault(a => a.IsActive);
        if (app != null)
        {
            _applicationId   = app.ApplicationId;
            _applicationName = app.ApplicationName;
            return;
        }

        var role = AuthState.CurrentUser?.UserRoles.FirstOrDefault(r => r.IsActive && r.ApplicationId != Guid.Empty);
        if (role != null)
        {
            _applicationId   = role.ApplicationId;
            _applicationName = AuthState.CurrentUser?.UserApplications
                .FirstOrDefault(a => a.ApplicationId == role.ApplicationId)?.ApplicationName
                ?? "My Clinic";
        }
    }

    private async Task LoadUsersAsync()
    {
        _usersLoading = true;
        try
        {
            var result = await AppClient.GetApplicationUsersAsync(_applicationId);
            _users = result.Success ? result.Data ?? [] : [];
        }
        catch { _users = []; }
        finally { _usersLoading = false; }
    }

    private async Task LoadDeactivatedUsersAsync()
    {
        _deactivatedLoading = true;
        try
        {
            var result = await AppClient.GetDeactivatedApplicationUsersAsync(_applicationId);
            _deactivatedUsers = result.Success ? result.Data ?? [] : [];
        }
        catch { _deactivatedUsers = []; }
        finally { _deactivatedLoading = false; }
    }

    private async Task LoadRolesAsync()
    {
        _rolesLoading = true;
        try
        {
            var result = await AppClient.GetRolesByApplicationAsync(_applicationId);
            _roles = result.Success && result.Data != null ? result.Data.Roles : [];
            if (_roles.Count > 0) _selectedRoleId = _roles[0].RoleId;
        }
        catch { _roles = []; }
        finally { _rolesLoading = false; }
    }

    private async Task LoadInvitationsAsync()
    {
        _invitationsLoading = true;
        try
        {
            var result = await AppClient.GetApplicationInvitationsAsync(_applicationId);
            if (result.Success)
                _invitations = result.Data ?? [];
            else
            {
                _invitations = [];
                Toast.ShowError($"Invitations: {result.Message}");
            }
        }
        catch (Exception ex)
        {
            _invitations = [];
            Toast.ShowError($"Failed to load invitations: {ex.Message}");
        }
        finally { _invitationsLoading = false; }
    }

    // ── Invite dialog ─────────────────────────────────────────────────────────
    private void OpenInviteDialog()
    {
        _inviteMode = 0;
        ResetInviteForm();
        _inviteDialogVisible = true;
    }

    private void CloseInviteDialog()
    {
        _inviteDialogVisible = false;
        ResetInviteForm();
    }

    private void ResetInviteForm()
    {
        _searchEmail          = null;
        _searchResults        = null;
        _selectedExistingUser = null;
        _inviteModel          = new();
        _selectedRoleId       = _roles.Count > 0 ? _roles[0].RoleId : Guid.Empty;
        _searchDebounce?.Cancel();
    }

    private void OnSelectedRoleChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
            _selectedRoleId = id;
    }

    private void OnNewRoleChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
            _newRoleId = id;
    }

    private async Task OnSearchEmailInput(ChangeEventArgs e)
    {
        _searchEmail          = e.Value?.ToString();
        _selectedExistingUser = null;

        if (string.IsNullOrWhiteSpace(_searchEmail) || _searchEmail.Length < 3)
        {
            _searchResults = null;
            return;
        }

        _searchDebounce?.Cancel();
        _searchDebounce = new CancellationTokenSource();
        var token = _searchDebounce.Token;
        try
        {
            await Task.Delay(350, token);
            await OnSearchEmailChanged(_searchEmail);
        }
        catch (OperationCanceledException) { }
    }

    private async Task OnSearchEmailChanged(string value)
    {
        _searching = true;
        StateHasChanged();
        try
        {
            var result = await AuthClient.SearchUsersByEmailAsync(value);
            _searchResults = result.Success ? result.Data ?? [] : [];
        }
        catch { _searchResults = []; }
        finally { _searching = false; StateHasChanged(); }
    }

    private void SelectExistingUser(UserSearchResultDto user)
    {
        _selectedExistingUser = user;
        _searchResults        = null;
        _selectedRoleId       = _roles.Count > 0 ? _roles[0].RoleId : Guid.Empty;
        StateHasChanged();
    }

    private void ClearSelectedUser()
    {
        _selectedExistingUser = null;
        _searchEmail          = null;
        _searchResults        = null;
    }

    private async Task AddExistingUserAsync()
    {
        if (_selectedExistingUser is null || AuthState.CurrentUser is null || _selectedRoleId == Guid.Empty) return;
        _saving = true;
        try
        {
            var req = new InviteExistingUserRequestDto
            {
                UserId        = _selectedExistingUser.UserId,
                ApplicationId = _applicationId,
                RoleId        = _selectedRoleId
            };
            var result = await AppClient.InviteExistingUserAsync(AuthState.CurrentUser.UserId, req);
            if (result.Success)
            {
                Toast.ShowSuccess(result.Message ?? $"{_selectedExistingUser.FullName} added to the clinic.");
                CloseInviteDialog();
                await Task.WhenAll(LoadUsersAsync(), LoadDeactivatedUsersAsync(), LoadInvitationsAsync());
            }
            else
            {
                Toast.ShowError(result.Message ?? "Failed to add user.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Error: {ex.Message}"); }
        finally { _saving = false; }
    }

    private async Task InviteNewUserAsync()
    {
        if (string.IsNullOrWhiteSpace(_inviteModel.FirstName) ||
            string.IsNullOrWhiteSpace(_inviteModel.LastName) ||
            string.IsNullOrWhiteSpace(_inviteModel.EmailId))
        {
            Toast.ShowWarning("Please fill in all required fields.");
            return;
        }
        if (_selectedRoleId == Guid.Empty) { Toast.ShowWarning("Please select a role."); return; }
        if (AuthState.CurrentUser is null) return;

        _inviteModel.ApplicationId = _applicationId;
        _inviteModel.RoleId        = _selectedRoleId;
        _saving = true;
        try
        {
            var result = await AppClient.InviteUserAsync(AuthState.CurrentUser.UserId, _inviteModel);
            if (result.Success)
            {
                Toast.ShowSuccess($"Invitation sent to {_inviteModel.EmailId}.");
                CloseInviteDialog();
                await Task.WhenAll(LoadUsersAsync(), LoadInvitationsAsync());
            }
            else
            {
                Toast.ShowError(result.Message ?? "Failed to send invitation.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Error: {ex.Message}"); }
        finally { _saving = false; }
    }

