            var newStatus = !_userToToggle.IsActive;
            var result = await AppClient.ToggleUserApplicationMappingAsync(
                _applicationId, _userToToggle.UserId,
                AuthState.CurrentUser.UserId,
                new ToggleStatusRequestDto { IsActive = newStatus });

            if (result.Success)
