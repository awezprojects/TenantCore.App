                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label">Last Name *</label>
                            <input class="form-input" type="text" @bind="_inviteModel.LastName" disabled="@_saving" />
                        </div>
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Email Address *</label>
                        <input class="form-input" type="email" @bind="_inviteModel.EmailId" disabled="@_saving" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Mobile Number</label>
                        <input class="form-input" type="tel" placeholder="Optional" @bind="_inviteModel.MobileNo" disabled="@_saving" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Assign Role *</label>
                        <select class="form-input" style="margin-bottom:0;"
                                disabled="@(_rolesLoading || _roles.Count == 0 || _saving)"
                                @onchange="OnSelectedRoleChanged">
                            @if (_rolesLoading)
                            {
                                <option value="">Loading roles…</option>
                            }
                            else
                            {
                                <option value="">Select role...</option>
                                @foreach (var r in _roles)
                                {
                                    <option value="@r.RoleId" selected="@(_selectedRoleId == r.RoleId)">@r.RoleName</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div style="padding:12px;background:#EFF6FF;border-radius:10px;
                            font-size:12px;color:#1565C0;display:flex;align-items:flex-start;gap:8px;">
                    <span>ℹ</span>
                    <span>An invitation email will be sent. The user will have 7 days to accept it and set their password.</span>
                </div>
            }
        </div>
        <div style="padding:14px 24px;border-top:1px solid #E2E8F0;display:flex;justify-content:flex-end;gap:10px;flex-shrink:0;">
            <button style="@BtnGhost" @onclick="CloseInviteDialog" disabled="@_saving">Cancel</button>
            @if (_inviteMode == 0 && _selectedExistingUser != null)
            {
                <button style="@(_saving || _selectedRoleId == Guid.Empty ? BtnPrimaryDisabled : BtnPrimary)"
                        @onclick="AddExistingUserAsync"
                        disabled="@(_saving || _selectedRoleId == Guid.Empty)">
                    @(_saving ? "Adding…" : "Add Member")
                </button>
            }
            else if (_inviteMode == 1)
            {
                <button style="@(_saving ? BtnPrimaryDisabled : BtnPrimary)"
                        @onclick="InviteNewUserAsync"
                        disabled="@_saving">
                    @(_saving ? "Sending…" : "Send Invitation")
                </button>
            }
        </div>
    </div>
}

