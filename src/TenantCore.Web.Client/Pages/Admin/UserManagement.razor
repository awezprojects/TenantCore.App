    // ── Invitation status helper ───────────────────────────────────────────────
    private static (string text, string fg, string bg) GetInvitationStatus(InvitationResponseDto inv)
    {
        if (inv.IsAccepted)  return ("Accepted",  "#16A34A", "#DCFCE7");
        if (inv.IsExpired)   return ("Expired",   "#EF4444", "#FEE2E2");
        return                      ("Pending",   "#D97706", "#FEF3C7");
    }
