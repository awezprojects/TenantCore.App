@page "/auth/accept-existing-invitation"
@layout AuthInvitationLayout
@inject IAuthApiClient AuthClient

<PageTitle>Accept Invitation - TenantCore</PageTitle>

<div style="max-width:480px;width:100%;background:#fff;border-radius:14px;padding:40px 32px;
            box-shadow:0 4px 24px rgba(0,0,0,0.12);text-align:center;">

    @if (_processing)
    {
        <div style="display:flex;justify-content:center;margin-bottom:24px;">
            <div class="auth-spinner" style="width:48px;height:48px;border-width:4px;"></div>
        </div>
        <h2 style="font-size:20px;font-weight:700;color:#111827;margin:0 0 8px;">Accepting Invitation...</h2>
        <p style="color:#6B7280;font-size:14px;">Please wait while we process your invitation.</p>
    }
    else if (_accepted)
    {
        <div style="margin-bottom:20px;"><span style="font-size:72px;">✅</span></div>
        <h2 style="font-size:20px;font-weight:700;color:#22C55E;margin:0 0 8px;">Invitation Accepted!</h2>
        <p style="color:#6B7280;font-size:14px;margin-bottom:24px;">
            @(_successMessage ?? "You have been added to the application. You can now access it from your dashboard.")
        </p>
        <a href="/select-clinic" class="auth-btn-primary"
           style="display:flex;align-items:center;justify-content:center;text-decoration:none;">
            Go to My Clinics
        </a>
    }
    else if (_error)
    {
        <div style="margin-bottom:20px;"><span style="font-size:72px;">❌</span></div>
        <h2 style="font-size:20px;font-weight:700;color:#111827;margin:0 0 12px;">Invitation Failed</h2>
        <div class="auth-error" style="text-align:left;margin-bottom:20px;">@_errorMessage</div>
        <a href="/select-clinic" class="auth-btn-primary"
           style="display:flex;align-items:center;justify-content:center;text-decoration:none;">
            Go to My Clinics
        </a>
    }
    else
    {
        <div style="margin-bottom:20px;"><span style="font-size:72px;">🔗</span></div>
        <h2 style="font-size:20px;font-weight:700;color:#111827;margin:0 0 8px;">Invalid Invitation</h2>
        <p style="color:#6B7280;font-size:14px;margin-bottom:24px;">
            The invitation link is invalid or missing the required token.
        </p>
        <a href="/select-clinic" class="auth-btn-primary"
           style="display:flex;align-items:center;justify-content:center;text-decoration:none;">
            Go to My Clinics
        </a>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private bool _processing;
    private bool _accepted;
    private bool _error;
    private string? _successMessage;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Token))
        {
            await AcceptInvitationAsync();
        }
    }

    private async Task AcceptInvitationAsync()
    {
        _processing = true;
        StateHasChanged();

        try
        {
            var response = await AuthClient.AcceptExistingInvitationAsync(Token!);

            if (response.Success)
            {
                _accepted = true;
                _successMessage = response.Message;
            }
            else
            {
                _error = true;
                _errorMessage = response.Message ?? "Failed to accept invitation. The link may have expired or already been used.";
            }
        }
        catch (Exception ex)
        {
            _error = true;
            _errorMessage = "An unexpected error occurred while accepting the invitation. Please try again.";
            Console.WriteLine($"Accept existing invitation error: {ex.Message}");
        }
        finally
        {
            _processing = false;
        }
    }
}
