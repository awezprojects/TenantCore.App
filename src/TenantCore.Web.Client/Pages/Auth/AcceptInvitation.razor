@page "/auth/accept-invitation/{Token}"
@layout AuthInvitationLayout
@inject IAuthApiClient AuthApi
@inject NavigationManager Navigation
@using TenantCore.Shared.Dtos.Auth

<PageTitle>Accept Invitation</PageTitle>

<div style="max-width:440px;width:100%;background:#fff;border-radius:14px;padding:32px;
            box-shadow:0 4px 24px rgba(0,0,0,0.12);">

    <div class="auth-brand" style="margin-bottom:20px;">
        <span style="font-size:22px;">🏥</span>
        <span style="font-weight:700;color:#1a56db;font-size:15px;">ClinicCore</span>
    </div>

    <h2 style="font-size:20px;font-weight:700;color:#111827;margin:0 0 8px;">Accept Invitation</h2>
    <div class="auth-info" style="margin-bottom:20px;">
        Please set your password to activate your account.
    </div>

    <EditForm Model="_model" OnValidSubmit="AcceptInvitationAsync">
        <DataAnnotationsValidator />

        <div class="auth-input-wrap">
            <label class="auth-label">Password</label>
            <div class="auth-input-with-toggle">
                <input class="auth-input" type="@(_showPassword ? "text" : "password")"
                       @bind="_model.Password" disabled="@(_loading || _success)" />
                <button type="button" class="auth-input-toggle" @onclick="@(() => _showPassword = !_showPassword)">
                    @(_showPassword ? "Hide" : "Show")
                </button>
            </div>
        </div>

        <div class="auth-input-wrap">
            <label class="auth-label">Confirm Password</label>
            <input class="auth-input" type="@(_showPassword ? "text" : "password")"
                   @bind="_model.ConfirmPassword" disabled="@(_loading || _success)" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="auth-error">@_error</div>
        }

        @if (_success)
        {
            <div class="auth-success-msg" style="margin-bottom:16px;">
                Invitation accepted! You can now <a href="/auth/login" class="auth-link">sign in</a>.
            </div>
        }

        <button type="submit" class="auth-btn-primary" disabled="@(_loading || _success)"
                style="display:flex;align-items:center;justify-content:center;gap:8px;">
            @if (_loading)
            {
                <span class="auth-spinner"></span>
                <span>Submitting...</span>
            }
            else
            {
                <span>Accept Invitation</span>
            }
        </button>
    </EditForm>
</div>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private AcceptInvitationRequestDto _model = new();
    private bool _loading;
    private bool _success;
    private bool _showPassword;
    private string _error = string.Empty;

    protected override void OnInitialized()
    {
        _model.Token = Token;
    }

    private async Task AcceptInvitationAsync()
    {
        _error = string.Empty;

        if (_model.Password != _model.ConfirmPassword)
        {
            _error = "Passwords do not match.";
            return;
        }

        _loading = true;
        try
        {
            var result = await AuthApi.AcceptInvitationAsync(_model);
            if (result.Success)
            {
                _success = true;
            }
            else
            {
                _error = result.Message ?? "Failed to accept invitation.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
