@page "/auth/forgot-password"
@layout AuthLayout
@inject IAuthApiClient AuthClient
@inject NavigationManager NavigationManager

<PageTitle>Reset Password — ClinicCore</PageTitle>

<div class="auth-brand">
    <span style="font-size:22px;">🏥</span>
    <span style="font-weight:700;color:#1a56db;font-size:15px;">ClinicCore</span>
</div>

@if (_submitted)
{
    <div style="text-align:center;margin-bottom:20px;">
        <span style="font-size:80px;">📧</span>
    </div>

    <h2 style="font-size:22px;font-weight:700;color:#111827;margin:0 0 4px;">Check Your Email</h2>
    <p style="color:#6B7280;margin:0 0 1.5rem;font-size:14px;">
        If this email is registered, a reset link has been sent. Check your inbox and spam folder.
    </p>

    <a href="/auth/login" class="auth-btn-primary" style="display:flex;align-items:center;justify-content:center;text-decoration:none;">
        ← Back to Login
    </a>
}
else
{
    <h2 style="font-size:22px;font-weight:700;color:#111827;margin:0 0 4px;">Reset Password</h2>
    <p style="color:#6B7280;margin:0 0 1.5rem;font-size:14px;">
        Enter your email and we'll send you a link to reset your password.
    </p>

    <EditForm Model="_model" OnValidSubmit="HandleForgotPassword">
        <DataAnnotationsValidator />

        <div class="auth-input-wrap">
            <label class="auth-label">Email Address</label>
            <input class="auth-input" type="email" @bind="_model.EmailId"
                   placeholder="you@example.com" disabled="@_loading" />
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="auth-error">@_errorMessage</div>
        }

        <button type="submit" class="auth-btn-primary" disabled="@_loading"
                style="display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:16px;">
            @if (_loading)
            {
                <span class="auth-spinner"></span>
                <span>Sending...</span>
            }
            else
            {
                <span>Send Reset Link</span>
            }
        </button>
    </EditForm>

    <div style="text-align:center;">
        <a href="/auth/login" class="auth-link" style="font-size:13px;">← Back to Login</a>
    </div>
}

@code {
    private ForgotPasswordRequestDto _model = new();
    private bool _loading;
    private bool _submitted;
    private string? _errorMessage;

    private async Task HandleForgotPassword()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            var response = await AuthClient.ForgotPasswordAsync(_model);
            // Always show success to prevent email enumeration
            _submitted = true;
        }
        catch (Exception)
        {
            _errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }
}
