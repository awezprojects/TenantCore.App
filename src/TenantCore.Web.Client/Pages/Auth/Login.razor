@page "/"
@page "/auth/login"
@layout AuthLayout
@inject IAuthApiClient AuthClient
@inject AuthStateService AuthState
@inject NavigationManager NavigationManager
@inject IToastService Toast

<PageTitle>Sign In — ClinicCore</PageTitle>

<div class="auth-brand">
    <span style="font-size:22px;">🏥</span>
    <span style="font-weight:700;color:#1a56db;font-size:15px;">ClinicCore</span>
</div>

<h2 style="font-size:22px;font-weight:700;color:#111827;margin:0 0 4px;">Log in to your Account</h2>
<p style="color:#6B7280;margin:0 0 1.5rem;font-size:14px;">Welcome back! Enter your credentials to continue.</p>

<EditForm Model="_loginModel" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator />

    <div class="auth-input-wrap">
        <label class="auth-label">Email Address</label>
        <input class="auth-input" type="email" @bind="_loginModel.EmailId"
               placeholder="you@example.com" disabled="@_loading" />
    </div>

    <div class="auth-input-wrap">
        <label class="auth-label">Password</label>
        <div class="auth-input-with-toggle">
            <input class="auth-input" type="@(_showPassword ? "text" : "password")"
                   @bind="_loginModel.Password" placeholder="Enter your password" disabled="@_loading" />
            <button type="button" class="auth-input-toggle" @onclick="@(() => _showPassword = !_showPassword)">
                @(_showPassword ? "Hide" : "Show")
            </button>
        </div>
    </div>

    <div style="text-align:right;margin-bottom:16px;">
        <a href="/auth/forgot-password" class="auth-link" style="font-size:13px;">Forgot Password?</a>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="auth-error">@_errorMessage</div>
    }

    <button type="submit" class="auth-btn-primary" disabled="@_loading" style="display:flex;align-items:center;justify-content:center;gap:8px;">
        @if (_loading)
        {
            <span class="auth-spinner"></span>
            <span>Signing In...</span>
        }
        else
        {
            <span>Sign In</span>
        }
    </button>
</EditForm>

<hr class="auth-divider" />

<div style="text-align:center;font-size:14px;color:#374151;">
    Don't have an account?
    <a href="/auth/register" class="auth-link">Create one</a>
</div>
<div style="text-align:center;font-size:14px;color:#374151;margin-top:8px;">
    Need to verify your email?
    <a href="/auth/resend-verification" class="auth-link">Resend verification</a>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private LoginRequestDto _loginModel = new();
    private bool _loading;
    private bool _showPassword;
    private string? _errorMessage;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await AuthState.InitializeAsync();

            if (AuthState.IsAuthenticated)
            {
                NavigateToReturn();
            }

            StateHasChanged();
        }
    }

    private async Task HandleLogin()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            var response = await AuthClient.LoginAsync(_loginModel);

            if (response.Success && response.Data != null)
            {
                var data = response.Data;

                if (data.RequiresPasswordReset)
                {
                    AuthState.SetTempLoginState(data);
                    Toast.ShowWarning("Please reset your password to continue.");
                    NavigationManager.NavigateTo($"/auth/reset-password?userId={data.User?.UserId}");
                }
                else if (data.RequiresTwoFactor)
                {
                    AuthState.SetTempLoginState(data);
                    var returnParam = !string.IsNullOrEmpty(ReturnUrl) ? $"?returnUrl={ReturnUrl}" : "";
                    NavigationManager.NavigateTo($"/auth/two-factor{returnParam}");
                }
                else
                {
                    await AuthState.SetAuthenticatedStateAsync(data);
                    Toast.ShowSuccess("Login successful!");
                    NavigateToReturn();
                }
            }
            else
            {
                _errorMessage = response.Message ?? "Invalid email or password. Please try again.";
            }
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Unable to connect to the authentication server. Please try again later.";
        }
        catch (Exception)
        {
            _errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void NavigateToReturn()
    {
        if (!string.IsNullOrEmpty(ReturnUrl))
        {
            try
            {
                var decodedUrl = Uri.UnescapeDataString(ReturnUrl);
                if (decodedUrl.StartsWith("/") && !decodedUrl.StartsWith("//")
                    && !decodedUrl.StartsWith("/auth/login", StringComparison.OrdinalIgnoreCase))
                {
                    NavigationManager.NavigateTo(decodedUrl);
                    return;
                }
            }
            catch { }
        }

        NavigationManager.NavigateTo("/select-clinic");
    }
}
