@page "/auth/profile"
@layout AuthorizedLayout
@inject AuthStateService AuthState
@inject IAuthApiClient AuthClient
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>My Profile - CloudClinic</PageTitle>

@if (_loading)
{
    <div style="display:flex;justify-content:center;padding:60px 0;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (AuthState.CurrentUser != null)
{
    <div class="cc-fade-in" style="max-width:780px;display:flex;flex-direction:column;gap:20px;">

        <!-- Header card with avatar -->
        <div style="background:#fff;border-radius:16px;border:1px solid #E2E8F0;overflow:hidden;">
            <div style="padding:24px;display:flex;align-items:center;gap:20px;">
                <div style="width:64px;height:64px;border-radius:18px;
                            background:linear-gradient(135deg,#1565C0,#42A5F5);
                            display:flex;align-items:center;justify-content:center;
                            color:#fff;font-weight:800;font-size:22px;flex-shrink:0;">
                    @_initials
                </div>
                <div style="flex:1;">
                    <div style="font-size:18px;font-weight:800;color:#1E293B;">@AuthState.CurrentUser.FullName</div>
                    <div style="font-size:13px;color:#64748B;margin-top:2px;">@AuthState.CurrentUser.EmailId</div>
                    <div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap;">
                        @foreach (var role in AuthState.CurrentUser.UserRoles.Where(r => r.IsActive))
                        {
                            <span style="padding:3px 10px;background:#EFF6FF;color:#1565C0;
                                         border-radius:20px;font-size:11px;font-weight:700;">@role.RoleName</span>
                        }
                        <span style="padding:3px 10px;font-size:11px;font-weight:700;border-radius:20px;
                                     background:@(AuthState.CurrentUser.IsActive ? "#ECFDF5" : "#FEF2F2");
                                     color:@(AuthState.CurrentUser.IsActive ? "#16A34A" : "#EF4444");">
                            @(AuthState.CurrentUser.IsActive ? "Active" : "Inactive")
                        </span>
                        @if (AuthState.CurrentUser.IsEmailVerified)
                        {
                            <span style="padding:3px 10px;background:#ECFDF5;color:#16A34A;
                                         border-radius:20px;font-size:11px;font-weight:700;">✓ Verified</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Personal Information -->
        <div style="background:#fff;border-radius:16px;border:1px solid #E2E8F0;overflow:hidden;">
            <div style="padding:18px 24px;border-bottom:1px solid #E2E8F0;
                        display:flex;justify-content:space-between;align-items:center;">
                <div>
                    <div style="font-size:15px;font-weight:800;color:#1E293B;">Personal Information</div>
                    <div style="font-size:12px;color:#94A3B8;margin-top:2px;">Name and contact details</div>
                </div>
                @if (!_editingProfile)
                {
                    <button @onclick="StartEditProfile"
                            style="padding:8px 16px;background:#EFF6FF;color:#1565C0;border:1px solid #BFDBFE;
                                   border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;">
                        Edit Profile
                    </button>
                }
            </div>
            <div style="padding:22px 24px;">
                @if (_editingProfile)
                {
                    <EditForm Model="_profileModel" OnValidSubmit="SaveProfile">
                        <DataAnnotationsValidator />
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                            <MudTextField @bind-Value="_profileModel.FirstName" Label="First Name" Variant="Variant.Outlined"
                                          For="@(() => _profileModel.FirstName)" Disabled="_savingProfile" />
                            <MudTextField @bind-Value="_profileModel.LastName" Label="Last Name" Variant="Variant.Outlined"
                                          For="@(() => _profileModel.LastName)" Disabled="_savingProfile" />
                            <MudTextField @bind-Value="_profileModel.MiddleName" Label="Middle Name (optional)" Variant="Variant.Outlined"
                                          Disabled="_savingProfile" />
                            <MudTextField @bind-Value="_profileModel.MobileNo" Label="Mobile Number" Variant="Variant.Outlined"
                                          Disabled="_savingProfile" />
                        </div>
                        <div style="display:flex;align-items:center;gap:10px;padding:11px 14px;
                                    background:#F8FAFC;border-radius:10px;margin-bottom:14px;">
                            <span>📧</span>
                            <div style="flex:1;">
                                <div style="font-size:11px;color:#94A3B8;font-weight:600;">Email Address (cannot be changed)</div>
                                <div style="font-size:13px;font-weight:700;color:#1E293B;">@AuthState.CurrentUser.EmailId</div>
                            </div>
                        </div>
                        <div style="display:flex;gap:10px;">
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                                       Disabled="_savingProfile" Style="min-width:130px;">
                                @if (_savingProfile)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Surface" Class="mr-2" />
                                    <span>Saving…</span>
                                }
                                else { <span>Save Changes</span> }
                            </MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CancelEditProfile"
                                       Disabled="_savingProfile">Cancel</MudButton>
                        </div>
                    </EditForm>
                }
                else
                {
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                        <div>
                            <div style="font-size:11px;color:#94A3B8;font-weight:600;margin-bottom:4px;">FIRST NAME</div>
                            <div style="font-size:14px;font-weight:600;color:#1E293B;">@AuthState.CurrentUser.FirstName</div>
                        </div>
                        <div>
                            <div style="font-size:11px;color:#94A3B8;font-weight:600;margin-bottom:4px;">LAST NAME</div>
                            <div style="font-size:14px;font-weight:600;color:#1E293B;">@AuthState.CurrentUser.LastName</div>
                        </div>
                        @if (!string.IsNullOrEmpty(AuthState.CurrentUser.MiddleName))
                        {
                            <div>
                                <div style="font-size:11px;color:#94A3B8;font-weight:600;margin-bottom:4px;">MIDDLE NAME</div>
                                <div style="font-size:14px;font-weight:600;color:#1E293B;">@AuthState.CurrentUser.MiddleName</div>
                            </div>
                        }
                        <div>
                            <div style="font-size:11px;color:#94A3B8;font-weight:600;margin-bottom:4px;">MOBILE</div>
                            <div style="font-size:14px;font-weight:600;color:#1E293B;">
                                @(string.IsNullOrEmpty(AuthState.CurrentUser.MobileNo) ? "—" : AuthState.CurrentUser.MobileNo)
                            </div>
                        </div>
                        <div style="grid-column:1/-1;">
                            <div style="font-size:11px;color:#94A3B8;font-weight:600;margin-bottom:4px;">EMAIL</div>
                            <div style="font-size:14px;font-weight:600;color:#1E293B;">@AuthState.CurrentUser.EmailId</div>
                        </div>
                        <div>
                            <div style="font-size:11px;color:#94A3B8;font-weight:600;margin-bottom:4px;">MEMBER SINCE</div>
                            <div style="font-size:14px;font-weight:600;color:#1E293B;">@AuthState.CurrentUser.CreatedDate.ToString("dd MMM yyyy")</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Security -->
        <div style="background:#fff;border-radius:16px;border:1px solid #E2E8F0;overflow:hidden;">
            <div style="padding:18px 24px;border-bottom:1px solid #E2E8F0;">
                <div style="font-size:15px;font-weight:800;color:#1E293B;">Security</div>
                <div style="font-size:12px;color:#94A3B8;margin-top:2px;">Manage password, 2FA, and active sessions</div>
            </div>

            <!-- Two-Factor Authentication -->
            <div style="padding:20px 24px;border-bottom:1px solid #F1F5F9;">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:20px;">
                    <div style="display:flex;align-items:flex-start;gap:14px;">
                        <div style="width:42px;height:42px;border-radius:12px;
                                    background:@(_isTwoFactorEnabled ? "#ECFDF5" : "#F8FAFC");
                                    display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">🔐</div>
                        <div>
                            <div style="font-size:14px;font-weight:700;color:#1E293B;">Two-Factor Authentication</div>
                            <div style="font-size:12px;color:#64748B;margin-top:2px;">
                                @if (_isTwoFactorEnabled)
                                {
                                    <span style="color:#16A34A;font-weight:600;">● Enabled</span>
                                    <span style="margin-left:6px;">— Your account is protected with TOTP.</span>
                                }
                                else
                                {
                                    <span style="color:#D97706;font-weight:600;">● Disabled</span>
                                    <span style="margin-left:6px;">— Add an extra layer of security.</span>
                                }
                            </div>
                        </div>
                    </div>
                    @if (_isTwoFactorEnabled)
                    {
                        <button @onclick="@(() => _disable2faDialogVisible = true)"
                                style="padding:8px 18px;background:#FEF2F2;color:#DC2626;border:1px solid #FECACA;
                                       border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap;flex-shrink:0;">
                            Disable 2FA
                        </button>
                    }
                    else
                    {
                        <button @onclick="InitiateEnable2faAsync" disabled="@_processing2fa"
                                style="padding:8px 18px;background:#EFF6FF;color:#1565C0;border:1px solid #BFDBFE;
                                       border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap;flex-shrink:0;">
                            Enable 2FA
                        </button>
                    }
                </div>
            </div>

            <!-- Change Password -->
            <div style="padding:20px 24px;border-bottom:1px solid #F1F5F9;">
                <div style="display:flex;justify-content:space-between;align-items:center;cursor:pointer;" @onclick="TogglePasswordForm">
                    <div style="display:flex;align-items:center;gap:14px;">
                        <div style="width:42px;height:42px;border-radius:12px;background:#F8FAFC;
                                    display:flex;align-items:center;justify-content:center;font-size:20px;">🔑</div>
                        <div>
                            <div style="font-size:14px;font-weight:700;color:#1E293B;">Change Password</div>
                            <div style="font-size:12px;color:#64748B;margin-top:2px;">Update your account password</div>
                        </div>
                    </div>
                    <span style="font-size:18px;color:#94A3B8;transition:transform 0.2s;
                                 transform:rotate(@(_showPasswordForm ? "90deg" : "0deg"));">›</span>
                </div>
                @if (_showPasswordForm)
                {
                    <div style="margin-top:16px;padding-top:16px;border-top:1px solid #F1F5F9;">
                        <EditForm Model="_pwModel" OnValidSubmit="SavePassword">
                            <DataAnnotationsValidator />
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                                <div style="grid-column:1/-1;">
                                    <MudTextField @bind-Value="_pwModel.CurrentPassword" Label="Current Password"
                                                  Variant="Variant.Outlined"
                                                  InputType="@(_showCurr ? InputType.Text : InputType.Password)"
                                                  Adornment="Adornment.End"
                                                  AdornmentIcon="@(_showCurr ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                                  OnAdornmentClick="@(() => _showCurr = !_showCurr)"
                                                  For="@(() => _pwModel.CurrentPassword)" Disabled="_savingPw" />
                                </div>
                                <MudTextField @bind-Value="_pwModel.NewPassword" Label="New Password"
                                              Variant="Variant.Outlined"
                                              InputType="@(_showNew ? InputType.Text : InputType.Password)"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@(_showNew ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                              OnAdornmentClick="@(() => _showNew = !_showNew)"
                                              For="@(() => _pwModel.NewPassword)" Disabled="_savingPw" />
                                <MudTextField @bind-Value="_pwModel.ConfirmPassword" Label="Confirm New Password"
                                              Variant="Variant.Outlined"
                                              InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@(_showConfirm ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                              OnAdornmentClick="@(() => _showConfirm = !_showConfirm)"
                                              For="@(() => _pwModel.ConfirmPassword)" Disabled="_savingPw" />
                            </div>
                            @if (!string.IsNullOrEmpty(_pwError))
                            {
                                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_pwError</MudAlert>
                            }
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                                       Disabled="_savingPw" Style="min-width:150px;">
                                @if (_savingPw) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Surface" Class="mr-2" /><span>Updating…</span> }
                                else { <span>Update Password</span> }
                            </MudButton>
                        </EditForm>
                    </div>
                }
            </div>

            <!-- Sign Out All -->
            <div style="padding:20px 24px;">
                <div style="display:flex;justify-content:space-between;align-items:center;gap:20px;">
                    <div style="display:flex;align-items:flex-start;gap:14px;">
                        <div style="width:42px;height:42px;border-radius:12px;background:#FFF5F5;
                                    display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;">🚪</div>
                        <div>
                            <div style="font-size:14px;font-weight:700;color:#1E293B;">Sign Out All Devices</div>
                            <div style="font-size:12px;color:#64748B;margin-top:2px;">End all active sessions across every device.</div>
                        </div>
                    </div>
                    <button @onclick="@(() => _signOutAllDialogVisible = true)"
                            style="padding:8px 18px;background:#FEF2F2;color:#DC2626;border:1px solid #FECACA;
                                   border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap;flex-shrink:0;">
                        Sign Out All
                    </button>
                </div>
            </div>
        </div>

    </div>
}

<!-- Sign Out All Confirmation -->
<MudDialog @bind-Visible="_signOutAllDialogVisible">
    <TitleContent><MudText Typo="Typo.h6">Sign Out All Devices</MudText></TitleContent>
    <DialogContent>
        <MudText>Are you sure you want to sign out from <b>all devices</b>? You'll need to log in again everywhere.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _signOutAllDialogVisible = false)">Cancel</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="SignOutAllDevices">Sign Out All</MudButton>
    </DialogActions>
</MudDialog>

<!-- Enable 2FA Dialog -->
<MudDialog @bind-Visible="_enable2faDialogVisible"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = false })">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Enable Two-Factor Authentication</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_enable2faStep == 1 && !string.IsNullOrEmpty(_enable2faQrCode))
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                    Scan this QR code with your authenticator app, then enter the 6-digit code below.
                </MudText>
                <MudPaper Elevation="2" Class="pa-3">
                    <img src="@($"data:image/png;base64,{_enable2faQrCode}")" alt="2FA QR Code" style="width:200px;height:200px;" />
                </MudPaper>
                <MudTextField @bind-Value="_enable2faOtp" Label="6-Digit Code" Variant="Variant.Outlined"
                              InputType="InputType.Number" MaxLength="6" Placeholder="000000" FullWidth="true"
                              Disabled="_processing2fa" />
                @if (!string.IsNullOrEmpty(_twoFaError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_twoFaError</MudAlert>
                }
            </MudStack>
        }
        else if (string.IsNullOrEmpty(_enable2faQrCode))
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelEnable2fa" Disabled="_processing2fa">Cancel</MudButton>
        @if (_enable2faStep == 1)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmEnable2faAsync"
                       Disabled="_processing2fa || _enable2faOtp.Length != 6">
                @if (_processing2fa) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                Verify &amp; Enable
            </MudButton>
        }
    </DialogActions>
</MudDialog>

<!-- Disable 2FA Dialog -->
<MudDialog @bind-Visible="_disable2faDialogVisible"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true })">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.SecurityUpdateWarning" Color="Color.Warning" />
            <MudText Typo="Typo.h6">Disable Two-Factor Authentication</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Enter the current 6-digit code from your authenticator app to confirm.
        </MudText>
        <MudTextField @bind-Value="_disable2faOtp" Label="6-Digit Code" Variant="Variant.Outlined"
                      InputType="InputType.Number" MaxLength="6" Placeholder="000000" FullWidth="true"
                      Disabled="_processing2fa" />
        @if (!string.IsNullOrEmpty(_twoFaError))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_twoFaError</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => { _disable2faDialogVisible = false; _disable2faOtp = string.Empty; _twoFaError = null; })"
                   Disabled="_processing2fa">Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Disable2faAsync"
                   Disabled="_processing2fa || _disable2faOtp.Length != 6">
            @if (_processing2fa) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            Disable 2FA
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _loading = true;
    private string _initials = "U";
    private bool _editingProfile;
    private bool _savingProfile;
    private bool _isTwoFactorEnabled;
    private bool _signOutAllDialogVisible;
    private UpdateUserProfileRequestDto _profileModel = new();

    private bool _showPasswordForm;
    private ChangePasswordRequestDto _pwModel = new();
    private bool _savingPw;
    private string? _pwError;
    private bool _showCurr;
    private bool _showNew;
    private bool _showConfirm;

    private bool _enable2faDialogVisible;
    private bool _disable2faDialogVisible;
    private bool _processing2fa;
    private int _enable2faStep;
    private string _enable2faQrCode = string.Empty;
    private string _enable2faOtp = string.Empty;
    private string _disable2faOtp = string.Empty;
    private string? _twoFaError;

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        if (!AuthState.IsAuthenticated || AuthState.CurrentUser is null) return;

        var user = AuthState.CurrentUser;
        _initials = string.Join("", user.FullName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2).Select(p => p[0].ToString().ToUpper()));

        _profileModel = new UpdateUserProfileRequestDto
        {
            FirstName = user.FirstName,
            MiddleName = user.MiddleName,
            LastName = user.LastName,
            MobileNo = user.MobileNo,
        };

        var profileResult = await AuthClient.GetUserByIdAsync(user.UserId);
        if (profileResult.Success && profileResult.Data is not null)
        {
            AuthState.UpdateUserProfile(profileResult.Data);
            _isTwoFactorEnabled = profileResult.Data.IsTwoFactorEnabled;
        }
        else
        {
            _isTwoFactorEnabled = user.IsTwoFactorEnabled;
        }

        _loading = false;
    }

    private void StartEditProfile()
    {
        if (AuthState.CurrentUser is null) return;
        _profileModel = new UpdateUserProfileRequestDto
        {
            FirstName = AuthState.CurrentUser.FirstName,
            MiddleName = AuthState.CurrentUser.MiddleName,
            LastName = AuthState.CurrentUser.LastName,
            MobileNo = AuthState.CurrentUser.MobileNo,
        };
        _editingProfile = true;
    }

    private void CancelEditProfile() => _editingProfile = false;

    private async Task SaveProfile()
    {
        if (AuthState.CurrentUser is null) return;
        _savingProfile = true;
        try
        {
            var result = await AuthClient.UpdateUserProfileAsync(AuthState.CurrentUser.UserId, _profileModel);
            if (result.Success && result.Data is not null)
            {
                AuthState.UpdateUserProfile(result.Data);
                _initials = string.Join("", result.Data.FullName
                    .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                    .Take(2).Select(p => p[0].ToString().ToUpper()));
                Snackbar.Add("Profile updated successfully!", Severity.Success);
                _editingProfile = false;
            }
            else { Snackbar.Add(result.Message ?? "Failed to update profile.", Severity.Error); }
        }
        catch { Snackbar.Add("An error occurred. Please try again.", Severity.Error); }
        finally { _savingProfile = false; }
    }

    private void TogglePasswordForm()
    {
        _showPasswordForm = !_showPasswordForm;
        if (!_showPasswordForm) { _pwModel = new ChangePasswordRequestDto(); _pwError = null; }
    }

    private async Task SavePassword()
    {
        _savingPw = true; _pwError = null;
        try
        {
            var result = await AuthClient.ChangePasswordAsync(AuthState.CurrentUser!.UserId, _pwModel);
            if (result.Success)
            {
                Snackbar.Add("Password updated successfully.", Severity.Success);
                _pwModel = new ChangePasswordRequestDto();
                _showPasswordForm = false;
            }
            else { _pwError = result.Message ?? "Failed to update password."; }
        }
        catch { _pwError = "An error occurred. Please try again."; }
        finally { _savingPw = false; }
    }

    private async Task SignOutAllDevices()
    {
        var result = await AuthClient.LogoutAllSessionsAsync();
        if (result.Success)
        {
            await AuthState.ClearAuthStateAsync();
            NavigationManager.NavigateTo("/auth/login", forceLoad: true);
        }
        else { Snackbar.Add(result.Message ?? "Failed to sign out.", Severity.Error); }
    }

    private async Task InitiateEnable2faAsync()
    {
        if (AuthState.CurrentUser is null) return;
        _processing2fa = true; _twoFaError = null;
        _enable2faQrCode = string.Empty; _enable2faStep = 0; _enable2faOtp = string.Empty;
        _enable2faDialogVisible = true; StateHasChanged();
        try
        {
            var response = await AuthClient.EnableTwoFactorAsync(AuthState.CurrentUser.UserId);
            if (response.Success && response.Data?.QrCodeBase64 is not null)
            {
                _enable2faQrCode = response.Data.QrCodeBase64;
                _enable2faStep = 1;
            }
            else { _twoFaError = response.Message ?? "Failed to initiate 2FA setup."; }
        }
        catch { _twoFaError = "An error occurred."; }
        finally { _processing2fa = false; StateHasChanged(); }
    }

    private async Task ConfirmEnable2faAsync()
    {
        if (AuthState.CurrentUser is null) return;
        _processing2fa = true; _twoFaError = null; StateHasChanged();
        try
        {
            var response = await AuthClient.ConfirmEnableTwoFactorAsync(AuthState.CurrentUser.UserId,
                new ValidateTwoFactorRequestDto { OtpCode = _enable2faOtp });
            if (response.Success)
            {
                _enable2faDialogVisible = false; _enable2faOtp = string.Empty; _enable2faQrCode = string.Empty;
                _isTwoFactorEnabled = true;
                Snackbar.Add("Two-factor authentication enabled successfully.", Severity.Success);
            }
            else { _twoFaError = response.Message ?? "Invalid code. Please try again."; }
        }
        catch { _twoFaError = "An error occurred."; }
        finally { _processing2fa = false; StateHasChanged(); }
    }

    private void CancelEnable2fa()
    {
        _enable2faDialogVisible = false; _enable2faOtp = string.Empty;
        _enable2faQrCode = string.Empty; _enable2faStep = 0; _twoFaError = null;
    }

    private async Task Disable2faAsync()
    {
        if (AuthState.CurrentUser is null) return;
        _processing2fa = true; _twoFaError = null; StateHasChanged();
        try
        {
            var response = await AuthClient.DisableTwoFactorAsync(AuthState.CurrentUser.UserId,
                new DisableTwoFactorRequestDto { Code = _disable2faOtp });
            if (response.Success)
            {
                _disable2faDialogVisible = false; _disable2faOtp = string.Empty;
                _isTwoFactorEnabled = false;
                Snackbar.Add("Two-factor authentication disabled.", Severity.Success);
            }
            else { _twoFaError = response.Message ?? "Invalid code. Please try again."; }
        }
        catch { _twoFaError = "An error occurred."; }
        finally { _processing2fa = false; StateHasChanged(); }
    }
}
