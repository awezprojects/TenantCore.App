@page "/auth/register"
@layout AuthLayout
@inject IAuthApiClient AuthClient
@inject NavigationManager NavigationManager
@inject IToastService Toast

<PageTitle>Create Account — ClinicCore</PageTitle>

<div class="auth-brand">
    <span style="font-size:22px;">🏥</span>
    <span style="font-weight:700;color:#1a56db;font-size:15px;">ClinicCore</span>
</div>

<h2 style="font-size:22px;font-weight:700;color:#111827;margin:0 0 4px;">Create Your Account</h2>
<p style="color:#6B7280;margin:0 0 1.5rem;font-size:14px;">Start managing your clinic today.</p>

<EditForm Model="_model" OnValidSubmit="HandleRegister">
    <DataAnnotationsValidator />

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div class="auth-input-wrap" style="margin-bottom:0;">
            <label class="auth-label">First Name</label>
            <input class="auth-input" type="text" @bind="_model.FirstName" disabled="@_loading" />
        </div>
        <div class="auth-input-wrap" style="margin-bottom:0;">
            <label class="auth-label">Last Name</label>
            <input class="auth-input" type="text" @bind="_model.LastName" disabled="@_loading" />
        </div>
    </div>
    <div style="height:16px;"></div>

    <div class="auth-input-wrap">
        <label class="auth-label">Email Address</label>
        <input class="auth-input" type="email" @bind="_model.EmailId"
               placeholder="you@example.com" disabled="@_loading" />
    </div>

    <div class="auth-input-wrap">
        <label class="auth-label">Mobile Number (Optional)</label>
        <input class="auth-input" type="tel" @bind="_model.MobileNo"
               placeholder="+91 00000 00000" disabled="@_loading" />
    </div>

    <div class="auth-input-wrap">
        <label class="auth-label">Password</label>
        <div class="auth-input-with-toggle">
            <input class="auth-input" type="@(_showPassword ? "text" : "password")"
                   @bind="_model.Password" disabled="@_loading" />
            <button type="button" class="auth-input-toggle" @onclick="@(() => _showPassword = !_showPassword)">
                @(_showPassword ? "Hide" : "Show")
            </button>
        </div>
        <span style="font-size:11px;color:#94A3B8;margin-top:3px;">At least 8 characters</span>
    </div>

    <div class="auth-input-wrap">
        <label class="auth-label">Confirm Password</label>
        <input class="auth-input" type="@(_showPassword ? "text" : "password")"
               @bind="_confirmPassword" disabled="@_loading" />
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="auth-error">@_errorMessage</div>
    }

    <button type="submit" class="auth-btn-primary" disabled="@_loading"
            style="display:flex;align-items:center;justify-content:center;gap:8px;margin-top:8px;">
        @if (_loading)
        {
            <span class="auth-spinner"></span>
            <span>Creating Account...</span>
        }
        else
        {
            <span>Create Account</span>
        }
    </button>
</EditForm>

<hr class="auth-divider" />

<div style="text-align:center;font-size:14px;color:#374151;">
    Already have an account? <a href="/auth/login" class="auth-link">Sign in</a>
</div>

@code {
    private RegisterRequestDto _model = new();
    private string _confirmPassword = string.Empty;
    private bool _loading;
    private bool _showPassword;
    private string? _errorMessage;

    private async Task HandleRegister()
    {
        _errorMessage = null;

        if (_model.Password != _confirmPassword)
        {
            _errorMessage = "Passwords do not match.";
            return;
        }

        _loading = true;

        try
        {
            var response = await AuthClient.RegisterAsync(_model);

            if (response.Success)
            {
                Toast.ShowSuccess("Account created! Please check your email to verify your account.");
                NavigationManager.NavigateTo("/auth/login");
            }
            else
            {
                _errorMessage = response.Message ?? "Registration failed. Please try again.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }
}
