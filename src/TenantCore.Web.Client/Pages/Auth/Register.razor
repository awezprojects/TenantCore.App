@page "/auth/register"
@layout AuthLayout
@inject IAuthApiClient AuthClient
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Create Account — ClinicCore</PageTitle>

<div class="auth-brand">
    <MudAvatar Size="Size.Small" Color="Color.Primary">
        <MudIcon Icon="@Icons.Material.Filled.LocalHospital" />
    </MudAvatar>
    <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #1a56db;">ClinicCore</MudText>
</div>

<MudText Typo="Typo.h5" Style="font-weight: 700; color: #111827; margin-bottom: 4px;">Create Your Account</MudText>
<MudText Typo="Typo.body2" Style="color: #6B7280; margin-bottom: 2rem;">Start managing your clinic today.</MudText>

<EditForm Model="_model" OnValidSubmit="HandleRegister">
    <DataAnnotationsValidator />

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="_model.FirstName"
                          Label="First Name"
                          Variant="Variant.Outlined"
                          For="@(() => _model.FirstName)"
                          Disabled="_loading"
                          Required="true" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="_model.LastName"
                          Label="Last Name"
                          Variant="Variant.Outlined"
                          For="@(() => _model.LastName)"
                          Disabled="_loading"
                          Required="true" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField @bind-Value="_model.EmailId"
                          Label="Email Address"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          For="@(() => _model.EmailId)"
                          Disabled="_loading"
                          Required="true" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField @bind-Value="_model.MobileNo"
                          Label="Mobile Number (Optional)"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Phone"
                          Disabled="_loading" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField @bind-Value="_model.Password"
                          Label="Password"
                          Variant="Variant.Outlined"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                          OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                          For="@(() => _model.Password)"
                          Disabled="_loading"
                          Required="true"
                          HelperText="At least 8 characters" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField @bind-Value="_confirmPassword"
                          Label="Confirm Password"
                          Variant="Variant.Outlined"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Disabled="_loading"
                          Required="true" />
        </MudItem>
    </MudGrid>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true" Variant="Variant.Filled">
            @_errorMessage
        </MudAlert>
    }

    <MudButton ButtonType="ButtonType.Submit"
               Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               Size="Size.Large"
               Disabled="_loading"
               Class="mt-4 mb-4"
               Style="height: 48px; text-transform: none; border-radius: 8px; font-weight: 600;">
        @if (_loading)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Surface" Class="mr-2" />
            <span>Creating Account...</span>
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="mr-2" />
            <span>Create Account</span>
        }
    </MudButton>
</EditForm>

<MudDivider Class="my-4" />

<MudStack AlignItems="AlignItems.Center">
    <MudText Typo="Typo.body2">
        Already have an account?
        <MudLink Href="/auth/login" Color="Color.Primary" Typo="Typo.body2" Style="font-weight: 600;">
            Sign in
        </MudLink>
    </MudText>
</MudStack>

@code {
    private RegisterRequestDto _model = new();
    private string _confirmPassword = string.Empty;
    private bool _loading;
    private bool _showPassword;
    private string? _errorMessage;

    private async Task HandleRegister()
    {
        _errorMessage = null;

        if (_model.Password != _confirmPassword)
        {
            _errorMessage = "Passwords do not match.";
            return;
        }

        _loading = true;

        try
        {
            var response = await AuthClient.RegisterAsync(_model);

            if (response.Success)
            {
                Snackbar.Add("Account created successfully! Please check your email to verify your account.", Severity.Success);
                NavigationManager.NavigateTo("/auth/login");
            }
            else
            {
                _errorMessage = response.Message ?? "Registration failed. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }
}
