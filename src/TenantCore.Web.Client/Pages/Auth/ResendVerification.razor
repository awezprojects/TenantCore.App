@page "/auth/resend-verification"
@layout AuthLayout
@inject IAuthApiClient AuthClient
@inject NavigationManager NavigationManager

<PageTitle>Resend Verification — ClinicCore</PageTitle>

<div class="auth-brand">
    <span style="font-size:22px;">🏥</span>
    <span style="font-weight:700;color:#1a56db;font-size:15px;">ClinicCore</span>
</div>

@if (_sent)
{
    <div style="text-align:center;margin-bottom:20px;"><span style="font-size:80px;">📬</span></div>
    <h2 style="font-size:22px;font-weight:700;color:#111827;margin:0 0 4px;">Verification Email Sent!</h2>
    <p style="color:#6B7280;margin:0 0 1.5rem;font-size:14px;">
        Please check your inbox and click the verification link.
    </p>
    <a href="/auth/login" class="auth-btn-primary"
       style="display:flex;align-items:center;justify-content:center;text-decoration:none;">
        Back to Login
    </a>
}
else
{
    <h2 style="font-size:22px;font-weight:700;color:#111827;margin:0 0 4px;">Resend Verification Email</h2>
    <p style="color:#6B7280;margin:0 0 1.5rem;font-size:14px;">
        Enter your email address to receive a new verification link.
    </p>

    <EditForm Model="_model" OnValidSubmit="HandleResend">
        <DataAnnotationsValidator />

        <div class="auth-input-wrap">
            <label class="auth-label">Email Address</label>
            <input class="auth-input" type="email" @bind="_model.EmailId"
                   placeholder="you@example.com" disabled="@_loading" />
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="auth-error">@_errorMessage</div>
        }

        <button type="submit" class="auth-btn-primary" disabled="@_loading"
                style="display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:16px;">
            @if (_loading)
            {
                <span class="auth-spinner"></span>
                <span>Sending...</span>
            }
            else
            {
                <span>Send Verification Email</span>
            }
        </button>
    </EditForm>

    <div style="text-align:center;">
        <a href="/auth/login" class="auth-link" style="font-size:13px;">← Back to Login</a>
    </div>
}

@code {
    private ResendEmailVerificationRequestDto _model = new();
    private bool _loading;
    private bool _sent;
    private string? _errorMessage;

    private async Task HandleResend()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            var response = await AuthClient.ResendEmailVerificationAsync(_model);

            if (response.Success)
            {
                _sent = true;
            }
            else
            {
                _errorMessage = response.Message ?? "Failed to send verification email. Please try again.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }
}
