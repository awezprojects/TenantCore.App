@page "/auth/reset-password"
@layout AuthLayout
@inject IAuthApiClient AuthClient
@inject AuthStateService AuthState
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Set New Password — ClinicCore</PageTitle>

<div class="auth-brand">
    <MudAvatar Size="Size.Small" Color="Color.Primary">
        <MudIcon Icon="@Icons.Material.Filled.LocalHospital" />
    </MudAvatar>
    <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #1a56db;">ClinicCore</MudText>
</div>

<MudText Typo="Typo.h5" Style="font-weight: 700; color: #111827; margin-bottom: 4px;">Set New Password</MudText>
<MudText Typo="Typo.body2" Style="color: #6B7280; margin-bottom: 2rem;">
    Choose a strong password to protect your account.
</MudText>

<EditForm Model="_model" OnValidSubmit="HandleReset">
    <DataAnnotationsValidator />

    <MudTextField @bind-Value="_model.NewPassword"
                  Label="New Password"
                  Variant="Variant.Outlined"
                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                  Adornment="Adornment.End"
                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                  OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                  For="@(() => _model.NewPassword)"
                  Disabled="_loading"
                  Class="mb-4"
                  HelperText="At least 8 characters" />

    <MudTextField @bind-Value="_model.ConfirmPassword"
                  Label="Confirm Password"
                  Variant="Variant.Outlined"
                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                  For="@(() => _model.ConfirmPassword)"
                  Disabled="_loading"
                  Class="mb-4" />

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true" Variant="Variant.Filled">
            @_errorMessage
        </MudAlert>
    }

    <MudButton ButtonType="ButtonType.Submit"
               Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               Size="Size.Large"
               Disabled="_loading || !_hasUserId"
               Class="mb-4"
               Style="height: 48px; text-transform: none; border-radius: 8px; font-weight: 600;">
        @if (_loading)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Surface" Class="mr-2" />
            <span>Resetting...</span>
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.Save" Class="mr-2" />
            <span>Reset Password</span>
        }
    </MudButton>
</EditForm>

<MudStack AlignItems="AlignItems.Center">
    <MudLink Href="/auth/login" Typo="Typo.body2" Color="Color.Secondary">
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Style="font-size: 1rem; vertical-align: middle; margin-right: 4px;" />
        Back to Login
    </MudLink>
</MudStack>

@code {
    [SupplyParameterFromQuery]
    public Guid? UserId { get; set; }

    private ResetPasswordRequestDto _model = new();
    private bool _loading;
    private bool _showPassword;
    private string? _errorMessage;
    private bool _hasUserId => UserId.HasValue || AuthState.PendingPasswordResetUserId.HasValue;

    private Guid GetUserId() => UserId ?? AuthState.PendingPasswordResetUserId ?? Guid.Empty;

    private async Task HandleReset()
    {
        if (!_hasUserId)
        {
            _errorMessage = "Invalid reset request. Please try again.";
            return;
        }

        _loading = true;
        _errorMessage = null;

        try
        {
            var response = await AuthClient.ResetPasswordAsync(GetUserId(), _model);

            if (response.Success)
            {
                AuthState.ClearTempState();
                Snackbar.Add("Password reset successfully! Please log in with your new password.", Severity.Success);
                NavigationManager.NavigateTo("/auth/login");
            }
            else
            {
                _errorMessage = response.Message ?? "Password reset failed. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }
}
