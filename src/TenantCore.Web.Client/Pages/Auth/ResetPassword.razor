@page "/auth/reset-password"
@layout AuthLayout
@inject IAuthApiClient AuthClient
@inject AuthStateService AuthState
@inject NavigationManager NavigationManager
@inject IToastService Toast

<PageTitle>Set New Password — ClinicCore</PageTitle>

<div class="auth-brand">
    <span style="font-size:22px;">🏥</span>
    <span style="font-weight:700;color:#1a56db;font-size:15px;">ClinicCore</span>
</div>

<h2 style="font-size:22px;font-weight:700;color:#111827;margin:0 0 4px;">Set New Password</h2>
<p style="color:#6B7280;margin:0 0 1.5rem;font-size:14px;">Choose a strong password to protect your account.</p>

<EditForm Model="_model" OnValidSubmit="HandleReset">
    <DataAnnotationsValidator />

    <div class="auth-input-wrap">
        <label class="auth-label">New Password</label>
        <div class="auth-input-with-toggle">
            <input class="auth-input" type="@(_showPassword ? "text" : "password")"
                   @bind="_model.NewPassword" disabled="@_loading" />
            <button type="button" class="auth-input-toggle" @onclick="@(() => _showPassword = !_showPassword)">
                @(_showPassword ? "Hide" : "Show")
            </button>
        </div>
        <span style="font-size:11px;color:#94A3B8;margin-top:3px;">At least 8 characters</span>
    </div>

    <div class="auth-input-wrap">
        <label class="auth-label">Confirm Password</label>
        <input class="auth-input" type="@(_showPassword ? "text" : "password")"
               @bind="_model.ConfirmPassword" disabled="@_loading" />
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="auth-error">@_errorMessage</div>
    }

    <button type="submit" class="auth-btn-primary" disabled="@(_loading || !_hasUserId)"
            style="display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:16px;">
        @if (_loading)
        {
            <span class="auth-spinner"></span>
            <span>Resetting...</span>
        }
        else
        {
            <span>Reset Password</span>
        }
    </button>
</EditForm>

<div style="text-align:center;">
    <a href="/auth/login" class="auth-link" style="font-size:13px;">← Back to Login</a>
</div>

@code {
    [SupplyParameterFromQuery]
    public Guid? UserId { get; set; }

    private ResetPasswordRequestDto _model = new();
    private bool _loading;
    private bool _showPassword;
    private string? _errorMessage;
    private bool _hasUserId => UserId.HasValue || AuthState.PendingPasswordResetUserId.HasValue;

    private Guid GetUserId() => UserId ?? AuthState.PendingPasswordResetUserId ?? Guid.Empty;

    private async Task HandleReset()
    {
        if (!_hasUserId)
        {
            _errorMessage = "Invalid reset request. Please try again.";
            return;
        }

        _loading = true;
        _errorMessage = null;

        try
        {
            var response = await AuthClient.ResetPasswordAsync(GetUserId(), _model);

            if (response.Success)
            {
                AuthState.ClearTempState();
                Toast.ShowSuccess("Password reset successfully! Please log in with your new password.");
                NavigationManager.NavigateTo("/auth/login");
            }
            else
            {
                _errorMessage = response.Message ?? "Password reset failed. Please try again.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }
}
