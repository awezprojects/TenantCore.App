@page "/auth/two-factor"
@layout AuthLayout
@inject IAuthApiClient AuthClient
@inject AuthStateService AuthState
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Two-Factor Authentication — ClinicCore</PageTitle>

<div class="auth-brand">
    <MudAvatar Size="Size.Small" Color="Color.Primary">
        <MudIcon Icon="@Icons.Material.Filled.LocalHospital" />
    </MudAvatar>
    <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #1a56db;">ClinicCore</MudText>
</div>

@if (AuthState.IsFirstTimeSetup)
{
    <MudText Typo="Typo.h5" Style="font-weight: 700; color: #111827; margin-bottom: 4px;">Set Up Authenticator</MudText>
    <MudText Typo="Typo.body2" Style="color: #6B7280; margin-bottom: 1.5rem;">
        Scan the QR code with Google Authenticator or Authy to get started.
    </MudText>

    @if (!string.IsNullOrEmpty(AuthState.QrCodeBase64))
    {
        <MudStack AlignItems="AlignItems.Center" Class="mb-4">
            <MudPaper Elevation="2" Class="pa-3" Style="border-radius: 12px; display: inline-block;">
                <img src="@($"data:image/png;base64,{AuthState.QrCodeBase64}")"
                     alt="Authenticator QR Code"
                     style="width: 180px; height: 180px; display: block;" />
            </MudPaper>
        </MudStack>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
            After scanning, enter the 6-digit code from your authenticator app below.
        </MudText>
    }
}
else
{
    <MudText Typo="Typo.h5" Style="font-weight: 700; color: #111827; margin-bottom: 4px;">Two-Factor Authentication</MudText>
    <MudText Typo="Typo.body2" Style="color: #6B7280; margin-bottom: 1.5rem;">
        Enter the 6-digit code from your authenticator app.
    </MudText>

    @if (!string.IsNullOrEmpty(AuthState.UserDisplayName))
    {
        <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
            Signing in as: <strong>@AuthState.UserDisplayName</strong>
        </MudAlert>
    }
}

<EditForm Model="_model" OnValidSubmit="HandleValidate">
    <DataAnnotationsValidator />

    <MudTextField @bind-Value="_model.OtpCode"
                  Label="6-Digit Code"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Pin"
                  For="@(() => _model.OtpCode)"
                  Disabled="_loading"
                  MaxLength="6"
                  Placeholder="000000"
                  Class="mb-4"
                  Style="font-size: 1.5rem; letter-spacing: 0.5rem;" />

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true" Variant="Variant.Filled">
            @_errorMessage
        </MudAlert>
    }

    <MudButton ButtonType="ButtonType.Submit"
               Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               Size="Size.Large"
               Disabled="_loading"
               Class="mb-4"
               Style="height: 48px; text-transform: none; border-radius: 8px; font-weight: 600;">
        @if (_loading)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Surface" Class="mr-2" />
            <span>Verifying...</span>
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.Verified" Class="mr-2" />
            <span>Verify Code</span>
        }
    </MudButton>
</EditForm>

<MudStack AlignItems="AlignItems.Center">
    <MudLink Typo="Typo.body2" Color="Color.Secondary" @onclick="BackToLogin" Style="cursor: pointer;">
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Style="font-size: 1rem; vertical-align: middle; margin-right: 4px;" />
        Back to Login
    </MudLink>
</MudStack>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private ValidateTwoFactorRequestDto _model = new();
    private bool _loading;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(AuthState.TempLoginToken))
        {
            NavigationManager.NavigateTo("/auth/login");
        }
    }

    private async Task HandleValidate()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            var response = await AuthClient.ValidateTwoFactorAsync(AuthState.TempLoginToken!, _model);

            if (response.Success && response.Data != null)
            {
                await AuthState.SetAuthenticatedStateAsync(response.Data);
                Snackbar.Add("Login successful!", Severity.Success);

                if (!string.IsNullOrEmpty(ReturnUrl))
                {
                    var decoded = Uri.UnescapeDataString(ReturnUrl);
                    // Only allow same-app relative paths; reject external URLs and protocol-relative references
                    if (decoded.StartsWith("/") && !decoded.StartsWith("//")
                        && !decoded.StartsWith("/auth/login", StringComparison.OrdinalIgnoreCase))
                    {
                        NavigationManager.NavigateTo(decoded);
                        return;
                    }
                }

                NavigationManager.NavigateTo("/select-clinic");
            }
            else
            {
                _errorMessage = response.Message ?? "Invalid code. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Verification failed. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void BackToLogin()
    {
        AuthState.ClearTempState();
        NavigationManager.NavigateTo("/auth/login");
    }
}
