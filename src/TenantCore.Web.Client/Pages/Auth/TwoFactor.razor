@page "/auth/two-factor"
@layout AuthLayout
@inject IAuthApiClient AuthClient
@inject AuthStateService AuthState
@inject NavigationManager NavigationManager
@inject IToastService Toast

<PageTitle>Two-Factor Authentication — ClinicCore</PageTitle>

<div class="auth-brand">
    <span style="font-size:22px;">🏥</span>
    <span style="font-weight:700;color:#1a56db;font-size:15px;">ClinicCore</span>
</div>

@if (AuthState.IsFirstTimeSetup)
{
    <h2 style="font-size:22px;font-weight:700;color:#111827;margin:0 0 4px;">Set Up Authenticator</h2>
    <p style="color:#6B7280;margin:0 0 1.5rem;font-size:14px;">
        Scan the QR code with Google Authenticator or Authy to get started.
    </p>

    @if (!string.IsNullOrEmpty(AuthState.QrCodeBase64))
    {
        <div style="display:flex;justify-content:center;margin-bottom:16px;">
            <div style="background:#fff;border-radius:12px;padding:12px;box-shadow:0 2px 8px rgba(0,0,0,0.12);display:inline-block;">
                <img src="@($"data:image/png;base64,{AuthState.QrCodeBase64}")"
                     alt="Authenticator QR Code"
                     style="width:180px;height:180px;display:block;" />
            </div>
        </div>
        <p style="text-align:center;font-size:12px;color:#94A3B8;margin-bottom:20px;">
            After scanning, enter the 6-digit code from your authenticator app below.
        </p>
    }
}
else
{
    <h2 style="font-size:22px;font-weight:700;color:#111827;margin:0 0 4px;">Two-Factor Authentication</h2>
    <p style="color:#6B7280;margin:0 0 1.5rem;font-size:14px;">
        Enter the 6-digit code from your authenticator app.
    </p>

    @if (!string.IsNullOrEmpty(AuthState.UserDisplayName))
    {
        <div class="auth-info" style="margin-bottom:16px;">
            Signing in as: <strong>@AuthState.UserDisplayName</strong>
        </div>
    }
}

<EditForm Model="_model" OnValidSubmit="HandleValidate">
    <DataAnnotationsValidator />

    <div class="auth-input-wrap">
        <label class="auth-label">6-Digit Code</label>
        <input class="auth-input" type="text" @bind="_model.OtpCode"
               maxlength="6" placeholder="000000" disabled="@_loading"
               style="font-size:1.5rem;letter-spacing:0.5rem;text-align:center;" />
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="auth-error">@_errorMessage</div>
    }

    <button type="submit" class="auth-btn-primary" disabled="@_loading"
            style="display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:16px;">
        @if (_loading)
        {
            <span class="auth-spinner"></span>
            <span>Verifying...</span>
        }
        else
        {
            <span>Verify Code</span>
        }
    </button>
</EditForm>

<div style="text-align:center;">
    <button type="button" class="auth-link"
            style="font-size:13px;background:none;border:none;cursor:pointer;padding:0;"
            @onclick="BackToLogin">← Back to Login</button>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private ValidateTwoFactorRequestDto _model = new();
    private bool _loading;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(AuthState.TempLoginToken))
        {
            NavigationManager.NavigateTo("/auth/login");
        }
    }

    private async Task HandleValidate()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            var response = await AuthClient.ValidateTwoFactorAsync(AuthState.TempLoginToken!, _model);

            if (response.Success && response.Data != null)
            {
                await AuthState.SetAuthenticatedStateAsync(response.Data);
                Toast.ShowSuccess("Login successful!");

                if (!string.IsNullOrEmpty(ReturnUrl))
                {
                    var decoded = Uri.UnescapeDataString(ReturnUrl);
                    if (decoded.StartsWith("/") && !decoded.StartsWith("//")
                        && !decoded.StartsWith("/auth/login", StringComparison.OrdinalIgnoreCase))
                    {
                        NavigationManager.NavigateTo(decoded);
                        return;
                    }
                }

                NavigationManager.NavigateTo("/select-clinic");
            }
            else
            {
                _errorMessage = response.Message ?? "Invalid code. Please try again.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Verification failed. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void BackToLogin()
    {
        AuthState.ClearTempState();
        NavigationManager.NavigateTo("/auth/login");
    }
}
