@page "/auth/verify-email"
@layout AuthLayout
@inject IAuthApiClient AuthClient
@inject NavigationManager NavigationManager

<PageTitle>Verify Email — ClinicCore</PageTitle>

<div class="auth-brand">
    <span style="font-size:22px;">🏥</span>
    <span style="font-weight:700;color:#1a56db;font-size:15px;">ClinicCore</span>
</div>

@if (_verifying)
{
    <div style="display:flex;justify-content:center;margin-bottom:24px;">
        <div class="auth-spinner" style="width:64px;height:64px;border-width:5px;"></div>
    </div>
    <h2 style="font-size:22px;font-weight:700;color:#111827;margin:0 0 4px;">Verifying Email…</h2>
    <p style="color:#6B7280;font-size:14px;">Please wait while we verify your email address.</p>
}
else if (_verified)
{
    <div style="text-align:center;margin-bottom:20px;"><span style="font-size:80px;">✅</span></div>
    <h2 style="font-size:22px;font-weight:700;color:#22C55E;margin:0 0 4px;">Email Verified!</h2>
    <p style="color:#6B7280;margin:0 0 1.5rem;font-size:14px;">
        Your email is confirmed. You can now sign in to your account.
    </p>
    <a href="/auth/login" class="auth-btn-primary"
       style="display:flex;align-items:center;justify-content:center;text-decoration:none;">
        Sign In
    </a>
}
else if (_error)
{
    <div style="text-align:center;margin-bottom:20px;"><span style="font-size:80px;">❌</span></div>
    <h2 style="font-size:22px;font-weight:700;color:#111827;margin:0 0 12px;">Verification Failed</h2>
    <div class="auth-error" style="margin-bottom:16px;">@_errorMessage</div>
    <a href="/auth/login" class="auth-btn-primary"
       style="display:flex;align-items:center;justify-content:center;text-decoration:none;margin-bottom:12px;">
        Back to Login
    </a>
    <div style="text-align:center;">
        <a href="/auth/resend-verification" class="auth-link" style="font-size:13px;">Resend Verification Email</a>
    </div>
}
else
{
    <div style="text-align:center;margin-bottom:20px;"><span style="font-size:80px;">🔗</span></div>
    <h2 style="font-size:22px;font-weight:700;color:#111827;margin:0 0 4px;">Invalid Link</h2>
    <p style="color:#6B7280;margin:0 0 1.5rem;font-size:14px;">
        The verification link is invalid or missing required parameters.
    </p>
    <a href="/auth/login" class="auth-btn-primary"
       style="display:flex;align-items:center;justify-content:center;text-decoration:none;margin-bottom:12px;">
        Back to Login
    </a>
    <div style="text-align:center;">
        <a href="/auth/resend-verification" class="auth-link" style="font-size:13px;">Resend Verification Email</a>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public Guid? UserId { get; set; }

    [SupplyParameterFromQuery]
    public string? VerificationCode { get; set; }

    private bool _verifying;
    private bool _verified;
    private bool _error;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (UserId.HasValue && !string.IsNullOrEmpty(VerificationCode))
        {
            await VerifyEmailAsync();
        }
    }

    private async Task VerifyEmailAsync()
    {
        _verifying = true;
        StateHasChanged();

        try
        {
            var response = await AuthClient.VerifyEmailAsync(UserId!.Value, VerificationCode!);

            if (response.Success)
            {
                _verified = true;
            }
            else
            {
                _error = true;
                _errorMessage = response.Message ?? "Email verification failed. The link may have expired.";
            }
        }
        catch (Exception)
        {
            _error = true;
            _errorMessage = "An unexpected error occurred during verification. Please try again.";
        }
        finally
        {
            _verifying = false;
        }
    }
}
