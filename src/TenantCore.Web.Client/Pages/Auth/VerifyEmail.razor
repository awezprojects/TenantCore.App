@page "/auth/verify-email"
@layout AuthLayout
@inject IAuthApiClient AuthClient
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Verify Email — ClinicCore</PageTitle>

<div class="auth-brand">
    <MudAvatar Size="Size.Small" Color="Color.Primary">
        <MudIcon Icon="@Icons.Material.Filled.LocalHospital" />
    </MudAvatar>
    <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #1a56db;">ClinicCore</MudText>
</div>

@if (_verifying)
{
    <MudStack AlignItems="AlignItems.Center" Class="mb-6">
        <MudProgressCircular Size="Size.Large" Indeterminate="true" Color="Color.Primary"
                             Style="width: 64px; height: 64px;" />
    </MudStack>
    <MudText Typo="Typo.h5" Style="font-weight: 700; color: #111827; margin-bottom: 4px;">Verifying Email…</MudText>
    <MudText Typo="Typo.body2" Style="color: #6B7280;">Please wait while we verify your email address.</MudText>
}
else if (_verified)
{
    <MudStack AlignItems="AlignItems.Center" Class="mb-6">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                 Style="font-size: 5rem; color: #22C55E; display: block;" />
    </MudStack>
    <MudText Typo="Typo.h5" Style="font-weight: 700; color: #22C55E; margin-bottom: 4px;">Email Verified!</MudText>
    <MudText Typo="Typo.body2" Style="color: #6B7280; margin-bottom: 2rem;">
        Your email is confirmed. You can now sign in to your account.
    </MudText>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               Href="/auth/login"
               Size="Size.Large"
               Style="height: 48px; text-transform: none; border-radius: 8px; font-weight: 600;">
        <MudIcon Icon="@Icons.Material.Filled.Login" Class="mr-2" />
        Sign In
    </MudButton>
}
else if (_error)
{
    <MudStack AlignItems="AlignItems.Center" Class="mb-6">
        <MudIcon Icon="@Icons.Material.Filled.Cancel"
                 Style="font-size: 5rem; color: #EF4444; display: block;" />
    </MudStack>
    <MudText Typo="Typo.h5" Style="font-weight: 700; color: #111827; margin-bottom: 4px;">Verification Failed</MudText>
    <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">
        @_errorMessage
    </MudAlert>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               Href="/auth/login"
               Size="Size.Large"
               Class="mb-3"
               Style="height: 48px; text-transform: none; border-radius: 8px; font-weight: 600;">
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Class="mr-2" />
        Back to Login
    </MudButton>
    <MudStack AlignItems="AlignItems.Center">
        <MudLink Href="/auth/resend-verification" Typo="Typo.body2" Color="Color.Secondary">
            Resend Verification Email
        </MudLink>
    </MudStack>
}
else
{
    <MudStack AlignItems="AlignItems.Center" Class="mb-6">
        <MudIcon Icon="@Icons.Material.Filled.LinkOff"
                 Style="font-size: 5rem; color: #F59E0B; display: block;" />
    </MudStack>
    <MudText Typo="Typo.h5" Style="font-weight: 700; color: #111827; margin-bottom: 4px;">Invalid Link</MudText>
    <MudText Typo="Typo.body2" Style="color: #6B7280; margin-bottom: 2rem;">
        The verification link is invalid or missing required parameters.
    </MudText>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               Href="/auth/login"
               Size="Size.Large"
               Class="mb-3"
               Style="height: 48px; text-transform: none; border-radius: 8px; font-weight: 600;">
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Class="mr-2" />
        Back to Login
    </MudButton>
    <MudStack AlignItems="AlignItems.Center">
        <MudLink Href="/auth/resend-verification" Typo="Typo.body2" Color="Color.Secondary">
            Resend Verification Email
        </MudLink>
    </MudStack>
}

@code {
    [SupplyParameterFromQuery]
    public Guid? UserId { get; set; }

    [SupplyParameterFromQuery]
    public string? VerificationCode { get; set; }

    private bool _verifying;
    private bool _verified;
    private bool _error;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (UserId.HasValue && !string.IsNullOrEmpty(VerificationCode))
        {
            await VerifyEmailAsync();
        }
    }

    private async Task VerifyEmailAsync()
    {
        _verifying = true;
        StateHasChanged();

        try
        {
            var response = await AuthClient.VerifyEmailAsync(UserId!.Value, VerificationCode!);

            if (response.Success)
            {
                _verified = true;
            }
            else
            {
                _error = true;
                _errorMessage = response.Message ?? "Email verification failed. The link may have expired.";
            }
        }
        catch (Exception ex)
        {
            _error = true;
            _errorMessage = "An unexpected error occurred during verification. Please try again.";
        }
        finally
        {
            _verifying = false;
        }
    }
}
