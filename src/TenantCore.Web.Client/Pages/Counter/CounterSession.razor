@page "/counter-session"
@layout AuthorizedLayout
@using TenantCore.Web.Client.Helpers
@inject ICounterSessionApiClient CounterSessionClient
@inject IAmountHandoverApiClient HandoverClient
@inject IExpenseRecordApiClient ExpenseClient
@inject IApplicationApiClient AppClient
@inject ClinicContextService ClinicContext
@inject AuthStateService AuthState
@inject ISnackbar Snackbar
@using TenantCore.Shared.Enums
@using TenantCore.Shared.Authorization
@using TenantCore.Shared.Dtos
@using TenantCore.Shared.Dtos.Auth
@using TenantCore.Web.Client.Services

<PageTitle>Counter Session - CloudClinic</PageTitle>

<div class="opd-page">

    <div class="opd-header">
        <div>
            <div class="opd-title">Counter Session</div>
            <div class="opd-subtitle">Finance &middot; @DateTime.Now.ToString("dddd, dd MMMM yyyy · hh:mm tt")</div>
        </div>
        @if (_activeSession is null && !_loading)
        {
            <button class="opd-btn-primary" @onclick="OpenSessionAsync" disabled="@_saving">
                @(_saving ? "Opening..." : "▶ Open Session")
            </button>
        }
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        @if (_activeSession is not null)
        {
            <div class="opd-stats">
                <div class="opd-stat-card done" style="flex:1;">
                    <div class="opd-stat-label">Collected</div>
                    <div class="opd-stat-icon">💰</div>
                    <div class="opd-stat-value" style="color:#16A34A;">Rs. @_activeSession.TotalCollected.ToString("N0")</div>
                </div>
                <div class="opd-stat-card waiting" style="flex:1;">
                    <div class="opd-stat-label">Paid Expenses</div>
                    <div class="opd-stat-icon">📋</div>
                    <div class="opd-stat-value" style="color:#DC2626;">Rs. @_activeSession.TotalExpenses.ToString("N0")</div>
                </div>
                <div class="opd-stat-card" style="flex:1;">
                    <div class="opd-stat-label">Net Balance</div>
                    <div class="opd-stat-icon">🏦</div>
                    <div class="opd-stat-value" style="color:@(_activeSession.NetAmount >= 0 ? "#16A34A" : "#DC2626");">
                        Rs. @_activeSession.NetAmount.ToString("N0")
                    </div>
                </div>
            </div>

            <div class="opd-table-card" style="margin-bottom:16px;">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;">
                    <div>
                        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px;">
                            <span style="background:#DCFCE7;color:#166534;border-radius:12px;padding:3px 14px;font-size:12px;font-weight:700;">● Session Open</span>
                            @if (_hasPendingHandover)
                            {
                                <span style="background:#FEF3C7;color:#92400E;border-radius:12px;padding:3px 14px;font-size:12px;font-weight:700;">⇄ Handover Pending</span>
                            }
                            else if (_sessionHandovers.Any(h => h.Status == HandoverStatus.Accepted))
                            {
                                <span style="background:#DCFCE7;color:#166534;border-radius:12px;padding:3px 14px;font-size:12px;font-weight:700;">✓ Handover Accepted</span>
                            }
                        </div>
                        <div style="font-size:13px;color:#64748B;line-height:1.8;">
                            <div>Opened: <strong>@DateTimeHelper.ToLocalString(_activeSession.OpenedAt)</strong></div>
                            <div>Session Date: <strong>@_activeSession.SessionDate.ToString("dd MMM yyyy")</strong></div>
                        </div>
                    </div>
                    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px;">
                        @if (_hasPendingHandover)
                        {
                            <div style="font-size:12px;color:#D97706;text-align:right;max-width:240px;">
                                ⚠ Accept the pending handover before closing.
                                <a href="/amount-handovers" style="color:#2563EB;text-decoration:underline;">Go to Handovers →</a>
                            </div>
                        }
                        @if (!_sessionHandovers.Any(h => h.Status == HandoverStatus.Accepted))
                        {
                            <button class="opd-btn-primary" style="padding:8px 20px;"
                                    @onclick="OpenHandoverDialog" disabled="@(_saving || _hasPendingHandover)">
                                💸 Handover
                            </button>
                        }
                        <button class="opd-btn" style="padding:8px 20px;@(_canClose ? "color:#DC2626;border-color:#DC2626;" : "opacity:.5;cursor:not-allowed;")"
                                @onclick="CloseSessionAsync" disabled="@(_saving || !_canClose)">
                            @(_saving ? "Closing..." : "🔒 Close Session")
                        </button>
                    </div>
                </div>
            </div>

            @if (_sessionExpenses.Any())
            {
                <div style="margin-bottom:16px;">
                    <div style="font-size:14px;font-weight:700;color:#374151;margin-bottom:8px;">
                        Expenses This Session
                        <span style="font-size:12px;font-weight:400;color:#64748B;margin-left:8px;">
                            (bill: Rs. @_sessionExpenses.Sum(e => e.Amount).ToString("N0") | paid: Rs. @_sessionExpenses.Sum(e => e.PaidAmount).ToString("N0"))
                        </span>
                    </div>
                    <div class="opd-table-card" style="padding:0;">
                        <table class="opd-table">
                            <thead><tr><th>Category</th><th>Bill</th><th>Paid</th><th>Pending</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var exp in _sessionExpenses)
                                {
                                    var p = exp.Amount - exp.PaidAmount;
                                    var paid = exp.PaidAmount >= exp.Amount;
                                    <tr>
                                        <td><strong>@exp.CategoryName</strong></td>
                                        <td style="color:#DC2626;font-weight:600;">Rs. @exp.Amount.ToString("N2")</td>
                                        <td style="color:#16A34A;font-weight:600;">Rs. @exp.PaidAmount.ToString("N2")</td>
                                        <td style="color:@(p > 0 ? "#D97706" : "#94A3B8");">Rs. @p.ToString("N2")</td>
                                        <td>@StatusBadge(paid, exp.PaidAmount > 0 && !paid)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if (_sessionHandovers.Any())
            {
                <div style="margin-bottom:16px;">
                    <div style="font-size:14px;font-weight:700;color:#374151;margin-bottom:8px;">Handovers This Session</div>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;">
                        @foreach (var h in _sessionHandovers)
                        {
                            var (bg, fg) = h.Status switch
                            {
                                HandoverStatus.Accepted => ("#DCFCE7", "#166534"),
                                HandoverStatus.Disputed => ("#FEE2E2", "#991B1B"),
                                _                       => ("#FEF3C7", "#92400E")
                            };
                            <div style="background:@bg;border-radius:10px;padding:6px 16px;font-size:13px;font-weight:600;color:@fg;">
                                Rs. @h.Amount.ToString("N0") — @h.Status @(string.IsNullOrEmpty(h.HandedOverToRoleName) ? "" : $"({h.HandedOverToRoleName})")
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="opd-table-card" style="text-align:center;padding:40px 20px;">
                <div style="font-size:40px;margin-bottom:12px;">🏦</div>
                <div style="font-size:16px;font-weight:600;color:#374151;margin-bottom:6px;">No Active Session</div>
                <div style="font-size:13px;color:#64748B;margin-bottom:20px;">Open a session to start recording payments and expenses.</div>
                <button class="opd-btn-primary" @onclick="OpenSessionAsync" disabled="@_saving">
                    @(_saving ? "Opening..." : "▶ Open Session")
                </button>
            </div>
        }

        <!-- Session History -->
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:8px;">
            <div style="font-size:14px;font-weight:700;color:#374151;">Session History</div>
            <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
                <button class="opd-btn" style="padding:5px 12px;font-size:12px;@(_histPreset=="today"?"background:#2563EB;color:#fff;border-color:#2563EB;":"")" @onclick='() => ApplyHistPreset("today")'>Today</button>
                <button class="opd-btn" style="padding:5px 12px;font-size:12px;@(_histPreset=="yesterday"?"background:#2563EB;color:#fff;border-color:#2563EB;":"")" @onclick='() => ApplyHistPreset("yesterday")'>Yesterday</button>
                <button class="opd-btn" style="padding:5px 12px;font-size:12px;@(_histPreset=="7d"?"background:#2563EB;color:#fff;border-color:#2563EB;":"")" @onclick='() => ApplyHistPreset("7d")'>Last 7 Days</button>
                <button class="opd-btn" style="padding:5px 12px;font-size:12px;@(_histPreset=="30d"?"background:#2563EB;color:#fff;border-color:#2563EB;":"")" @onclick='() => ApplyHistPreset("30d")'>Last 30 Days</button>
                <button class="opd-btn" style="padding:5px 12px;font-size:12px;@(_histPreset=="all"?"background:#2563EB;color:#fff;border-color:#2563EB;":"")" @onclick='() => ApplyHistPreset("all")'>All</button>
                <input type="date" class="opd-search-input" style="width:120px;padding:5px 8px;font-size:12px;" @bind="_histFrom" @bind:event="onchange" />
                <span style="font-size:12px;color:#94A3B8;">–</span>
                <input type="date" class="opd-search-input" style="width:120px;padding:5px 8px;font-size:12px;" @bind="_histTo" @bind:event="onchange" />
                <button class="opd-btn-primary" style="padding:5px 12px;font-size:12px;" @onclick="LoadHistoryAsync">Apply</button>
            </div>
        </div>
        <div class="opd-table-card" style="padding:0;">
            <table class="opd-table">
                <thead>
                    <tr><th>Session Date</th><th>Opened At</th><th>Status</th><th>Collected</th><th>Expenses</th><th>Net</th></tr>
                </thead>
                <tbody>
                    @if (!_sessions.Any())
                    {
                        <tr><td colspan="6" class="opd-empty">No sessions found for the selected period.</td></tr>
                    }
                    else
                    {
                        @foreach (var s in _sessions)
                        {
                            <tr>
                                <td>@s.SessionDate.ToString("dd MMM yyyy")</td>
                                <td style="font-size:12px;color:#64748B;">@DateTimeHelper.ToLocalString(s.OpenedAt, "HH:mm")</td>
                                <td>
                                    @if (s.Status == CounterSessionStatus.Open)
                                    {
                                        <span style="background:#DCFCE7;color:#166534;border-radius:12px;padding:2px 10px;font-size:11px;font-weight:600;">Open</span>
                                    }
                                    else
                                    {
                                        <span style="background:#F1F5F9;color:#475569;border-radius:12px;padding:2px 10px;font-size:11px;font-weight:600;">Closed</span>
                                    }
                                </td>
                                <td style="color:#16A34A;font-weight:600;">Rs. @s.TotalCollected.ToString("N2")</td>
                                <td style="color:#DC2626;font-weight:600;">Rs. @s.TotalExpenses.ToString("N2")</td>
                                <td style="font-weight:700;color:@(s.NetAmount >= 0 ? "#16A34A" : "#DC2626");">Rs. @s.NetAmount.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Handover Dialog -->
<MudDialog @bind-Visible="_handoverVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">💸 Handover Cash</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Info" Dense="true">
                Net amount after expenses: <strong>Rs. @(_activeSession?.NetAmount.ToString("N2") ?? "0.00")</strong>
            </MudAlert>
            <MudNumericField @bind-Value="_handoverAmount" Label="Amount to Handover (Rs.) *" Min="0.01m" Variant="Variant.Outlined" />
            <MudSelect T="ApplicationUserResponseDto?" @bind-Value="_handoverRecipient"
                       Label="Handover To *" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomLeft">
                @foreach (var u in _handoverUsers)
                {
                    <MudSelectItem T="ApplicationUserResponseDto?" Value="@u">
                        @u.FullName <span style="color:#94A3B8;font-size:0.75rem;margin-left:6px;">(@u.RoleName)</span>
                    </MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_handoverNotes" Label="Notes" Variant="Variant.Outlined" Lines="2" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _handoverVisible = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SubmitHandoverAsync"
                   Disabled="@(_saving || _handoverRecipient is null)">
            @(_saving ? "Sending..." : "Send")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _loading = true;
    private bool _saving;
    private CounterSessionDto? _activeSession;
    private List<CounterSessionSummaryDto> _sessions = [];
    private List<AmountHandoverSummaryDto> _sessionHandovers = [];
    private List<ExpenseRecordSummaryDto> _sessionExpenses = [];
    private bool _hasPendingHandover => _sessionHandovers.Any(h => h.Status == HandoverStatus.Pending);
    private bool _canClose => _sessionHandovers.Any(h => h.Status == HandoverStatus.Accepted) && !_hasPendingHandover;

    // Handover dialog
    private bool _handoverVisible;
    private decimal _handoverAmount;
    private string? _handoverNotes;
    private ApplicationUserResponseDto? _handoverRecipient;
    private List<ApplicationUserResponseDto> _handoverUsers = [];

    private static readonly string[] HandoverTargetRoles = [AppRoles.ClinicAdmin, AppRoles.ClinicManager, AppRoles.Doctor];

    private string _histPreset = "today";
    private DateTime? _histFrom = DateTime.Today;
    private DateTime? _histTo = DateTime.Today;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var active = await CounterSessionClient.GetActiveAsync();
        _activeSession = active.Success ? active.Data : null;

        if (_activeSession is not null)
        {
            var handovers = await HandoverClient.GetBySessionAsync(_activeSession.Id);
            _sessionHandovers = handovers.Success && handovers.Data is not null ? handovers.Data.ToList() : [];
            var expenses = await ExpenseClient.GetBySessionAsync(_activeSession.Id);
            _sessionExpenses = expenses.Success && expenses.Data is not null ? expenses.Data.ToList() : [];
        }
        else
        {
            _sessionHandovers = [];
            _sessionExpenses = [];
        }

        await LoadHistoryAsync();
        _loading = false;
    }

    private async Task LoadHistoryAsync()
    {
        var all = await CounterSessionClient.GetAllAsync(_histFrom, _histTo);
        _sessions = all.Success && all.Data is not null ? all.Data.ToList() : [];
    }

    private async Task ApplyHistPreset(string preset)
    {
        _histPreset = preset;
        var today = DateTime.Today;
        (_histFrom, _histTo) = preset switch
        {
            "today"     => ((DateTime?)today, (DateTime?)today),
            "yesterday" => (today.AddDays(-1), today.AddDays(-1)),
            "7d"        => (today.AddDays(-6), today),
            "30d"       => (today.AddDays(-29), today),
            "all"       => (null, null),
            _           => (_histFrom, _histTo)
        };
        await LoadHistoryAsync();
    }

    private async Task OpenSessionAsync()
    {
        _saving = true;
        // Send as Unspecified so JSON doesn't add +05:30, which would be UTC-converted by the server
        var response = await CounterSessionClient.OpenAsync(new OpenCounterSessionRequest { SessionDate = DateTime.SpecifyKind(DateTime.Today, DateTimeKind.Unspecified) });
        if (response.Success) { Snackbar.Add("Session opened.", Severity.Success); await LoadAsync(); }
        else Snackbar.Add(response.Message, Severity.Error);
        _saving = false;
    }

    private async Task CloseSessionAsync()
    {
        if (_activeSession is null) return;
        _saving = true;
        var response = await CounterSessionClient.CloseAsync(_activeSession.Id);
        if (response.Success) { Snackbar.Add("Session closed.", Severity.Success); await LoadAsync(); }
        else Snackbar.Add(response.Message, Severity.Error);
        _saving = false;
    }

    private async Task OpenHandoverDialog()
    {
        _handoverAmount = _activeSession?.NetAmount ?? 0;
        _handoverNotes  = null;
        _handoverRecipient = null;
        _handoverVisible = true;

        var currentUserId = AuthState.CurrentUser?.UserId;
        var response = await AppClient.GetApplicationUsersAsync(ClinicContext.SelectedApplicationId);
        _handoverUsers = response.Success && response.Data is not null
            ? response.Data
                .Where(u => u.IsActive && u.UserId != currentUserId && u.RoleName is not null && HandoverTargetRoles.Contains(u.RoleName))
                .OrderBy(u => u.RoleName).ThenBy(u => u.FullName)
                .ToList()
            : [];
    }

    private async Task SubmitHandoverAsync()
    {
        if (_handoverRecipient is null || _activeSession is null) return;
        _saving = true;
        var response = await HandoverClient.CreateAsync(new CreateAmountHandoverRequest
        {
            CounterSessionId    = _activeSession.Id,
            HandedOverToUserId  = _handoverRecipient.UserId,
            HandedOverToRoleName = _handoverRecipient.RoleName ?? string.Empty,
            Amount = _handoverAmount,
            Notes  = _handoverNotes
        });
        if (response.Success)
        {
            Snackbar.Add("Handover sent.", Severity.Success);
            _handoverVisible = false;
            await LoadAsync();
        }
        else Snackbar.Add(response.Message ?? "Failed.", Severity.Error);
        _saving = false;
    }

    private static MarkupString StatusBadge(bool isPaid, bool isPartial)
    {
        if (isPaid)    return new MarkupString("<span style=\"background:#DCFCE7;color:#166534;border-radius:12px;padding:2px 10px;font-size:11px;font-weight:600;\">Paid</span>");
        if (isPartial) return new MarkupString("<span style=\"background:#FEF3C7;color:#92400E;border-radius:12px;padding:2px 10px;font-size:11px;font-weight:600;\">Partial</span>");
        return             new MarkupString("<span style=\"background:#FEE2E2;color:#991B1B;border-radius:12px;padding:2px 10px;font-size:11px;font-weight:600;\">Unpaid</span>");
    }
}
