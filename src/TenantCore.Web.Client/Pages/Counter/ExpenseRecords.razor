@page "/expense-records"
@layout AuthorizedLayout
@using TenantCore.Web.Client.Helpers
@using TenantCore.Shared.Authorization
@inject IExpenseRecordApiClient ExpenseRecordClient
@inject IExpenseCategoryApiClient ExpenseCategoryClient
@inject ICounterSessionApiClient CounterSessionClient
@inject AuthStateService AuthState
@inject ClinicContextService ClinicContext
@inject IToastService Toast

<PageTitle>Expenses - CloudClinic</PageTitle>

<div class="opd-page">

    <div class="opd-header">
        <div>
            <div class="opd-title">Expense Records</div>
            <div class="opd-subtitle">Counter &middot; @DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
        </div>
        <button class="opd-btn-primary" @onclick="OpenAddDialog">+ Add Expense</button>
    </div>

    <!-- Date filter bar -->
    <div class="opd-filter-bar" style="flex-direction:row;align-items:center;gap:10px;flex-wrap:wrap;">
        <div style="display:flex;gap:6px;flex-wrap:wrap;">
            <button class="opd-btn" style="padding:6px 14px;font-size:12px;@(_preset=="today"?"background:#2563EB;color:#fff;border-color:#2563EB;":"")" @onclick='() => ApplyPreset("today")'>Today</button>
            <button class="opd-btn" style="padding:6px 14px;font-size:12px;@(_preset=="yesterday"?"background:#2563EB;color:#fff;border-color:#2563EB;":"")" @onclick='() => ApplyPreset("yesterday")'>Yesterday</button>
            <button class="opd-btn" style="padding:6px 14px;font-size:12px;@(_preset=="7d"?"background:#2563EB;color:#fff;border-color:#2563EB;":"")" @onclick='() => ApplyPreset("7d")'>Last 7 Days</button>
            <button class="opd-btn" style="padding:6px 14px;font-size:12px;@(_preset=="30d"?"background:#2563EB;color:#fff;border-color:#2563EB;":"")" @onclick='() => ApplyPreset("30d")'>Last 30 Days</button>
            <button class="opd-btn" style="padding:6px 14px;font-size:12px;@(_preset=="all"?"background:#2563EB;color:#fff;border-color:#2563EB;":"")" @onclick='() => ApplyPreset("all")'>All</button>
        </div>
        <div style="display:flex;align-items:center;gap:6px;">
            <input type="date" class="opd-search-input" style="width:130px;padding:6px 8px;font-size:12px;"
                   @bind="_fromDate" @bind:event="onchange" @oninput="ClearPreset" />
            <span style="font-size:12px;color:#64748B;">–</span>
            <input type="date" class="opd-search-input" style="width:130px;padding:6px 8px;font-size:12px;"
                   @bind="_toDate" @bind:event="onchange" @oninput="ClearPreset" />
            <button class="opd-btn-primary" style="padding:6px 14px;font-size:12px;" @onclick="LoadAsync">Apply</button>
        </div>
    </div>

    @if (_loading)
    {
        <div style="display:flex;justify-content:center;padding:32px 0;">
            <div class="auth-spinner" style="width:32px;height:32px;border-width:3px;"></div>
        </div>
    }
    else
    {
        @if (_items.Any())
        {
            var totalBill    = _items.Sum(i => i.Amount);
            var totalPaid    = _items.Sum(i => i.PaidAmount);
            var totalPending = totalBill - totalPaid;
            <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:16px;">
                <div style="background:#FEF2F2;border:1px solid #FECACA;border-radius:8px;padding:10px 20px;min-width:140px;">
                    <div style="font-size:11px;font-weight:600;color:#991B1B;text-transform:uppercase;letter-spacing:.5px;">Total Bill</div>
                    <div style="font-size:20px;font-weight:700;color:#DC2626;">Rs. @totalBill.ToString("N0")</div>
                </div>
                <div style="background:#F0FDF4;border:1px solid #BBF7D0;border-radius:8px;padding:10px 20px;min-width:140px;">
                    <div style="font-size:11px;font-weight:600;color:#166534;text-transform:uppercase;letter-spacing:.5px;">Paid</div>
                    <div style="font-size:20px;font-weight:700;color:#16A34A;">Rs. @totalPaid.ToString("N0")</div>
                </div>
                @if (totalPending > 0)
                {
                    <div style="background:#FFFBEB;border:1px solid #FDE68A;border-radius:8px;padding:10px 20px;min-width:140px;">
                        <div style="font-size:11px;font-weight:600;color:#92400E;text-transform:uppercase;letter-spacing:.5px;">Pending</div>
                        <div style="font-size:20px;font-weight:700;color:#D97706;">Rs. @totalPending.ToString("N0")</div>
                    </div>
                }
            </div>
        }

        <div class="opd-table-card">
            <table class="opd-table">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Bill Amount</th>
                        <th>Paid</th>
                        <th>Pending</th>
                        <th>Status</th>
                        <th>Notes</th>
                        <th>Recorded At</th>
                        <th style="white-space:nowrap;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_items.Any())
                    {
                        <tr><td colspan="8" class="opd-empty">No expense records found for the selected period.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in _items)
                        {
                            var pending = item.Amount - item.PaidAmount;
                            var isPaid = item.PaidAmount >= item.Amount;
                            var isPartial = item.PaidAmount > 0 && !isPaid;
                            <tr>
                                <td><strong>@item.CategoryName</strong></td>
                                <td style="color:#DC2626;font-weight:600;">Rs. @item.Amount.ToString("N2")</td>
                                <td style="color:#16A34A;font-weight:600;">Rs. @item.PaidAmount.ToString("N2")</td>
                                <td style="color:@(pending > 0 ? "#D97706" : "#94A3B8");font-weight:600;">Rs. @pending.ToString("N2")</td>
                                <td>@StatusBadge(isPaid, isPartial)</td>
                                <td style="color:#64748B;font-size:12px;">@(item.Notes ?? "—")</td>
                                <td style="font-size:12px;color:#475569;">@DateTimeHelper.ToLocalString(item.RecordedAt, "dd MMM HH:mm")</td>
                                <td>
                                    <div class="opd-actions">
                                        @if (!isPaid)
                                        {
                                            <button class="opd-btn edit-btn" @onclick="@(() => OpenPayDialog(item))">Pay</button>
                                        }
                                        @if (_isAdmin)
                                        {
                                            <button class="opd-btn edit-btn" @onclick="@(() => OpenEditDialog(item))">Edit</button>
                                            <button class="opd-btn delete-btn" @onclick="@(() => ConfirmDelete(item.Id))">Delete</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Add Expense Modal -->
@if (_addVisible)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:900;" @onclick="@(() => _addVisible = false)"></div>
    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
                background:#fff;border-radius:14px;width:440px;max-width:96vw;
                box-shadow:0 20px 60px rgba(0,0,0,0.2);z-index:901;overflow:hidden;">
        <div style="padding:20px 24px 16px;border-bottom:1px solid #E2E8F0;">
            <div style="font-size:16px;font-weight:800;color:#0F172A;">Add Expense</div>
        </div>
        <div style="padding:20px 24px;display:flex;flex-direction:column;gap:14px;">
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Category *</label>
                <select class="form-input" style="margin-bottom:0;"
                        value="@_expenseCategoryId"
                        @onchange="OnCategoryChanged">
                    <option value="">— Select category —</option>
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Bill Amount (Rs.) *</label>
                <input class="form-input" type="number" min="0.01" step="0.01" @bind="_amount" />
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Notes</label>
                <textarea class="form-input" rows="2" @bind="_notes" style="resize:vertical;min-height:60px;"></textarea>
            </div>
        </div>
        <div style="padding:14px 24px;border-top:1px solid #E2E8F0;display:flex;justify-content:flex-end;gap:10px;">
            <button @onclick="@(() => _addVisible = false)"
                    style="padding:9px 20px;border-radius:8px;border:1.5px solid #E2E8F0;background:#fff;font-size:13px;font-weight:600;color:#64748B;cursor:pointer;">
                Cancel
            </button>
            <button @onclick="SaveAsync" disabled="@(_saving || _expenseCategoryId is null)"
                    style="padding:9px 20px;border-radius:8px;border:none;background:#1565C0;color:#fff;font-size:13px;font-weight:700;cursor:pointer;
                           opacity:@((_saving || _expenseCategoryId is null) ? "0.6" : "1");">
                @(_saving ? "Saving..." : "Save")
            </button>
        </div>
    </div>
}

<!-- Pay Modal -->
@if (_payVisible && _payingItem is not null)
{
    var remaining = _payingItem.Amount - _payingItem.PaidAmount;
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:900;" @onclick="@(() => _payVisible = false)"></div>
    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
                background:#fff;border-radius:14px;width:440px;max-width:96vw;
                box-shadow:0 20px 60px rgba(0,0,0,0.2);z-index:901;overflow:hidden;">
        <div style="padding:20px 24px 16px;border-bottom:1px solid #E2E8F0;">
            <div style="font-size:16px;font-weight:800;color:#0F172A;">Record Payment — @_payingItem.CategoryName</div>
        </div>
        <div style="padding:20px 24px;display:flex;flex-direction:column;gap:14px;">
            <div style="background:#F8FAFC;border-radius:8px;padding:12px 16px;display:flex;justify-content:space-between;gap:12px;">
                <div>
                    <div style="font-size:11px;color:#64748B;font-weight:600;">TOTAL BILL</div>
                    <div style="font-size:18px;font-weight:700;color:#DC2626;">Rs. @_payingItem.Amount.ToString("N2")</div>
                </div>
                <div>
                    <div style="font-size:11px;color:#64748B;font-weight:600;">ALREADY PAID</div>
                    <div style="font-size:18px;font-weight:700;color:#16A34A;">Rs. @_payingItem.PaidAmount.ToString("N2")</div>
                </div>
                <div>
                    <div style="font-size:11px;color:#64748B;font-weight:600;">REMAINING</div>
                    <div style="font-size:18px;font-weight:700;color:#D97706;">Rs. @remaining.ToString("N2")</div>
                </div>
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Amount Paying Now (Rs.) *</label>
                <input class="form-input" type="number" min="0.01" max="@remaining" step="0.01" @bind="_payAmount" />
            </div>
            <button type="button" @onclick="@(() => _payAmount = remaining)"
                    style="background:none;border:none;color:#2563EB;font-size:12px;font-weight:600;cursor:pointer;text-align:left;padding:0;">
                Pay Full Remaining (Rs. @remaining.ToString("N2"))
            </button>
        </div>
        <div style="padding:14px 24px;border-top:1px solid #E2E8F0;display:flex;justify-content:flex-end;gap:10px;">
            <button @onclick="@(() => _payVisible = false)"
                    style="padding:9px 20px;border-radius:8px;border:1.5px solid #E2E8F0;background:#fff;font-size:13px;font-weight:600;color:#64748B;cursor:pointer;">
                Cancel
            </button>
            <button @onclick="ConfirmPayAsync" disabled="@(_saving || _payAmount <= 0)"
                    style="padding:9px 20px;border-radius:8px;border:none;background:#059669;color:#fff;font-size:13px;font-weight:700;cursor:pointer;
                           opacity:@((_saving || _payAmount <= 0) ? "0.6" : "1");">
                @(_saving ? "Processing..." : "Confirm Payment")
            </button>
        </div>
    </div>
}

<!-- Edit Modal -->
@if (_editVisible && _editingItem is not null)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:900;" @onclick="@(() => _editVisible = false)"></div>
    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
                background:#fff;border-radius:14px;width:440px;max-width:96vw;
                box-shadow:0 20px 60px rgba(0,0,0,0.2);z-index:901;overflow:hidden;">
        <div style="padding:20px 24px 16px;border-bottom:1px solid #E2E8F0;">
            <div style="font-size:16px;font-weight:800;color:#0F172A;">Edit Expense — @_editingItem.CategoryName</div>
        </div>
        <div style="padding:20px 24px;display:flex;flex-direction:column;gap:14px;">
            @if (_editingItem.PaidAmount > 0)
            {
                <div style="background:#FEF9C3;border:1px solid #FDE68A;border-radius:8px;padding:10px 14px;font-size:12px;color:#92400E;">
                    Rs. @_editingItem.PaidAmount.ToString("N2") already paid — new amount cannot be less than this.
                </div>
            }
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Amount (Rs.) *</label>
                <input class="form-input" type="number" min="@_editingItem.PaidAmount" step="0.01" @bind="_editAmount" />
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Notes</label>
                <textarea class="form-input" rows="2" @bind="_editNotes" style="resize:vertical;min-height:60px;"></textarea>
            </div>
        </div>
        <div style="padding:14px 24px;border-top:1px solid #E2E8F0;display:flex;justify-content:flex-end;gap:10px;">
            <button @onclick="@(() => _editVisible = false)"
                    style="padding:9px 20px;border-radius:8px;border:1.5px solid #E2E8F0;background:#fff;font-size:13px;font-weight:600;color:#64748B;cursor:pointer;">
                Cancel
            </button>
            <button @onclick="SaveEditAsync" disabled="@(_saving || _editAmount <= 0)"
                    style="padding:9px 20px;border-radius:8px;border:none;background:#1565C0;color:#fff;font-size:13px;font-weight:700;cursor:pointer;
                           opacity:@((_saving || _editAmount <= 0) ? "0.6" : "1");">
                @(_saving ? "Saving..." : "Save Changes")
            </button>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (_deleteVisible)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:900;" @onclick="@(() => _deleteVisible = false)"></div>
    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
                background:#fff;border-radius:14px;width:380px;max-width:96vw;
                box-shadow:0 20px 60px rgba(0,0,0,0.2);z-index:901;overflow:hidden;">
        <div style="padding:20px 24px 16px;border-bottom:1px solid #E2E8F0;">
            <div style="font-size:16px;font-weight:800;color:#0F172A;">Delete Expense?</div>
        </div>
        <div style="padding:20px 24px;font-size:13px;color:#374151;">
            This expense record will be permanently removed. Are you sure?
        </div>
        <div style="padding:14px 24px;border-top:1px solid #E2E8F0;display:flex;justify-content:flex-end;gap:10px;">
            <button @onclick="@(() => _deleteVisible = false)"
                    style="padding:9px 20px;border-radius:8px;border:1.5px solid #E2E8F0;background:#fff;font-size:13px;font-weight:600;color:#64748B;cursor:pointer;">
                Cancel
            </button>
            <button @onclick="DeleteAsync" disabled="@_saving"
                    style="padding:9px 20px;border-radius:8px;border:none;background:#DC2626;color:#fff;font-size:13px;font-weight:700;cursor:pointer;
                           opacity:@(_saving ? "0.6" : "1");">
                @(_saving ? "Deleting..." : "Delete")
            </button>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _addVisible;
    private bool _payVisible;
    private bool _deleteVisible;
    private bool _saving;
    private bool _isAdmin;
    private List<ExpenseRecordSummaryDto> _items = [];
    private List<ExpenseCategorySummaryDto> _categories = [];
    private Guid? _activeSessionId;
    private string _preset = "today";

    private DateTime? _fromDate = DateTime.Today;
    private DateTime? _toDate = DateTime.Today;

    // Add dialog
    private Guid? _expenseCategoryId;
    private decimal _amount;
    private string? _notes;

    // Pay dialog
    private ExpenseRecordSummaryDto? _payingItem;
    private decimal _payAmount;

    // Edit dialog
    private bool _editVisible;
    private ExpenseRecordSummaryDto? _editingItem;
    private decimal _editAmount;
    private string? _editNotes;

    // Delete dialog
    private Guid _deletingId;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = AuthState.GetRolesForApplication(ClinicContext.SelectedApplicationId)
            .Any(r => string.Equals(r, AppRoles.ClinicAdmin, StringComparison.OrdinalIgnoreCase));

        var catResponse = await ExpenseCategoryClient.GetAllAsync();
        if (catResponse.Success && catResponse.Data is not null)
            _categories = catResponse.Data.Where(c => c.IsActive).ToList();

        var session = await CounterSessionClient.GetActiveAsync();
        _activeSessionId = session.Success && session.Data is not null ? session.Data.Id : null;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var response = await ExpenseRecordClient.GetAllAsync(_fromDate, _toDate);
        _items = response.Success && response.Data is not null ? response.Data.ToList() : [];
        _loading = false;
    }

    private async Task ApplyPreset(string preset)
    {
        _preset = preset;
        var today = DateTime.Today;
        (_fromDate, _toDate) = preset switch
        {
            "today"     => ((DateTime?)today, (DateTime?)today),
            "yesterday" => (today.AddDays(-1), today.AddDays(-1)),
            "7d"        => (today.AddDays(-6), today),
            "30d"       => (today.AddDays(-29), today),
            "all"       => (null, null),
            _           => (_fromDate, _toDate)
        };
        await LoadAsync();
    }

    private void ClearPreset() => _preset = string.Empty;

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id)) _expenseCategoryId = id;
        else _expenseCategoryId = null;
    }

    private void OpenAddDialog()
    {
        _expenseCategoryId = _categories.Count > 0 ? (Guid?)_categories[0].Id : null;
        _amount = 0;
        _notes = null;
        _addVisible = true;
    }

    private async Task SaveAsync()
    {
        if (_expenseCategoryId is null) { Toast.ShowWarning("Select a category."); return; }
        _saving = true;
        var response = await ExpenseRecordClient.CreateAsync(new CreateExpenseRecordRequest
        {
            ExpenseCategoryId = _expenseCategoryId.Value,
            Amount = _amount,
            Notes = _notes,
            CounterSessionId = _activeSessionId
        });
        if (response.Success) { Toast.ShowSuccess("Expense recorded."); _addVisible = false; await LoadAsync(); }
        else Toast.ShowError(response.Message ?? "Failed.");
        _saving = false;
    }

    private void OpenPayDialog(ExpenseRecordSummaryDto item)
    {
        _payingItem = item;
        _payAmount = item.Amount - item.PaidAmount;
        _payVisible = true;
    }

    private async Task ConfirmPayAsync()
    {
        if (_payingItem is null || _payAmount <= 0) return;
        _saving = true;
        var response = await ExpenseRecordClient.PayAsync(_payingItem.Id, new PayExpenseRecordRequest { PayAmount = _payAmount });
        if (response.Success) { Toast.ShowSuccess($"Rs. {_payAmount:N2} payment recorded."); _payVisible = false; await LoadAsync(); }
        else Toast.ShowError(response.Message ?? "Failed.");
        _saving = false;
    }

    private void OpenEditDialog(ExpenseRecordSummaryDto item)
    {
        _editingItem = item;
        _editAmount = item.Amount;
        _editNotes = item.Notes;
        _editVisible = true;
    }

    private async Task SaveEditAsync()
    {
        if (_editingItem is null || _editAmount <= 0) return;
        _saving = true;
        var response = await ExpenseRecordClient.UpdateAsync(_editingItem.Id, new UpdateExpenseRecordRequest
        {
            Amount = _editAmount,
            Notes = _editNotes
        });
        if (response.Success) { Toast.ShowSuccess("Expense updated."); _editVisible = false; await LoadAsync(); }
        else Toast.ShowError(response.Message ?? "Failed.");
        _saving = false;
    }

    private void ConfirmDelete(Guid id) { _deletingId = id; _deleteVisible = true; }

    private async Task DeleteAsync()
    {
        _saving = true;
        var response = await ExpenseRecordClient.DeleteAsync(_deletingId);
        if (response.Success) { Toast.ShowSuccess("Expense deleted."); _deleteVisible = false; await LoadAsync(); }
        else Toast.ShowError(response.Message ?? "Failed.");
        _saving = false;
    }

    private static MarkupString StatusBadge(bool isPaid, bool isPartial)
    {
        if (isPaid)    return new MarkupString("<span style=\"background:#DCFCE7;color:#166534;border-radius:12px;padding:2px 10px;font-size:11px;font-weight:600;\">Paid</span>");
        if (isPartial) return new MarkupString("<span style=\"background:#FEF3C7;color:#92400E;border-radius:12px;padding:2px 10px;font-size:11px;font-weight:600;\">Partial</span>");
        return             new MarkupString("<span style=\"background:#FEE2E2;color:#991B1B;border-radius:12px;padding:2px 10px;font-size:11px;font-weight:600;\">Unpaid</span>");
    }
}
