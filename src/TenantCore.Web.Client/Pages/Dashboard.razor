@page "/dashboard"
@layout AuthorizedLayout
@inject AuthStateService AuthState
@inject ClinicContextService ClinicContext
@inject IClinicApiClient ClinicApi
@inject IPrescriptionApiClient PrescriptionApi
@inject NavigationManager Nav
@using TenantCore.Web.Client.Clients
@using TenantCore.Shared.Enums

<PageTitle>Dashboard - CloudClinic</PageTitle>

@if (_loading)
{
    <div style="display:flex;justify-content:center;align-items:center;padding:60px 0;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (_isDoctor)
{
    <div class="cc-fade-in" style="display:flex;flex-direction:column;gap:20px;">

        <!-- Greeting Row -->
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
            <div>
                <div style="font-size:20px;font-weight:800;color:#1E293B;">
                    Good @_greeting, Dr. @_doctorFirstName 👋
                </div>
                <div style="font-size:13px;color:#64748B;margin-top:3px;">
                    @_totalCount appointments today &nbsp;·&nbsp; @_visitedCount completed &nbsp;·&nbsp; @_pendingCount pending
                </div>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/prescriptions/new"
                       Style="border-radius:8px;font-weight:600;text-transform:none;box-shadow:0 3px 10px rgba(21,101,192,0.3);">
                New Prescription
            </MudButton>
        </div>

        <!-- Stat Cards -->
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" md="3">
                <div class="cc-stat-card" style="background:#EFF6FF;">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;">
                        <div>
                            <div class="cc-stat-label">TODAY'S APPOINTMENTS</div>
                            <div class="cc-stat-value">@_totalCount</div>
                            <div class="cc-stat-sub">All scheduled</div>
                        </div>
                        <div class="cc-stat-icon">📅</div>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="cc-stat-card" style="background:#ECFDF5;">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;">
                        <div>
                            <div class="cc-stat-label">VISITED</div>
                            <div class="cc-stat-value" style="color:#16A34A;">@_visitedCount</div>
                            <div class="cc-stat-sub">Consultations done</div>
                        </div>
                        <div class="cc-stat-icon">✅</div>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="cc-stat-card" style="background:#FFFBEB;">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;">
                        <div>
                            <div class="cc-stat-label">PENDING</div>
                            <div class="cc-stat-value" style="color:#D97706;">@_pendingCount</div>
                            <div class="cc-stat-sub">In queue</div>
                        </div>
                        <div class="cc-stat-icon">⏳</div>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="cc-stat-card" style="background:#FAF5FF;">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;">
                        <div>
                            <div class="cc-stat-label">RX TODAY</div>
                            <div class="cc-stat-value" style="color:#7C3AED;">@_rxCount</div>
                            <div class="cc-stat-sub">Prescriptions written</div>
                        </div>
                        <div class="cc-stat-icon">📋</div>
                    </div>
                </div>
            </MudItem>
        </MudGrid>

        <!-- Two Column: Appointments + Visited -->
        <MudGrid Spacing="3">
            <!-- Today's Appointments -->
            <MudItem xs="12" md="6">
                <div class="cc-card">
                    <div class="cc-card-header">
                        <div class="cc-card-title">📅 Today's Appointments</div>
                        <button class="cc-btn-light" @onclick='() => Nav.NavigateTo("/doctor/opd-queue")'>
                            View all →
                        </button>
                    </div>
                    <div>
                        @if (!_todayOpd.Any())
                        {
                            <div class="cc-empty">No appointments today</div>
                        }
                        else
                        {
                            @foreach (var (opd, idx) in _todayOpd.Take(5).Select((o, i) => (o, i)))
                            {
                                var (badgeColor, badgeBg, badgeLabel) = GetStatusStyle(opd.Status);
                                var isLast = idx == Math.Min(4, _todayOpd.Count - 1);
                                <div style="display:flex;align-items:center;gap:12px;padding:12px 18px;
                                            border-bottom:@(isLast ? "none" : "1px solid #E2E8F0");
                                            background:@(opd.Status == OpdStatus.InProgress ? "#F0F7FF" : "transparent");">
                                    <div style="width:44px;text-align:center;flex-shrink:0;">
                                        <div style="font-size:12px;font-weight:800;color:#1E293B;">
                                            @opd.RegistrationDate.ToString("hh:mm")
                                        </div>
                                        <div style="font-size:10px;color:#94A3B8;">
                                            @opd.RegistrationDate.ToString("tt")
                                        </div>
                                    </div>
                                    <div class="cc-avatar cc-avatar-blue">
                                        @GetInitials(opd.PatientName)
                                    </div>
                                    <div style="flex:1;min-width:0;">
                                        <div style="font-size:13px;font-weight:600;color:#1E293B;
                                                    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                            @opd.PatientName
                                        </div>
                                        <div style="font-size:11px;color:#94A3B8;">
                                            @opd.RegistrationNumber
                                        </div>
                                    </div>
                                    <span class="cc-badge" style="color:@badgeColor;background:@badgeBg;">
                                        @badgeLabel
                                    </span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </MudItem>

            <!-- Today's Visited Patients -->
            <MudItem xs="12" md="6">
                <div class="cc-card">
                    <div class="cc-card-header">
                        <div class="cc-card-title">✅ Today's Visited Patients</div>
                        <button class="cc-btn-light" @onclick='() => Nav.NavigateTo("/doctor/opd-queue")'>
                            View all →
                        </button>
                    </div>
                    <div>
                        @if (!_visitedOpd.Any())
                        {
                            <div class="cc-empty">No visited patients yet</div>
                        }
                        else
                        {
                            @foreach (var (opd, idx) in _visitedOpd.Take(5).Select((o, i) => (o, i)))
                            {
                                var isLast = idx == Math.Min(4, _visitedOpd.Count - 1);
                                <div style="display:flex;align-items:center;gap:12px;padding:12px 18px;
                                            border-bottom:@(isLast ? "none" : "1px solid #E2E8F0");">
                                    <div style="width:44px;text-align:center;flex-shrink:0;">
                                        <div style="font-size:12px;font-weight:800;color:#16A34A;">
                                            @opd.RegistrationDate.ToString("hh:mm")
                                        </div>
                                        <div style="font-size:10px;color:#94A3B8;">
                                            @opd.RegistrationDate.ToString("tt")
                                        </div>
                                    </div>
                                    <div class="cc-avatar cc-avatar-green">
                                        @GetInitials(opd.PatientName)
                                    </div>
                                    <div style="flex:1;min-width:0;">
                                        <div style="font-size:13px;font-weight:600;color:#1E293B;">
                                            @opd.PatientName
                                        </div>
                                        <div style="font-size:11px;color:#94A3B8;">
                                            @opd.RegistrationNumber
                                        </div>
                                    </div>
                                    <span class="cc-badge" style="color:#16A34A;background:#ECFDF5;">✓ Done</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </MudItem>
        </MudGrid>

        <!-- Recent Prescriptions Table -->
        <div class="cc-card">
            <div class="cc-card-header">
                <div class="cc-card-title">📋 Recent Prescriptions</div>
                <button class="cc-btn-light" @onclick='() => Nav.NavigateTo("/prescriptions")'>
                    View all →
                </button>
            </div>
            @if (!_recentRx.Any())
            {
                <div class="cc-empty">No prescriptions written today</div>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table class="cc-table">
                        <thead>
                            <tr>
                                <th>Rx #</th>
                                <th>Patient</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Next Visit</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rx in _recentRx.Take(5))
                            {
                                <tr class="cc-table-row" @onclick="() => NavigateToRx(rx.Id)">
                                    <td>
                                        <span style="font-weight:700;color:#1565C0;font-size:12px;">
                                            @rx.PrescriptionNumber
                                        </span>
                                    </td>
                                    <td>
                                        <div style="font-weight:600;font-size:13px;">@rx.PatientName</div>
                                    </td>
                                    <td>
                                        <span style="font-size:12px;color:#64748B;">
                                            @rx.PrescribedDate.ToString("dd MMM yyyy")
                                        </span>
                                    </td>
                                    <td>
                                        @{
                                            var (rxColor, rxBg) = GetRxStatusStyle(rx.Status);
                                        }
                                        <span class="cc-badge" style="color:@rxColor;background:@rxBg;">
                                            @rx.Status
                                        </span>
                                    </td>
                                    <td>
                                        <span style="font-size:12px;color:#64748B;">
                                            @(rx.NextVisitDate.HasValue ? rx.NextVisitDate.Value.ToString("dd MMM yyyy") : "—")
                                        </span>
                                    </td>
                                    <td>
                                        <button class="cc-btn-light cc-btn-sm"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => NavigateToRx(rx.Id)">
                                            View Rx
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>
}
else
{
    <!-- Generic Dashboard for non-doctor roles -->
    <MudText Typo="Typo.h4" Class="mb-4">Dashboard</MudText>
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">OPD Registrations</MudText>
                        <MudText Typo="Typo.h4">—</MudText>
                    </MudStack>
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.LocalHospital" />
                    </MudAvatar>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">IPD Admissions</MudText>
                        <MudText Typo="Typo.h4">—</MudText>
                    </MudStack>
                    <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.Bed" />
                    </MudAvatar>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Patients</MudText>
                        <MudText Typo="Typo.h4">—</MudText>
                    </MudStack>
                    <MudAvatar Color="Color.Info" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.People" />
                    </MudAvatar>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Today's Revenue</MudText>
                        <MudText Typo="Typo.h4">—</MudText>
                    </MudStack>
                    <MudAvatar Color="Color.Warning" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.CurrencyRupee" />
                    </MudAvatar>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="8">
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-4">Quick Actions</MudText>
                <MudStack Spacing="2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Add" Href="/opd">New OPD Registration</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Add" Href="/ipd">New IPD Admission</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.PersonAdd" Href="/patients">Register Patient</MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private bool _loading = true;
    private bool _isDoctor;
    private string _doctorFirstName = string.Empty;
    private string _greeting = "morning";

    private List<OpdRegistrationDto> _todayOpd = [];
    private List<OpdRegistrationDto> _visitedOpd = [];
    private List<PrescriptionDto> _recentRx = [];

    private int _totalCount;
    private int _visitedCount;
    private int _pendingCount;
    private int _rxCount;

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        await ClinicContext.InitializeAsync();

        _isDoctor = AuthState.CurrentUser?.UserRoles
            .Any(r => r.RoleName.Equals("Doctor", StringComparison.OrdinalIgnoreCase)) ?? false;

        // Doctors must select a clinic first
        if (_isDoctor && ClinicContext.SelectedApplicationId == Guid.Empty)
        {
            Nav.NavigateTo("/doctor/home", forceLoad: true);
            return;
        }

        var fullName = AuthState.CurrentUser?.FullName ?? "Doctor";
        _doctorFirstName = fullName.Split(' ').FirstOrDefault() ?? fullName;
        _greeting = GetGreeting();

        if (_isDoctor)
        {
            var userId = AuthState.CurrentUser?.UserId ?? Guid.Empty;
            await LoadDoctorDashboardAsync(userId);
        }

        _loading = false;
    }

    private async Task LoadDoctorDashboardAsync(Guid userId)
    {
        var opdTask = ClinicApi.GetOpdRegistrationsAsync(
            page: 1, pageSize: 50, doctorUserId: userId, todayOnly: true);

        var today = DateTime.UtcNow.Date;
        var rxTask = PrescriptionApi.GetPrescriptionsAsync(
            page: 1, pageSize: 10, doctorUserId: userId,
            from: today, to: today.AddDays(1).AddSeconds(-1));

        await Task.WhenAll(opdTask, rxTask);

        var opdResult = await opdTask;
        if (opdResult.Success && opdResult.Data != null)
        {
            _todayOpd = opdResult.Data.Items.ToList();
            _visitedOpd = _todayOpd.Where(o => o.Status == OpdStatus.Completed).ToList();
            _totalCount = _todayOpd.Count;
            _visitedCount = _visitedOpd.Count;
            _pendingCount = _todayOpd.Count(o => o.Status is OpdStatus.Pending or OpdStatus.InProgress);
        }

        var rxResult = await rxTask;
        if (rxResult.Success && rxResult.Data != null)
        {
            _recentRx = rxResult.Data.Items.ToList();
            _rxCount = _recentRx.Count;
        }
    }

    private void NavigateToRx(Guid id) => Nav.NavigateTo($"/prescriptions/{id}");

    private static string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        return hour < 12 ? "morning" : hour < 17 ? "afternoon" : "evening";
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}"
            : parts.Length == 1 ? parts[0][0].ToString() : "?";
    }

    private static (string color, string bg, string label) GetStatusStyle(OpdStatus status) => status switch
    {
        OpdStatus.Completed  => ("#16A34A", "#ECFDF5", "Visited"),
        OpdStatus.InProgress => ("#1565C0", "#EFF6FF", "In Progress"),
        OpdStatus.Cancelled  => ("#EF4444", "#FEF2F2", "Cancelled"),
        _                    => ("#D97706", "#FFFBEB", "Waiting"),
    };

    private static (string color, string bg) GetRxStatusStyle(PrescriptionStatus status) => status switch
    {
        PrescriptionStatus.Submitted => ("#16A34A", "#ECFDF5"),
        PrescriptionStatus.Draft     => ("#D97706", "#FFFBEB"),
        _                            => ("#1565C0", "#EFF6FF"),
    };
}
