@page "/doctor/change-password"
@layout DoctorPortalLayout
@inject AuthStateService AuthState
@inject IAuthApiClient AuthClient
@inject ISnackbar Snackbar
@using TenantCore.Web.Client.Clients
@using TenantCore.Shared.Dtos.Auth

<PageTitle>Change Password - CloudClinic</PageTitle>

<div style="max-width:480px;">
    <div style="background:#fff;border-radius:16px;border:1px solid #E2E8F0;overflow:hidden;">
        <div style="padding:20px 24px;border-bottom:1px solid #E2E8F0;">
            <div style="font-size:16px;font-weight:800;color:#1E293B;">Change Password</div>
            <div style="font-size:12px;color:#94A3B8;margin-top:2px;">
                Choose a strong password of at least 8 characters
            </div>
        </div>
        <div style="padding:24px;">
            <EditForm Model="_model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="_model.CurrentPassword"
                              Label="Current Password"
                              Variant="Variant.Outlined"
                              InputType="@(_showCurrent ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showCurrent ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="@(() => _showCurrent = !_showCurrent)"
                              For="@(() => _model.CurrentPassword)"
                              Class="mb-4"
                              Disabled="_loading" />

                <MudTextField @bind-Value="_model.NewPassword"
                              Label="New Password"
                              Variant="Variant.Outlined"
                              InputType="@(_showNew ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showNew ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="@(() => _showNew = !_showNew)"
                              For="@(() => _model.NewPassword)"
                              Class="mb-4"
                              Disabled="_loading"
                              HelperText="Minimum 8 characters" />

                <MudTextField @bind-Value="_model.ConfirmPassword"
                              Label="Confirm New Password"
                              Variant="Variant.Outlined"
                              InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showConfirm ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="@(() => _showConfirm = !_showConfirm)"
                              For="@(() => _model.ConfirmPassword)"
                              Class="mb-4"
                              Disabled="_loading" />

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" Variant="Variant.Filled">
                        @_errorMessage
                    </MudAlert>
                }

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" Disabled="_loading"
                           Style="height:44px;">
                    @if (_loading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Surface" Class="mr-2" />
                        <span>Updating...</span>
                    }
                    else { <span>Update Password</span> }
                </MudButton>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private ChangePasswordRequestDto _model = new();
    private bool _loading;
    private string? _errorMessage;
    private bool _showCurrent;
    private bool _showNew;
    private bool _showConfirm;

    private async Task HandleSubmit()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            var userId = AuthState.CurrentUser?.UserId ?? Guid.Empty;
            var result = await AuthClient.ChangePasswordAsync(userId, _model);
            if (result.Success)
            {
                Snackbar.Add("Password updated successfully.", Severity.Success);
                _model = new ChangePasswordRequestDto();
            }
            else
                _errorMessage = result.Message ?? "Failed to update password.";
        }
        catch { _errorMessage = "An error occurred. Please try again."; }
        finally { _loading = false; }
    }
}
