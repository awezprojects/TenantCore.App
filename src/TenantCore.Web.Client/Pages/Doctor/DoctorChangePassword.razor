@page "/doctor/change-password"
@layout DoctorPortalLayout
@inject AuthStateService AuthState
@inject IAuthApiClient AuthClient
@inject IToastService Toast
@using TenantCore.Web.Client.Clients
@using TenantCore.Shared.Dtos.Auth

<PageTitle>Change Password - CloudClinic</PageTitle>

<div style="max-width:480px;">
    <div style="background:#fff;border-radius:16px;border:1px solid #E2E8F0;overflow:hidden;">
        <div style="padding:20px 24px;border-bottom:1px solid #E2E8F0;">
            <div style="font-size:16px;font-weight:800;color:#1E293B;">Change Password</div>
            <div style="font-size:12px;color:#94A3B8;margin-top:2px;">
                Choose a strong password of at least 8 characters
            </div>
        </div>
        <div style="padding:24px;">
            <EditForm Model="_model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label class="form-label">Current Password</label>
                    <div class="auth-input-with-toggle">
                        <input class="form-input auth-input" style="margin-bottom:0;"
                               type="@(_showCurrent ? "text" : "password")"
                               @bind="_model.CurrentPassword" disabled="@_loading" />
                        <button type="button" class="auth-input-toggle" @onclick="@(() => _showCurrent = !_showCurrent)">
                            @(_showCurrent ? "Hide" : "Show")
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">New Password</label>
                    <div class="auth-input-with-toggle">
                        <input class="form-input auth-input" style="margin-bottom:0;"
                               type="@(_showNew ? "text" : "password")"
                               @bind="_model.NewPassword" disabled="@_loading" />
                        <button type="button" class="auth-input-toggle" @onclick="@(() => _showNew = !_showNew)">
                            @(_showNew ? "Hide" : "Show")
                        </button>
                    </div>
                    <span class="form-helper">Minimum 8 characters</span>
                </div>

                <div class="form-group">
                    <label class="form-label">Confirm New Password</label>
                    <div class="auth-input-with-toggle">
                        <input class="form-input auth-input" style="margin-bottom:0;"
                               type="@(_showConfirm ? "text" : "password")"
                               @bind="_model.ConfirmPassword" disabled="@_loading" />
                        <button type="button" class="auth-input-toggle" @onclick="@(() => _showConfirm = !_showConfirm)">
                            @(_showConfirm ? "Hide" : "Show")
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="auth-error" style="margin-bottom:12px;">@_errorMessage</div>
                }

                <button type="submit" disabled="@_loading"
                        style="display:flex;align-items:center;justify-content:center;gap:8px;
                               width:100%;padding:12px;border-radius:8px;border:none;
                               background:#1565C0;color:#fff;font-size:14px;font-weight:700;cursor:pointer;
                               opacity:@(_loading ? "0.7" : "1");">
                    @if (_loading)
                    {
                        <span class="auth-spinner" style="width:16px;height:16px;border-width:2px;"></span>
                        <span>Updating...</span>
                    }
                    else { <span>Update Password</span> }
                </button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private ChangePasswordRequestDto _model = new();
    private bool _loading;
    private string? _errorMessage;
    private bool _showCurrent;
    private bool _showNew;
    private bool _showConfirm;

    private async Task HandleSubmit()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            var userId = AuthState.CurrentUser?.UserId ?? Guid.Empty;
            var result = await AuthClient.ChangePasswordAsync(userId, _model);
            if (result.Success)
            {
                Toast.ShowSuccess("Password updated successfully.");
                _model = new ChangePasswordRequestDto();
            }
            else
                _errorMessage = result.Message ?? "Failed to update password.";
        }
        catch { _errorMessage = "An error occurred. Please try again."; }
        finally { _loading = false; }
    }
}
