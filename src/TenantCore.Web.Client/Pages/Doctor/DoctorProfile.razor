        "Gynecology & Obstetrics" => "🤰",
        "ENT"                     => "👂",
        "Neurology"               => "🧠",
        "Psychiatry"              => "💭",
        "Pulmonology"             => "🫁",
        "Gastroenterology"        => "🫃",
        "Nephrology"              => "💧",
        "Urology"                 => "🫘",
        "Oncology"                => "🎗️",
        "Endocrinology"           => "🔬",
        "Rheumatology"            => "💪",
        "Anesthesiology"          => "💉",
        "Radiology"               => "📡",
