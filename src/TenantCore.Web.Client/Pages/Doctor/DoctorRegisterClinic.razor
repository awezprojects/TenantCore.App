@page "/doctor/register-clinic"
@layout DoctorPortalLayout
@inject IApplicationApiClient AppClient
@inject AuthStateService AuthState
@inject NavigationManager Nav
@inject IToastService Toast
@using TenantCore.Web.Client.Clients
@using TenantCore.Shared.Dtos.Auth

<PageTitle>Register Your Clinic - CloudClinic</PageTitle>

<div style="max-width:760px;">

    <!-- Info banner -->
    <div style="background:linear-gradient(135deg,#EFF6FF,#DBEAFE);border-radius:14px;
                padding:18px 22px;margin-bottom:24px;border:1px solid #BFDBFE;
                display:flex;align-items:flex-start;gap:14px;">
        <div style="font-size:28px;flex-shrink:0;">🏥</div>
        <div>
            <div style="font-size:15px;font-weight:800;color:#1E293B;margin-bottom:4px;">
                Register Your Own Practice
            </div>
            <div style="font-size:13px;color:#64748B;line-height:1.6;">
                Create your clinic on CloudClinic and gain full control over patients, staff, OPD queues, and
                prescriptions. Each doctor can register up to <strong>1 clinic</strong> per account.
            </div>
        </div>
    </div>

    <div style="background:#fff;border-radius:16px;border:1px solid #E2E8F0;overflow:hidden;">
        <div style="padding:20px 24px;border-bottom:1px solid #E2E8F0;">
            <div style="font-size:16px;font-weight:800;color:#1E293B;">Clinic Details</div>
        </div>
        <div style="padding:24px;">

            <!-- Basic info -->
            <div style="margin-bottom:10px;font-size:12px;font-weight:700;color:#94A3B8;
                        text-transform:uppercase;letter-spacing:0.5px;">Basic Information</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;">
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Clinic Name *</label>
                    <input class="form-input" type="text" @bind="_model.ClinicName" disabled="@_submitting" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Clinic Code *</label>
                    <input class="form-input" type="text" @bind="_model.ClinicCode" disabled="@_submitting"
                           placeholder="e.g. DMC-001" />
                    <div class="form-helper">Unique short code, letters/digits/hyphens only</div>
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Clinic Registration No.</label>
                    <input class="form-input" type="text" @bind="_model.RegistrationNumber" disabled="@_submitting"
                           placeholder="Official license or registration number" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Contact Person</label>
                    <input class="form-input" type="text" @bind="_model.ContactPerson" disabled="@_submitting" />
                </div>
            </div>

            <!-- Contact info -->
            <div style="margin-bottom:10px;font-size:12px;font-weight:700;color:#94A3B8;
                        text-transform:uppercase;letter-spacing:0.5px;">Contact Information</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;">
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Contact Number</label>
                    <input class="form-input" type="tel" @bind="_model.ContactNumber" disabled="@_submitting" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Official Email</label>
                    <input class="form-input" type="email" @bind="_model.OfficialEmail" disabled="@_submitting" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Website</label>
                    <input class="form-input" type="url" @bind="_model.Website" disabled="@_submitting" />
                </div>
            </div>

            <div class="form-group" style="margin-bottom:24px;">
                <label class="form-label">Address</label>
                <textarea class="form-input" rows="2" @bind="_model.Address" disabled="@_submitting"
                          style="resize:vertical;min-height:60px;"></textarea>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="auth-error" style="margin-bottom:16px;">@_error</div>
            }

            <div style="display:flex;gap:12px;justify-content:flex-end;">
                <button style="background:transparent;color:#64748B;border:1.5px solid #E2E8F0;border-radius:8px;
                               padding:10px 20px;font-weight:600;font-size:13px;cursor:pointer;"
                        @onclick='() => Nav.NavigateTo("/select-clinic")' disabled="@_submitting">
                    Cancel
                </button>
                <button @onclick="SubmitAsync" disabled="@_submitting"
                        style="display:inline-flex;align-items:center;justify-content:center;gap:8px;
                               min-width:160px;padding:10px 24px;border-radius:8px;border:none;
                               background:#1565C0;color:#fff;font-size:13px;font-weight:700;cursor:pointer;
                               opacity:@(_submitting ? "0.75" : "1");">
                    @if (_submitting)
                    {
                        <span class="auth-spinner" style="width:14px;height:14px;border-width:2px;"></span>
                        <span>Creating...</span>
                    }
                    else
                    {
                        <span>Register Clinic</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private bool _submitting;
    private string? _error;
    private CreateClinicRequestDto _model = new();

    protected override Task OnInitializedAsync()
    {
        var user = AuthState.CurrentUser;
        if (user == null) return Task.CompletedTask;

        var hasAnyClinic = user.UserApplications?.Any() ?? false;
        var isDoctor = user.UserRoles.Any(r =>
            r.IsActive && r.RoleName.Equals("Doctor", StringComparison.OrdinalIgnoreCase));

        if (hasAnyClinic && !isDoctor)
            Nav.NavigateTo("/select-clinic");

        return Task.CompletedTask;
    }

    private async Task SubmitAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_model.ClinicName) || string.IsNullOrWhiteSpace(_model.ClinicCode))
        {
            _error = "Clinic Name and Clinic Code are required.";
            return;
        }

        _submitting = true;
        try
        {
            var result = await AppClient.CreateClinicAsync(_model);
            if (result.Success)
            {
                Toast.ShowSuccess($"Clinic '{result.Data?.ApplicationName}' registered successfully!");
                StateHasChanged();
                await Task.Delay(1800);
                Nav.NavigateTo("/select-clinic", forceLoad: true);
            }
            else
            {
                _error = result.Message ?? "Failed to register clinic.";
                Toast.ShowError(_error);
            }
        }
        catch (Exception ex)
        {
            _error = $"Error: {ex.Message}";
            Toast.ShowError(_error);
        }
        finally { _submitting = false; }
    }
}
