@code {
    // ── page-level state ─────────────────────────────────────────────────────
    private bool _loading = true;
    private bool _isAdmin;

    // ── wards (shared) ───────────────────────────────────────────────────────
    private List<WardDto> _wards = [];
    private int _totalBeds, _availableBeds, _occupiedBeds, _overallOccupancy;

    // ── doctors (shared) ─────────────────────────────────────────────────────
    private List<DoctorDto> _doctors = [];

    // ── admin view ────────────────────────────────────────────────────────────
    private bool _admissionsLoading;
    private string? _search;
    private int _page = 1;
    private const int PageSize = 20;
    private TenantCore.Shared.Common.PagedResult<IpdRegistrationDto>? _result;

    // admin admit dialog
    private bool _adminAdmitVisible;
    private bool _saving;
    private Guid _selectedPatientId;
    private Guid? _selectedDoctorId;
    private Guid? _selectedWardId;
    private Guid? _selectedRoomId;
    private Guid? _selectedBedId;
    private List<RoomDto> _dialogRooms = [];
    private List<BedDto> _dialogBeds = [];
    private RoomDto? _selectedRoomDto;
    private bool _loadingRooms, _loadingBeds;
    private decimal _initialFee;
    private string? _admissionNotes;

    // admin view/discharge dialogs
    private bool _viewDialogVisible, _dischargeDialogVisible;
    private IpdRegistrationDto? _selected, _discharging;
    private string? _dischargeNotes;

    // ── reception / bed map view ─────────────────────────────────────────────
    private WardDto? _selectedWard;
    private List<RoomDto> _selectedWardRooms = [];
    private List<(BedDto Bed, RoomDto Room)> _flatBeds = [];
    private bool _loadingBedMap;
    private Dictionary<string, IpdRegistrationDto> _admissionsByBed = new();
    private Guid? _selectedRoomFilter;

    // auto-refresh (reception only)
    private CancellationTokenSource? _refreshCts;

    // reception: bed admit dialog (bed pre-selected)
    private bool _bedAdmitVisible;
    private BedDto? _admitToBed;
    private RoomDto? _admitToRoom;
    private List<PatientDto> _bedPatients = [];
    private Guid _bedSelectedPatientId;
    private Guid? _bedSelectedDoctorId;
    private decimal _bedInitialFee;
    private string? _bedAdmissionNotes;

    // reception: occupied bed detail dialog
    private bool _bedDetailVisible;
    private bool _showDischargeFields;
    private BedDto? _bedDetailBed;
    private RoomDto? _bedDetailRoom;
    private IpdRegistrationDto? _bedDetailAdm;

    private int TotalPages => _result is null ? 1 : (int)Math.Ceiling(_result.TotalCount / (double)PageSize);

    private int WardBeds => _selectedWardRooms.Any()
        ? _selectedWardRooms.Sum(r => r.Beds.Count(b => b.IsActive))
        : _selectedWard?.BedCount ?? 0;

    private int WardOccupied => _selectedWardRooms.Any()
        ? _selectedWardRooms.Sum(r => r.Beds.Count(b => b.IsActive && b.IsOccupied))
        : (_selectedWard?.BedCount ?? 0) - (_selectedWard?.AvailableBeds ?? 0);

    private int WardAvailable => WardBeds - WardOccupied;

    private int WardCleaning => _selectedWardRooms.Sum(r => r.Beds.Count(b => !b.IsActive));

    private List<RoomDto> FilteredRooms => _selectedRoomFilter == null
        ? _selectedWardRooms.OrderBy(r => r.RoomNumber).ToList()
        : _selectedWardRooms.Where(r => r.Id == _selectedRoomFilter).ToList();

    // ── lifecycle ────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        var roles = AuthState.CurrentUser?.UserRoles ?? [];
        _isAdmin = roles.Any(r =>
            r.RoleName.Equals("Clinic Admin", StringComparison.OrdinalIgnoreCase) ||
            r.RoleName.Equals("System Admin", StringComparison.OrdinalIgnoreCase));

        var wardsTask   = ClinicClient.GetWardsAsync();
        var doctorsTask = ClinicClient.GetDoctorsAsync();
        await Task.WhenAll(wardsTask, doctorsTask);

        var wr = await wardsTask;
        if (wr.Success && wr.Data != null)
        {
            _wards = wr.Data.ToList();
            _totalBeds       = _wards.Sum(w => w.BedCount);
            _availableBeds   = _wards.Sum(w => w.AvailableBeds);
            _occupiedBeds    = _totalBeds - _availableBeds;
            _overallOccupancy = _totalBeds == 0 ? 0 : (int)(_occupiedBeds * 100.0 / _totalBeds);
        }

        var dr = await doctorsTask;
        if (dr.Success) _doctors = dr.Data?.ToList() ?? [];

        if (_isAdmin)
        {
            await LoadAdmissionsAsync();
        }
        else
        {
            // pre-select the first ward and load its bed map
            if (_wards.Any())
                await SelectWardAsync(_wards[0]);

            // start 10-second live refresh for reception
            _refreshCts = new CancellationTokenSource();
            _ = AutoRefreshBedMapAsync(_refreshCts.Token);
        }

        _loading = false;

        if (Navigation.Uri.EndsWith("/ipd/new", StringComparison.OrdinalIgnoreCase))
        {
            if (_isAdmin) OpenAdminAdmitDialog();
        }
    }

    // ── admin: admissions list ───────────────────────────────────────────────
    private async Task LoadAdmissionsAsync()
    {
        _admissionsLoading = true;
        var r = await ClinicClient.GetIpdRegistrationsAsync(_page, PageSize, _search);
        if (r.Success) _result = r.Data;
        else Toast.ShowError(r.Message ?? "Failed.");
        _admissionsLoading = false;
    }

    private void OnSearchInput(ChangeEventArgs e) => _search = e.Value?.ToString();
    private async Task OnSearchKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") { _page = 1; await LoadAdmissionsAsync(); } }
    private async Task OnPageChanged(int page) { _page = page; await LoadAdmissionsAsync(); }

    // ── admin: admit dialog ──────────────────────────────────────────────────
    private void OnAdminPatientSelected(PatientDto? p) => _selectedPatientId     = p?.Id ?? Guid.Empty;
    private void OnBedPatientSelected(PatientDto? p)   => _bedSelectedPatientId = p?.Id ?? Guid.Empty;

    private void OpenAdminAdmitDialog()
    {
        _selectedPatientId = Guid.Empty;
        _selectedDoctorId  = null; _initialFee = 0; _admissionNotes = null;
        _selectedWardId    = null; _selectedRoomId = null; _selectedBedId = null;
        _selectedRoomDto   = null; _dialogRooms = []; _dialogBeds = [];
        _adminAdmitVisible = true;
    }

    private async Task OnAdminWardSelected(Guid? wardId)
    {
        _selectedWardId  = wardId;
        _selectedRoomId  = null; _selectedBedId = null;
        _selectedRoomDto = null; _dialogRooms   = []; _dialogBeds = [];
        if (wardId == null) return;
        _loadingRooms = true;
        var r = await ClinicClient.GetRoomsByWardAsync(wardId.Value);
        if (r.Success && r.Data != null)
            _dialogRooms = r.Data.Where(x => x.IsActive && x.AvailableBeds > 0).ToList();
        _loadingRooms = false;
    }

    private async Task OnAdminWardChangedAsync(ChangeEventArgs e)
        => await OnAdminWardSelected(Guid.TryParse(e.Value?.ToString(), out var id) ? id : (Guid?)null);

    private async Task OnAdminRoomSelected(Guid? roomId)
    {
        _selectedRoomId  = roomId;
        _selectedBedId   = null; _dialogBeds = [];
        _selectedRoomDto = roomId == null ? null : _dialogRooms.FirstOrDefault(r => r.Id == roomId);
        if (roomId == null || _selectedWardId == null) return;
        _loadingBeds = true;
        var r = await ClinicClient.GetAvailableBedsAsync(_selectedWardId);
        if (r.Success && r.Data != null)
            _dialogBeds = r.Data.Where(b => b.RoomId == roomId).ToList();
        _loadingBeds = false;
    }

    private async Task OnAdminRoomChangedAsync(ChangeEventArgs e)
        => await OnAdminRoomSelected(Guid.TryParse(e.Value?.ToString(), out var id) ? id : (Guid?)null);

    private async Task AdminAdmitAsync()
    {
        if (_selectedPatientId == Guid.Empty)
        { Toast.ShowWarning("Please select a patient."); return; }
        _saving = true;
        var ward   = _selectedWardId.HasValue ? _wards.FirstOrDefault(w => w.Id == _selectedWardId) : null;
        var bed    = _selectedBedId.HasValue  ? _dialogBeds.FirstOrDefault(b => b.Id == _selectedBedId) : null;
        var doctor = _selectedDoctorId.HasValue ? _doctors.FirstOrDefault(d => d.UserId == _selectedDoctorId) : null;
        var dto = new CreateIpdRegistrationDto(
            _selectedPatientId, _selectedDoctorId ?? Guid.Empty, doctor?.FullName ?? string.Empty,
            ward?.Name, _selectedRoomDto?.RoomNumber, bed?.BedNumber, _initialFee, _admissionNotes);
        var r = await ClinicClient.CreateIpdRegistrationAsync(dto);
        if (r.Success)
        {
            Toast.ShowSuccess($"Patient admitted — {r.Data?.AdmissionNumber}");
            _adminAdmitVisible = false;
            await Task.WhenAll(LoadAdmissionsAsync(), RefreshWardsAsync());
        }
        else Toast.ShowError(r.Message ?? "Failed.");
        _saving = false;
    }

    // ── admin: view / discharge ──────────────────────────────────────────────
    private void OpenViewDialog(IpdRegistrationDto reg) { _selected = reg; _viewDialogVisible = true; }

    private void OpenDischargeDialog(IpdRegistrationDto reg)
    { _discharging = reg; _dischargeNotes = null; _dischargeDialogVisible = true; }

    private async Task AdminDischargeAsync()
    {
        if (_discharging is null) return;
        _saving = true;
        var r = await ClinicClient.DischargePatientAsync(_discharging.Id, new DischargePatientDto(_dischargeNotes));
        if (r.Success)
        {
            Toast.ShowSuccess("Patient discharged.");
            _dischargeDialogVisible = false;
            await Task.WhenAll(LoadAdmissionsAsync(), RefreshWardsAsync());
        }
        else Toast.ShowError(r.Message ?? "Failed.");
        _saving = false;
    }

    // ── reception: ward tab selection ────────────────────────────────────────
    private async Task SelectWardAsync(WardDto ward)
    {
        _selectedWard      = ward;
        _selectedWardRooms = [];
        _flatBeds          = [];
        _admissionsByBed   = new();
        _loadingBedMap    = true;
        StateHasChanged();

        var roomsTask = ClinicClient.GetRoomsByWardAsync(ward.Id);
        var admTask   = ClinicClient.GetIpdRegistrationsAsync(1, 200, null);
        await Task.WhenAll(roomsTask, admTask);

        var rr = await roomsTask;
        if (rr.Success && rr.Data != null)
        {
            _selectedWardRooms = rr.Data.ToList();
            _flatBeds = _selectedWardRooms
                .OrderBy(r => r.RoomNumber)
                .SelectMany(r => r.Beds
                    .Where(b => b.IsActive)
                    .OrderBy(b => b.BedNumber)
                    .Select(b => (Bed: b, Room: r)))
                .ToList();
        }
        else
        {
            _flatBeds = [];
        }

        var ar = await admTask;
        if (ar.Success && ar.Data != null)
        {
            _admissionsByBed = ar.Data.Items
                .Where(a => a.Status == IpdStatus.Admitted &&
                            a.WardName?.Equals(ward.Name, StringComparison.OrdinalIgnoreCase) == true)
                .GroupBy(
                    a => $"{a.RoomNumber?.Trim()}|{a.BedNumber?.Trim()}",
                    StringComparer.OrdinalIgnoreCase)
                .ToDictionary(
                    g => g.Key,
                    g => g.OrderByDescending(a => a.AdmissionDate).First(),
                    StringComparer.OrdinalIgnoreCase);
        }

        _loadingBedMap = false;
    }

    // ── reception: bed click handler ─────────────────────────────────────────
    private void OnBedClick(BedDto bed, RoomDto room, IpdRegistrationDto? adm)
    {
        if (bed.IsOccupied)
        {
            _bedDetailBed    = bed;
            _bedDetailRoom   = room;
            _bedDetailAdm    = adm;
            _showDischargeFields = false;
            _dischargeNotes  = null;
            _bedDetailVisible = true;
        }
        else
        {
            OpenBedAdmitDialog(bed, room);
        }
    }

    private void OpenBedAdmitDialog(BedDto bed, RoomDto room)
    {
        _admitToBed           = bed;
        _admitToRoom          = room;
        _bedPatients          = [];
        _bedSelectedPatientId = Guid.Empty;
        _bedSelectedDoctorId  = null;
        _bedInitialFee        = room.PricePerDay;
        _bedAdmissionNotes    = null;
        _bedAdmitVisible      = true;
    }


    private async Task BedAdmitAsync()
    {
        if (_bedSelectedPatientId == Guid.Empty)
        { Toast.ShowWarning("Please select a patient."); return; }
        if (_admitToBed == null || _admitToRoom == null || _selectedWard == null) return;

        _saving = true;
        var doctor = _bedSelectedDoctorId.HasValue
            ? _doctors.FirstOrDefault(d => d.UserId == _bedSelectedDoctorId)
            : null;
        var dto = new CreateIpdRegistrationDto(
            _bedSelectedPatientId,
            _bedSelectedDoctorId ?? Guid.Empty,
            doctor?.FullName ?? string.Empty,
            _selectedWard.Name,
            _admitToRoom.RoomNumber,
            _admitToBed.BedNumber,
            _bedInitialFee,
            _bedAdmissionNotes);

        var r = await ClinicClient.CreateIpdRegistrationAsync(dto);
        if (r.Success)
        {
            Toast.ShowSuccess($"Patient admitted — {r.Data?.AdmissionNumber}");
            _bedAdmitVisible = false;
            await Task.WhenAll(RefreshWardsAsync(), SelectWardAsync(_selectedWard));
        }
        else Toast.ShowError(r.Message ?? "Failed.");
        _saving = false;
    }

    private async Task BedDischargeAsync()
    {
        if (_bedDetailAdm is null) return;
        _saving = true;
        var r = await ClinicClient.DischargePatientAsync(_bedDetailAdm.Id, new DischargePatientDto(_dischargeNotes));
        if (r.Success)
        {
            Toast.ShowSuccess("Patient discharged.");
            _bedDetailVisible = false;
            if (_selectedWard != null)
                await Task.WhenAll(RefreshWardsAsync(), SelectWardAsync(_selectedWard));
        }
        else Toast.ShowError(r.Message ?? "Failed.");
        _saving = false;
    }

    // ── shared helpers ───────────────────────────────────────────────────────
    private async Task RefreshWardsAsync()
    {
        var r = await ClinicClient.GetWardsAsync();
        if (r.Success && r.Data != null)
        {
            _wards           = r.Data.ToList();
            _totalBeds       = _wards.Sum(w => w.BedCount);
            _availableBeds   = _wards.Sum(w => w.AvailableBeds);
            _occupiedBeds    = _totalBeds - _availableBeds;
            _overallOccupancy = _totalBeds == 0 ? 0 : (int)(_occupiedBeds * 100.0 / _totalBeds);
            // keep _selectedWard in sync
            if (_selectedWard != null)
                _selectedWard = _wards.FirstOrDefault(w => w.Id == _selectedWard.Id) ?? _selectedWard;
        }
    }

    private IpdRegistrationDto? GetAdmissionForBed(string roomNumber, string bedNumber)
        => _admissionsByBed.GetValueOrDefault($"{roomNumber.Trim()}|{bedNumber.Trim()}");

    private static string GetShortName(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0]} {parts[1][0]}." : name;
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}"
            : parts.Length == 1 ? parts[0][0].ToString() : "?";
    }

    private static (string color, string bg) GetStatusBadge(IpdStatus status) => status switch
    {
        IpdStatus.Admitted    => ("#1565C0", "#EFF6FF"),
        IpdStatus.Discharged  => ("#16A34A", "#ECFDF5"),
        IpdStatus.Transferred => ("#D97706", "#FFFBEB"),
        IpdStatus.Cancelled   => ("#EF4444", "#FEF2F2"),
        _                     => ("#64748B", "#F1F5F9"),
    };

    // ── auto-refresh (reception only) ────────────────────────────────────────
    private async Task AutoRefreshBedMapAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(30_000, ct);
                if (_selectedWard != null && !ct.IsCancellationRequested)
                {
                    await SelectWardAsync(_selectedWard);
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (TaskCanceledException) { break; }
            catch { /* swallow transient network errors */ }
        }
    }

    public void Dispose()
    {
        _refreshCts?.Cancel();
        _refreshCts?.Dispose();
    }
}
