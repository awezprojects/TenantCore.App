                box-shadow:0 20px 60px rgba(0,0,0,0.2);z-index:901;" @onclick:stopPropagation="true">
        <div style="padding:18px 24px;border-bottom:1px solid #E2E8F0;">
            <div style="font-size:16px;font-weight:700;color:#1E293B;">IPD Details — @_selected?.AdmissionNumber</div>
        </div>
        <div style="padding:20px 24px;">
            @if (_selected is not null)
            {
                <div style="display:flex;flex-direction:column;gap:12px;">
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                        <div><div style="font-size:10px;font-weight:600;color:#94A3B8;margin-bottom:2px;">PATIENT</div>
                             <div style="font-weight:600;color:#1E293B;">@_selected.PatientName</div></div>
                        <div><div style="font-size:10px;font-weight:600;color:#94A3B8;margin-bottom:2px;">DOCTOR</div>
                             <div style="color:#1E293B;">@(_selected.DoctorName ?? "—")</div></div>
                        <div><div style="font-size:10px;font-weight:600;color:#94A3B8;margin-bottom:2px;">WARD</div>
                             <div style="color:#1E293B;">@(_selected.WardName ?? "—")</div></div>
                        <div><div style="font-size:10px;font-weight:600;color:#94A3B8;margin-bottom:2px;">ROOM</div>
                             <div style="color:#1E293B;">@(_selected.RoomNumber ?? "—")</div></div>
                        <div><div style="font-size:10px;font-weight:600;color:#94A3B8;margin-bottom:2px;">BED</div>
                             <div style="color:#1E293B;">@(_selected.BedNumber ?? "—")</div></div>
                        <div><div style="font-size:10px;font-weight:600;color:#94A3B8;margin-bottom:2px;">ADMITTED</div>
                             <div style="color:#1E293B;">@_selected.AdmissionDate.ToString("MMM dd, yyyy")</div></div>
                        <div><div style="font-size:10px;font-weight:600;color:#94A3B8;margin-bottom:2px;">STATUS</div>
                             @{ var (vc,vbg)=GetStatusBadge(_selected.Status); }
                             <span class="cc-badge" style="color:@vc;background:@vbg;">@_selected.Status</span></div>
                        @if (FeatureFlagsContext.IsBillingEnabled)
                        {
                            <div><div style="font-size:10px;font-weight:600;color:#94A3B8;margin-bottom:2px;">INITIAL FEE</div>
                                 <div style="font-weight:600;color:#1E293B;">₹@_selected.InitialFee.ToString("N2")</div></div>
                        }
                    </div>
                    @if (_selected.DischargeDate.HasValue)
                    {
                        <div style="border-top:1px solid #E2E8F0;padding-top:10px;">
                            <div style="font-size:10px;font-weight:600;color:#94A3B8;margin-bottom:2px;">DISCHARGED</div>
                            <div style="color:#1E293B;">@_selected.DischargeDate.Value.ToString("MMM dd, yyyy")</div>
                            @if (!string.IsNullOrEmpty(_selected.DischargeNotes))
                            {
                                <div style="font-size:10px;font-weight:600;color:#94A3B8;margin-top:8px;margin-bottom:2px;">DISCHARGE NOTES</div>
                                <div style="color:#475569;font-size:13px;">@_selected.DischargeNotes</div>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_selected.AdmissionNotes))
                    {
                        <div style="border-top:1px solid #E2E8F0;padding-top:10px;">
                            <div style="font-size:10px;font-weight:600;color:#94A3B8;margin-bottom:2px;">ADMISSION NOTES</div>
                            <div style="color:#475569;font-size:13px;">@_selected.AdmissionNotes</div>
                        </div>
                    }

                    @if (_selected.Status == IpdStatus.Admitted)
                    {
                        <div style="border-top:1px solid #E2E8F0;padding-top:10px;">
                            <button class="cc-btn-light" @onclick="OpenTransferDialog">↔ Shift Bed</button>
                        </div>
                    }

                    @if (FeatureFlagsContext.IsBillingEnabled)
                    {
                        <div style="border-top:1px solid #E2E8F0;padding-top:12px;">
                            <div style="font-size:12px;font-weight:700;color:#1E293B;margin-bottom:8px;">Deposit & Bill</div>

                            @if (_billingLoading)
                            {
                                <div style="font-size:12px;color:#64748B;">Loading billing details…</div>
                            }
                            else if (_selected.Status == IpdStatus.Admitted && _provisionalBill is not null)
                            {
                                <div style="font-size:11px;color:#92400E;background:#FEF3C7;border-radius:6px;padding:6px 10px;margin-bottom:8px;">
                                    Provisional — amount payable if discharged today
                                </div>
                                @if (_provisionalBill.Discount > 0)
                                {
                                    <div style="display:flex;justify-content:space-between;font-size:12px;color:#64748B;margin-bottom:4px;">
                                        <span>Discount applied</span><span>- ₹@_provisionalBill.Discount.ToString("N2")</span>
                                    </div>
                                }
                                @if (_provisionalBill.WriteOffTotal > 0)
                                {
                                    @* DEF-IPD-16: a grace- or manually-adjusted shift day wrote off part of the
                                       standard room charge — show it so the bill isn't a mystery lower number. *@
                                    <div style="display:flex;justify-content:space-between;font-size:12px;color:#16A34A;margin-bottom:4px;">
                                        <span>Shift charge write-off</span><span>- ₹@_provisionalBill.WriteOffTotal.ToString("N2")</span>
                                    </div>
                                }
                                <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:4px;">
                                    <span>Final amount</span><span style="font-weight:700;">₹@_provisionalBill.FinalAmount.ToString("N2")</span>
                                </div>
                                <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:10px;">
                                    <span>@(_provisionalBill.BalanceDue >= 0 ? "Balance" : "Refund due")</span>
                                    <span style="font-weight:700;">₹@Math.Abs(_provisionalBill.BalanceDue).ToString("N2")</span>
                                </div>
                                <button class="cc-btn-light" style="margin-bottom:10px;" @onclick="PrintProvisionalBill">🖨️ Print Provisional Bill</button>

                                <div style="display:flex;gap:6px;margin-bottom:8px;">
                                    <input type="number" min="0" step="0.01" class="cc-input" style="flex:1;" placeholder="Deposit amount"
                                           value="@_depositAmount" @oninput="e => _depositAmount = ParseDecimal(e.Value)" />
                                    <button class="cc-btn-primary" disabled="@(_savingBilling || _depositAmount <= 0)" @onclick="CollectDepositAsync">Collect</button>
                                </div>

                                <div style="display:flex;gap:6px;margin-bottom:8px;">
                                    <input type="number" min="0" step="0.01" class="cc-input" style="flex:1;" placeholder="Discount amount"
                                           value="@_discountAmount" @oninput="e => _discountAmount = ParseDecimal(e.Value)" />
                                    <button class="cc-btn-light" disabled="@_savingBilling" @onclick="ApplyDiscountAsync">Apply discount</button>
                                </div>

                                <div style="display:flex;gap:6px;margin-bottom:10px;">
                                    <select class="cc-input" style="flex:1;" @onchange="OnParticularSelected">
                                        <option value="">Add a service item…</option>
                                        @foreach (var p in _particularCatalog)
                                        {
                                            <option value="@p.Id">@p.Name (₹@p.DefaultAmount.ToString("N0"))</option>
                                        }
                                    </select>
                                    <button class="cc-btn-light" disabled="@(_savingBilling || _selectedParticularId is null)" @onclick="AddParticularAsync">Add</button>
                                </div>

                                @if (_particulars.Count > 0)
                                {
                                    <table style="width:100%;font-size:12px;margin-bottom:6px;">
                                        @foreach (var item in _particulars)
                                        {
                                            <tr>
                                                <td>@item.ParticularName</td>
                                                <td style="text-align:right;">₹@item.Amount.ToString("N2")</td>
                                                <td style="text-align:right;width:30px;">
                                                    <button class="cc-btn-light" style="padding:2px 6px;" @onclick="() => OpenRemoveParticularConfirm(item)">✕</button>
                                                </td>
                                            </tr>
                                        }
                                    </table>
                                }

                                @if (_deposits.Count > 0)
                                {
                                    <div style="font-size:10px;font-weight:600;color:#94A3B8;margin-top:8px;margin-bottom:2px;">DEPOSITS COLLECTED</div>
                                    @foreach (var d in _deposits)
                                    {
                                        <div style="display:flex;justify-content:space-between;font-size:12px;">
                                            <span>@d.CollectedAt.ToLocalTime().ToString("dd MMM, HH:mm")</span>
                                            <span>₹@d.Amount.ToString("N2")</span>
                                        </div>
                                    }
                                }
                            }
                            else if (_selected.Status is IpdStatus.Discharged or IpdStatus.Cancelled && _finalBill is not null)
                            {
                                @* DEF-IPD-22: without this, a cancelled stay's panel showed only
                                   "Final amount ₹0.00" with no explanation — reading as if the bill
                                   just happened to be zero, not that cancelling always waives it. *@
                                @if (_finalBill.WasCancelled)
                                {
                                    <div style="font-size:11px;color:#991B1B;background:#FEF2F2;border-radius:6px;padding:6px 10px;margin-bottom:8px;">
                                        Cancelled — no charge. All fees waived.
                                    </div>
                                }
                                @if (_finalBill.WriteOffTotal > 0)
                                {
                                    <div style="display:flex;justify-content:space-between;font-size:12px;color:#16A34A;margin-bottom:4px;">
                                        <span>Shift charge write-off</span><span>- ₹@_finalBill.WriteOffTotal.ToString("N2")</span>
                                    </div>
                                }
                                <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:4px;">
                                    <span>Final amount</span><span style="font-weight:700;">₹@_finalBill.FinalAmount.ToString("N2")</span>
                                </div>
                                <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:10px;">
                                    <span>@(_finalBill.BalanceDue >= 0 ? "Balance" : "Refund due")</span>
                                    <span style="font-weight:700;">₹@Math.Abs(_finalBill.BalanceDue).ToString("N2")</span>
                                </div>
                                <button class="cc-btn-light" style="margin-bottom:10px;" @onclick="PrintFinalBill">🖨️ Print Final Bill</button>

                                @if (_finalBill.BalanceDue > 0 && _finalBill.PaymentStatus != TenantCore.Shared.Enums.PaymentStatus.Received)
                                {
                                    <button class="cc-btn-primary" disabled="@_savingBilling" @onclick="CollectBalanceAsync">Collect Balance</button>
                                }
                                else if (_finalBill.RefundStatus == TenantCore.Shared.Enums.RefundStatus.PendingRefund)
                                {
                                    <button class="cc-btn-primary" disabled="@_savingBilling" @onclick="ProcessRefundAsync">Confirm Refund Given</button>
                                }
                                else
                                {
                                    <div style="font-size:12px;color:#16A34A;font-weight:700;">Fully settled</div>
                                }
                            }
                        </div>
                    }
                </div>
            }
        </div>
        <div style="padding:14px 24px;border-top:1px solid #E2E8F0;display:flex;justify-content:flex-end;gap:10px;">
            @* DEF-IPD-08: reception's bed click now opens this same dialog instead of the old
               Discharge-only "Bed Details" one — but discharge itself has always lived outside this
               dialog, triggered from the admin admissions table row. Added here too so reception
               (which has no such table) keeps a working discharge path, through the exact same
               confirm-dialog flow the table's own Discharge button already uses. *@
            @if (_selected?.Status == IpdStatus.Admitted)
            {
                @* DEF-IPD-27 (16-Nov): Cancel existed only as an API endpoint — no UI anywhere could
                   trigger it, so DEF-IPD-26's whole cancellation-window setting had nothing to test
                   against in a browser. Same confirm-dialog pattern as Discharge, its sibling action. *@
                <button class="cc-btn-light" style="color:#DC2626;border-color:#DC2626;"
                        @onclick="() => OpenCancelDialog(_selected!)">Cancel Admission</button>
                <button class="cc-btn-light" style="color:#D97706;border-color:#D97706;"
                        @onclick="() => OpenDischargeDialog(_selected!)">Discharge</button>
            }
            <button class="cc-btn-light" @onclick="() => _viewDialogVisible = false">Close</button>
        </div>
    </div>
}

@if (_transferDialogVisible)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:910;" @onclick="() => _transferDialogVisible = false"></div>
    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
                background:#fff;border-radius:14px;width:380px;max-width:94vw;max-height:90vh;overflow-y:auto;
                box-shadow:0 20px 60px rgba(0,0,0,0.2);z-index:911;" @onclick:stopPropagation="true">
        <div style="padding:18px 24px;border-bottom:1px solid #E2E8F0;">
            <div style="font-size:16px;font-weight:700;color:#1E293B;">Shift Bed — @_selected?.AdmissionNumber</div>
        </div>
        <div style="padding:20px 24px;display:flex;flex-direction:column;gap:10px;">
            <select class="cc-input" @onchange="OnTransferWardChangedAsync">
                <option value="">Select ward…</option>
                @foreach (var w in _wards)
                {
                    <option value="@w.Id" selected="@(w.Id == _transferWardId)">@w.Name</option>
                }
            </select>
            <select class="cc-input" @onchange="OnTransferRoomChangedAsync" disabled="@(_transferWardId is null)">
                <option value="">Select room…</option>
                @foreach (var r in _transferRooms)
                {
                    <option value="@r.Id" selected="@(r.Id == _transferRoomId)">@r.RoomNumber (@r.RoomType)</option>
                }
            </select>
            <select class="cc-input" @onchange="OnTransferBedChangedAsync" disabled="@(_transferRoomId is null)">
                <option value="">Select bed…</option>
                @foreach (var b in _transferBeds)
                {
                    <option value="@b.Id" selected="@(b.Id == _transferBedId)">@b.BedNumber</option>
                }
            </select>
            <input class="cc-input" placeholder="Notes (optional)" @bind="_transferNotes" />

            @* DEF-IPD-16: preview the standard charge and any grace-window result before the user
               commits, instead of them finding out only after submitting. *@
            @if (_transferPreviewLoading)
            {
                <div style="font-size:12px;color:#64748B;">Checking the room charge…</div>
            }
            else if (_transferPreview is not null)
            {
                <div style="font-size:12px;background:#F8FAFC;border-radius:8px;padding:8px 10px;color:#334155;">
                    <div>Time spent in current room bills at <strong>₹@_transferPreview.StandardAmount.ToString("N2")</strong> standard.</div>
                    @if (_transferPreview.WithinGraceWindow)
                    {
                        <div style="color:#16A34A;font-weight:600;margin-top:2px;">
                            Within the grace window — suggested charge ₹@_transferPreview.SuggestedAmount.ToString("N2").
                        </div>
                    }
                </div>

                @if (_transferPreview.ManualChargeAllowed)
                {
                    <div style="border-top:1px solid #E2E8F0;padding-top:10px;margin-top:4px;">
                        <div style="font-size:11px;font-weight:700;color:#64748B;margin-bottom:6px;">
                            MANUAL OVERRIDE (optional, max ₹@_transferPreview.MaxManualAmount.ToString("N2"))
                        </div>
                        <input type="number" min="0" max="@_transferPreview.MaxManualAmount" step="0.01" class="cc-input"
                               placeholder="Manual amount" value="@_transferManualAmount"
                               @oninput="e => _transferManualAmount = ParseDecimal(e.Value)" />
                        <input class="cc-input" style="margin-top:6px;" placeholder="Reason (required if entering an amount)"
                               @bind="_transferManualReason" />
                    </div>
                }
            }
        </div>
        <div style="padding:14px 24px;border-top:1px solid #E2E8F0;display:flex;justify-content:flex-end;gap:8px;">
            <button class="cc-btn-light" @onclick="() => _transferDialogVisible = false">Cancel</button>
            <button class="cc-btn-primary" disabled="@(_saving || _transferBedId is null)" @onclick="TransferBedAsync">Shift</button>
        </div>
    </div>
}

