    private async Task AdminAdmitAsync()
    {
        if (_selectedPatientId == Guid.Empty)
        { Toast.ShowWarning("Please select a patient."); return; }
        // DEF-IPD-09: the field was labelled "(optional)" but the server has always required a
        // doctor — saving without one surfaced the server's raw FluentValidation text instead of
        // ever reaching this far. Same friendly-toast pattern as the patient check above.
        if (!_selectedDoctorId.HasValue)
        { Toast.ShowWarning("Please select an attending doctor."); return; }
        _saving = true;
        var bed    = _selectedBedId.HasValue  ? _dialogBeds.FirstOrDefault(b => b.Id == _selectedBedId) : null;
        var doctor = _selectedDoctorId.HasValue ? _doctors.FirstOrDefault(d => d.UserId == _selectedDoctorId) : null;
        var dto = new CreateIpdRegistrationDto(
            _selectedPatientId, _selectedDoctorId ?? Guid.Empty, doctor?.FullName ?? string.Empty,
            bed?.Id, _initialFee, _admissionNotes);
        var r = await ClinicClient.CreateIpdRegistrationAsync(dto);
        if (r.Success)
        {
            Toast.ShowSuccess($"Patient admitted — {r.Data?.AdmissionNumber}");
            _adminAdmitVisible = false;
            await Task.WhenAll(LoadAdmissionsAsync(), RefreshWardsAsync());
            await UsageBillingContext.RefreshAsync(); // OBS-14: the ₹10 admission usage charge just moved the wallet
        }
        else if (r.ErrorCode == UsageBillingErrorCodes.InsufficientWalletBalance)
        {
            // Nothing was admitted and nothing was charged — explain the way out, don't dead-end the user.
            await UsageBillingContext.RefreshAsync();
            _insufficientBalance = true;
        }
        else Toast.ShowError(r.Message ?? "Failed.");
        _saving = false;
    }

    // ── admin: view / discharge ──────────────────────────────────────────────
    private async Task OpenViewDialog(IpdRegistrationDto reg)
    {
        _selected = reg;
        _viewDialogVisible = true;
        _provisionalBill = null;
        _finalBill = null;
        _deposits = [];
        _particulars = [];
        _depositAmount = 0;
        _discountAmount = 0;
        _selectedParticularId = null;
        if (FeatureFlagsContext.IsBillingEnabled)
            await LoadBillingPanelAsync();
    }

    // DEF-IPD-05: this used to be called from an `async void` OpenViewDialog, which Blazor's
    // renderer does not track as a pending render — so the "Loading billing details…" spinner
    // never cleared until some unrelated event forced a re-render. Every caller now awaits a
    // Task, and this explicit StateHasChanged is a backstop regardless of caller.
    private async Task LoadBillingPanelAsync()
    {
        if (_selected is null) return;
        _billingLoading = true;

        if (_selected.Status == IpdStatus.Admitted)
        {
            var billTask = ClinicClient.GetIpdProvisionalBillAsync(_selected.Id);
            var depositsTask = ClinicClient.GetIpdDepositsAsync(_selected.Id);
            var particularsTask = ClinicClient.GetIpdParticularsAsync(_selected.Id);
            var catalogTask = ParticularClient.GetAllAsync();
            await Task.WhenAll(billTask, depositsTask, particularsTask, catalogTask);

            var billResponse = await billTask;
            if (billResponse.Success) _provisionalBill = billResponse.Data;
            var depositsResponse = await depositsTask;
            if (depositsResponse.Success) _deposits = depositsResponse.Data?.ToList() ?? [];
            var particularsResponse = await particularsTask;
            if (particularsResponse.Success) _particulars = particularsResponse.Data?.ToList() ?? [];
            var catalogResponse = await catalogTask;
            if (catalogResponse.Success) _particularCatalog = catalogResponse.Data?.Where(p => p.IsActive).ToList() ?? [];
        }
        else if (_selected.Status is IpdStatus.Discharged or IpdStatus.Cancelled)
        {
            // DEF-IPD-07: a Cancelled admission now also gets a locked Final Bill (finalized at
            // the moment it was cancelled), so Collect Balance / Confirm Refund work here too.
            var r = await ClinicClient.GetIpdFinalBillAsync(_selected.Id);
            if (r.Success) _finalBill = r.Data;
        }

        _billingLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private static decimal ParseDecimal(object? value) => decimal.TryParse(value?.ToString(), out var d) ? d : 0;

