    private async Task TransferBedAsync()
    {
        if (_selected is null || _transferBedId is null) return;
        if (_transferManualAmount.HasValue && string.IsNullOrWhiteSpace(_transferManualReason))
        { Toast.ShowWarning("A reason is required when entering a manual charge amount."); return; }
        _saving = true;
        var r = await ClinicClient.TransferBedAsync(
            _selected.Id, new TransferBedRequest(_transferBedId.Value, _transferNotes, _transferManualAmount, _transferManualReason));
        if (r.Success)
        {
            Toast.ShowSuccess("Bed shifted.");
            _transferDialogVisible = false;
            _selected = r.Data;
            // DEF-IPD-14: the View dialog stays open underneath the Shift dialog — reload its
            // billing panel too, not just the registration pointer, so the Provisional Bill
            // reflects the new room's rate immediately instead of staying stale until reopened.
            await Task.WhenAll(LoadAdmissionsAsync(), RefreshWardsAsync(), LoadBillingPanelAsync());
        }
        else if (r.ErrorCode == "manual_shift_charge_not_allowed")
        {
            Toast.ShowError(r.Message ?? "Manual shift charges are not allowed.");
        }
        else Toast.ShowError(r.Message ?? "Failed to shift bed.");
        _saving = false;
    }

