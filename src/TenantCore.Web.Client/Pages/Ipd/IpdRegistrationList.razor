    private async Task AdminDischargeAsync()
    {
        if (_discharging is null) return;
        _saving = true;
        var dischargingId = _discharging.Id;
        var r = await ClinicClient.DischargePatientAsync(dischargingId, new DischargePatientDto(_dischargeNotes));
        if (r.Success)
        {
            Toast.ShowSuccess("Patient discharged.");
            _dischargeDialogVisible = false;
            await Task.WhenAll(LoadAdmissionsAsync(), RefreshWardsAsync());
            await UsageBillingContext.RefreshAsync(); // the ₹100 discharge usage charge just moved the wallet
            // DEF-IPD-14: Discharge can be triggered from the View dialog's own button (which
            // stays open underneath this confirm dialog) — refresh its bound registration + bill
            // instead of leaving it showing a stale "Admitted" status, which is what made a second
            // discharge attempt look possible from there.
            if (_viewDialogVisible && _selected?.Id == dischargingId)
            {
                _selected = r.Data;
                await LoadBillingPanelAsync();
            }
        }
        else if (r.ErrorCode == UsageBillingErrorCodes.InsufficientWalletBalance)
        {
            // The metered discharge was refused: the patient is still admitted and nothing was charged.
            await UsageBillingContext.RefreshAsync();
            _insufficientBalance = true;
        }
        else Toast.ShowError(r.Message ?? "Failed.");
        _saving = false;
    }

