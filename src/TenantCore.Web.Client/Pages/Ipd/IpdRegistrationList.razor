                <div style="font-size:12px;color:#64748B;margin-top:3px;display:flex;gap:8px;flex-wrap:wrap;">
                    <span style="background:#EFF6FF;color:#1565C0;padding:2px 8px;border-radius:6px;font-weight:600;">@_selectedWard.Name</span>
                    <span style="background:#F1F5F9;color:#475569;padding:2px 8px;border-radius:6px;font-weight:600;">Room @_admitToRoom.RoomNumber</span>
                    <span style="background:#F0FDF4;color:#16A34A;padding:2px 8px;border-radius:6px;font-weight:600;">Bed @_admitToBed.BedNumber</span>
                </div>
            }
        </div>
        <div style="padding:20px 24px;display:flex;flex-direction:column;gap:16px;">
            @if (_admitToRoom != null)
            {
                <div style="padding:10px 14px;background:#F0FDF4;border-radius:10px;
                             font-size:12px;color:#16A34A;font-weight:600;display:flex;gap:20px;">
                    @if (!string.IsNullOrEmpty(_admitToRoom.RoomType))
                    {<span>Room Type: @_admitToRoom.RoomType</span>}
                    <span>₹@_admitToRoom.PricePerDay.ToString("N0") / day</span>
                </div>
            }
            <PatientSearchInput OnPatientSelected="OnBedPatientSelected"
                                Placeholder="Type patient name or phone to search…" />
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Attending Doctor *</label>
                <select class="form-input" @onchange="e => _bedSelectedDoctorId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : (Guid?)null">
                    <option value="">— Select Doctor —</option>
                    @foreach (var d in _doctors)
                    {<option value="@d.UserId">@d.FullName</option>}
                </select>
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Initial Fee (₹)</label>
                <input class="form-input" type="number" min="0" @bind="_bedInitialFee" />
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Admission Notes (optional)</label>
                <textarea class="form-input" rows="2" @bind="_bedAdmissionNotes" style="resize:vertical;min-height:56px;"></textarea>
            </div>
        </div>
        <div style="padding:14px 24px;border-top:1px solid #E2E8F0;display:flex;justify-content:flex-end;gap:10px;">
            <button class="cc-btn-light" @onclick="() => _bedAdmitVisible = false">Cancel</button>
            <button class="cc-btn-primary" @onclick="BedAdmitAsync" disabled="@_saving">
                @(_saving ? "Admitting..." : "Confirm Admission")
            </button>
        </div>
    </div>
}

<!-- ════════════════════════════════════════════════════════
     DIALOG: Reception – Occupied bed detail / discharge
     ════════════════════════════════════════════════════════ -->
@if (_bedDetailVisible)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:900;"
         @onclick="() => _bedDetailVisible = false"></div>
    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
                background:#fff;border-radius:14px;width:460px;max-width:96vw;max-height:90vh;overflow-y:auto;
                box-shadow:0 20px 60px rgba(0,0,0,0.2);z-index:901;" @onclick:stopPropagation="true">
        <div style="padding:18px 24px;border-bottom:1px solid #E2E8F0;">
            <div style="font-size:16px;font-weight:700;color:#1E293B;">Bed Details</div>
        </div>
        <div style="padding:20px 24px;">
        @if (_bedDetailAdm != null && _bedDetailBed != null && _bedDetailRoom != null)
        {
            <div style="display:flex;flex-direction:column;gap:14px;">
                <!-- Bed location badges -->
                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                    <span style="background:#EFF6FF;color:#1565C0;padding:3px 10px;border-radius:8px;font-size:12px;font-weight:700;">
                        @_selectedWard?.Name
                    </span>
                    <span style="background:#F1F5F9;color:#475569;padding:3px 10px;border-radius:8px;font-size:12px;font-weight:700;">
                        Room @_bedDetailRoom.RoomNumber
                    </span>
                    <span style="background:#FEF3C7;color:#D97706;padding:3px 10px;border-radius:8px;font-size:12px;font-weight:700;">
                        Bed @_bedDetailBed.BedNumber
                    </span>
                </div>

                <!-- Patient card -->
                <div style="background:#F8FAFC;border-radius:12px;padding:16px;">
                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                        <div style="width:44px;height:44px;border-radius:12px;background:#EFF6FF;
                                    display:flex;align-items:center;justify-content:center;
                                    font-size:18px;font-weight:800;color:#1565C0;flex-shrink:0;">
                            @GetInitials(_bedDetailAdm.PatientName)
                        </div>
                        <div>
                            <div style="font-size:15px;font-weight:700;color:#1E293B;">@_bedDetailAdm.PatientName</div>
                            <div style="font-size:11px;color:#64748B;">@_bedDetailAdm.AdmissionNumber</div>
                        </div>
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
                        <div>
                            <div style="font-size:10px;font-weight:600;color:#94A3B8;margin-bottom:2px;">DOCTOR</div>
                            <div style="font-size:13px;color:#1E293B;">@(_bedDetailAdm.DoctorName ?? "—")</div>
                        </div>
                        <div>
                            <div style="font-size:10px;font-weight:600;color:#94A3B8;margin-bottom:2px;">ADMITTED</div>
                            <div style="font-size:13px;color:#1E293B;">@_bedDetailAdm.AdmissionDate.ToString("MMM dd, yyyy")</div>
                        </div>
                        <div>
                            <div style="font-size:10px;font-weight:600;color:#94A3B8;margin-bottom:2px;">DAYS IN</div>
                            <div style="font-size:13px;font-weight:700;color:#D97706;">
                                Day @((int)(DateTime.Today - _bedDetailAdm.AdmissionDate.Date).TotalDays + 1)
                            </div>
                        </div>
                        @if (FeatureFlagsContext.IsBillingEnabled)
                        {
                            <div>
                                <div style="font-size:10px;font-weight:600;color:#94A3B8;margin-bottom:2px;">INITIAL FEE</div>
                                <div style="font-size:13px;color:#1E293B;">₹@_bedDetailAdm.InitialFee.ToString("N0")</div>
                            </div>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(_bedDetailAdm.AdmissionNotes))
                    {
                        <div style="margin-top:10px;border-top:1px solid #E2E8F0;padding-top:10px;">
                            <div style="font-size:10px;font-weight:600;color:#94A3B8;margin-bottom:4px;">NOTES</div>
                            <div style="font-size:12px;color:#475569;">@_bedDetailAdm.AdmissionNotes</div>
                        </div>
                    }
                </div>

                <!-- Discharge section -->
                @if (!_showDischargeFields)
                {
                    <button class="cc-btn-light" style="color:#D97706;border-color:#D97706;width:100%;"
                            @onclick="@(() => _showDischargeFields = true)">
                        Discharge Patient
                    </button>
                }
                else
                {
                    <div style="border:1px solid #FDE68A;border-radius:10px;padding:14px;background:#FFFBEB;">
                        <div style="font-size:12px;font-weight:700;color:#D97706;margin-bottom:10px;">
                            Confirm Discharge
                        </div>
                        <textarea class="form-input" rows="2" @bind="_dischargeNotes"
                                  placeholder="Discharge Notes (optional)" style="resize:vertical;min-height:56px;"></textarea>
                        <div style="display:flex;gap:8px;margin-top:10px;">
                            <button class="cc-btn-light" style="flex:1;"
                                    @onclick="@(() => _showDischargeFields = false)">Cancel</button>
                            <button class="cc-btn-light" style="flex:1;color:#D97706;border-color:#D97706;"
                                    @onclick="BedDischargeAsync" disabled="@_saving">
                                @(_saving ? "Discharging..." : "Confirm")
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        </div>
        <div style="padding:14px 24px;border-top:1px solid #E2E8F0;display:flex;justify-content:flex-end;">
            <button class="cc-btn-light" @onclick="() => _bedDetailVisible = false">Close</button>
        </div>
    </div>
}

<!-- ════════════════════════════════════════════════════════
     DIALOG: Admin – View admission detail
     ════════════════════════════════════════════════════════ -->
@if (_viewDialogVisible)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:900;"
         @onclick="() => _viewDialogVisible = false"></div>
    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
