@page "/clinic-requests/new"
@layout DoctorPortalLayout
@inject IOnboardingApiClient OnboardingApi
@inject AuthStateService AuthState
@inject IToastService Toast
@inject NavigationManager Nav
@using TenantCore.Shared.Dtos.Onboarding
@using TenantCore.Shared.Enums

<PageTitle>Request a New Clinic - CloudClinic</PageTitle>

<div style="max-width:760px;">

    @if (_loading)
    {
        <div style="display:flex;justify-content:center;padding:60px 0;">
            <div class="auth-spinner" style="width:40px;height:40px;border-width:3px;"></div>
        </div>
    }
    else if (_blockedByOpenRequest)
    {
        <div style="background:#FEF3C7;border:1px solid #FDE68A;border-radius:14px;padding:20px 24px;
                    display:flex;align-items:flex-start;gap:14px;">
            <div style="font-size:24px;flex-shrink:0;">⏳</div>
            <div>
                <div style="font-size:14px;font-weight:800;color:#92400E;margin-bottom:4px;">
                    You already have an open clinic request
                </div>
                <div style="font-size:13px;color:#78350F;line-height:1.6;margin-bottom:12px;">
                    You can submit a new request only after the current one is completed, rejected, cancelled or the payment link expires.
                </div>
                <button @onclick='@(() => Nav.NavigateTo("/clinic-requests"))'
                        style="padding:8px 16px;background:#92400E;color:#fff;border:none;border-radius:8px;
                               font-size:12px;font-weight:700;cursor:pointer;">
                    View my requests
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- Info banner -->
        <div style="background:linear-gradient(135deg,#EFF6FF,#DBEAFE);border-radius:14px;
                    padding:18px 22px;margin-bottom:24px;border:1px solid #BFDBFE;
                    display:flex;align-items:flex-start;gap:14px;">
            <div style="font-size:28px;flex-shrink:0;">🏥</div>
            <div>
                <div style="font-size:15px;font-weight:800;color:#1E293B;margin-bottom:4px;">
                    Request a New Clinic
                </div>
                <div style="font-size:13px;color:#64748B;line-height:1.6;">
                    Submit your clinic details for review. An internal admin will check the request and either grant a
                    trial or send a payment link to activate your subscription.
                </div>
            </div>
        </div>

        <div style="background:#fff;border-radius:16px;border:1px solid #E2E8F0;overflow:hidden;">
            <div style="padding:20px 24px;border-bottom:1px solid #E2E8F0;">
                <div style="font-size:16px;font-weight:800;color:#1E293B;">Clinic &amp; Doctor Details</div>
            </div>
            <div style="padding:24px;">

                <div style="margin-bottom:10px;font-size:12px;font-weight:700;color:#94A3B8;
                            text-transform:uppercase;letter-spacing:0.5px;">Clinic Information</div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;">
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Clinic Name *</label>
                        <input class="form-input" type="text" maxlength="200" @bind="_model.ClinicName" disabled="@_submitting" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Preferred Clinic Code *</label>
                        <input class="form-input" type="text" maxlength="20" @bind="_model.PreferredClinicCode" disabled="@_submitting"
                               placeholder="e.g. DMC-001" />
                        <div class="form-helper">3-20 chars, letters/digits/hyphens only</div>
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Clinic Contact Number</label>
                        <input class="form-input" type="text" maxlength="20" @bind="_model.ClinicContactNumber" disabled="@_submitting" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Official Email</label>
                        <input class="form-input" type="email" maxlength="256" @bind="_model.OfficialEmail" disabled="@_submitting" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Website</label>
                        <input class="form-input" type="text" maxlength="256" @bind="_model.Website" disabled="@_submitting" />
                    </div>
                </div>

                <div style="margin-bottom:10px;font-size:12px;font-weight:700;color:#94A3B8;
                            text-transform:uppercase;letter-spacing:0.5px;">Address</div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;">
                    <div class="form-group" style="margin-bottom:0;grid-column:1 / -1;">
                        <label class="form-label">Address *</label>
                        <input class="form-input" type="text" maxlength="500" @bind="_model.Address" disabled="@_submitting" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">City *</label>
                        <input class="form-input" type="text" maxlength="100" @bind="_model.City" disabled="@_submitting" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">State *</label>
                        <input class="form-input" type="text" maxlength="100" @bind="_model.State" disabled="@_submitting" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Pincode *</label>
                        <input class="form-input" type="text" maxlength="6" @bind="_model.Pincode" disabled="@_submitting" />
                        <div class="form-helper">Exactly 6 digits</div>
                    </div>
                </div>

                <div style="margin-bottom:10px;font-size:12px;font-weight:700;color:#94A3B8;
                            text-transform:uppercase;letter-spacing:0.5px;">Doctor Information</div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;">
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Doctor Name *</label>
                        <input class="form-input" type="text" maxlength="150" @bind="_model.DoctorName" disabled="@_submitting" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Your Phone *</label>
                        <input class="form-input" type="text" maxlength="20" @bind="_model.RequesterPhone" disabled="@_submitting" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Medical Registration No. *</label>
                        <input class="form-input" type="text" maxlength="50" @bind="_model.MedicalRegistrationNumber" disabled="@_submitting" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Medical Council *</label>
                        <input class="form-input" type="text" maxlength="150" @bind="_model.MedicalCouncil" disabled="@_submitting" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Expected Staff Count *</label>
                        <input class="form-input" type="number" min="1" max="500" step="1" @bind="_model.ExpectedStaffCount" disabled="@_submitting" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Referral Source</label>
                        <input class="form-input" type="text" maxlength="100" @bind="_model.ReferralSource" disabled="@_submitting" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Notes</label>
                    <textarea class="form-input" rows="3" maxlength="1000" @bind="_model.Notes" disabled="@_submitting" style="resize:none;"></textarea>
                </div>

                @if (_errors.Count > 0)
                {
                    <div style="background:#FEE2E2;border:1px solid #FCA5A5;border-radius:8px;padding:10px 14px;
                                font-size:12px;color:#991B1B;font-weight:600;margin-bottom:14px;">
                        @if (_errors.Count == 1)
                        {
                            @_errors[0]
                        }
                        else
                        {
                            <ul style="margin:0;padding-left:18px;">
                                @foreach (var err in _errors)
                                {
                                    <li style="margin-bottom:2px;">@err</li>
                                }
                            </ul>
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div style="background:#FEE2E2;border:1px solid #FCA5A5;border-radius:8px;padding:10px 14px;
                                font-size:12px;color:#991B1B;font-weight:600;margin-bottom:14px;">
                        @_error
                    </div>
                }

                <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:10px;">
                    <button @onclick='@(() => Nav.NavigateTo("/select-clinic"))' disabled="@_submitting"
                            style="padding:10px 20px;background:transparent;color:#64748B;border:1.5px solid #E2E8F0;
                                   border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;">
                        Cancel
                    </button>
                    <button @onclick="SubmitAsync" disabled="@_submitting"
                            style="padding:10px 24px;background:#1565C0;color:#fff;border:none;border-radius:8px;
                                   font-size:13px;font-weight:700;cursor:pointer;opacity:@(_submitting ? "0.7" : "1");">
                        @(_submitting ? "Submitting..." : "Submit Request")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private bool _blockedByOpenRequest;
    private bool _submitting;
    private string? _error;
    private List<string> _errors = [];
    private readonly FormModel _model = new();

    // SubmitClinicOnboardingRequest is an immutable record (init-only) — a mutable shadow model
    // is what @bind targets, and the record is built from it at submit time.
    private sealed class FormModel
    {
        public string ClinicName { get; set; } = string.Empty;
        public string PreferredClinicCode { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public string State { get; set; } = string.Empty;
        public string Pincode { get; set; } = string.Empty;
        public string? ClinicContactNumber { get; set; }
        public string? OfficialEmail { get; set; }
        public string? Website { get; set; }
        public string RequesterPhone { get; set; } = string.Empty;
        public string DoctorName { get; set; } = string.Empty;
        public string MedicalRegistrationNumber { get; set; } = string.Empty;
        public string MedicalCouncil { get; set; } = string.Empty;
        // String-backed (not int): a bound int input silently coerces "2.5" to the previous valid
        // value before validation ever runs, so the whole-number check below could never fire for
        // the real decimal-entry repro. Keeping the raw text lets Validate() see exactly what the
        // user typed (DEF-CR-04).
        public string ExpectedStaffCount { get; set; } = "1";
        public string? ReferralSource { get; set; }
        public string? Notes { get; set; }
    }

    private static readonly ClinicOnboardingStatus[] OpenStatuses =
    [
        ClinicOnboardingStatus.Submitted, ClinicOnboardingStatus.Approved, ClinicOnboardingStatus.AwaitingPayment,
        ClinicOnboardingStatus.PaymentReceived, ClinicOnboardingStatus.Provisioning
    ];

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/auth/login", forceLoad: true);
            return;
        }

        var mine = await OnboardingApi.GetMineAsync();
        if (mine.Success && mine.Data is not null)
            _blockedByOpenRequest = mine.Data.Any(r => OpenStatuses.Contains(r.Status));

        var user = AuthState.CurrentUser;
        if (user is not null)
        {
            _model.DoctorName = user.FullName;
            _model.RequesterPhone = user.MobileNo ?? string.Empty;
        }

        _loading = false;
    }

    private async Task SubmitAsync()
    {
        _errors = Validate();
        _error = null;
        if (_errors.Count > 0) return;

        var request = new SubmitClinicOnboardingRequest
        {
            ClinicName = _model.ClinicName.Trim(),
            PreferredClinicCode = _model.PreferredClinicCode.Trim().ToUpperInvariant(),
            Address = _model.Address.Trim(),
            City = _model.City.Trim(),
            State = _model.State.Trim(),
            Pincode = _model.Pincode.Trim(),
            ClinicContactNumber = _model.ClinicContactNumber?.Trim(),
            OfficialEmail = _model.OfficialEmail?.Trim(),
            Website = _model.Website?.Trim(),
            RequesterPhone = _model.RequesterPhone.Trim(),
            DoctorName = _model.DoctorName.Trim(),
            MedicalRegistrationNumber = _model.MedicalRegistrationNumber.Trim(),
            MedicalCouncil = _model.MedicalCouncil.Trim(),
            ExpectedStaffCount = int.Parse(_model.ExpectedStaffCount.Trim()),
            ReferralSource = _model.ReferralSource?.Trim(),
            Notes = _model.Notes?.Trim()
        };

        _submitting = true;
        var response = await OnboardingApi.SubmitAsync(request);
        _submitting = false;

        if (response.Success)
        {
            Toast.ShowSuccess("Your clinic request has been submitted for review.");
            Nav.NavigateTo("/clinic-requests");
        }
        else
        {
            _error = response.Message ?? "Could not submit the request. Please try again.";
        }
    }

    private static readonly System.Text.RegularExpressions.Regex PhoneRegex = new(@"^[0-9+\-\s]+$");
    private static readonly System.Text.RegularExpressions.Regex ClinicCodeRegex = new("^[A-Za-z0-9-]+$");
    private static readonly System.Text.RegularExpressions.Regex PincodeRegex = new("^[0-9]{6}$");

    private List<string> Validate()
    {
        var errors = new List<string>();

        if (string.IsNullOrWhiteSpace(_model.ClinicName))
            errors.Add("Clinic name is required.");
        else if (_model.ClinicName.Contains('<') || _model.ClinicName.Contains('>'))
            errors.Add("Clinic name must not contain '<' or '>' characters.");

        var code = _model.PreferredClinicCode?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(code))
            errors.Add("Clinic code is required.");
        else if (code.Length < 3 || !ClinicCodeRegex.IsMatch(code))
            errors.Add("Clinic code must be 3-20 letters, digits or hyphens.");

        if (string.IsNullOrWhiteSpace(_model.Address))
            errors.Add("Address is required.");
        if (string.IsNullOrWhiteSpace(_model.City))
            errors.Add("City is required.");
        if (string.IsNullOrWhiteSpace(_model.State))
            errors.Add("State is required.");
        if (!PincodeRegex.IsMatch(_model.Pincode?.Trim() ?? ""))
            errors.Add("Pincode must be exactly 6 digits.");

        if (string.IsNullOrWhiteSpace(_model.RequesterPhone))
            errors.Add("Phone number is required.");
        else if (!PhoneRegex.IsMatch(_model.RequesterPhone))
            errors.Add("Phone number contains invalid characters.");
        else if (_model.RequesterPhone.Trim().Length < 10)
            errors.Add("Enter a valid phone number (at least 10 digits).");

        if (!string.IsNullOrWhiteSpace(_model.ClinicContactNumber))
        {
            if (!PhoneRegex.IsMatch(_model.ClinicContactNumber))
                errors.Add("Contact number contains invalid characters.");
            else if (_model.ClinicContactNumber.Trim().Length < 10)
                errors.Add("Enter a valid contact number (at least 10 digits).");
        }

        if (!string.IsNullOrWhiteSpace(_model.OfficialEmail) &&
            !_model.OfficialEmail.Contains('@'))
            errors.Add("Official email is not a valid email address.");

        if (!string.IsNullOrWhiteSpace(_model.Website) &&
            !(Uri.TryCreate(_model.Website.Trim(), UriKind.Absolute, out var uri) &&
              (uri.Scheme == "http" || uri.Scheme == "https")))
            errors.Add("Website must be a valid URL (e.g. https://example.com).");

        if (string.IsNullOrWhiteSpace(_model.DoctorName))
            errors.Add("Doctor name is required.");
        if (string.IsNullOrWhiteSpace(_model.MedicalRegistrationNumber))
            errors.Add("Medical registration number is required.");
        if (string.IsNullOrWhiteSpace(_model.MedicalCouncil))
            errors.Add("Medical council is required.");
        var staffCountText = _model.ExpectedStaffCount.Trim();
        if (string.IsNullOrWhiteSpace(staffCountText))
            errors.Add("Expected staff count is required.");
        else if (!int.TryParse(staffCountText, out var staffCount))
            errors.Add(double.TryParse(staffCountText, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out _)
                ? "Staff count must be a whole number."
                : "Staff count must be a valid number.");
        else if (staffCount is < 1 or > 500)
            errors.Add("Staff count must be between 1 and 500.");

        return errors;
    }
}
