@page "/opd"
@page "/opd/new"
@layout AuthorizedLayout
@inject IClinicApiClient ClinicClient
@inject IPrescriptionApiClient PrescriptionClient
@inject IOpdParticularApiClient OpdParticularClient
@inject IOpdPaymentApiClient OpdPaymentClient
@inject IDoctorFeeConfigApiClient DoctorFeeConfigClient
@inject ICounterSessionApiClient CounterSessionClient
@inject AuthStateService AuthState
@inject ClinicContextService ClinicContext
@inject IToastService Toast
@inject NavigationManager Navigation
@using TenantCore.Shared.Enums
@using TenantCore.Web.Client.Services

<PageTitle>OPD Management - CloudClinic</PageTitle>

<div class="opd-page">

    <!-- Header -->
    <div class="opd-header">
        <div>
            <div class="opd-title">OPD Management</div>
            <div class="opd-subtitle">Outpatient Department &middot; @DateTime.Now.ToString("dddd, dd MMMM yyyy · hh:mm tt")</div>
        </div>
        @if (!_isDoctor)
        {
            <button class="opd-btn-primary" @onclick="OpenNewDialog">+ New OPD Entry</button>
        }
    </div>

    <!-- Stats Strip (counts from current date-range query, no status filter) -->
    <div class="opd-stats">
        <div class="opd-stat-card">
            <div class="opd-stat-label">Total</div>
            <div class="opd-stat-icon">📋</div>
            <div class="opd-stat-value">@_totalCount</div>
        </div>
        <div class="opd-stat-card waiting">
            <div class="opd-stat-label">Waiting</div>
            <div class="opd-stat-icon">⏳</div>
            <div class="opd-stat-value">@_waitingCount</div>
        </div>
        <div class="opd-stat-card progress">
            <div class="opd-stat-label">In Progress</div>
            <div class="opd-stat-icon">🩺</div>
            <div class="opd-stat-value">@_inProgressCount</div>
        </div>
        <div class="opd-stat-card done">
            <div class="opd-stat-label">Completed</div>
            <div class="opd-stat-icon">✅</div>
            <div class="opd-stat-value">@_completedCount</div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="opd-filter-bar" style="flex-direction:column;align-items:stretch;gap:12px;">

        <!-- Row 1: Date presets + search + refresh -->
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
            <div class="opd-filter-tabs">
                @foreach (var preset in _datePresets)
                {
                    <button class="opd-tab @(_activePreset == preset.Key ? "active" : "")"
                            @onclick="() => ApplyPreset(preset.Key)">
                        @preset.Label
                    </button>
                }
                <button class="opd-tab @(_activePreset == "custom" ? "active" : "")"
                        @onclick='() => _activePreset = "custom"'>
                    Custom
                </button>
            </div>

            <div class="opd-search-wrap" style="flex:1;min-width:180px;">
                <span class="opd-search-icon">🔍</span>
                <input class="opd-search-input"
                       type="text"
                       placeholder="Search by name, token, doctor..."
                       @bind="_search"
                       @bind:event="oninput"
                       @onkeyup="OnSearchKeyUp" />
            </div>

            @if (!_isDoctor && _doctors.Count > 0)
            {
                <select class="opd-search-input" style="min-width:160px;max-width:220px;cursor:pointer;"
                        @onchange="OnDoctorFilterChanged">
                    <option value="">All Doctors</option>
                    @foreach (var doc in _doctors)
                    {
                        <option value="@doc.UserId">Dr. @doc.FullName</option>
                    }
                </select>
            }

            <button class="opd-btn start" style="white-space:nowrap;padding:8px 14px;" @onclick="ReloadAll">↻ Refresh</button>
        </div>

        <!-- Row 2: Custom date range -->
        @if (_activePreset == "custom")
        {
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                <span style="font-size:12px;color:#64748B;font-weight:600;">From</span>
                <input type="date" class="opd-search-input" style="width:150px;padding:7px 10px;"
                       @bind="_customFrom" @bind:event="onchange" />
                <span style="font-size:12px;color:#64748B;font-weight:600;">To</span>
                <input type="date" class="opd-search-input" style="width:150px;padding:7px 10px;"
                       @bind="_customTo" @bind:event="onchange" />
                <button class="opd-btn-primary" style="padding:7px 16px;font-size:12px;" @onclick="ReloadAll">Apply</button>
            </div>
        }

        <!-- Row 3: Status tabs -->
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
            <div class="opd-filter-tabs">
                <button class="opd-tab @(_statusFilter == "all"        ? "active" : "")" @onclick='() => ApplyStatus("all")'>
                    All (@_totalCount)
                </button>
                <button class="opd-tab @(_statusFilter == "waiting"    ? "active" : "")" @onclick='() => ApplyStatus("waiting")'>
                    Waiting (@_waitingCount)
                </button>
                <button class="opd-tab @(_statusFilter == "progress"   ? "active" : "")" @onclick='() => ApplyStatus("progress")'>
                    In Progress (@_inProgressCount)
                </button>
                <button class="opd-tab @(_statusFilter == "done"       ? "active" : "")" @onclick='() => ApplyStatus("done")'>
                    Completed (@_completedCount)
                </button>
                <button class="opd-tab @(_statusFilter == "notvisited" ? "active" : "")" @onclick='() => ApplyStatus("notvisited")'>
                    Not Visited (@_notVisitedCount)
                </button>
            </div>
        </div>
    </div>

    <!-- Table -->
    @if (_loading)
    {
        <div style="height:4px;background:linear-gradient(90deg,#1565C0 0%,#42A5F5 50%,#1565C0 100%);
                    background-size:200% 100%;animation:opdload 1.2s ease infinite;border-radius:2px;margin-bottom:8px;"></div>
        <style>@@keyframes opdload{0%{background-position:200% 0}100%{background-position:-200% 0}}</style>
    }
    else
    {
        <div class="opd-table-card">
            <table class="opd-table">
                <thead>
                    <tr>
                        <th>Token</th>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Date / Time</th>
                        @if (_isDoctor)
                        {
                            <th>Vitals</th>
                        }
                        else
                        {
                            <th>Reason / Notes</th>
                        }
                        <th>Fee</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!(_result?.Items.Any() ?? false))
                    {
                        <tr><td colspan="8" class="opd-empty">No OPD registrations found.</td></tr>
                    }
                    else
                    {
                        @foreach (var reg in _result!.Items)
                        {
                            var notVisited = IsNotVisited(reg);
                            <tr>
                                <td><span class="opd-token">@reg.RegistrationNumber</span></td>
                                <td>
                                    <div class="opd-patient-name">@reg.PatientName</div>
                                    <div class="opd-patient-meta">@reg.RegistrationDate.ToString("dd MMM yyyy")</div>
                                </td>
                                <td>
                                    <div class="opd-doctor-name">@(string.IsNullOrWhiteSpace(reg.DoctorName) ? "—" : reg.DoctorName)</div>
                                </td>
                                <td style="font-size:12px;color:#475569;">
                                    <div style="font-weight:600;">@reg.RegistrationDate.ToString("dd MMM yyyy")</div>
                                    <div>@reg.RegistrationDate.ToString("hh:mm tt")</div>
                                </td>
                                @if (_isDoctor)
                                {
                                    <td>
                                        <div style="font-size:12px;color:#475569;line-height:1.6;">
                                            @if (reg.Weight.HasValue)      { <div>Wt: @reg.Weight.Value.ToString("F1") kg</div> }
                                            @if (!string.IsNullOrWhiteSpace(reg.BloodPressure)) { <div>BP: @reg.BloodPressure</div> }
                                            @if (reg.PulseRate.HasValue)   { <div>Pulse: @reg.PulseRate bpm</div> }
                                            @if (!reg.Weight.HasValue && string.IsNullOrWhiteSpace(reg.BloodPressure) && !reg.PulseRate.HasValue)
                                                { <span style="color:#94A3B8;">—</span> }
                                        </div>
                                    </td>
                                }
                                else
                                {
                                    <td style="font-size:12px;color:#64748B;max-width:150px;">
                                        @(string.IsNullOrWhiteSpace(reg.Notes) ? "—" : reg.Notes)
                                    </td>
                                }
                                <td style="font-weight:700;color:#059669;">₹@reg.Fee.ToString("N0")</td>
                                <td>
                                    @if (notVisited)
                                    {
                                        <span class="opd-badge notvisited">Not Visited</span>
                                    }
                                    else
                                    {
                                        <span class="opd-badge @GetBadgeClass(reg.Status)">@GetStatusLabel(reg.Status)</span>
                                    }
                                </td>
                                <td>
                                    <div class="opd-actions">
                                        @if (_isDoctor)
                                        {
                                            @if (reg.Status == OpdStatus.Pending && !notVisited)
                                            {
                                                <button class="opd-btn start" @onclick="() => StartAsync(reg)" disabled="@_updating">Start</button>
                                            }
                                            @if (reg.Status == OpdStatus.InProgress)
                                            {
                                                <button class="opd-btn rx" @onclick="() => OpenPrescription(reg)">Rx</button>
                                                <button class="opd-btn done-btn" @onclick="() => MarkDoneAsync(reg)" disabled="@_updating">Done</button>
                                            }
                                        }
                                        else
                                        {
                                            <button class="opd-btn rx" @onclick="() => OpenParticularsPopup(reg)">Items</button>
                                            @if (reg.Status == OpdStatus.Completed)
                                            {
                                                @if (reg.PaymentStatus == PaymentStatus.Received)
                                                {
                                                    <span class="opd-badge done" style="font-size:11px;padding:3px 8px;">Paid ✓</span>
                                                }
                                                else
                                                {
                                                    @if (reg.HasDiscount)
                                                    {
                                                        <button class="opd-btn done-btn" @onclick="() => CollectFeeAsync(reg)" disabled="@_updating">
                                                            Collect Full ₹@((reg.FinalAmount ?? reg.Fee).ToString("N0"))
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="opd-btn done-btn" @onclick="() => CollectFeeAsync(reg)" disabled="@_updating">
                                                            Collect ₹@reg.Fee.ToString("N0")
                                                        </button>
                                                    }
                                                }
                                            }
                                            @if (reg.Status != OpdStatus.Cancelled && reg.Status != OpdStatus.Completed)
                                            {
                                                <button class="opd-btn cancelled" @onclick="() => CancelAsync(reg)" disabled="@_updating">Cancel</button>
                                            }
                                            @if (reg.Status == OpdStatus.Cancelled && NeedsRefund(reg))
                                            {
                                                <button class="opd-btn done-btn" @onclick="() => OpenDiscountDialog(reg)">Refund</button>
                                            }
                                            @if (reg.Status == OpdStatus.Cancelled && CanDelete(reg))
                                            {
                                                <button class="opd-btn delete-btn" @onclick="() => ConfirmDeleteOpd(reg)" disabled="@_updating">Delete</button>
                                            }
                                        }
                                        @if (_isDoctor)
                                        {
                                            <button class="opd-btn rx" @onclick="() => OpenDiscountDialog(reg)">Disc</button>
                                        }
                                        <button class="opd-btn more" @onclick="() => OpenViewModal(reg)">···</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination footer -->
        <div class="opd-pagination" style="align-items:center;gap:16px;flex-wrap:wrap;">
            <span style="white-space:nowrap;">
                Showing @((_page - 1) * _pageSize + 1)–@(Math.Min(_page * _pageSize, _result?.TotalCount ?? 0))
                of @(_result?.TotalCount ?? 0) records &mdash; @_dateRangeLabel
            </span>

            <div style="flex:1;display:flex;justify-content:center;align-items:center;gap:4px;">
                <button @onclick="() => OnPageChanged(_page - 1)" disabled="@(_page <= 1)"
                        style="width:32px;height:32px;border:1.5px solid #E2E8F0;border-radius:7px;
                               background:#fff;cursor:pointer;font-size:14px;font-weight:700;color:#64748B;
                               opacity:@(_page <= 1 ? "0.4" : "1");">‹</button>
                @for (int pg = Math.Max(1, _page - 2); pg <= Math.Min(TotalPages, _page + 2); pg++)
                {
                    var p = pg;
                    <button @onclick="() => OnPageChanged(p)"
                            style="min-width:32px;height:32px;border:1.5px solid @(p == _page ? "#1565C0" : "#E2E8F0");
                                   border-radius:7px;background:@(p == _page ? "#1565C0" : "#fff");cursor:pointer;
                                   font-size:12px;font-weight:@(p == _page ? "700" : "500");
                                   color:@(p == _page ? "#fff" : "#64748B");padding:0 6px;">@p</button>
                }
                <button @onclick="() => OnPageChanged(_page + 1)" disabled="@(_page >= TotalPages)"
                        style="width:32px;height:32px;border:1.5px solid #E2E8F0;border-radius:7px;
                               background:#fff;cursor:pointer;font-size:14px;font-weight:700;color:#64748B;
                               opacity:@(_page >= TotalPages ? "0.4" : "1");">›</button>
            </div>

            <!-- Page size selector -->
            <div style="display:flex;align-items:center;gap:8px;white-space:nowrap;">
                <span style="font-size:12px;color:#64748B;">Rows per page:</span>
                @foreach (var size in new[] { 10, 20, 50, 100 })
                {
                    <button class="opd-tab @(_pageSize == size ? "active" : "")" style="padding:5px 10px;min-width:36px;"
                            @onclick="() => SetPageSize(size)">
                        @size
                    </button>
                }
            </div>
        </div>
    }

</div>

<!-- ── Visit Detail Modal ── -->
@if (_viewModalOpen && _selected is not null)
{
    var notVisited = IsNotVisited(_selected);
    <div class="opd-modal-overlay" @onclick="CloseViewModal">
        <div class="opd-modal" @onclick:stopPropagation="true">
            <button class="opd-modal-close" @onclick="CloseViewModal">✕</button>
            <div class="opd-modal-title">OPD Visit Details</div>

            <div class="opd-modal-patient-row">
                <div class="opd-avatar">@GetInitials(_selected.PatientName)</div>
                <div>
                    <div class="opd-modal-name">@_selected.PatientName</div>
                    <div class="opd-modal-meta">
                        @_selected.RegistrationNumber &middot; @_selected.RegistrationDate.ToLocalTime().ToString("dd MMM yyyy")
                    </div>
                    <span class="opd-badge @(notVisited ? "notvisited" : GetBadgeClass(_selected.Status))"
                          style="margin-top:6px;display:inline-flex;">
                        @(notVisited ? "Not Visited" : GetStatusLabel(_selected.Status))
                    </span>
                </div>
            </div>

            <div class="opd-modal-grid">
                <div class="opd-modal-field">
                    <div class="opd-modal-field-label">Token</div>
                    <div class="opd-modal-field-value">@_selected.RegistrationNumber</div>
                </div>
                <div class="opd-modal-field">
                    <div class="opd-modal-field-label">Doctor</div>
                    <div class="opd-modal-field-value">@(string.IsNullOrWhiteSpace(_selected.DoctorName) ? "—" : _selected.DoctorName)</div>
                </div>
                <div class="opd-modal-field">
                    <div class="opd-modal-field-label">Appointment</div>
                    <div class="opd-modal-field-value">@_selected.RegistrationDate.ToString("hh:mm tt")</div>
                </div>
                <div class="opd-modal-field">
                    <div class="opd-modal-field-label">Fee</div>
                    <div class="opd-modal-field-value">₹@_selected.Fee.ToString("N0")</div>
                </div>
                @if (_selected.Weight.HasValue || !string.IsNullOrWhiteSpace(_selected.BloodPressure) || _selected.PulseRate.HasValue
                     || _selected.OxygenSaturation.HasValue || _selected.Temperature.HasValue || _selected.RespiratoryRate.HasValue || _selected.Sugar.HasValue)
                {
                    <div class="opd-modal-field">
                        <div class="opd-modal-field-label">Weight</div>
                        <div class="opd-modal-field-value">@(_selected.Weight.HasValue ? $"{_selected.Weight:F1} kg" : "—")</div>
                    </div>
                    <div class="opd-modal-field">
                        <div class="opd-modal-field-label">Blood Pressure</div>
                        <div class="opd-modal-field-value">@(_selected.BloodPressure ?? "—")</div>
                    </div>
                    <div class="opd-modal-field">
                        <div class="opd-modal-field-label">Pulse</div>
                        <div class="opd-modal-field-value">@(_selected.PulseRate.HasValue ? $"{_selected.PulseRate} bpm" : "—")</div>
                    </div>
                    <div class="opd-modal-field">
                        <div class="opd-modal-field-label">O2 Sat.</div>
                        <div class="opd-modal-field-value">@(_selected.OxygenSaturation.HasValue ? $"{_selected.OxygenSaturation:F1}%" : "—")</div>
                    </div>
                    <div class="opd-modal-field">
                        <div class="opd-modal-field-label">Temp</div>
                        <div class="opd-modal-field-value">@(_selected.Temperature.HasValue ? $"{_selected.Temperature:F1} °F" : "—")</div>
                    </div>
                    <div class="opd-modal-field">
                        <div class="opd-modal-field-label">RR</div>
                        <div class="opd-modal-field-value">@(_selected.RespiratoryRate.HasValue ? $"{_selected.RespiratoryRate} /min" : "—")</div>
                    </div>
                    <div class="opd-modal-field">
                        <div class="opd-modal-field-label">Sugar</div>
                        <div class="opd-modal-field-value">@(_selected.Sugar.HasValue ? $"{_selected.Sugar:F1}" : "—")</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_selected.Notes))
                {
                    <div class="opd-modal-field" style="grid-column:1/-1;">
                        <div class="opd-modal-field-label">Reason / Notes</div>
                        <div class="opd-modal-field-value">@_selected.Notes</div>
                    </div>
                }
            </div>

            <div class="opd-modal-actions">
                @if (_isDoctor)
                {
                    @if (_selected.Status == OpdStatus.InProgress)
                    {
                        <button class="opd-modal-btn-filled"
                                @onclick="() => { CloseViewModal(); OpenPrescription(_selected); }">
                            Write Prescription
                        </button>
                    }
                    @if (_selected.Status == OpdStatus.Completed)
                    {
                        <button class="opd-modal-btn-filled" style="background:#059669;"
                                disabled="@_checkingRx"
                                @onclick="() => ViewPrescription(_selected)">
                            @(_checkingRx ? "Loading..." : "View Prescription")
                        </button>
                    }
                }
                else
                {
                    @if (_selected.Status != OpdStatus.Cancelled && _selected.Status != OpdStatus.Completed)
                    {
                        <button class="opd-modal-btn-filled" style="background:#EF4444;"
                                @onclick="async () => { CloseViewModal(); await CancelAsync(_selected); }"
                                disabled="@_updating">
                            Cancel Appointment
                        </button>
                    }
                }
                <button class="opd-modal-btn-outline" @onclick="CloseViewModal">Close</button>
            </div>
        </div>
    </div>
}

<!-- ── New OPD Dialog (reception only) ── -->
@if (!_isDoctor && _newDialogVisible)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:900;"
         @onclick="@(() => _newDialogVisible = false)"></div>
    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
                background:#fff;border-radius:14px;width:540px;max-width:96vw;max-height:90vh;overflow-y:auto;
                box-shadow:0 20px 60px rgba(0,0,0,0.2);z-index:901;" @onclick:stopPropagation="true">
        <div style="padding:18px 24px;border-bottom:1px solid #E2E8F0;">
            <div style="font-size:16px;font-weight:800;color:#1E293B;">New OPD Registration</div>
        </div>
        <div style="padding:20px 24px;display:flex;flex-direction:column;gap:14px;">
            <PatientSearchInput OnPatientSelected="OnOpdPatientSelected"
                                Placeholder="Type patient name or phone to search…" />
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Select Doctor (optional)</label>
                <select class="form-input" @onchange="OnNewOpdDoctorChanged">
                    <option value="">— No Doctor —</option>
                    @foreach (var d in _doctors)
                    {
                        <option value="@d.UserId" selected="@(_selectedDoctorId == d.UserId)">@d.FullName</option>
                    }
                </select>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Fee (₹)</label>
                    <input class="form-input" type="number" min="0" @bind="_fee" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Weight (kg)</label>
                    <input class="form-input" type="number" min="0" step="0.1" @bind="_weight" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">BP (e.g. 120/80)</label>
                    <input class="form-input" type="text" @bind="_bloodPressure" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Pulse (bpm)</label>
                    <input class="form-input" type="number" min="0" @bind="_pulseRate" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">O2 Sat. (%)</label>
                    <input class="form-input" type="number" min="0" max="100" step="0.1" @bind="_oxygenSaturation" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Temp (°F)</label>
                    <input class="form-input" type="number" min="0" step="0.1" @bind="_temperature" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">RR (/min)</label>
                    <input class="form-input" type="number" min="0" @bind="_respiratoryRate" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Sugar (F)</label>
                    <input class="form-input" type="number" min="0" step="0.1" @bind="_sugar" />
                </div>
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Reason / Notes</label>
                <textarea class="form-input" rows="2" @bind="_notes" style="resize:vertical;min-height:56px;"></textarea>
            </div>
        </div>
        <div style="padding:14px 24px;border-top:1px solid #E2E8F0;display:flex;justify-content:flex-end;gap:10px;">
            <button style="background:transparent;color:#64748B;border:1.5px solid #E2E8F0;border-radius:8px;
                           padding:9px 18px;font-weight:600;font-size:13px;cursor:pointer;"
                    @onclick="@(() => _newDialogVisible = false)">Cancel</button>
            <button style="background:#1565C0;color:#fff;border:none;border-radius:8px;
                           padding:9px 20px;font-weight:700;font-size:13px;cursor:pointer;
                           opacity:@(_saving ? "0.75" : "1");"
                    @onclick="CreateOpdAsync" disabled="@_saving">
                @(_saving ? "Saving..." : "Register")
            </button>
        </div>
    </div>
}

<!-- OPD Particulars Popup (reception) -->
<OpdParticularsPopup Visible="_particularsVisible"
                     VisibleChanged="OnParticularsVisibleChanged"
                     OpdRegistrationId="_particularsOpdId"
                     OnFeesChanged="ReloadAll" />

<!-- OPD Discount Dialog (doctor) -->
<OpdDiscountDialog @bind-Visible="_discountVisible" OpdRegistrationId="_discountOpdId" OnDiscountApplied="ReloadAll" />

<!-- Delete Confirmation Dialog -->
@if (_deleteDialogOpen)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:900;"
         @onclick="() => _deleteDialogOpen = false"></div>
    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
                background:#fff;border-radius:14px;width:400px;max-width:96vw;
                box-shadow:0 20px 60px rgba(0,0,0,0.2);z-index:901;overflow:hidden;"
         @onclick:stopPropagation="true">
        <div style="padding:18px 24px;border-bottom:1px solid #E2E8F0;">
            <div style="font-size:16px;font-weight:800;color:#EF4444;">Delete OPD Registration</div>
        </div>
        <div style="padding:20px 24px;font-size:14px;color:#1E293B;">
            Permanently delete this cancelled OPD record for <strong>@_deleteTarget?.PatientName</strong>?
            This cannot be undone.
        </div>
        <div style="padding:14px 24px;border-top:1px solid #E2E8F0;display:flex;justify-content:flex-end;gap:10px;">
            <button style="background:transparent;color:#64748B;border:1.5px solid #E2E8F0;border-radius:8px;
                           padding:8px 16px;font-weight:600;font-size:13px;cursor:pointer;"
                    @onclick="() => _deleteDialogOpen = false">Cancel</button>
            <button style="background:#EF4444;color:#fff;border:none;border-radius:8px;
                           padding:9px 20px;font-weight:700;font-size:13px;cursor:pointer;
                           opacity:@(_updating ? "0.65" : "1");"
                    @onclick="ExecuteDeleteOpdAsync" disabled="@_updating">
                @(_updating ? "Deleting..." : "Delete")
            </button>
        </div>
    </div>
}

@code {
    private bool _deleteDialogOpen;
    private OpdRegistrationDto? _deleteTarget;

    private record DatePreset(string Key, string Label, DateTime From, DateTime To);
    private List<DatePreset> _datePresets = [];

    // ── Auth ─────────────────────────────────────────────────────────────────
    private bool _isDoctor;
    private Guid? _doctorUserId;

    // ── Counter session (reception only) ─────────────────────────────────────
    private Guid? _activeSessionId;

    // ── Particulars popup (reception) ─────────────────────────────────────────
    private bool _particularsVisible;
    private Guid _particularsOpdId;

    // ── Discount dialog (doctor) ──────────────────────────────────────────────
    private bool _discountVisible;
    private Guid _discountOpdId;

    // ── Paging / filter state ─────────────────────────────────────────────────
    private int  _page       = 1;
    private int  _pageSize   = 20;
    private string _activePreset  = "today";
    private string _statusFilter  = "all";
    private string? _search;
    private DateTime _customFrom = DateTime.Today;
    private DateTime _customTo   = DateTime.Today;
    private Guid? _filterDoctorId;
    private Guid? _clinicAppId;   // resolved once in OnInitializedAsync, passed explicitly on every API call

    // ── Data ──────────────────────────────────────────────────────────────────
    private bool _loading    = true;
    private bool _updating;
    private bool _checkingRx;
    private TenantCore.Shared.Common.PagedResult<OpdRegistrationDto>? _result;

    // Summary counts (from a separate "all" query for the current date range)
    private int _totalCount      = 0;
    private int _waitingCount    = 0;
    private int _inProgressCount = 0;
    private int _completedCount  = 0;
    private int _notVisitedCount = 0;

    // Modal
    private bool _viewModalOpen;
    private OpdRegistrationDto? _selected;

    // New OPD form
    private bool _newDialogVisible;
    private bool _saving;
    private List<DoctorDto>   _doctors  = [];
    private Guid    _selectedPatientId;
    private Guid?   _selectedDoctorId;
    private decimal _fee;
    private string? _notes;
    private decimal? _weight;
    private string?  _bloodPressure;
    private int?     _pulseRate;
    private decimal? _oxygenSaturation;
    private decimal? _temperature;
    private int?     _respiratoryRate;
    private decimal? _sugar;

    // ── Computed ──────────────────────────────────────────────────────────────
    private int TotalPages => _result is null || _pageSize == 0
        ? 1
        : (int)Math.Ceiling(_result.TotalCount / (double)_pageSize);

    private string _dateRangeLabel => _activePreset switch
    {
        "today"     => "Today",
        "yesterday" => "Yesterday",
        "last7"     => "Last 7 Days",
        "lastmonth" => "Last Month",
        "custom"    => $"{_customFrom:dd MMM} – {_customTo:dd MMM yyyy}",
        _           => ""
    };

    private static bool IsNotVisited(OpdRegistrationDto r)
        => r.Status == OpdStatus.Pending && r.RegistrationDate.Date < DateTime.Today;

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        // Both services must be initialised from storage before any role or API call
        await AuthState.InitializeAsync();
        await ClinicContext.InitializeAsync();

        var appId = ClinicContext.SelectedApplicationId;

        // Resolve role for the SELECTED clinic only — prevents cross-clinic role bleed.
        var clinicRoles = appId != Guid.Empty
            ? AuthState.GetRolesForApplication(appId)
            : (AuthState.CurrentUser?.UserRoles
                .Where(r => r.IsActive)
                .Select(r => r.RoleName)
                .ToList() ?? []);

        _isDoctor     = clinicRoles.Any(r => r.Equals("Doctor", StringComparison.OrdinalIgnoreCase));
        _doctorUserId = _isDoctor ? AuthState.CurrentUser?.UserId : null;

        // Store for use in LoadPageAsync / LoadCountsAsync so all calls are explicit
        _clinicAppId = appId != Guid.Empty ? appId : null;

        BuildPresets();
        await Task.WhenAll(LoadPageAsync(), LoadCountsAsync());
        if (!_isDoctor)
        {
            await Task.WhenAll(LoadDoctorsAsync(), LoadActiveSessionAsync());
        }
        if (Navigation.Uri.EndsWith("/opd/new", StringComparison.OrdinalIgnoreCase) && !_isDoctor)
            OpenNewDialog();
    }

    private void BuildPresets()
    {
        var today = DateTime.Today;
        _datePresets =
        [
            new("today",     "Today",       today,              today),
            new("yesterday", "Yesterday",   today.AddDays(-1),  today.AddDays(-1)),
            new("last7",     "Last 7 Days", today.AddDays(-6),  today),
            new("lastmonth", "Last Month",  today.AddDays(-29), today),
        ];
    }

    // ── Data loading ──────────────────────────────────────────────────────────

    // Load the current page with active status filter
    private async Task LoadPageAsync()
    {
        _loading = true;
        var (from, to)  = GetDateRange();
        var (status, nv) = MapStatusFilter(_statusFilter);

        var response = await ClinicClient.GetOpdRegistrationsAsync(
            page: _page, pageSize: _pageSize,
            search: string.IsNullOrWhiteSpace(_search) ? null : _search,
            doctorUserId: _isDoctor ? _doctorUserId : _filterDoctorId,
            fromDate: from, toDate: to,
            status: status, notVisited: nv,
            applicationId: _clinicAppId);

        if (response.Success) _result = response.Data;
        else Toast.ShowError(response.Message ?? "Failed to load.");
        _loading = false;
    }

    // Load summary counts (status = all, large page to get counts)
    private async Task LoadCountsAsync()
    {
        var (from, to) = GetDateRange();
        var search = string.IsNullOrWhiteSpace(_search) ? null : _search;

        // Fetch all statuses with pageSize=1 to get TotalCount for each bucket
        async Task<int> Count(OpdStatus? s, bool nv)
        {
            var r = await ClinicClient.GetOpdRegistrationsAsync(
                page: 1, pageSize: 1,
                search: search,
                doctorUserId: _isDoctor ? _doctorUserId : _filterDoctorId,
                fromDate: from, toDate: to,
                status: s, notVisited: nv,
                applicationId: _clinicAppId);
            return r.Success ? r.Data?.TotalCount ?? 0 : 0;
        }

        var results = await Task.WhenAll(
            Count(null,                    false),   // total (all)
            Count(OpdStatus.Pending,       false),   // waiting (today's pending)
            Count(OpdStatus.InProgress,    false),   // in progress
            Count(OpdStatus.Completed,     false),   // completed
            Count(null,                    true)     // not visited
        );

        _totalCount      = results[0];
        _waitingCount    = results[1];
        _inProgressCount = results[2];
        _completedCount  = results[3];
        _notVisitedCount = results[4];
    }

    // Full reload — counts + page
    private async Task ReloadAll()
    {
        _page = 1;
        await Task.WhenAll(LoadPageAsync(), LoadCountsAsync());
    }

    private async Task LoadDoctorsAsync()
    {
        var r = await ClinicClient.GetDoctorsAsync();
        if (r.Success) _doctors = r.Data?.ToList() ?? [];
    }

    private async Task LoadActiveSessionAsync()
    {
        var r = await CounterSessionClient.GetActiveAsync();
        _activeSessionId = r.Success && r.Data is not null ? r.Data.Id : null;
    }

    private (DateTime From, DateTime To) GetDateRange()
    {
        if (_activePreset == "custom") return (_customFrom, _customTo);
        var p = _datePresets.FirstOrDefault(x => x.Key == _activePreset);
        return p is not null ? (p.From, p.To) : (DateTime.Today, DateTime.Today);
    }

    private static (OpdStatus? status, bool notVisited) MapStatusFilter(string filter) => filter switch
    {
        "waiting"    => (OpdStatus.Pending,    false),
        "progress"   => (OpdStatus.InProgress, false),
        "done"       => (OpdStatus.Completed,  false),
        "notvisited" => (null,                 true),
        _            => (null,                 false)
    };

    // ── User interactions ─────────────────────────────────────────────────────
    private async Task ApplyPreset(string key)
    {
        _activePreset = key;
        await ReloadAll();
    }

    private async Task ApplyStatus(string filter)
    {
        _statusFilter = filter;
        _page = 1;
        await LoadPageAsync();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ReloadAll();
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await LoadPageAsync();
    }

    private async Task SetPageSize(int size)
    {
        _pageSize = size;
        _page = 1;
        await LoadPageAsync();
    }

    // ── OPD actions ───────────────────────────────────────────────────────────
    private void OpenViewModal(OpdRegistrationDto reg) { _selected = reg; _viewModalOpen = true; }

    private void OpenParticularsPopup(OpdRegistrationDto reg) { _particularsOpdId = reg.Id; _particularsVisible = true; }

    private async Task OnParticularsVisibleChanged(bool visible)
    {
        _particularsVisible = visible;
        if (!visible) await ReloadAll();
    }

    private void OpenDiscountDialog(OpdRegistrationDto reg) { _discountOpdId = reg.Id; _discountVisible = true; }
    private void CloseViewModal() { _viewModalOpen = false; _selected = null; }

    private async Task OpenPrescription(OpdRegistrationDto reg)
    {
        var existing = await PrescriptionClient.GetPrescriptionByOpdIdAsync(reg.Id);
        if (existing.Success && existing.Data is not null)
            Navigation.NavigateTo($"/prescriptions/{existing.Data.Id}");
        else
            Navigation.NavigateTo($"/prescriptions/new/{reg.Id}");
    }

    private async Task ViewPrescription(OpdRegistrationDto reg)
    {
        _checkingRx = true;
        var existing = await PrescriptionClient.GetPrescriptionByOpdIdAsync(reg.Id);
        _checkingRx = false;
        if (existing.Success && existing.Data is not null)
            Navigation.NavigateTo($"/prescriptions/{existing.Data.Id}");
        else
            Toast.ShowWarning("No prescription found for this visit.");
    }

    private async Task StartAsync(OpdRegistrationDto reg)
    {
        _updating = true;
        var dto = new UpdateOpdRegistrationDto(reg.DoctorUserId, reg.DoctorName, reg.Fee, OpdStatus.InProgress, reg.Notes);
        var result = await ClinicClient.UpdateOpdRegistrationAsync(reg.Id, dto);
        if (result.Success) { Toast.ShowSuccess("Consultation started."); await ReloadAll(); }
        else Toast.ShowError(result.Message ?? "Failed.");
        _updating = false;
    }

    private async Task MarkDoneAsync(OpdRegistrationDto reg)
    {
        _updating = true;
        var dto = new UpdateOpdRegistrationDto(reg.DoctorUserId, reg.DoctorName, reg.Fee, OpdStatus.Completed, reg.Notes);
        var result = await ClinicClient.UpdateOpdRegistrationAsync(reg.Id, dto);
        if (result.Success) { Toast.ShowSuccess("Visit marked as completed."); await ReloadAll(); }
        else Toast.ShowError(result.Message ?? "Failed.");
        _updating = false;
    }

    private async Task CancelAsync(OpdRegistrationDto reg)
    {
        _updating = true;
        var dto = new UpdateOpdRegistrationDto(reg.DoctorUserId, reg.DoctorName, reg.Fee, OpdStatus.Cancelled, reg.Notes);
        var result = await ClinicClient.UpdateOpdRegistrationAsync(reg.Id, dto);
        if (result.Success) { Toast.ShowSuccess("Appointment cancelled."); await ReloadAll(); }
        else Toast.ShowError(result.Message ?? "Failed.");
        _updating = false;
    }

    private static bool CanDelete(OpdRegistrationDto reg) =>
        reg.PaymentStatus is null or PaymentStatus.Pending || reg.RefundStatus == RefundStatus.Refunded;

    private static bool NeedsRefund(OpdRegistrationDto reg) =>
        reg.PaymentStatus == PaymentStatus.Received && reg.RefundStatus != RefundStatus.Refunded;

    private void ConfirmDeleteOpd(OpdRegistrationDto reg)
    {
        _deleteTarget = reg;
        _deleteDialogOpen = true;
    }

    private async Task ExecuteDeleteOpdAsync()
    {
        if (_deleteTarget is null) return;
        _updating = true;
        var result = await ClinicClient.DeleteOpdRegistrationAsync(_deleteTarget.Id);
        if (result.Success)
        {
            Toast.ShowSuccess("OPD registration deleted.");
            _deleteDialogOpen = false;
            _deleteTarget = null;
            await ReloadAll();
        }
        else
        {
            Toast.ShowError(result.Message ?? "Failed to delete.");
        }
        _updating = false;
    }

    private async Task CollectFeeAsync(OpdRegistrationDto reg)
    {
        _updating = true;

        if (_activeSessionId is null)
        {
            Toast.ShowWarning("No active counter session. Open a counter session first.", "Open counter session", "/counter-session");
            _updating = false;
            return;
        }

        var paymentResp = await OpdPaymentClient.GetByOpdAsync(reg.Id);
        if (!paymentResp.Success || paymentResp.Data is null)
        {
            Toast.ShowError("Payment record not found for this visit.");
            _updating = false;
            return;
        }

        var payment = paymentResp.Data;

        ApiResponse<OpdPaymentDto> acceptResp;
        decimal collectedAmount;

        if (reg.HasDiscount)
        {
            // Discount applied — collect the entire discounted bill at once.
            acceptResp = await OpdPaymentClient.AcceptFullAsync(payment.Id,
                new AcceptOpdPaymentFullRequest { OpdRegistrationId = reg.Id, CounterSessionId = _activeSessionId });
            collectedAmount = payment.FinalAmount;
        }
        else
        {
            // No discount — collect visit fee only; services are collected per-item in the Items popup.
            acceptResp = await OpdPaymentClient.AcceptAsync(payment.Id,
                new AcceptOpdPaymentRequest { OpdRegistrationId = reg.Id, CounterSessionId = _activeSessionId });
            collectedAmount = payment.VisitFee;
        }

        if (acceptResp.Success)
        {
            Toast.ShowSuccess($"₹{collectedAmount:N0} collected for {reg.PatientName}.");
            await ReloadAll();
        }
        else
            Toast.ShowError(acceptResp.Message ?? "Payment failed.");

        _updating = false;
    }

    // New OPD form
    private void OnOpdPatientSelected(PatientDto? p) => _selectedPatientId = p?.Id ?? Guid.Empty;

    private void OpenNewDialog()
    {
        _selectedPatientId = Guid.Empty; _selectedDoctorId = null;
        _fee = 0; _notes = null;

        // Pre-fill vitals with normal/typical values — reception only needs to touch
        // whatever reading is actually abnormal for this patient, same convention as
        // the doctor's prescription vitals defaults.
        _weight = 70; _bloodPressure = "120/80"; _pulseRate = 72; _oxygenSaturation = 98;
        _temperature = 98.6m; _respiratoryRate = 16; _sugar = 95;

        _newDialogVisible = true;
    }

    private async Task OnDoctorSelectedAsync(Guid? userId)
    {
        _selectedDoctorId = userId;
        _fee = 0;
        if (userId is null) return;

        var doctor = _doctors.FirstOrDefault(d => d.UserId == userId);
        if (doctor?.ProfileId is null) return;

        var resp = await DoctorFeeConfigClient.GetByDoctorIdAsync(doctor.ProfileId.Value);
        if (resp.Success && resp.Data is not null && resp.Data.IsActive)
            _fee = resp.Data.VisitFee;
    }

    private async Task CreateOpdAsync()
    {
        if (_selectedPatientId == Guid.Empty) { Toast.ShowWarning("Please select a patient."); return; }
        _saving = true;
        var doctor = _selectedDoctorId.HasValue ? _doctors.FirstOrDefault(d => d.UserId == _selectedDoctorId) : null;
        var dto = new CreateOpdRegistrationDto(
            _selectedPatientId, _selectedDoctorId ?? Guid.Empty,
            doctor?.FullName ?? string.Empty,
            _fee > 0 ? _fee : null, _notes,
            _weight > 0 ? _weight : null,
            string.IsNullOrWhiteSpace(_bloodPressure) ? null : _bloodPressure,
            _pulseRate > 0 ? _pulseRate : null,
            _oxygenSaturation > 0 ? _oxygenSaturation : null,
            _temperature > 0 ? _temperature : null,
            _respiratoryRate > 0 ? _respiratoryRate : null,
            _sugar > 0 ? _sugar : null);
        var response = await ClinicClient.CreateOpdRegistrationAsync(dto);
        if (response.Success)
        {
            Toast.ShowSuccess($"OPD registration {response.Data?.RegistrationNumber} created.");
            _newDialogVisible = false;
            await ReloadAll();
        }
        else if (response.Message?.Contains("counter session", StringComparison.OrdinalIgnoreCase) == true)
            Toast.ShowError(response.Message, "Open counter session", "/counter-session");
        else Toast.ShowError(response.Message ?? "Failed to create.");
        _saving = false;
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    private static string GetBadgeClass(OpdStatus s) => s switch
    {
        OpdStatus.Pending    => "waiting",
        OpdStatus.InProgress => "progress",
        OpdStatus.Completed  => "done",
        OpdStatus.Cancelled  => "cancelled",
        _                    => ""
    };

    private static string GetStatusLabel(OpdStatus s) => s switch
    {
        OpdStatus.Pending    => "Waiting",
        OpdStatus.InProgress => "In Progress",
        OpdStatus.Completed  => "Completed",
        OpdStatus.Cancelled  => "Cancelled",
        _                    => s.ToString()
    };

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : name[..Math.Min(2, name.Length)].ToUpper();
    }

    private async Task OnDoctorFilterChanged(ChangeEventArgs e)
    {
        _filterDoctorId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : (Guid?)null;
        await ReloadAll();
    }

    private async Task OnNewOpdDoctorChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        Guid? newId = string.IsNullOrEmpty(val) ? null : Guid.TryParse(val, out var id) ? id : (Guid?)null;
        await OnDoctorSelectedAsync(newId);
    }
}
