    private string PatientName => _patient is not null ? _patient.FullName : (_opd?.PatientName ?? "Patient");
    private string PatientInitials => string.Join("", PatientName.Split(' ').Take(2).Select(n => n.Length > 0 ? n[0].ToString() : ""));
    private string PatientSubtitle
    {
        get
        {
            var parts = new List<string>();
            if (_opd is not null) parts.Add(_opd.RegistrationNumber);
            if (_patient?.DateOfBirth is not null)
                parts.Add($"{(DateTime.Today.Year - _patient.DateOfBirth.Value.Year)}y");
