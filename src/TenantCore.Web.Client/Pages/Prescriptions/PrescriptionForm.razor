    // Re-prescribes a medicine from a previous visit — carries the dose/frequency/instructions
    // forward exactly as they were, so a doctor repeating a drug doesn't have to rebuild it from scratch.
    private void AddMedicineFromHistory(PrescriptionItemDto m)
    {
        if (TryAddMedicineFromHistory(m))
        {
            CheckInteractions();
            Toast.ShowSuccess($"{m.MedicineName} added to prescription.");
        }
        else
            Toast.ShowWarning($"{m.MedicineName} is already in this prescription.");
    }

    private void AddAllMedicinesFromHistory(PrescriptionDto visit)
    {
        var addedCount = visit.Items.Count(TryAddMedicineFromHistory);
        if (addedCount > 0)
        {
            CheckInteractions();
            Toast.ShowSuccess($"{addedCount} medicine{(addedCount != 1 ? "s" : "")} added to prescription.");
        }
        else
            Toast.ShowWarning("All medicines from this visit are already in the prescription.");
    }

    private bool TryAddMedicineFromHistory(PrescriptionItemDto m)
    {
        if (_items.Any(i => i.MedicineId == m.MedicineId)) return false;

        var duration = m.DurationDays > 0 ? m.DurationDays : 7;
        var item = new PrescriptionItemRow
        {
            MedicineId = m.MedicineId,
            MedicineName = m.MedicineName,
            MedicineForm = m.MedicineForm,
            Strength = m.Strength ?? string.Empty,
            DosageUnit = string.IsNullOrWhiteSpace(m.DosageUnit) ? GetDefaultUnit(m.MedicineForm) : m.DosageUnit,
            DosageMorningStr = m.DosageMorning?.ToString(),
            DosageAfternoonStr = m.DosageAfternoon?.ToString(),
            DosageEveningStr = m.DosageEvening?.ToString(),
            DosageNightStr = m.DosageNight?.ToString(),
            DurationDays = duration,
            DurationInput = $"{duration} days",
            Frequency = m.Frequency ?? "OD",
            InstructionList = string.IsNullOrWhiteSpace(m.Instructions)
                ? GetDefaultInstructions(m.MedicineForm)
                : m.Instructions.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList(),
        };
        item.DoseAmountStr = item.DosageMorningStr ?? item.DosageAfternoonStr
            ?? item.DosageEveningStr ?? item.DosageNightStr ?? "1";
        UpdateTimingSummary(item);
        _items.Add(item);
        RecalcQuantity(_items.Count - 1);
        return true;
    }

    private string GetVital(string key) => key switch
    {
        "bp" => _vBP, "pulse" => _vPulse, "temp" => _vTemp,
        "weight" => _vWeight, "spo2" => _vSpO2, "rr" => _vRR, "sugar" => _vSugar,
        _ => string.Empty
    };

    private void SetVital(string key, string? value)
    {
