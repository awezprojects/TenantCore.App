        var dto = new UpdatePrescriptionConfigDto(
            _lang switch { "hi" => PrescriptionLanguage.Hindi, "mr" => PrescriptionLanguage.Marathi, _ => PrescriptionLanguage.English },
            _pMarginTop, _pMarginRight, _pMarginBottom, _pMarginLeft, _pHideHeader);
