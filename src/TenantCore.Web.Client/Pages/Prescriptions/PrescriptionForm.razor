    private UpsertObstetricPrescriptionDataDto? BuildObstetricDto()
    {
        if (!_isGynecologist) return null;
        var hasData = _obsGravida.HasValue || _obsPara.HasValue || _obsLive.HasValue ||
                      _obsAbortion.HasValue || !string.IsNullOrWhiteSpace(_obsInformation) ||
                      _menstrualHistory.Count > 0 || _pamHistory.Count > 0 || _familyHistory.Count > 0 ||
                      _lmpValue.HasValue || _eddByUsgValue.HasValue;
        if (!hasData) return null;
        return new UpsertObstetricPrescriptionDataDto(
            _obsGravida, _obsPara, _obsLive, _obsAbortion,
            NullIfEmpty(_obsInformation),
            _menstrualHistory.Count > 0 ? _menstrualHistory : null,
            _pamHistory.Count > 0 ? _pamHistory : null,
            _familyHistory.Count > 0 ? _familyHistory : null,
            Lmp: _lmpValue,
            EddByUsg: _eddByUsgValue);
    }

    private void CarryForwardObstetricData(ObstetricPrescriptionDataDto source)
    {
        _obsGravida = source.Gravida;
        _obsPara = source.Para;
        _obsLive = source.Live;
        _obsAbortion = source.Abortion;
        _obsInformation = source.Information ?? string.Empty;
        _menstrualHistory = source.MenstrualHistory.ToList();
        _pamHistory = source.PastMedicalHistory.ToList();
        _familyHistory = source.FamilyHistory.ToList();
        _lmpValue = source.Lmp;
        _eddByUsgValue = source.EddByUsg;
    }

