    private void AddMedicine(MedicineDto? medicine)
    {
        if (medicine is null) return;

        // Map DosageFormName → MedicineFormType
        var formType = MapFormType(medicine.DosageFormName ?? medicine.Form ?? string.Empty);

        var item = new PrescriptionItemRow
        {
            MedicineId = medicine.Id,
            MedicineName = medicine.Name,
            GenericName = medicine.GenericName,
            MedicineForm = formType,
            Strength = medicine.Dosage ?? string.Empty,
            DosageUnit = GetDefaultUnit(formType),
            DurationDays = 7,
            DurationInput = "7 days",
            Frequency = "OD",
            DoseAmountStr = "1",
            DosageMorningStr = "1",
            InstructionList = GetDefaultInstructions(formType),
        };
        UpdateTimingSummary(item);
        _items.Add(item);
        RecalcQuantity(_items.Count - 1);
        CheckInteractions();
    }

    private static MedicineFormType MapFormType(string formName)
    {
        var f = formName.ToLowerInvariant();
        if (f.Contains("cap")) return MedicineFormType.Capsule;
        if (f.Contains("syr") || f.Contains("liquid") || f.Contains("suspension")) return MedicineFormType.Syrup;
        if (f.Contains("drop")) return MedicineFormType.Drops;
        if (f.Contains("inj") || f.Contains("vial") || f.Contains("amp")) return MedicineFormType.Injection;
        if (f.Contains("cream") || f.Contains("ointment") || f.Contains("gel") || f.Contains("lotion") || f.Contains("tube")) return MedicineFormType.Tube;
        if (f.Contains("powder") || f.Contains("sachet")) return MedicineFormType.Powder;
        if (f.Contains("neb") || f.Contains("inhal") || f.Contains("rotacap") || f.Contains("respule") || f.Contains("spray")) return MedicineFormType.Other;
        if (f.Contains("tab")) return MedicineFormType.Tab;
        return MedicineFormType.Other;
    }

    private void RemoveMedicine(int idx)
    {
        _items.RemoveAt(idx);
        CheckInteractions();
    }

    private void AutoFillRemark(int idx)
    {
        if (idx < 0 || idx >= _items.Count) return;
        var item = _items[idx];
        item.RemarkEnglish = GenerateRemark(item, "en");
        item.RemarkHindi = GenerateRemark(item, "hi");
        item.RemarkMarathi = GenerateRemark(item, "mr");
    }

    private void RecalcQuantity(int idx)
    {
        if (idx < 0 || idx >= _items.Count) return;
        var item = _items[idx];
        var m = decimal.TryParse(item.DosageMorningStr, out var mv) ? mv : 0;
        var a = decimal.TryParse(item.DosageAfternoonStr, out var av) ? av : 0;
        var e = decimal.TryParse(item.DosageEveningStr, out var ev) ? ev : 0;
        var n = decimal.TryParse(item.DosageNightStr, out var nv) ? nv : 0;
        item.Quantity = (m + a + e + n) * item.DurationDays;
    }

    private void ToggleInvestigation(string inv)
    {
        if (_investigations.Contains(inv)) _investigations.Remove(inv);
        else _investigations.Add(inv);
    }

    private void RemoveInvestigation(string inv) => _investigations.Remove(inv);

    private void CheckInteractions()
    {
        _interactions.Clear();
        var names = _items.Select(i => i.MedicineName).ToHashSet(StringComparer.OrdinalIgnoreCase);
        foreach (var (pair, msg) in _knownInteractions)
        {
            var parts = pair.Split('|');
            if (parts.Length == 2 && names.Contains(parts[0]) && names.Contains(parts[1]))
                _interactions.Add(msg);
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            var items = BuildItemDtos();
            if (PrescriptionId == Guid.Empty)
            {
                var user = AuthState.CurrentUser;
                if (user is null) { Toast.ShowError("Not authenticated."); return; }
                var dto = new CreatePrescriptionDto(
                    OpdRegistrationId, user.UserId, user.FullName,
                    _followup, _diagnosis, _investigations,
                    _notes, NullIfEmpty(_vBP), ParseInt(_vPulse), ParseDecimal(_vTemp),
                    ParseDecimal(_vWeight), ParseDecimal(_vSpO2), ParseInt(_vRR), ParseDecimal(_vSugar),
                    items, BuildObstetricDto());
                var r = await PrescriptionClient.CreatePrescriptionAsync(dto);
                if (r.Success && r.Data is not null)
                {
                    _prescription = r.Data;
                    PrescriptionId = r.Data.Id;
                    Toast.ShowSuccess("Prescription saved.");
                    Navigation.NavigateTo($"/prescriptions/{PrescriptionId}");
                }
                else Toast.ShowError(r.Message ?? "Failed to save.");
            }
            else
            {
                var dto = new UpdatePrescriptionDto(
                    _followup, _diagnosis, _investigations,
                    _notes, NullIfEmpty(_vBP), ParseInt(_vPulse), ParseDecimal(_vTemp),
                    ParseDecimal(_vWeight), ParseDecimal(_vSpO2), ParseInt(_vRR), ParseDecimal(_vSugar),
                    items, BuildObstetricDto());
                var r = await PrescriptionClient.UpdatePrescriptionAsync(PrescriptionId, dto);
                if (r.Success) { _prescription = r.Data; Toast.ShowSuccess("Prescription updated."); }
                else Toast.ShowError(r.Message ?? "Failed to update.");
            }
        }
        finally { _saving = false; }
    }

    private async Task SubmitAsync()
    {
        if (PrescriptionId == Guid.Empty) await SaveAsync();
        if (PrescriptionId == Guid.Empty) return;

        _saving = true;
        var r = await PrescriptionClient.SubmitPrescriptionAsync(PrescriptionId);
        if (r.Success) { _prescription = r.Data; Toast.ShowSuccess("Prescription submitted successfully."); }
        else Toast.ShowError(r.Message ?? "Failed to submit.");
        _saving = false;
    }

    private async Task OnFileUploaded(IBrowserFile file)
    {
        if (PrescriptionId == Guid.Empty) { Toast.ShowWarning("Save the prescription first."); return; }
        using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        var r = await PrescriptionClient.UploadReportAsync(PrescriptionId, stream, file.Name);
        if (r.Success)
        {
            Toast.ShowSuccess("Report uploaded.");
            var pr = await PrescriptionClient.GetPrescriptionByIdAsync(PrescriptionId);
            if (pr.Success) _prescription = pr.Data;
        }
        else Toast.ShowError(r.Message ?? "Upload failed.");
    }

    private IReadOnlyList<CreatePrescriptionItemDto> BuildItemDtos()
    {
        for (var i = 0; i < _items.Count; i++) AutoFillRemark(i);

        return _items.Select((item, idx) => new CreatePrescriptionItemDto(
            item.MedicineId, item.MedicineName, item.MedicineForm,
            NullIfEmpty(item.Strength),
            string.IsNullOrWhiteSpace(item.DosageUnit) ? GetDefaultUnit(item.MedicineForm) : item.DosageUnit,
            decimal.TryParse(item.DosageMorningStr, out var m) ? m : null,
            decimal.TryParse(item.DosageAfternoonStr, out var a) ? a : null,
            decimal.TryParse(item.DosageEveningStr, out var e) ? e : null,
            decimal.TryParse(item.DosageNightStr, out var n) ? n : null,
            item.DurationDays, item.Quantity,
            NullIfEmpty(item.Frequency), NullIfEmpty(item.Timing),
            NullIfEmpty(string.Join(", ", item.InstructionList)),
            item.RemarkEnglish, item.RemarkHindi, item.RemarkMarathi, idx)).ToList();
    }

    private static string GetDefaultUnit(MedicineFormType form) => form switch
    {
        MedicineFormType.Tab or MedicineFormType.Capsule => "tablet",
        MedicineFormType.Syrup => "ml",
        MedicineFormType.Drops => "drops",
        MedicineFormType.Tube => "application",
        MedicineFormType.Injection => "dose",
        MedicineFormType.Powder => "sachet",
        MedicineFormType.Other => "dose",
        _ => "unit"
    };

    private static readonly string[] _doseUnits = ["tablet", "capsule", "ml", "drops", "sachet", "application", "puff", "dose", "unit"];

    private static List<string> GetDefaultInstructions(MedicineFormType form) => form switch
    {
        MedicineFormType.Tab or MedicineFormType.Capsule or MedicineFormType.Powder or MedicineFormType.Syrup => ["After meals"],
        MedicineFormType.Tube => ["Apply externally on affected area"],
        MedicineFormType.Drops => ["Instill as directed"],
        MedicineFormType.Injection => ["To be administered by healthcare professional"],
        MedicineFormType.Other => ["Use as directed"],
        _ => []
    };

