    private static string MedicineDisplay(MedicineDto? m)
    {
        if (m is null) return string.Empty;
        return string.IsNullOrEmpty(m.DosageFormName) ? m.Name : $"{m.Name} ({m.DosageFormName})";
    }

    private static string FormIcon(MedicineFormType form) => form switch
    {
        MedicineFormType.Tab => "💊",
        MedicineFormType.Capsule => "💊",
        MedicineFormType.Syrup => "🧴",
        MedicineFormType.Injection => "💉",
        MedicineFormType.Drops => "💧",
        MedicineFormType.Tube => "🧴",
        MedicineFormType.Powder => "🥄",
        _ => "💊"
    };

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        await ClinicContext.InitializeAsync();
        if (!AuthState.IsClinical(ClinicContext.SelectedApplicationId))
        {
            Navigation.NavigateTo("/dashboard", replace: true);
            return;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!AuthState.IsClinical(ClinicContext.SelectedApplicationId)) return;
        _loading = true;
        try
        {
            var drR = await DoctorProfileClient.GetMyProfileAsync();
            if (drR.Success && drR.Data is not null)
            {
                _doctorProfile = drR.Data;
                _isGynecologist = _doctorProfile.SpecialityName?
                    .Contains("Gynec", StringComparison.OrdinalIgnoreCase) == true;
            }

            if (PrescriptionId != Guid.Empty)
            {
                var r = await PrescriptionClient.GetPrescriptionByIdAsync(PrescriptionId);
                if (r.Success && r.Data is not null)
                    await LoadFromPrescription(r.Data);
            }
            else if (OpdRegistrationId != Guid.Empty)
            {
                var r = await ClinicClient.GetOpdRegistrationByIdAsync(OpdRegistrationId);
                if (r.Success && r.Data is not null)
                {
                    _opd = r.Data;
                    _vBP = _opd.BloodPressure ?? string.Empty;
                    _vPulse = _opd.PulseRate?.ToString() ?? string.Empty;
                    _vWeight = _opd.Weight?.ToString("F1") ?? string.Empty;
                    _vSpO2 = _opd.OxygenSaturation?.ToString("F1") ?? string.Empty;
                    await LoadPatientAndHistory(_opd.PatientId);
                }
            }

            var cfgR = await PrescriptionClient.GetPrescriptionConfigAsync();
            if (cfgR.Success && cfgR.Data is not null)
            {
                var cfg = cfgR.Data;
                _lang = cfg.DefaultLanguage switch
                {
                    PrescriptionLanguage.Hindi => "hi",
                    PrescriptionLanguage.Marathi => "mr",
                    _ => "en"
                };
                _pMarginTop    = cfg.PrintMarginTop;
                _pMarginRight  = cfg.PrintMarginRight;
                _pMarginBottom = cfg.PrintMarginBottom;
                _pMarginLeft   = cfg.PrintMarginLeft;
                _pHideHeader   = cfg.HideClinicHeader;
            }
        }
        finally { _loading = false; }
    }

    private async Task LoadFromPrescription(PrescriptionDto dto)
    {
        _prescription = dto;
        _diagnosis = dto.Diagnosis ?? string.Empty;
        _investigations = dto.Investigations.ToList();
        _notes = dto.Notes ?? string.Empty;
        _followup = dto.NextVisitDate;
        _vBP = dto.VitalBP ?? string.Empty;
        _vPulse = dto.VitalPulse?.ToString() ?? string.Empty;
        _vTemp = dto.VitalTemp?.ToString("F1") ?? string.Empty;
        _vWeight = dto.VitalWeight?.ToString("F1") ?? string.Empty;
        _vSpO2 = dto.VitalSpO2?.ToString("F1") ?? string.Empty;
        _vRR = dto.VitalRR?.ToString() ?? string.Empty;
        _vSugar = dto.VitalSugar?.ToString("F1") ?? string.Empty;
        _items = dto.Items.Select(i => new PrescriptionItemRow
        {
            MedicineId = i.MedicineId,
            MedicineName = i.MedicineName,
            MedicineForm = i.MedicineForm,
            Strength = i.Strength ?? string.Empty,
            DosageUnit = i.DosageUnit,
            DosageMorningStr = i.DosageMorning?.ToString(),
            DosageAfternoonStr = i.DosageAfternoon?.ToString(),
            DosageEveningStr = i.DosageEvening?.ToString(),
            DosageNightStr = i.DosageNight?.ToString(),
            DurationDays = i.DurationDays,
            DurationInput = $"{i.DurationDays} days",
            Quantity = i.Quantity,
            Frequency = i.Frequency ?? string.Empty,
            Timing = i.Timing ?? string.Empty,
            Instructions = i.Instructions ?? string.Empty,
            InstructionList = string.IsNullOrWhiteSpace(i.Instructions)
                ? []
                : i.Instructions.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList(),
            RemarkEnglish = i.RemarkEnglish,
            RemarkHindi = i.RemarkHindi,
            RemarkMarathi = i.RemarkMarathi,
        }).ToList();

        foreach (var item in _items)
        {
            item.DoseAmountStr = item.DosageMorningStr ?? item.DosageAfternoonStr
                ?? item.DosageEveningStr ?? item.DosageNightStr ?? "1";
            UpdateTimingSummary(item);
        }

        if (_isGynecologist && dto.ObstetricData is not null)
            CarryForwardObstetricData(dto.ObstetricData);

        var opdR = await ClinicClient.GetOpdRegistrationByIdAsync(dto.OpdRegistrationId);
        if (opdR.Success) _opd = opdR.Data;
        if (_opd is not null) await LoadPatientAndHistory(_opd.PatientId);
        CheckInteractions();
    }

    private async Task LoadPatientAndHistory(Guid patientId)
    {
        var pR = await ClinicClient.GetPatientByIdAsync(patientId);
        if (pR.Success) _patient = pR.Data;

        if (_isGynecologist)
            await LoadActiveTenureAsync(patientId);

        var histR = await PrescriptionClient.GetPrescriptionsAsync(patientId: patientId, pageSize: 20);
        if (histR.Success && histR.Data is not null)
        {
            _history = histR.Data.Items.Where(p => p.Id != PrescriptionId).ToList();

            // Carry forward obstetric data for new prescriptions (gynecologist only)
            if (_isGynecologist && PrescriptionId == Guid.Empty)
            {
                var lastWithObs = _history
                    .OrderByDescending(p => p.PrescribedDate)
                    .FirstOrDefault(p => p.ObstetricData is not null);
                if (lastWithObs?.ObstetricData is not null)
                    CarryForwardObstetricData(lastWithObs.ObstetricData);
            }
        }
    }

