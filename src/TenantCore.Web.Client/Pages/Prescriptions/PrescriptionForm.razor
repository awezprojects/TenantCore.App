    // Tube/ointment doses aren't counted (you don't say "2 ointments") — always exactly 1 application.
    private static bool IsDoseLocked(PrescriptionItemRow item) => item.MedicineForm == MedicineFormType.Tube;

    // Eye/ear/nose drops are counted individually — "1.5 drops" isn't a real instruction.
    private static bool IsIntegerDoseUnit(string? unit) => string.Equals(unit, "drops", StringComparison.OrdinalIgnoreCase);

    private static string DoseStepAttr(PrescriptionItemRow item) =>
        IsDoseLocked(item) || IsIntegerDoseUnit(item.DosageUnit) ? "1" : "0.5";

    // Enforces the locked/whole-number rules above whenever a dose value is entered or changed.
    private static string? SanitizeDoseStr(PrescriptionItemRow item, string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return IsDoseLocked(item) ? null : raw;
        if (IsDoseLocked(item)) return "1";
        if (!decimal.TryParse(raw, out var v) || v <= 0) return raw;
        if (IsIntegerDoseUnit(item.DosageUnit)) v = Math.Round(v, MidpointRounding.AwayFromZero);
        return FormatAmount(v);
    }

    private void SelectFrequency(PrescriptionItemRow item, int idx, string code)
    {
        item.Frequency = code;
        var dose = SanitizeDoseStr(item, string.IsNullOrWhiteSpace(item.DoseAmountStr) ? "1" : item.DoseAmountStr) ?? "1";
        item.DoseAmountStr = dose;
        switch (code)
        {
            case "OD":
                item.DosageMorningStr = dose; item.DosageAfternoonStr = null;
                item.DosageEveningStr = null; item.DosageNightStr = null;
                break;
            case "BD":
                item.DosageMorningStr = dose; item.DosageAfternoonStr = null;
                item.DosageEveningStr = null; item.DosageNightStr = dose;
                break;
            case "TDS":
                item.DosageMorningStr = dose; item.DosageAfternoonStr = dose;
                item.DosageEveningStr = null; item.DosageNightStr = dose;
                break;
            case "QID":
                item.DosageMorningStr = dose; item.DosageAfternoonStr = dose;
                item.DosageEveningStr = dose; item.DosageNightStr = dose;
                break;
            case "HS":
                item.DosageMorningStr = null; item.DosageAfternoonStr = null;
                item.DosageEveningStr = null; item.DosageNightStr = dose;
                break;
            case "SOS":
                item.DosageMorningStr = null; item.DosageAfternoonStr = null;
                item.DosageEveningStr = null; item.DosageNightStr = null;
                break;
        }
        UpdateTimingSummary(item);
        RecalcQuantity(idx);
    }

    // Re-applies the "dose per intake" amount to whichever slots are currently active,
    // keeping the frequency pattern intact while changing only the quantity taken each time.
    private void OnDoseAmountChanged(PrescriptionItemRow item, int idx)
    {
        var dose = SanitizeDoseStr(item, string.IsNullOrWhiteSpace(item.DoseAmountStr) ? "1" : item.DoseAmountStr) ?? "1";
        item.DoseAmountStr = dose;
        if (item.DosageMorningStr is not null) item.DosageMorningStr = dose;
        if (item.DosageAfternoonStr is not null) item.DosageAfternoonStr = dose;
        if (item.DosageEveningStr is not null) item.DosageEveningStr = dose;
        if (item.DosageNightStr is not null) item.DosageNightStr = dose;
        RecalcQuantity(idx);
    }

    // Called when a doctor manually edits a single time-slot dose (e.g. half tablet at night only).
    // The per-slot fields become the source of truth from this point on.
    private void OnSlotDoseChanged(PrescriptionItemRow item, int idx)
    {
        item.DosageMorningStr = SanitizeDoseStr(item, item.DosageMorningStr);
        item.DosageAfternoonStr = SanitizeDoseStr(item, item.DosageAfternoonStr);
        item.DosageEveningStr = SanitizeDoseStr(item, item.DosageEveningStr);
        item.DosageNightStr = SanitizeDoseStr(item, item.DosageNightStr);
        UpdateTimingSummary(item);
        RecalcQuantity(idx);
    }

    // ── Timing is always derived from which dose slots are filled — never chosen independently,
    // so Frequency and Timing can never disagree (fixes the two controls drifting apart).
    private static List<string> GetActiveSlots(PrescriptionItemRow item)
    {
        var list = new List<string>();
        if (!string.IsNullOrWhiteSpace(item.DosageMorningStr)) list.Add("Morning");
        if (!string.IsNullOrWhiteSpace(item.DosageAfternoonStr)) list.Add("Afternoon");
        if (!string.IsNullOrWhiteSpace(item.DosageEveningStr)) list.Add("Evening");
        if (!string.IsNullOrWhiteSpace(item.DosageNightStr)) list.Add("Night");
        return list;
    }

    private static string BuildTimingLabel(List<string> slots, string lang)
    {
        if (slots.Count == 0)
            return lang switch { "hi" => "आवश्यकतानुसार", "mr" => "आवश्यकतेनुसार", _ => "As needed" };

        var map = lang switch
        {
            "hi" => new Dictionary<string, string> { ["Morning"] = "सुबह", ["Afternoon"] = "दोपहर", ["Evening"] = "शाम", ["Night"] = "रात" },
            "mr" => new Dictionary<string, string> { ["Morning"] = "सकाळी", ["Afternoon"] = "दुपारी", ["Evening"] = "संध्याकाळी", ["Night"] = "रात्री" },
            _    => new Dictionary<string, string> { ["Morning"] = "Morning", ["Afternoon"] = "Afternoon", ["Evening"] = "Evening", ["Night"] = "Night" },
        };
        var and = lang switch { "hi" => "और", "mr" => "आणि", _ => "&" };
        var labels = slots.Select(s => map[s]).ToList();
        return labels.Count == 1
            ? labels[0]
            : string.Join(", ", labels.Take(labels.Count - 1)) + $" {and} " + labels[^1];
    }

    // item.Timing stores the canonical English label (back-compat with the saved DTO / older prescriptions);
    // on-screen and print always re-derive the localized label from the dose slots via BuildTimingLabel.
    private static void UpdateTimingSummary(PrescriptionItemRow item)
        => item.Timing = BuildTimingLabel(GetActiveSlots(item), "en");

    // Standard prescription pattern: 3 numbers (Morning-Afternoon-Night) for the common cases —
    // "1-0-1" for twice a day, "1-0-0" for morning only, "0-0-1" for night only, "1-1-1" for
    // three times a day. The 4th (Evening) slot only appears — becoming "1-1-1-1" — when a dose
    // is actually given in the evening, since that's the one pattern that needs it.
    private static string BuildSlotPattern(PrescriptionItemRow item)
    {
        if (item.Frequency == "SOS" && GetActiveSlots(item).Count == 0) return "SOS";
        string Slot(string? s) => decimal.TryParse(s, out var v) && v > 0 ? FormatAmount(v) : "0";
        if (decimal.TryParse(item.DosageEveningStr, out var e) && e > 0)
            return $"{Slot(item.DosageMorningStr)}-{Slot(item.DosageAfternoonStr)}-{Slot(item.DosageEveningStr)}-{Slot(item.DosageNightStr)}";
        return $"{Slot(item.DosageMorningStr)}-{Slot(item.DosageAfternoonStr)}-{Slot(item.DosageNightStr)}";
    }

