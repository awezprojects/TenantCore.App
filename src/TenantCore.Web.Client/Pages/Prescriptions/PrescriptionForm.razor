    private async Task QuickSaveLmpAsync()
    {
        if (!_lmpValue.HasValue || PrescriptionId == Guid.Empty) return;
        _savingLmp = true;
        var r = await ObstetricClient.SetLmpAsync(PrescriptionId, new SetLmpRequest { Lmp = _lmpValue.Value });
        _savingLmp = false;
        if (r.Success)
        {
            _eddByUsgValue = r.Data?.EddByUsg ?? _eddByUsgValue;
            Snackbar.Add("LMP saved.", Severity.Success);
        }
        else Snackbar.Add(r.Message ?? "Failed to save LMP.", Severity.Error);
    }

    private async Task QuickSaveEddByUsgAsync()
    {
        if (!_eddByUsgValue.HasValue || PrescriptionId == Guid.Empty) return;
        _savingEddUsg = true;
        var r = await ObstetricClient.SetEddByUsgAsync(PrescriptionId, new SetEddByUsgRequest { EddByUsg = _eddByUsgValue.Value });
        _savingEddUsg = false;
        if (r.Success) Snackbar.Add("EDD by USG saved.", Severity.Success);
        else Snackbar.Add(r.Message ?? "Failed to save EDD by USG.", Severity.Error);
    }

    private async Task LoadActiveTenureAsync(Guid patientId)
    {
        var r = await PregnancyTenureClient.GetActiveForPatientAsync(patientId);
        if (r.Success)
        {
            _activeTenure = r.Data;
            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            _tenureOverdue = _activeTenure is not null
                && (_activeTenure.EddByUsg ?? _activeTenure.EddByLmp) < today;
        }
    }

    private async Task OnTenureClosed(PregnancyTenureDto? closed)
    {
        _showCloseTenureModal = false;
        if (closed is not null)
        {
            _activeTenure = null;
            _tenureOverdue = false;
            Snackbar.Add("Tenure closed. You can now set a new LMP.", Severity.Success);
        }
    }

    // ── Remark Generator ──────────────────────────────────────────────────────
    private static string GenerateRemark(PrescriptionItemRow item, string lang)
    {
        if (!string.IsNullOrWhiteSpace(item.RemarkEnglish) && lang == "en") return item.RemarkEnglish;
        if (!string.IsNullOrWhiteSpace(item.RemarkHindi) && lang == "hi") return item.RemarkHindi;
        if (!string.IsNullOrWhiteSpace(item.RemarkMarathi) && lang == "mr") return item.RemarkMarathi;

        var freq = item.Frequency;
        var timing = item.Timing;
        var duration = item.DurationDays > 0 ? $"{item.DurationDays} days" : item.DurationInput;
        var form = item.MedicineForm;

        if (lang == "hi")
        {
            var unit = form is MedicineFormType.Tab ? "गोली" : form is MedicineFormType.Capsule ? "कैप्सूल" : form is MedicineFormType.Syrup ? "मि.ली." : "इकाई";
            var freqHi = freq switch { "OD" => "दिन में एक बार", "BD" => "दिन में दो बार", "TDS" => "दिन में तीन बार", "QID" => "दिन में चार बार", "HS" => "सोते समय", "SOS" => "ज़रूरत पड़ने पर", _ => freq ?? "" };
            var timingHi = timing switch { "Morning" => "सुबह", "Night" => "रात को", "After meals" => "भोजन के बाद", "Before meals" => "भोजन से पहले", "Morning & Night" => "सुबह और रात को", _ => timing ?? "" };
            var parts = new List<string> { $"1 {unit} लें" };
            if (!string.IsNullOrEmpty(freqHi)) parts.Add(freqHi);
            if (!string.IsNullOrEmpty(timingHi)) parts.Add(timingHi);
            if (!string.IsNullOrEmpty(duration)) parts.Add($"{duration} के लिए");
            return string.Join(", ", parts);
        }
        else if (lang == "mr")
        {
            var unit = form is MedicineFormType.Tab ? "गोळी" : form is MedicineFormType.Capsule ? "कॅप्सूल" : form is MedicineFormType.Syrup ? "मि.ली." : "युनिट";
            var freqMr = freq switch { "OD" => "दिवसातून एकदा", "BD" => "दिवसातून दोनदा", "TDS" => "दिवसातून तीनदा", "QID" => "दिवसातून चार वेळा", "HS" => "झोपण्यापूर्वी", "SOS" => "आवश्यक असल्यास", _ => freq ?? "" };
            var timingMr = timing switch { "Morning" => "सकाळी", "Night" => "रात्री", "After meals" => "जेवणानंतर", "Before meals" => "जेवणापूर्वी", "Morning & Night" => "सकाळी आणि रात्री", _ => timing ?? "" };
            var parts = new List<string> { $"1 {unit} घ्या" };
            if (!string.IsNullOrEmpty(freqMr)) parts.Add(freqMr);
            if (!string.IsNullOrEmpty(timingMr)) parts.Add(timingMr);
            if (!string.IsNullOrEmpty(duration)) parts.Add($"{duration} साठी");
            return string.Join(", ", parts);
        }
        else
        {
            var unit = form is MedicineFormType.Tab ? "tablet" : form is MedicineFormType.Capsule ? "capsule" : form is MedicineFormType.Syrup ? "ml" : "unit";
            var freqEn = freq switch { "OD" => "once a day", "BD" => "twice a day", "TDS" => "three times a day", "QID" => "four times a day", "HS" => "at bedtime", "SOS" => "when required", "OW" => "once weekly", "BW" => "twice weekly", _ => freq ?? "" };
            var timingEn = timing switch { "Morning" => "in the morning", "Night" => "at night", "After meals" => "after meals", "Before meals" => "before meals", "Morning & Night" => "morning and night", "Empty stomach" => "on empty stomach", _ => timing?.ToLower() ?? "" };
            var parts = new List<string> { $"Take 1 {unit}" };
            if (!string.IsNullOrEmpty(freqEn)) parts.Add(freqEn);
            if (!string.IsNullOrEmpty(timingEn)) parts.Add(timingEn);
            if (!string.IsNullOrEmpty(duration)) parts.Add($"for {duration}");
            var instrStr = string.Join(", ", item.InstructionList);
            if (!string.IsNullOrEmpty(instrStr)) parts.Add(instrStr);
            return string.Join(", ", parts);
        }
    }

    private class PrescriptionItemRow
    {
        public Guid MedicineId { get; set; }
        public string MedicineName { get; set; } = string.Empty;
        public string? GenericName { get; set; }
        public MedicineFormType MedicineForm { get; set; } = MedicineFormType.Tab;
        public string Strength { get; set; } = string.Empty;
        public string DosageUnit { get; set; } = "tablet";
        public string? DosageMorningStr { get; set; }
        public string? DosageAfternoonStr { get; set; }
        public string? DosageEveningStr { get; set; }
        public string? DosageNightStr { get; set; }
        public int DurationDays { get; set; } = 7;
        public string DurationInput { get; set; } = "7 days";
        public decimal Quantity { get; set; }
        public string Frequency { get; set; } = string.Empty;
        public string Timing { get; set; } = string.Empty;
        public string Instructions { get; set; } = string.Empty;
        public List<string> InstructionList { get; set; } = [];
        public string? RemarkEnglish { get; set; }
        public string? RemarkHindi { get; set; }
        public string? RemarkMarathi { get; set; }
    }
