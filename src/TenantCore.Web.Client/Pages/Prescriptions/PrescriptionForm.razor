    private UpsertObstetricPrescriptionDataDto? BuildObstetricDto()
    {
        if (!_isGynecologist) return null;
        var hasData = _obsGravida.HasValue || _obsPara.HasValue || _obsLive.HasValue ||
                      _obsAbortion.HasValue || !string.IsNullOrWhiteSpace(_obsInformation) ||
                      _menstrualHistory.Count > 0 || _pamHistory.Count > 0 || _familyHistory.Count > 0 ||
                      _lmpValue.HasValue || _eddByUsgValue.HasValue;
        if (!hasData) return null;
        return new UpsertObstetricPrescriptionDataDto(
            _obsGravida, _obsPara, _obsLive, _obsAbortion,
            NullIfEmpty(_obsInformation),
            _menstrualHistory.Count > 0 ? _menstrualHistory : null,
            _pamHistory.Count > 0 ? _pamHistory : null,
            _familyHistory.Count > 0 ? _familyHistory : null,
            Lmp: _lmpValue,
            EddByUsg: _eddByUsgValue);
    }

    private void CarryForwardObstetricData(ObstetricPrescriptionDataDto source)
    {
        _obsGravida = source.Gravida;
        _obsPara = source.Para;
        _obsLive = source.Live;
        _obsAbortion = source.Abortion;
        _obsInformation = source.Information ?? string.Empty;
        _menstrualHistory = source.MenstrualHistory.ToList();
        _pamHistory = source.PastMedicalHistory.ToList();
        _familyHistory = source.FamilyHistory.ToList();
        _lmpValue = source.Lmp;
        _eddByUsgValue = source.EddByUsg;
    }

    // ── Obstetric quick-save (existing prescriptions only) ───────────────────
    private async Task QuickSaveLmpAsync()
    {
        if (!_lmpValue.HasValue || PrescriptionId == Guid.Empty) return;
        _savingLmp = true;
        var r = await ObstetricClient.SetLmpAsync(PrescriptionId, new SetLmpRequest { Lmp = _lmpValue.Value });
        _savingLmp = false;
        if (r.Success)
        {
            _eddByUsgValue = r.Data?.EddByUsg ?? _eddByUsgValue;
            Toast.ShowSuccess("LMP saved.");
        }
        else Toast.ShowError(r.Message ?? "Failed to save LMP.");
    }

    private async Task QuickSaveEddByUsgAsync()
    {
        if (!_eddByUsgValue.HasValue || PrescriptionId == Guid.Empty) return;
        _savingEddUsg = true;
        var r = await ObstetricClient.SetEddByUsgAsync(PrescriptionId, new SetEddByUsgRequest { EddByUsg = _eddByUsgValue.Value });
        _savingEddUsg = false;
        if (r.Success) Toast.ShowSuccess("EDD by USG saved.");
        else Toast.ShowError(r.Message ?? "Failed to save EDD by USG.");
    }

    private async Task LoadActiveTenureAsync(Guid patientId)
    {
        var r = await PregnancyTenureClient.GetActiveForPatientAsync(patientId);
        if (r.Success)
        {
            _activeTenure = r.Data;
            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            _tenureOverdue = _activeTenure is not null
                && (_activeTenure.EddByUsg ?? _activeTenure.EddByLmp) < today;
        }
    }

    private async Task OnTenureClosed(PregnancyTenureDto? closed)
    {
        _showCloseTenureModal = false;
        if (closed is not null)
        {
            _activeTenure = null;
            _tenureOverdue = false;
            Toast.ShowSuccess("Tenure closed. You can now set a new LMP.");
        }
    }

    // ── Remark Generator ──────────────────────────────────────────────────────
    private static string FormatAmount(decimal d) => d == Math.Floor(d) ? d.ToString("0") : d.ToString("0.##");

    private static string UnitLabel(string unit, string lang)
    {
        var en = new Dictionary<string, string> { ["tablet"] = "tab", ["capsule"] = "cap", ["ml"] = "ml", ["drops"] = "drops", ["sachet"] = "sachet", ["application"] = "application", ["puff"] = "puff", ["dose"] = "dose", ["unit"] = "unit" };
        var hi = new Dictionary<string, string> { ["tablet"] = "गोली", ["capsule"] = "कैप्सूल", ["ml"] = "मि.ली.", ["drops"] = "बूंद", ["sachet"] = "पुड़िया", ["application"] = "लेप", ["puff"] = "पफ", ["dose"] = "खुराक", ["unit"] = "इकाई" };
        var mr = new Dictionary<string, string> { ["tablet"] = "गोळी", ["capsule"] = "कॅप्सूल", ["ml"] = "मि.ली.", ["drops"] = "थेंब", ["sachet"] = "पुडी", ["application"] = "लेप", ["puff"] = "पफ", ["dose"] = "मात्रा", ["unit"] = "युनिट" };
        var dict = lang switch { "hi" => hi, "mr" => mr, _ => en };
        return dict.TryGetValue(unit, out var label) ? label : unit;
    }

    // Describes the dose amount(s): "1 tablet" when every active slot takes the same amount,
    // or a per-slot breakdown ("1 tablet – Morning, 0.5 tablet – Night") when they differ
    // (e.g. half a tablet at night only).
    private static string DescribeDose(PrescriptionItemRow item, string lang)
    {
        var unit = UnitLabel(string.IsNullOrWhiteSpace(item.DosageUnit) ? GetDefaultUnit(item.MedicineForm) : item.DosageUnit, lang);
        var slots = new (string Key, string? Str)[]
        {
            ("Morning", item.DosageMorningStr), ("Afternoon", item.DosageAfternoonStr),
            ("Evening", item.DosageEveningStr), ("Night", item.DosageNightStr),
        };
        var active = slots.Where(s => decimal.TryParse(s.Str, out var v) && v > 0)
                           .Select(s => (s.Key, Val: decimal.Parse(s.Str!))).ToList();

        if (active.Count == 0)
            return lang switch { "hi" => $"1 {unit} लें", "mr" => $"1 {unit} घ्या", _ => $"Take 1 {unit}" };

        var sameAmount = active.Select(a => a.Val).Distinct().Count() == 1;
        if (sameAmount)
        {
            var amt = FormatAmount(active[0].Val);
            return lang switch { "hi" => $"{amt} {unit} लें", "mr" => $"{amt} {unit} घ्या", _ => $"Take {amt} {unit}" };
        }

        var slotLabels = lang switch
        {
            "hi" => new Dictionary<string, string> { ["Morning"] = "सुबह", ["Afternoon"] = "दोपहर", ["Evening"] = "शाम", ["Night"] = "रात" },
            "mr" => new Dictionary<string, string> { ["Morning"] = "सकाळी", ["Afternoon"] = "दुपारी", ["Evening"] = "संध्याकाळी", ["Night"] = "रात्री" },
            _    => new Dictionary<string, string> { ["Morning"] = "Morning", ["Afternoon"] = "Afternoon", ["Evening"] = "Evening", ["Night"] = "Night" },
        };
        return string.Join(", ", active.Select(a => $"{FormatAmount(a.Val)} {unit} – {slotLabels[a.Key]}"));
    }

    // Always regenerated live from the item's current fields — there's no manual free-text
    // editor for the remark, so a stored value would only ever be stale leftover formatting
    // from a previous version of this logic. AutoFillRemark still populates RemarkEnglish/
    // Hindi/Marathi on save purely so the print page (and any external consumer) has a value.
    private static string GenerateRemark(PrescriptionItemRow item, string lang)
    {
        var freq = item.Frequency;
        var dose = DescribeDose(item, lang);

        // Duration/quantity have their own dedicated display (composer row fields + the Freq
        // pattern column on print), so they're deliberately left out of the remark text.
        if (lang == "hi")
        {
            var freqHi = freq switch { "OD" => "दिन में एक बार", "BD" => "दिन में दो बार", "TDS" => "दिन में तीन बार", "QID" => "दिन में चार बार", "HS" => "सोते समय", "SOS" => "ज़रूरत पड़ने पर", _ => freq ?? "" };
            var parts = new List<string> { dose };
            if (!string.IsNullOrEmpty(freqHi)) parts.Add(freqHi);
            return string.Join(", ", parts);
        }
        else if (lang == "mr")
        {
            var freqMr = freq switch { "OD" => "दिवसातून एकदा", "BD" => "दिवसातून दोनदा", "TDS" => "दिवसातून तीनदा", "QID" => "दिवसातून चार वेळा", "HS" => "झोपण्यापूर्वी", "SOS" => "आवश्यक असल्यास", _ => freq ?? "" };
            var parts = new List<string> { dose };
            if (!string.IsNullOrEmpty(freqMr)) parts.Add(freqMr);
            return string.Join(", ", parts);
        }
        else
        {
            var freqEn = freq switch { "OD" => "once a day", "BD" => "twice a day", "TDS" => "three times a day", "QID" => "four times a day", "HS" => "at bedtime", "SOS" => "when required", "OW" => "once weekly", "BW" => "twice weekly", _ => freq ?? "" };
            var parts = new List<string> { dose };
            if (!string.IsNullOrEmpty(freqEn)) parts.Add(freqEn);
            var instrStr = string.Join(", ", item.InstructionList);
            if (!string.IsNullOrEmpty(instrStr)) parts.Add(instrStr);
            return string.Join(", ", parts);
        }
    }

    private class PrescriptionItemRow
    {
        public Guid MedicineId { get; set; }
        public string MedicineName { get; set; } = string.Empty;
        public string? GenericName { get; set; }
        public MedicineFormType MedicineForm { get; set; } = MedicineFormType.Tab;
        public string Strength { get; set; } = string.Empty;
        public string DosageUnit { get; set; } = "tablet";
        // UI convenience only — the "dose per intake" the frequency presets apply to every active slot.
        // Not sent to the backend directly; per-slot Dosage*Str values are the source of truth.
        public string DoseAmountStr { get; set; } = "1";
        public bool CustomizePerSlot { get; set; }
        public string? DosageMorningStr { get; set; }
        public string? DosageAfternoonStr { get; set; }
        public string? DosageEveningStr { get; set; }
        public string? DosageNightStr { get; set; }
        public int DurationDays { get; set; } = 7;
        public string DurationInput { get; set; } = "7 days";
        public decimal Quantity { get; set; }
        public string Frequency { get; set; } = string.Empty;
        public string Timing { get; set; } = string.Empty;
        public string Instructions { get; set; } = string.Empty;
        public List<string> InstructionList { get; set; } = [];
        public string? RemarkEnglish { get; set; }
        public string? RemarkHindi { get; set; }
        public string? RemarkMarathi { get; set; }
    }
}
