@code {
    [Parameter] public Guid PrescriptionId { get; set; }

    private bool _loading = true;
    private PrescriptionDto? _prescription;
    private PatientDto? _patient;
    private ApplicationResponseDto? _clinic;
    private DoctorProfileDto? _doctorProfile;

    private PrescriptionConfigDto? _config;

    // OnAfterRenderAsync is the only safe place in Blazor WASM to call JS interop
    // (localStorage) before firing authenticated API calls. Parent OnInitializedAsync
    // tasks can still be in-flight when a child OnInitializedAsync starts, causing 401s.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            await AuthState.InitializeAsync();
            await ClinicContext.InitializeAsync();
            await LoadPrescription();
            await Task.WhenAll(LoadClinic(), LoadConfig());
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadPrescription()
    {
        var r = await PrescriptionClient.GetPrescriptionByIdAsync(PrescriptionId);
        if (r.Success && r.Data is not null)
        {
            _prescription = r.Data;

            var patientTask = _prescription.PatientId != Guid.Empty
                ? ClinicClient.GetPatientByIdAsync(_prescription.PatientId)
                : Task.FromResult(new ApiResponse<PatientDto>());
            var doctorTask = DoctorProfileClient.GetMyProfileAsync();

            await Task.WhenAll(patientTask, doctorTask);

            var pr = await patientTask;
            if (pr.Success && pr.Data is not null) _patient = pr.Data;

            var dr = await doctorTask;
            if (dr.Success && dr.Data is not null) _doctorProfile = dr.Data;
        }
    }

    private async Task LoadClinic()
    {
        var clinicId = ClinicContext.SelectedApplicationId != Guid.Empty
            ? ClinicContext.SelectedApplicationId
            : _prescription?.ApplicationId ?? Guid.Empty;
        if (clinicId == Guid.Empty) return;
        var cr = await AppClient.GetApplicationByIdAsync(clinicId);
        if (cr.Success && cr.Data is not null) _clinic = cr.Data;
    }

    private async Task LoadConfig()
    {
        var cfgR = await PrescriptionClient.GetPrescriptionConfigAsync();
        if (cfgR.Success && cfgR.Data is not null)
        {
            _config = cfgR.Data;
            var c = _config;
            if (c.PrintMarginTop != 0 || c.PrintMarginRight != 0 || c.PrintMarginBottom != 0 || c.PrintMarginLeft != 0)
            {
                var marginCss = $"@page{{margin:{c.PrintMarginTop}mm {c.PrintMarginRight}mm {c.PrintMarginBottom}mm {c.PrintMarginLeft}mm;}}";
                await JS.InvokeVoidAsync("eval",
                    "(function(){" +
                    "var e=document.getElementById('_rxps');" +
                    "if(!e){e=document.createElement('style');e.id='_rxps';document.head.appendChild(e);}" +
                    $"e.textContent='{marginCss}';" +
                    "})()");
            }
        }
    }

    private async Task PrintPage() => await JS.InvokeVoidAsync("window.print");

    // Pick the remark in the clinic's configured language.
    // Falls back: configured language → English remark → auto-generated text in configured language.
    private string GetInstructionText(PrescriptionItemDto item)
    {
        var lang = _config?.DefaultLanguage ?? PrescriptionLanguage.English;

        var stored = lang switch
        {
            PrescriptionLanguage.Marathi => item.RemarkMarathi,
            PrescriptionLanguage.Hindi   => item.RemarkHindi,
            _                            => item.RemarkEnglish
        };
        if (!string.IsNullOrWhiteSpace(stored)) return stored;

        // Fall back to English remark if the target language remark was not saved
        if (!string.IsNullOrWhiteSpace(item.RemarkEnglish) && lang == PrescriptionLanguage.English)
            return item.RemarkEnglish;

        // Auto-generate in the configured language
        return lang switch
        {
            PrescriptionLanguage.Marathi => BuildMarathiRemark(item),
            PrescriptionLanguage.Hindi   => BuildHindiRemark(item),
            _                            => BuildEnglishRemark(item)
        };
    }

    private static string BuildEnglishRemark(PrescriptionItemDto item)
    {
        var unit = item.MedicineForm switch
        {
            MedicineFormType.Tab     => "tablet",
            MedicineFormType.Capsule => "capsule",
            MedicineFormType.Syrup   => "ml",
            _                        => "unit"
        };
        var freq = item.Frequency switch
        {
            "OD"  => "once a day",       "BD"  => "twice a day",
            "TDS" => "three times a day","QID" => "four times a day",
            "HS"  => "at bedtime",       "SOS" => "when required",
            "OW"  => "once weekly",      "BW"  => "twice weekly",
            _     => item.Frequency ?? ""
        };
        var parts = new List<string> { $"Take 1 {unit}" };
        if (!string.IsNullOrEmpty(freq)) parts.Add(freq);
        if (!string.IsNullOrEmpty(item.Timing)) parts.Add(item.Timing.ToLower());
        parts.Add($"for {item.DurationDays} days");
        if (!string.IsNullOrEmpty(item.Instructions)) parts.Add(item.Instructions);
        return string.Join(", ", parts);
    }

    private static string BuildHindiRemark(PrescriptionItemDto item)
    {
        var unit = item.MedicineForm switch
        {
            MedicineFormType.Tab     => "गोली",
            MedicineFormType.Capsule => "कैप्सूल",
            MedicineFormType.Syrup   => "मिली",
            _                        => "यूनिट"
        };
        var freq = item.Frequency switch
        {
            "OD"  => "दिन में एक बार",   "BD"  => "दिन में दो बार",
            "TDS" => "दिन में तीन बार",  "QID" => "दिन में चार बार",
            "HS"  => "सोते समय",          "SOS" => "जरूरत पड़ने पर",
            "OW"  => "हफ्ते में एक बार", "BW"  => "हफ्ते में दो बार",
            _     => item.Frequency ?? ""
        };
        var parts = new List<string> { $"1 {unit} लें" };
        if (!string.IsNullOrEmpty(freq)) parts.Add(freq);
        parts.Add($"{item.DurationDays} दिनों के लिए");
        if (!string.IsNullOrEmpty(item.Instructions)) parts.Add(item.Instructions);
        return string.Join(", ", parts);
    }

    private static string BuildMarathiRemark(PrescriptionItemDto item)
    {
        var unit = item.MedicineForm switch
        {
            MedicineFormType.Tab     => "गोळी",
            MedicineFormType.Capsule => "कॅप्सूल",
            MedicineFormType.Syrup   => "मिली",
            _                        => "युनिट"
        };
        var freq = item.Frequency switch
        {
            "OD"  => "दिवसातून एकदा",    "BD"  => "दिवसातून दोनदा",
            "TDS" => "दिवसातून तीनदा",   "QID" => "दिवसातून चारदा",
            "HS"  => "झोपताना",           "SOS" => "गरज असेल तेव्हा",
            "OW"  => "आठवड्यातून एकदा", "BW"  => "आठवड्यातून दोनदा",
            _     => item.Frequency ?? ""
        };
        var parts = new List<string> { $"1 {unit} घ्या" };
        if (!string.IsNullOrEmpty(freq)) parts.Add(freq);
        parts.Add($"{item.DurationDays} दिवसांसाठी");
        if (!string.IsNullOrEmpty(item.Instructions)) parts.Add(item.Instructions);
        return string.Join(", ", parts);
    }

}
