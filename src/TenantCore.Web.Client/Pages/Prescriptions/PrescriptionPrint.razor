@page "/prescriptions/{PrescriptionId:guid}/print"
@layout PrintLayout
@inject IPrescriptionApiClient PrescriptionClient
@inject IClinicApiClient ClinicClient
@inject IApplicationApiClient AppClient
@inject IDoctorProfileApiClient DoctorProfileClient
@inject ClinicContextService ClinicContext
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using TenantCore.Shared.Dtos
@using TenantCore.Shared.Dtos.Auth
@using TenantCore.Shared.Enums
@using TenantCore.Web.Client.Clients
@using TenantCore.Web.Client.Services

<PageTitle>Print Prescription</PageTitle>

@if (_loading)
{
    <div style="display:flex;justify-content:center;align-items:center;height:100vh;flex-direction:column;gap:12px;">
        <div style="font-size:32px;">⏳</div>
        <div style="font-size:14px;color:#64748B;">Loading prescription...</div>
    </div>
}
else if (_prescription is null)
{
    <div style="display:flex;justify-content:center;align-items:center;height:100vh;flex-direction:column;gap:12px;">
        <div style="font-size:40px;">❌</div>
        <div style="font-size:15px;color:#64748B;">Prescription not found.</div>
        <button @onclick='async () => await JS.InvokeVoidAsync("window.close")'
                style="padding:10px 20px;border-radius:8px;border:none;background:#EF4444;color:#fff;cursor:pointer;font-size:13px;font-weight:600;">
            ✕ Close
        </button>
    </div>
}
else
{
    <!-- ── Print Action Bar (screen only) ─────────────────────── -->
    <div class="no-print" style="background:#1E3A5F;padding:10px 24px;display:flex;align-items:center;justify-content:space-between;gap:12px;position:sticky;top:0;z-index:100;">
        <div style="display:flex;align-items:center;gap:12px;">
            <button @onclick='async () => await JS.InvokeVoidAsync("window.close")'
                    style="padding:7px 16px;border-radius:8px;border:none;background:#EF4444;color:#fff;cursor:pointer;font-size:12px;font-weight:700;">
                ✕ Close
            </button>
            <div style="color:rgba(255,255,255,0.8);font-size:13px;">
                <strong style="color:#fff;">@_prescription.PrescriptionNumber</strong>
                · @_prescription.PatientName
                · @_prescription.PrescribedDate.ToString("dd MMM yyyy")
            </div>
        </div>
        <button @onclick="PrintPage"
                style="padding:9px 22px;border-radius:8px;border:none;background:#fff;color:#1E3A5F;cursor:pointer;font-size:13px;font-weight:800;display:flex;align-items:center;gap:6px;">
            🖨️ Print
        </button>
    </div>

    <!-- ── Prescription Sheet ────────────────────────────────── -->
    <div class="rx-bg">
        <div class="rx-sheet">

            @{
                var hideHeader = _config?.HideClinicHeader ?? false;
                var age = _patient?.DateOfBirth.HasValue == true
                    ? (DateTime.Today.Year - _patient.DateOfBirth.Value.Year).ToString()
                    : null;
                var ageSex = age is not null
                    ? $"{age} yrs / {_patient!.Gender}"
                    : _patient is not null ? _patient.Gender.ToString() : "";
                var uhid = _patient is not null
                    ? $"CC-{_patient.Id.ToString("N")[..8].ToUpper()}"
                    : "—";
                var hasVitals = _prescription.VitalBP != null || _prescription.VitalPulse != null
                    || _prescription.VitalTemp != null || _prescription.VitalWeight != null
                    || _prescription.VitalSpO2 != null || _prescription.VitalRR != null
                    || _prescription.VitalSugar != null;
            }

            <!-- ── Clinic + Doctor Header ──────── -->
            <div class="rx-header @(hideHeader ? "rx-no-print" : "")">
                <div class="rx-header-left">
                    <div class="rx-clinic-name">🏥 @(_clinic?.ApplicationName ?? "Medical Clinic")</div>
                    @{
                        var clinicLine = new List<string>();
                        if (!string.IsNullOrEmpty(_clinic?.Address)) clinicLine.Add(_clinic.Address);
                        if (!string.IsNullOrEmpty(_clinic?.ContactNumber)) clinicLine.Add($"Phone: {_clinic.ContactNumber}");
                    }
                    @if (clinicLine.Count > 0)
                    {
                        <div class="rx-clinic-sub">@string.Join(" · ", clinicLine)</div>
                    }
                    @{
                        var regLine = new List<string>();
                        if (!string.IsNullOrEmpty(_clinic?.RegistrationNumber)) regLine.Add($"Reg. No: {_clinic.RegistrationNumber}");
                        if (!string.IsNullOrEmpty(_clinic?.OfficialEmail)) regLine.Add(_clinic.OfficialEmail);
                    }
                    @if (regLine.Count > 0)
                    {
                        <div class="rx-clinic-sub">@string.Join(" · ", regLine)</div>
                    }
                </div>
                <div class="rx-header-right">
                    <div class="rx-doctor-name">Dr. @_prescription.DoctorName</div>
                    @if (!string.IsNullOrEmpty(_doctorProfile?.QualificationDetails))
                    {
                        <div class="rx-doctor-sub">@_doctorProfile.QualificationDetails</div>
                    }
                    @if (!string.IsNullOrEmpty(_doctorProfile?.SpecialityName))
                    {
                        <div class="rx-doctor-sub">@_doctorProfile.SpecialityName</div>
                    }
                    @if (!string.IsNullOrEmpty(_doctorProfile?.RegistrationNumber))
                    {
                        <div class="rx-doctor-sub">Reg. No: @_doctorProfile.RegistrationNumber</div>
                    }
                </div>
            </div>

            <hr class="rx-rule @(hideHeader ? "rx-no-print" : "")" />

            @if (hideHeader)
            {
                <div class="no-print" style="margin:0 28px 4px;padding:5px 12px;background:#FFF7ED;border:1px dashed #FED7AA;border-radius:4px;font-size:11px;font-weight:700;color:#92400E;letter-spacing:0.4px;text-align:center;">
                    ⚠️ Clinic header &amp; rule are hidden when printing (set in Settings → Print Settings)
                </div>
            }

            <!-- ── Patient Strip ───────────────── -->
            <div class="rx-patient-strip">
                <div class="rx-ps-cell rx-ps-wide">
                    <div class="rx-ps-label">PATIENT NAME</div>
                    <div class="rx-ps-name">@_prescription.PatientName</div>
                    @if (_patient?.Gender is not null)
                    {
                        <div class="rx-ps-sub">@_patient.Gender</div>
                    }
                </div>
                <div class="rx-ps-cell">
                    <div class="rx-ps-label">AGE / SEX</div>
                    <div class="rx-ps-value">@(string.IsNullOrEmpty(ageSex) ? "—" : ageSex)</div>
                </div>
                <div class="rx-ps-cell">
                    <div class="rx-ps-label">UHID</div>
                    <div class="rx-ps-value rx-uhid">@uhid</div>
                </div>
                <div class="rx-ps-cell">
                    <div class="rx-ps-label">DATE / TIME</div>
                    <div class="rx-ps-value">@_prescription.PrescribedDate.ToString("yyyy-MM-dd")</div>
                    <div class="rx-ps-sub">@_prescription.PrescribedDate.ToString("HH:mm")</div>
                </div>
            </div>

            <!-- ── Vital Signs ─────────────────── -->
            @if (hasVitals)
            {
                <div class="rx-section">
                    <div class="rx-section-title">VITAL SIGNS</div>
                    <div class="rx-vitals">
                        @if (_prescription.VitalBP != null)
                        {
                            <div class="rx-vital-cell">
                                <div class="rx-vital-label">BP</div>
                                <div class="rx-vital-value">@_prescription.VitalBP</div>
                                <div class="rx-vital-unit">mmHg</div>
                            </div>
                        }
                        @if (_prescription.VitalPulse != null)
                        {
                            <div class="rx-vital-cell">
                                <div class="rx-vital-label">PULSE</div>
                                <div class="rx-vital-value">@_prescription.VitalPulse</div>
                                <div class="rx-vital-unit">bpm</div>
                            </div>
                        }
                        @if (_prescription.VitalTemp != null)
                        {
                            <div class="rx-vital-cell">
                                <div class="rx-vital-label">TEMP</div>
                                <div class="rx-vital-value">@_prescription.VitalTemp?.ToString("F1")</div>
                                <div class="rx-vital-unit">°F</div>
                            </div>
                        }
                        @if (_prescription.VitalWeight != null)
                        {
                            <div class="rx-vital-cell">
                                <div class="rx-vital-label">WEIGHT</div>
                                <div class="rx-vital-value">@_prescription.VitalWeight?.ToString("F1")</div>
                                <div class="rx-vital-unit">kg</div>
                            </div>
                        }
                        @if (_prescription.VitalSpO2 != null)
                        {
                            <div class="rx-vital-cell">
                                <div class="rx-vital-label">SPO₂</div>
                                <div class="rx-vital-value">@_prescription.VitalSpO2?.ToString("F1")</div>
                                <div class="rx-vital-unit">%</div>
                            </div>
                        }
                        @if (_prescription.VitalRR != null)
                        {
                            <div class="rx-vital-cell">
                                <div class="rx-vital-label">RR</div>
                                <div class="rx-vital-value">@_prescription.VitalRR</div>
                                <div class="rx-vital-unit">/min</div>
                            </div>
                        }
                        @if (_prescription.VitalSugar != null)
                        {
                            <div class="rx-vital-cell">
                                <div class="rx-vital-label">SUGAR</div>
                                <div class="rx-vital-value">@_prescription.VitalSugar?.ToString("F0")</div>
                                <div class="rx-vital-unit">mg/dL</div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- ── Obstetric History (Gynecology) ─── -->
            @if (_prescription.ObstetricData is not null)
            {
                var obs = _prescription.ObstetricData;
                var hasGpla = obs.Gravida.HasValue || obs.Para.HasValue || obs.Live.HasValue || obs.Abortion.HasValue;
                <div class="rx-section">
                    <div class="rx-section-title">🤱 OBSTETRIC HISTORY</div>
                    @if (hasGpla)
                    {
                        <div class="rx-gpla">
                            G@(obs.Gravida?.ToString() ?? "?") &nbsp; P@(obs.Para?.ToString() ?? "?") &nbsp; L@(obs.Live?.ToString() ?? "?") &nbsp; A@(obs.Abortion?.ToString() ?? "?")
                        </div>
                        <div class="rx-obs-grid">
                            @if (obs.Gravida.HasValue)
                            {
                                <div class="rx-obs-cell"><div class="rx-obs-label">Gravida</div><div class="rx-obs-val">@obs.Gravida</div></div>
                            }
                            @if (obs.Para.HasValue)
                            {
                                <div class="rx-obs-cell"><div class="rx-obs-label">Para</div><div class="rx-obs-val">@obs.Para</div></div>
                            }
                            @if (obs.Live.HasValue)
                            {
                                <div class="rx-obs-cell"><div class="rx-obs-label">Live</div><div class="rx-obs-val">@obs.Live</div></div>
                            }
                            @if (obs.Abortion.HasValue)
                            {
                                <div class="rx-obs-cell"><div class="rx-obs-label">Abortion</div><div class="rx-obs-val">@obs.Abortion</div></div>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(obs.Information))
                    {
                        <div class="rx-obs-info">@obs.Information</div>
                    }

                    @if (obs.Lmp.HasValue || obs.EddByLmp.HasValue || obs.EddByUsg.HasValue)
                    {
                        <div style="margin-top:10px;display:flex;gap:24px;flex-wrap:wrap;padding:8px 0;border-top:1px solid #E2E8F0;">
                            @if (obs.Lmp.HasValue)
                            {
                                <div>
                                    <div style="font-size:9px;font-weight:700;color:#94A3B8;text-transform:uppercase;letter-spacing:.05em;">LMP</div>
                                    <div style="font-size:12px;font-weight:700;color:#1E293B;">@obs.Lmp.Value.ToString("dd MMM yyyy")</div>
                                </div>
                            }
                            @if (obs.EddByLmp.HasValue)
                            {
                                <div>
                                    <div style="font-size:9px;font-weight:700;color:#94A3B8;text-transform:uppercase;letter-spacing:.05em;">EDD by LMP</div>
                                    <div style="font-size:12px;font-weight:700;color:#1565C0;">@obs.EddByLmp.Value.ToString("dd MMM yyyy")</div>
                                </div>
                            }
                            @if (obs.EddByUsg.HasValue)
                            {
                                <div>
                                    <div style="font-size:9px;font-weight:700;color:#94A3B8;text-transform:uppercase;letter-spacing:.05em;">EDD by USG</div>
                                    <div style="font-size:12px;font-weight:700;color:#16A34A;">@obs.EddByUsg.Value.ToString("dd MMM yyyy")</div>
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (obs.MenstrualHistory.Count > 0 || obs.PastMedicalHistory.Count > 0 || obs.FamilyHistory.Count > 0)
                {
                    <div class="rx-section">
                        <div class="rx-section-title">PATIENT HISTORY</div>
                        <div class="rx-hist-grid">
                            @if (obs.MenstrualHistory.Count > 0)
                            {
                                <div>
                                    <div class="rx-hist-heading">Menstrual History</div>
                                    @foreach (var h in obs.MenstrualHistory)
                                    {
                                        <div class="rx-hist-item">• @h</div>
                                    }
                                </div>
                            }
                            @if (obs.PastMedicalHistory.Count > 0)
                            {
                                <div>
                                    <div class="rx-hist-heading">Past Medical History</div>
                                    @foreach (var h in obs.PastMedicalHistory)
                                    {
                                        <div class="rx-hist-item">• @h</div>
                                    }
                                </div>
                            }
                            @if (obs.FamilyHistory.Count > 0)
                            {
                                <div>
                                    <div class="rx-hist-heading">Family History</div>
                                    @foreach (var h in obs.FamilyHistory)
                                    {
                                        <div class="rx-hist-item">• @h</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }

            <!-- ── Diagnosis ────────────────────── -->
            @if (!string.IsNullOrEmpty(_prescription.Diagnosis))
            {
                <div class="rx-section">
                    <div class="rx-section-title">DIAGNOSIS</div>
                    <div class="rx-diagnosis">@_prescription.Diagnosis</div>
                </div>
            }

            <!-- ── Medicines ─────────────────────── -->
            @if (_prescription.Items.Count > 0)
            {
                <div class="rx-section">
                    <div class="rx-section-title rx-rx-title">℞ RX — MEDICINES PRESCRIBED</div>
                    <table class="rx-table">
                        <thead>
                            <tr>
                                <th class="rx-th-num">#</th>
                                <th class="rx-th-med">Medicine</th>
                                <th class="rx-th-dur">Duration</th>
                                <th class="rx-th-inst">Instructions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < _prescription.Items.Count; i++)
                            {
                                var item = _prescription.Items[i];
                                var instrText = GetInstructionText(item);
                                <tr class="@(i % 2 == 1 ? "rx-tr-alt" : "")">
                                    <td class="rx-td-num">@(i + 1)</td>
                                    <td class="rx-td-med">
                                        <div class="rx-med-name">@item.MedicineName @item.Strength</div>
                                        <div class="rx-med-form">@item.MedicineForm</div>
                                    </td>
                                    <td class="rx-td-dur">@item.DurationDays days</td>
                                    <td class="rx-td-inst">
                                        <div>@instrText</div>
                                        @if (!string.IsNullOrEmpty(item.Timing))
                                        {
                                            <div class="rx-timing">• @item.Timing</div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- ── Investigations ────────────────── -->
            @if (_prescription.Investigations.Count > 0)
            {
                <div class="rx-section">
                    <div class="rx-inv-box">
                        <div class="rx-section-title">🔬 INVESTIGATIONS ADVISED</div>
                        <ol class="rx-inv-list">
                            @foreach (var inv in _prescription.Investigations)
                            {
                                <li>@inv</li>
                            }
                        </ol>
                    </div>
                </div>
            }

            <!-- ── General Advice ─────────────────── -->
            @if (!string.IsNullOrEmpty(_prescription.Notes))
            {
                <div class="rx-section">
                    <div class="rx-section-title">📝 GENERAL ADVICE</div>
                    <div class="rx-notes">@_prescription.Notes</div>
                </div>
            }

            <!-- ── Next Visit + Signature ─────────── -->
            <div class="rx-bottom-row">
                @if (_prescription.NextVisitDate.HasValue)
                {
                    <div class="rx-next-visit">
                        <div class="rx-next-label">⏰ NEXT VISIT</div>
                        <div class="rx-next-date">@_prescription.NextVisitDate.Value.ToString("ddd, dd MMMM yyyy")</div>
                        <div class="rx-next-note">Please arrive 15 minutes prior with previous reports</div>
                    </div>
                }
                else
                {
                    <div></div>
                }
                <div class="rx-signature">
                    <div class="rx-sig-cursive">Dr. @(_prescription.DoctorName.Split(' ').LastOrDefault() ?? _prescription.DoctorName)</div>
                    <div class="rx-sig-line"></div>
                    <div class="rx-sig-name">Dr. @_prescription.DoctorName</div>
                    @{
                        var qual = _doctorProfile?.QualificationDetails;
                        var spec = _doctorProfile?.SpecialityName;
                        var qualLine = new List<string?> { qual, spec }.Where(s => !string.IsNullOrEmpty(s));
                    }
                    @if (qualLine.Any())
                    {
                        <div class="rx-sig-sub">@string.Join(" · ", qualLine)</div>
                    }
                    <div class="rx-sig-stamp">Signature &amp; Stamp</div>
                </div>
            </div>

            <!-- ── Disclaimer ───────────────────── -->
            <div class="rx-disclaimer">
                This prescription is computer-generated and digitally signed.
                For emergencies, call @(_clinic?.ContactNumber ?? "the clinic") (24×7).
                <br />
                ⚠️ Self-medication can be harmful · Take medicines only as advised · Complete the full course
            </div>

            <!-- ── Screen footer (hidden on print) ─ -->
            <div class="no-print rx-screen-footer">
                <span>Generated @DateTime.Now.ToString("dd MMM yyyy, HH:mm") · @_prescription.PrescriptionNumber</span>
                <button @onclick="PrintPage" class="rx-print-btn">🖨️ Print</button>
            </div>

        </div>
    </div>
}

<style>
    /* ── Layout ───────────────────────────────────────── */
    .rx-bg { background:#F0F4F8; min-height:calc(100vh - 44px); padding:28px 16px; }
    .rx-sheet { max-width:860px; margin:0 auto; background:#fff; border-radius:4px;
                box-shadow:0 2px 16px rgba(0,0,0,0.1); font-family:'Segoe UI',sans-serif; color:#111; }

    /* ── Clinic + Doctor Header ───────────────────────── */
    .rx-header { display:flex; justify-content:space-between; align-items:flex-start; padding:22px 28px 14px; }
    .rx-header-left { flex:1; }
    .rx-header-right { text-align:right; flex-shrink:0; max-width:260px; }
    .rx-clinic-name { font-size:22px; font-weight:800; color:#111; line-height:1.2; }
    .rx-clinic-sub { font-size:11px; color:#555; margin-top:3px; line-height:1.4; }
    .rx-doctor-name { font-size:15px; font-weight:700; color:#1565C0; }
    .rx-doctor-sub { font-size:11px; color:#555; margin-top:2px; }
    .rx-rule { border:none; border-top:1.5px solid #2563EB; margin:0 28px; }

    /* ── Patient Strip ────────────────────────────────── */
    .rx-patient-strip { display:grid; grid-template-columns:2fr 1fr 1.2fr 1.2fr;
                        border-bottom:1px solid #E2E8F0; padding:10px 28px; gap:8px; }
    .rx-ps-cell { padding:6px 0; }
    .rx-ps-wide { }
    .rx-ps-label { font-size:9px; font-weight:700; color:#94A3B8; text-transform:uppercase; letter-spacing:0.6px; margin-bottom:3px; }
    .rx-ps-name { font-size:15px; font-weight:800; color:#0F172A; }
    .rx-ps-value { font-size:14px; font-weight:700; color:#0F172A; }
    .rx-ps-sub { font-size:11px; color:#64748B; margin-top:1px; }
    .rx-uhid { color:#1565C0; }

    /* ── Sections ─────────────────────────────────────── */
    .rx-section { padding:12px 28px; border-bottom:1px solid #F1F5F9; }
    .rx-section-title { font-size:10px; font-weight:700; color:#1565C0; text-transform:uppercase;
                        letter-spacing:0.7px; margin-bottom:8px; }
    .rx-rx-title { font-size:12px; }

    /* ── Vitals ───────────────────────────────────────── */
    .rx-vitals { display:flex; gap:0; border:1px solid #E2E8F0; border-radius:6px; overflow:hidden; }
    .rx-vital-cell { flex:1; text-align:center; padding:8px 6px;
                     border-right:1px solid #E2E8F0; }
    .rx-vital-cell:last-child { border-right:none; }
    .rx-vital-label { font-size:9px; color:#94A3B8; font-weight:700; text-transform:uppercase;
                      letter-spacing:0.5px; margin-bottom:4px; }
    .rx-vital-value { font-size:16px; font-weight:800; color:#1565C0; line-height:1; }
    .rx-vital-unit { font-size:9px; color:#94A3B8; margin-top:3px; }

    /* ── Obstetric History ───────────────────────────── */
    .rx-gpla { font-size:16px; font-weight:800; color:#1565C0; letter-spacing:1px; margin-bottom:8px; }
    .rx-obs-grid { display:flex; gap:0; border:1px solid #E2E8F0; border-radius:6px;
                   overflow:hidden; margin-bottom:8px; width:fit-content; }
    .rx-obs-cell { padding:7px 18px; border-right:1px solid #E2E8F0; text-align:center; }
    .rx-obs-cell:last-child { border-right:none; }
    .rx-obs-label { font-size:9px; color:#94A3B8; font-weight:700; text-transform:uppercase;
                    letter-spacing:0.5px; margin-bottom:3px; }
    .rx-obs-val { font-size:15px; font-weight:800; color:#0F172A; }
    .rx-obs-info { font-size:12px; color:#374151; font-style:italic; }
    .rx-hist-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
    .rx-hist-heading { font-size:10px; font-weight:700; color:#475569; text-transform:uppercase;
                       letter-spacing:0.5px; margin-bottom:5px; }
    .rx-hist-item { font-size:12px; color:#0F172A; margin-bottom:3px; }

    /* ── Diagnosis ────────────────────────────────────── */
    .rx-diagnosis { font-size:14px; font-weight:600; color:#0F172A; }

    /* ── Medicines Table ──────────────────────────────── */
    .rx-table { width:100%; border-collapse:collapse; font-size:12px; }
    .rx-table thead tr { background:#F8FAFC; }
    .rx-table th { text-align:left; padding:8px 10px; font-size:10px; font-weight:700; color:#64748B;
                   text-transform:uppercase; letter-spacing:0.4px;
                   border-bottom:1.5px solid #E2E8F0; border-top:1px solid #E2E8F0; }
    .rx-th-num { width:32px; }
    .rx-th-dur { width:80px; }
    .rx-table td { padding:10px 10px; border-bottom:1px solid #F1F5F9; vertical-align:top; }
    .rx-tr-alt td { background:#FAFAFA; }
    .rx-td-num { font-weight:800; color:#1565C0; font-size:13px; }
    .rx-med-name { font-size:13px; font-weight:700; color:#0F172A; }
    .rx-med-form { font-size:10px; color:#64748B; margin-top:1px; }
    .rx-td-inst { color:#374151; font-style:italic; font-size:12px; }
    .rx-timing { font-size:11px; color:#1565C0; margin-top:3px; }

