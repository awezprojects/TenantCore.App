@page "/settings/clinic-profile"
@layout AuthorizedLayout
@inject IApplicationApiClient AppClient
@inject IClinicApiClient ClinicClient
@inject ClinicContextService ClinicContext
@inject IToastService Toast
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@using TenantCore.Shared.Dtos
@using TenantCore.Shared.Dtos.Auth
@using TenantCore.Web.Client.Clients
@using TenantCore.Web.Client.Services

<PageTitle>Clinic Profile - CloudClinic</PageTitle>

@if (_loading)
{
    <div style="display:flex;justify-content:center;padding:80px 0;">
        <div class="auth-spinner" style="width:44px;height:44px;border-width:3.5px;"></div>
    </div>
}
else if (_clinicId == Guid.Empty)
{
    <div class="auth-warning">No clinic selected. Please select a clinic first.</div>
}
else
{
    <div class="cc-fade-in" style="max-width:780px;display:flex;flex-direction:column;gap:20px;">

        <!-- ── Header Card ─────────────────────────────────────────────── -->
        <div style="background:#fff;border-radius:16px;border:1px solid #E2E8F0;overflow:hidden;">
            <div style="padding:24px;display:flex;align-items:center;gap:20px;">
                <div style="width:64px;height:64px;border-radius:18px;
                            background:linear-gradient(135deg,#1565C0,#42A5F5);
                            display:flex;align-items:center;justify-content:center;
                            font-size:28px;flex-shrink:0;">🏥</div>
                <div style="flex:1;">
                    <div style="font-size:18px;font-weight:800;color:#1E293B;">@_name</div>
                    <div style="font-size:13px;color:#64748B;margin-top:2px;">
                        Code: <strong style="color:#1E293B;">@_code</strong>
                    </div>
                    <div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap;">
                        <span style="padding:3px 10px;background:#EFF6FF;color:#1565C0;
                                     border-radius:20px;font-size:11px;font-weight:700;">🏥 Clinic</span>
                        @if (!string.IsNullOrEmpty(_contactNumber))
                        {
                            <span style="padding:3px 10px;background:#F1F5F9;color:#475569;
                                         border-radius:20px;font-size:11px;font-weight:700;">📞 @_contactNumber</span>
                        }
                        @if (!string.IsNullOrEmpty(_officialEmail))
                        {
                            <span style="padding:3px 10px;background:#F1F5F9;color:#475569;
                                         border-radius:20px;font-size:11px;font-weight:700;">✉ @_officialEmail</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Basic Information ───────────────────────────────────────── -->
        <div style="background:#fff;border-radius:16px;border:1px solid #E2E8F0;overflow:hidden;">
            <div style="padding:18px 24px;border-bottom:1px solid #E2E8F0;">
                <div style="font-size:15px;font-weight:800;color:#1E293B;">Basic Information</div>
                <div style="font-size:12px;color:#94A3B8;margin-top:2px;">Clinic name and official code</div>
            </div>
            <div style="padding:22px 24px;">
                <div style="display:grid;grid-template-columns:2fr 1fr;gap:16px;">
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Clinic Name *</label>
                        <input class="form-input" type="text" @bind="_name" maxlength="200" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Clinic Code</label>
                        <input class="form-input" type="text" value="@_code" disabled
                               style="background:#F8FAFC;color:#94A3B8;cursor:not-allowed;" />
                        <span class="form-helper">Code cannot be changed</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Address & Contact ───────────────────────────────────────── -->
        <div style="background:#fff;border-radius:16px;border:1px solid #E2E8F0;overflow:hidden;">
            <div style="padding:18px 24px;border-bottom:1px solid #E2E8F0;">
                <div style="font-size:15px;font-weight:800;color:#1E293B;">Address &amp; Contact</div>
                <div style="font-size:12px;color:#94A3B8;margin-top:2px;">Shown on prescription prints and reports</div>
            </div>
            <div style="padding:22px 24px;">
                <div class="form-group">
                    <label class="form-label">Address</label>
                    <textarea class="form-input" rows="2" @bind="_address" maxlength="500"
                              style="resize:vertical;min-height:58px;"></textarea>
                    <span class="form-helper">Displayed below the clinic name on prescription prints</span>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">State *</label>
                        <select class="form-input" value="@_stateId" @onchange="OnStateChangedAsync">
                            <option value="">— Select State —</option>
                            @foreach (var s in _states)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                        @if (!_stateId.HasValue && _touched)
                        {
                            <span class="form-helper" style="color:#DC2626;">State is required</span>
                        }
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">City *</label>
                        <select class="form-input" value="@_cityId" @onchange="OnCityChanged" disabled="@(!_stateId.HasValue)">
                            <option value="">— Select City —</option>
                            @foreach (var c in _cities)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                        @if (!_cityId.HasValue && _touched)
                        {
                            <span class="form-helper" style="color:#DC2626;">City is required</span>
                        }
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Contact Number</label>
                        <input class="form-input" type="tel" @bind="_contactNumber" maxlength="20" />
                        <span class="form-helper">Shown on prescription disclaimer footer</span>
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Contact Person</label>
                        <input class="form-input" type="text" @bind="_contactPerson" maxlength="200" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Official Email</label>
                        <input class="form-input" type="email" @bind="_officialEmail" maxlength="256" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-label">Registration Number</label>
                        <input class="form-input" type="text" @bind="_registrationNumber" maxlength="100" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;grid-column:span 2;">
                        <label class="form-label">Website</label>
                        <input class="form-input" type="url" @bind="_website" maxlength="500" />
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Save ────────────────────────────────────────────────────── -->
        <div style="display:flex;justify-content:flex-end;padding-bottom:8px;">
            <button @onclick="SaveAsync" disabled="@_saving"
                    style="display:inline-flex;align-items:center;gap:8px;padding:11px 28px;
                           border-radius:10px;border:none;background:#1565C0;color:#fff;
                           font-size:14px;font-weight:700;cursor:pointer;font-family:inherit;
                           opacity:@(_saving ? "0.7" : "1");transition:background 0.15s;">
                @if (_saving)
                {
                    <span class="auth-spinner" style="width:16px;height:16px;border-width:2px;"></span>
                    <span>Saving…</span>
                }
                else
                {
                    <span>💾 Save Profile</span>
                }
            </button>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private Guid _clinicId;
    private int _applicationType;

    private string _name = string.Empty;
    private string _code = string.Empty;
    private string? _address;
    private string? _contactNumber;
    private string? _contactPerson;
    private string? _registrationNumber;
    private string? _officialEmail;
    private string? _website;

    private List<StateDto> _states = [];
    private List<CityDto> _cities = [];
    private Guid? _stateId;
    private Guid? _cityId;
    private bool _touched;

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        await ClinicContext.InitializeAsync();
        if (!AuthState.IsClinicAdmin(ClinicContext.SelectedApplicationId))
        {
            Navigation.NavigateTo("/dashboard", replace: true);
            return;
        }

        _clinicId = ClinicContext.SelectedApplicationId;
        if (_clinicId == Guid.Empty)
        {
            _loading = false;
            return;
        }

        var r = await AppClient.GetApplicationByIdAsync(_clinicId);
        if (r.Success && r.Data is not null)
        {
            var d = r.Data;
            _name               = d.ApplicationName;
            _code               = d.ApplicationCode;
            _applicationType    = d.ApplicationType;
            _address            = d.Address;
            _contactNumber      = d.ContactNumber;
            _contactPerson      = d.ContactPerson;
            _registrationNumber = d.RegistrationNumber;
            _officialEmail      = d.OfficialEmail;
            _website            = d.Website;
        }

        var statesR = await ClinicClient.GetStatesAsync();
        if (statesR.Success && statesR.Data is not null) _states = statesR.Data.ToList();

        var locR = await ClinicClient.GetClinicLocationAsync();
        if (locR.Success && locR.Data is not null)
        {
            _stateId = locR.Data.StateId;
            _cityId = locR.Data.CityId;
            var citiesR = await ClinicClient.GetCitiesByStateAsync(locR.Data.StateId);
            if (citiesR.Success && citiesR.Data is not null) _cities = citiesR.Data.ToList();
        }

        _loading = false;
    }

    private async Task OnStateChangedAsync(ChangeEventArgs e)
    {
        _stateId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        _cityId = null;
        _cities = [];
        if (_stateId.HasValue)
        {
            var r = await ClinicClient.GetCitiesByStateAsync(_stateId.Value);
            if (r.Success && r.Data is not null) _cities = r.Data.ToList();
        }
    }

    private void OnCityChanged(ChangeEventArgs e)
    {
        _cityId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
    }

    private async Task SaveAsync()
    {
        _touched = true;

        if (string.IsNullOrWhiteSpace(_name))
        {
            Toast.ShowWarning("Clinic name is required.");
            return;
        }

        if (!_stateId.HasValue || !_cityId.HasValue)
        {
            Toast.ShowWarning("State and City are required.");
            return;
        }

        _saving = true;
        var dto = new ApplicationCreationRequestDto
        {
            ApplicationName    = _name.Trim(),
            ApplicationCode    = _code,
            ApplicationType    = _applicationType,
            Address            = _address?.Trim(),
            ContactNumber      = _contactNumber?.Trim(),
            ContactPerson      = _contactPerson?.Trim(),
            RegistrationNumber = _registrationNumber?.Trim(),
            OfficialEmail      = _officialEmail?.Trim(),
            Website            = _website?.Trim()
        };

        var r = await AppClient.EditApplicationAsync(_clinicId, dto);
        var locR = await ClinicClient.UpsertClinicLocationAsync(new UpsertClinicLocationDto(_stateId.Value, _cityId.Value));

        if (r.Success && locR.Success) Toast.ShowSuccess("Clinic profile saved.");
        else Toast.ShowError(r.Message ?? locR.Message ?? "Failed to save.");
        _saving = false;
    }
}
