@page "/settings/dosage-remarks"
@layout AuthorizedLayout
@inject IPrescriptionApiClient PrescriptionClient
@inject IToastService Toast
@inject AuthStateService AuthState
@inject ClinicContextService ClinicContext
@inject NavigationManager Navigation
@using TenantCore.Shared.Dtos
@using TenantCore.Shared.Enums
@using TenantCore.Web.Client.Clients

<PageTitle>Dosage Remarks - Settings</PageTitle>

<div class="opd-header" style="margin-bottom:24px;">
    <div class="opd-header-title">Dosage Remark Templates</div>
</div>

<div style="display:flex;gap:20px;align-items:flex-start;flex-wrap:wrap;">

    <!-- Add / Edit form panel -->
    <div style="min-width:280px;flex:0 0 280px;background:#fff;border-radius:14px;
                border:1px solid #E2E8F0;padding:22px;">
        <div style="font-size:14px;font-weight:800;color:#1E293B;margin-bottom:16px;">
            @(_editing is null ? "Add Remark" : "Edit Remark")
        </div>

        <div class="form-group">
            <label class="form-label">Medicine Form</label>
            <select class="form-input" @bind="_form">
                @foreach (MedicineFormType f in Enum.GetValues<MedicineFormType>())
                {
                    <option value="@f">@f</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label class="form-label">Remark (English)</label>
            <textarea class="form-input" rows="2" @bind="_remarkEnglish" maxlength="500" style="resize:none;"></textarea>
        </div>

        <div class="form-group">
            <label class="form-label">Remark (Hindi)</label>
            <textarea class="form-input" rows="2" @bind="_remarkHindi" maxlength="500" style="resize:none;"></textarea>
        </div>

        <div class="form-group">
            <label class="form-label">Remark (Marathi)</label>
            <textarea class="form-input" rows="2" @bind="_remarkMarathi" maxlength="500" style="resize:none;"></textarea>
        </div>

        <div style="display:flex;gap:8px;">
            <button @onclick="SaveAsync"
                    style="padding:9px 18px;border-radius:8px;border:none;background:#1565C0;color:#fff;
                           font-size:13px;font-weight:700;cursor:pointer;">
                @(_editing is null ? "Add" : "Update")
            </button>
            @if (_editing is not null)
            {
                <button @onclick="ClearForm"
                        style="padding:9px 16px;border-radius:8px;border:1.5px solid #E2E8F0;background:#fff;
                               font-size:13px;font-weight:600;color:#64748B;cursor:pointer;">
                    Cancel
                </button>
            }
        </div>
    </div>

    <!-- Table -->
    <div style="flex:1;min-width:0;">
        @if (_loading)
        {
            <div style="display:flex;justify-content:center;padding:40px 0;">
                <div class="auth-spinner" style="width:32px;height:32px;border-width:3px;"></div>
            </div>
        }
        else if (_remarks is not null)
        {
            <div class="opd-table-card">
                <table class="opd-table">
                    <thead>
                        <tr>
                            <th>Form</th>
                            <th>English</th>
                            <th>Hindi</th>
                            <th>Marathi</th>
                            <th>Active</th>
                            <th style="white-space:nowrap;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!_remarks.Any())
                        {
                            <tr><td colspan="6" class="opd-empty">No dosage remarks found.</td></tr>
                        }
                        @foreach (var r in _remarks)
                        {
                            <tr>
                                <td>@r.MedicineForm</td>
                                <td>@r.RemarkEnglish</td>
                                <td>@(r.RemarkHindi ?? "—")</td>
                                <td>@(r.RemarkMarathi ?? "—")</td>
                                <td>
                                    @if (r.IsActive)
                                    {
                                        <span style="background:#DCFCE7;color:#166534;border-radius:12px;padding:2px 8px;font-size:11px;font-weight:600;">Yes</span>
                                    }
                                    else
                                    {
                                        <span style="background:#F1F5F9;color:#64748B;border-radius:12px;padding:2px 8px;font-size:11px;font-weight:600;">No</span>
                                    }
                                </td>
                                <td>
                                    <div class="opd-actions">
                                        <button class="opd-btn edit-btn" @onclick="() => EditRemark(r)">Edit</button>
                                        <button class="opd-btn delete-btn" @onclick="() => DeleteAsync(r.Id)">Delete</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private bool _loading;
    private List<DosageRemarkDto>? _remarks;
    private DosageRemarkDto? _editing;
    private MedicineFormType _form = MedicineFormType.Tab;
    private string _remarkEnglish = string.Empty;
    private string? _remarkHindi;
    private string? _remarkMarathi;

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        await ClinicContext.InitializeAsync();
        if (!AuthState.IsClinical(ClinicContext.SelectedApplicationId))
        {
            Navigation.NavigateTo("/dashboard", replace: true);
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var r = await PrescriptionClient.GetDosageRemarksAsync(pageSize: 100);
        if (r.Success) _remarks = r.Data?.Items.ToList();
        _loading = false;
    }

    private void EditRemark(DosageRemarkDto remark)
    {
        _editing = remark;
        _form = remark.MedicineForm;
        _remarkEnglish = remark.RemarkEnglish;
        _remarkHindi = remark.RemarkHindi;
        _remarkMarathi = remark.RemarkMarathi;
    }

    private void ClearForm()
    {
        _editing = null;
        _remarkEnglish = string.Empty;
        _remarkHindi = null;
        _remarkMarathi = null;
    }

    private async Task SaveAsync()
    {
        if (_editing is null)
        {
            var r = await PrescriptionClient.CreateDosageRemarkAsync(
                new CreateDosageRemarkDto(_form, _remarkEnglish, _remarkHindi, _remarkMarathi));
            if (r.Success) { Toast.ShowSuccess("Remark added."); ClearForm(); }
            else Toast.ShowError(r.Message ?? "Failed.");
        }
        else
        {
            var r = await PrescriptionClient.UpdateDosageRemarkAsync(_editing.Id,
                new UpdateDosageRemarkDto(_form, _remarkEnglish, _remarkHindi, _remarkMarathi, _editing.IsActive));
            if (r.Success) { Toast.ShowSuccess("Remark updated."); ClearForm(); }
            else Toast.ShowError(r.Message ?? "Failed.");
        }
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        var r = await PrescriptionClient.DeleteDosageRemarkAsync(id);
        if (r.Success) { Toast.ShowSuccess("Remark deleted."); await LoadAsync(); }
        else Toast.ShowError(r.Message ?? "Failed.");
    }
}
