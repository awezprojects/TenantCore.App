@page "/settings/prescription"
@layout AuthorizedLayout
@inject IPrescriptionApiClient PrescriptionClient
@inject IToastService Toast
@inject AuthStateService AuthState
@inject ClinicContextService ClinicContext
@inject NavigationManager Navigation
@using TenantCore.Shared.Dtos
@using TenantCore.Shared.Enums
@using TenantCore.Web.Client.Clients

<PageTitle>Prescription Settings</PageTitle>

<div class="opd-header" style="margin-bottom:24px;">
    <div>
        <div class="opd-header-title">Prescription Settings</div>
        <div style="font-size:12px;color:#94A3B8;margin-top:2px;">Configure defaults for new prescriptions and print layout.</div>
    </div>
</div>

@if (_loading)
{
    <div style="display:flex;justify-content:center;padding:40px 0;">
        <div class="auth-spinner" style="width:32px;height:32px;border-width:3px;"></div>
    </div>
}
else
{
    <div style="display:flex;gap:20px;flex-wrap:wrap;align-items:flex-start;max-width:900px;">

        <!-- Default Language card -->
        <div style="flex:0 0 260px;background:#fff;border-radius:14px;border:1px solid #E2E8F0;padding:24px;">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
                <span style="font-size:20px;">🌐</span>
                <div style="font-size:15px;font-weight:800;color:#1E293B;">Default Language</div>
            </div>
            <p style="font-size:12px;color:#64748B;margin:0 0 16px;">
                Dosage remarks on new prescriptions are pre-filled in this language.
            </p>
            <div class="form-group">
                <label class="form-label">Language</label>
                <select class="form-input" @bind="_language">
                    @foreach (PrescriptionLanguage lang in Enum.GetValues<PrescriptionLanguage>())
                    {
                        <option value="@lang">@lang</option>
                    }
                </select>
            </div>
        </div>

        <!-- Print Settings card -->
        <div style="flex:1;min-width:280px;background:#fff;border-radius:14px;border:1px solid #E2E8F0;padding:24px;">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
                <span style="font-size:20px;">🖨️</span>
                <div style="font-size:15px;font-weight:800;color:#1E293B;">Print Settings</div>
            </div>
            <p style="font-size:12px;color:#64748B;margin:0 0 16px;">
                Page margins and header visibility when printing. Use when your clinic has pre-printed letterhead pads.
            </p>

            <div style="font-size:12px;font-weight:700;color:#374151;margin-bottom:10px;">Page Margins (mm)</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;">
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Top</label>
                    <input class="form-input" type="number" @bind="_marginTop" min="0" max="80" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Bottom</label>
                    <input class="form-input" type="number" @bind="_marginBottom" min="0" max="80" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Left</label>
                    <input class="form-input" type="number" @bind="_marginLeft" min="0" max="80" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Right</label>
                    <input class="form-input" type="number" @bind="_marginRight" min="0" max="80" />
                </div>
            </div>

            <hr style="border:none;border-top:1px solid #E2E8F0;margin-bottom:16px;" />

            <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-size:13px;color:#374151;">
                <input type="checkbox" @bind="_hideHeader" style="width:16px;height:16px;" />
                <span>@(_hideHeader ? "Clinic header hidden on print" : "Show clinic header on print")</span>
            </label>

            @if (_hideHeader)
            {
                <div class="auth-info" style="margin-top:12px;font-size:12px;">
                    The clinic name, address, and doctor info will not print — useful when using pre-printed pads.
                </div>
            }
        </div>
    </div>

    <div style="margin-top:24px;">
        <button @onclick="SaveAsync" disabled="@_saving"
                style="display:flex;align-items:center;gap:8px;padding:11px 24px;border-radius:8px;border:none;
                       background:#1565C0;color:#fff;font-size:14px;font-weight:700;cursor:pointer;
                       opacity:@(_saving ? "0.7" : "1");">
            @if (_saving)
            {
                <span class="auth-spinner" style="width:16px;height:16px;border-width:2px;"></span>
                <span>Saving…</span>
            }
            else { <span>Save Settings</span> }
        </button>
    </div>
}

@code {
    private bool _loading;
    private bool _saving;

    private PrescriptionLanguage _language = PrescriptionLanguage.English;
    private int _marginTop;
    private int _marginRight;
    private int _marginBottom;
    private int _marginLeft;
    private bool _hideHeader;

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        await ClinicContext.InitializeAsync();
        if (!AuthState.IsClinical(ClinicContext.SelectedApplicationId))
        {
            Navigation.NavigateTo("/dashboard", replace: true);
            return;
        }

        _loading = true;
        var r = await PrescriptionClient.GetPrescriptionConfigAsync();
        if (r.Success && r.Data is not null)
        {
            var d = r.Data;
            _language     = d.DefaultLanguage;
            _marginTop    = d.PrintMarginTop;
            _marginRight  = d.PrintMarginRight;
            _marginBottom = d.PrintMarginBottom;
            _marginLeft   = d.PrintMarginLeft;
            _hideHeader   = d.HideClinicHeader;
        }
        _loading = false;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        var dto = new UpdatePrescriptionConfigDto(
            _language, _marginTop, _marginRight, _marginBottom, _marginLeft, _hideHeader);
        var r = await PrescriptionClient.UpdatePrescriptionConfigAsync(dto);
        if (r.Success) Toast.ShowSuccess("Settings saved.");
        else Toast.ShowError(r.Message ?? "Failed to save.");
        _saving = false;
    }
}
