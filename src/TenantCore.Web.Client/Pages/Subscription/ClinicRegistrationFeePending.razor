@inject UsageBillingContextService UsageBillingContext
@inject ClinicContextService ClinicContext

<PageTitle>Registration Fee Required - CloudClinic</PageTitle>

<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;
            min-height:calc(100vh - 68px);padding:40px 20px;">

    @* Red alert bar at the top *@
    <div style="width:100%;max-width:560px;background:#FEE2E2;border:1.5px solid #FCA5A5;
                border-radius:12px;padding:16px 20px;display:flex;align-items:center;gap:14px;
                margin-bottom:32px;">
        <div style="font-size:24px;flex-shrink:0;">🔒</div>
        <div>
            <div style="font-size:14px;font-weight:800;color:#991B1B;">Your clinic is locked</div>
            <div style="font-size:12px;color:#B91C1C;margin-top:2px;line-height:1.5;">
                Pay the one-time registration fee to activate your wallet and unlock all features.
            </div>
        </div>
    </div>

    @* Payment card *@
    <div style="width:100%;max-width:560px;">
        <RegistrationFeeCard Summary="UsageBillingContext.Summary" OnChanged="HandleFeeChangedAsync" />
    </div>

    @* Clinic name hint *@
    @if (!string.IsNullOrWhiteSpace(ClinicContext.SelectedApplicationName))
    {
        <div style="margin-top:20px;font-size:12px;color:#94A3B8;">
            Clinic: <strong>@ClinicContext.SelectedApplicationName</strong>
        </div>
    }
</div>

@code {
    private async Task HandleFeeChangedAsync()
    {
        await UsageBillingContext.RefreshAsync();
    }
}
