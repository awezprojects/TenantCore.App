@page "/subscription"
@layout AuthorizedLayout
@inject ISubscriptionApiClient SubscriptionApi
@inject SubscriptionContextService SubscriptionContext
@inject ClinicContextService ClinicContext
@inject IToastService Toast
@inject NavigationManager Nav
@using TenantCore.Shared.Dtos.Subscriptions
@using TenantCore.Shared.Enums

<PageTitle>Subscription - CloudClinic</PageTitle>

<div class="opd-page">

    <div class="opd-header">
        <div>
            <div class="opd-title">@(SubscriptionContext.IsLocked ? "Activate your clinic" : "Subscription")</div>
            <div class="opd-subtitle">@ClinicContext.SelectedApplicationName</div>
        </div>
        <button @onclick="RefreshAsync" disabled="@_loading"
                style="padding:9px 16px;background:#fff;color:#1565C0;border:1.5px solid #BFDBFE;
                       border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;">
            🔄 Refresh
        </button>
    </div>

    @if (SubscriptionContext.IsLocked)
    {
        <div style="background:#FEE2E2;border:1px solid #FCA5A5;border-radius:10px;padding:14px 18px;margin-bottom:20px;
                    display:flex;align-items:center;gap:10px;">
            <span style="font-size:18px;">🔒</span>
            <div style="font-size:13px;color:#991B1B;font-weight:600;">
                This clinic has no active subscription. Every feature stays disabled until a plan is chosen below.
            </div>
        </div>
    }

    @if (_loading)
    {
        <div style="display:flex;justify-content:center;padding:60px 0;">
            <div class="auth-spinner" style="width:40px;height:40px;border-width:3px;"></div>
        </div>
    }
    else
    {
        <SubscriptionTimelineCard />

        @if (_pendingPayment is not null && !_switchingPlan)
        {
            <div style="background:linear-gradient(135deg,#EFF6FF,#DBEAFE);border:1px solid #BFDBFE;
                        border-radius:14px;padding:20px 24px;margin-bottom:22px;
                        display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;">
                <div>
                    <div style="font-size:14px;font-weight:800;color:#1E293B;margin-bottom:4px;">
                        Payment link ready — @_pendingPayment.PlanName
                        @if (_pendingPayment.IsAssignedByPlatform)
                        {
                            <span style="margin-left:8px;background:#E0E7FF;color:#3730A3;border-radius:12px;
                                         padding:2px 10px;font-size:10px;font-weight:800;">
                                SENT BY CLOUDCLINIC
                            </span>
                        }
                    </div>
                    <div style="font-size:13px;color:#475569;">
                        Amount: <strong>@_pendingPayment.Currency @_pendingPayment.Amount.ToString("N2")</strong>
                        @if (_pendingPayment.LinkExpiresAt.HasValue)
                        {
                            <text> &middot; Expires @_pendingPayment.LinkExpiresAt.Value.ToString("dd MMM yyyy HH:mm")</text>
                        }
                    </div>
                    @if (SubscriptionContext.Status?.CoverageEndDate is { } covered && !SubscriptionContext.IsLocked)
                    {
                        <div style="font-size:12px;color:#1565C0;font-weight:600;margin-top:6px;">
                            Once paid, this term starts on @covered.ToString("dd MMM yyyy") — no time is lost.
                        </div>
                    }
                </div>
                <div style="display:flex;gap:10px;flex-wrap:wrap;">
                    @if (!string.IsNullOrWhiteSpace(_pendingPayment.PaymentLinkUrl))
                    {
                        <a href="@_pendingPayment.PaymentLinkUrl" target="_blank" rel="noopener noreferrer"
                           style="padding:9px 18px;background:#16A34A;color:#fff;border-radius:8px;
                                  font-size:13px;font-weight:700;text-decoration:none;">
                            💳 Pay Now
                        </a>
                    }
                    <button @onclick="CheckPaymentAsync" disabled="@_checkingPayment"
                            style="padding:9px 18px;background:#fff;color:#1565C0;border:1.5px solid #BFDBFE;
                                   border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;
                                   opacity:@(_checkingPayment ? "0.7" : "1");">
                        @(_checkingPayment ? "Checking…" : "I've paid — check now")
                    </button>
                    @if (!_pendingPayment.IsAssignedByPlatform)
                    {
                        <button @onclick="OpenSwitchPlan"
                                style="padding:9px 18px;background:transparent;color:#64748B;border:1.5px solid #E2E8F0;
                                       border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;">
                            Choose a different plan
                        </button>
                    }
                </div>
            </div>
        }
        else
        {
            @if (_switchingPlan)
            {
                <div style="background:#FEF3C7;border:1px solid #FDE68A;border-radius:10px;padding:12px 18px;
                            margin-bottom:18px;display:flex;align-items:center;justify-content:space-between;
                            flex-wrap:wrap;gap:10px;">
                    <div style="font-size:13px;color:#92400E;font-weight:600;">
                        Pick a new plan below. Your current link for @_pendingPayment?.PlanName will be cancelled.
                    </div>
                    <button @onclick="@(() => _switchingPlan = false)"
                            style="padding:7px 14px;background:transparent;color:#92400E;border:1.5px solid #FDE68A;
                                   border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;">
                        Keep current link
                    </button>
                </div>
            }
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px;">
                @foreach (var plan in _plans.OrderBy(p => p.DisplayOrder))
                {
                    var disabled = plan.AlreadyUsed;
                    <div style="position:relative;background:#fff;border-radius:14px;padding:22px 20px;
                                border:@(plan.IsPopular ? "2px solid #1565C0" : "1.5px solid #E2E8F0");
                                box-shadow:@(plan.IsPopular ? "0 10px 30px rgba(21,101,192,0.15)" : "0 2px 8px rgba(0,0,0,0.04)");
                                opacity:@(disabled ? "0.55" : "1");">

                        @if (plan.IsPopular)
                        {
                            <div style="position:absolute;top:-11px;left:50%;transform:translateX(-50%);
                                        background:#1565C0;color:#fff;font-size:10px;font-weight:800;
                                        letter-spacing:0.5px;padding:4px 12px;border-radius:20px;white-space:nowrap;">
                                MOST POPULAR
                            </div>
                        }

                        <div style="font-size:15px;font-weight:800;color:#1E293B;margin-top:@(plan.IsPopular ? "8px" : "0");">@plan.Name</div>
                        <div style="font-size:12px;color:#64748B;margin-top:4px;min-height:32px;">@plan.Description</div>

                        <div style="margin-top:14px;">
                            @if (plan.IsTrial)
                            {
                                <span style="font-size:26px;font-weight:800;color:#16A34A;">Free</span>
                            }
                            else
                            {
                                <span style="font-size:26px;font-weight:800;color:#1E293B;">@plan.Currency @plan.Price.ToString("N0")</span>
                                @if (plan.IsSpecialOffer && plan.ListPrice > plan.Price)
                                {
                                    <span style="margin-left:8px;font-size:14px;color:#94A3B8;text-decoration:line-through;">
                                        @plan.ListPrice.ToString("N0")
                                    </span>
                                }
                            }
                        </div>
                        <div style="font-size:11px;color:#94A3B8;margin-top:2px;">
                            @plan.DurationDays days
                            @if (!plan.IsTrial)
                            {
                                <text> &middot; @((plan.Price / plan.DurationDays).ToString("N2")) @plan.Currency / day</text>
                            }
                        </div>

                        @if (plan.IsSpecialOffer)
                        {
                            <div style="margin-top:10px;">
                                <span style="background:#E0E7FF;color:#3730A3;border-radius:12px;padding:3px 10px;
                                             font-size:10px;font-weight:800;">
                                    SPECIAL PRICE FOR YOUR CLINIC
                                </span>
                                @if (plan.OfferValidUntil is { } until)
                                {
                                    <div style="font-size:10px;color:#64748B;margin-top:4px;">
                                        Until @until.ToString("dd MMM yyyy")
                                    </div>
                                }
                            </div>
                        }

                        @if (plan.IsTrial)
                        {
                            <div style="margin-top:10px;">
                                <span style="background:@(disabled ? "#F1F5F9" : "#DCFCE7");color:@(disabled ? "#475569" : "#166534");
                                            border-radius:12px;padding:3px 10px;font-size:10px;font-weight:700;">
                                    @(disabled ? "ALREADY USED" : "FREE · ONCE PER CLINIC")
                                </span>
                            </div>
                        }

                        @if (plan.IsTrial)
                        {
                            <button disabled="@(disabled || SubscriptionContext.Status?.CanSubscribe != true)"
                                    @onclick="@(() => OpenConfirm(plan))"
                                    style="width:100%;margin-top:18px;padding:10px;border-radius:8px;border:none;
                                           background:@(disabled ? "#E2E8F0" : "#1565C0");color:@(disabled ? "#94A3B8" : "#fff");
                                           font-size:13px;font-weight:700;cursor:@(disabled ? "not-allowed" : "pointer");">
                                @(disabled ? "Already Used" : "Choose Plan")
                            </button>
                        }
                        else
                        {
                            <button disabled="@(SubscriptionContext.Status?.CanSubscribe != true || _creatingLinkForPlanId == plan.Id)"
                                    @onclick="@(() => CreatePaymentLinkAsync(plan))"
                                    style="width:100%;margin-top:18px;padding:10px;border-radius:8px;border:none;
                                           background:#1565C0;color:#fff;
                                           font-size:13px;font-weight:700;cursor:pointer;
                                           opacity:@(_creatingLinkForPlanId == plan.Id ? "0.7" : "1");">
                                @(_creatingLinkForPlanId == plan.Id ? "Creating link..." : BuyLabel())
                            </button>
                        }
                    </div>
                }
            </div>

            @if (SubscriptionContext.Status?.CanSubscribe != true)
            {
                <div style="margin-top:18px;font-size:12px;color:#94A3B8;">
                    Only a Clinic Admin can choose a subscription plan.
                </div>
            }
        }

        @if (_payments.Count > 0)
        {
            <div style="margin-top:32px;">
                <div style="font-size:14px;font-weight:800;color:#1E293B;margin-bottom:12px;">Payment History</div>
                <div class="opd-table-card">
                    <table class="opd-table">
                        <thead>
                            <tr>
                                <th>Plan</th>
                                <th>Source</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Paid On</th>
                                <th>Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in _payments.OrderByDescending(p => p.CreatedAt))
                            {
                                <tr>
                                    <td>@p.PlanName</td>
                                    <td>@SourceLabel(p)</td>
                                    <td>@p.Currency @p.Amount.ToString("N2")</td>
                                    <td>
                                        <span style="background:@StatusBg(p.Status);color:@StatusFg(p.Status);
                                                     border-radius:12px;padding:2px 10px;font-size:11px;font-weight:700;">
                                            @p.Status
                                        </span>
                                    </td>
                                    <td>@(p.PaidAt?.ToString("dd MMM yyyy") ?? "—")</td>
                                    <td>@p.CreatedAt.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@if (_confirmPlan is not null)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:900;" @onclick="CloseConfirm"></div>
    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
                background:#fff;border-radius:14px;width:420px;max-width:96vw;
                box-shadow:0 20px 60px rgba(0,0,0,0.2);z-index:901;"
         @onclick:stopPropagation="true">
        <div style="padding:18px 24px;border-bottom:1px solid #E2E8F0;">
            <div style="font-size:16px;font-weight:800;color:#1E293B;">Confirm Subscription</div>
        </div>
        <div style="padding:20px 24px;font-size:13px;color:#334155;line-height:1.8;">
            <div><strong>Plan:</strong> @_confirmPlan.Name</div>
            <div><strong>Price:</strong> Free</div>
            <div><strong>Starts:</strong> @DateTime.UtcNow.ToString("dd MMM yyyy")</div>
            <div><strong>Ends:</strong> @DateTime.UtcNow.AddDays(_confirmPlan.DurationDays).ToString("dd MMM yyyy")</div>
        </div>
        <div style="padding:14px 24px;border-top:1px solid #E2E8F0;display:flex;justify-content:flex-end;gap:10px;">
            <button style="background:transparent;color:#64748B;border:1.5px solid #E2E8F0;border-radius:8px;padding:9px 18px;font-weight:600;font-size:13px;cursor:pointer;"
                    @onclick="CloseConfirm" disabled="@_subscribing">Cancel</button>
            <button style="background:#1565C0;color:#fff;border:none;border-radius:8px;padding:9px 20px;font-weight:700;font-size:13px;cursor:pointer;opacity:@(_subscribing ? "0.7" : "1");"
                    @onclick="SubscribeAsync" disabled="@_subscribing">
                @(_subscribing ? "Activating..." : "Confirm & Activate")
            </button>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _subscribing;
    private bool _checkingPayment;

    // Set by "Choose a different plan": shows the plan grid again even though a link is open.
    // Picking a plan then supersedes that link server-side.
    private bool _switchingPlan;

    private Guid? _creatingLinkForPlanId;
    private List<SubscriptionPlanDto> _plans = [];
    private List<SubscriptionPaymentDto> _payments = [];
    private SubscriptionPaymentDto? _pendingPayment;
    private SubscriptionPlanDto? _confirmPlan;

    protected override async Task OnInitializedAsync()
    {
        if (!SubscriptionContext.IsLoaded)
            await SubscriptionContext.RefreshAsync();

        await LoadAsync();
    }

    private async Task RefreshAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;

        var plansTask = SubscriptionApi.GetPlansAsync();
        var paymentsTask = SubscriptionApi.GetPaymentsAsync();
        await Task.WhenAll(plansTask, paymentsTask);

        var plansResponse = await plansTask;
        if (plansResponse.Success && plansResponse.Data is not null)
            _plans = plansResponse.Data.ToList();
        else
            Toast.ShowError(plansResponse.Message ?? "Failed to load subscription plans.");

        var paymentsResponse = await paymentsTask;
        if (paymentsResponse.Success && paymentsResponse.Data is not null)
        {
            _payments = paymentsResponse.Data.ToList();
            _pendingPayment = _payments
                .Where(p => p.Status is SubscriptionPaymentStatus.Pending or SubscriptionPaymentStatus.LinkCreated)
                .OrderByDescending(p => p.CreatedAt)
                .FirstOrDefault();
        }

        _loading = false;
    }

    /// <summary>"Buy — starts <date>" while the clinic is still covered, so the delay is never a surprise.</summary>
    private string BuyLabel()
    {
        var coverageEnd = SubscriptionContext.Status?.CoverageEndDate;
        return coverageEnd is { } end && !SubscriptionContext.IsLocked
            ? $"Buy — starts {end:dd MMM}"
            : "Get Payment Link";
    }

    private void OpenSwitchPlan() => _switchingPlan = true;

    /// <summary>
    /// Asks the server to reconcile this payment with Razorpay now. Activation happens on a
    /// background worker, so the status is re-read once after a short delay rather than polled.
    /// </summary>
    private async Task CheckPaymentAsync()
    {
        if (_pendingPayment is null) return;
        _checkingPayment = true;

        var response = await SubscriptionApi.CheckPaymentAsync(_pendingPayment.Id);
        if (response.Success)
        {
            Toast.ShowSuccess("Checking with the payment provider…");
            await Task.Delay(TimeSpan.FromSeconds(5));
            await SubscriptionContext.RefreshAsync();
            await LoadAsync();

            if (!SubscriptionContext.IsLocked && _pendingPayment is null)
                Toast.ShowSuccess("Payment confirmed — your subscription is active.");
        }
        else
        {
            Toast.ShowError(response.Message ?? "Could not check the payment. Please try again shortly.");
        }

        _checkingPayment = false;
    }

    private void OpenConfirm(SubscriptionPlanDto plan)
    {
        if (SubscriptionContext.Status?.CanSubscribe != true) return;
        _confirmPlan = plan;
    }

    private void CloseConfirm() => _confirmPlan = null;

    private async Task SubscribeAsync()
    {
        if (_confirmPlan is null) return;
        _subscribing = true;

        var response = await SubscriptionApi.SubscribeAsync(new SubscribeRequest { SubscriptionPlanId = _confirmPlan.Id });
        if (response.Success)
        {
            Toast.ShowSuccess($"{_confirmPlan.Name} activated — your clinic is now unlocked.");
            _confirmPlan = null;
            await SubscriptionContext.RefreshAsync();
            Nav.NavigateTo("/dashboard");
        }
        else
        {
            Toast.ShowError(response.Message ?? "Could not activate the plan. Please try again.");
        }

        _subscribing = false;
    }

    private async Task CreatePaymentLinkAsync(SubscriptionPlanDto plan)
    {
        if (SubscriptionContext.Status?.CanSubscribe != true) return;
        _creatingLinkForPlanId = plan.Id;

        var response = await SubscriptionApi.CreateRenewalPaymentLinkAsync(new CreateRenewalPaymentLinkRequest { SubscriptionPlanId = plan.Id });
        if (response.Success)
        {
            Toast.ShowSuccess("Payment link created.");
            _switchingPlan = false;
            await LoadAsync();
        }
        else
        {
            Toast.ShowError(response.Message ?? "Could not create a payment link. Please try again.");
        }

        _creatingLinkForPlanId = null;
    }

    private static string SourceLabel(SubscriptionPaymentDto payment) => payment.Purpose switch
    {
        PaymentPurpose.Onboarding => "Onboarding",
        PaymentPurpose.AdminAssigned => "Sent by CloudClinic",
        _ => "Renewal"
    };

    private static string StatusBg(SubscriptionPaymentStatus status) => status switch
    {
        SubscriptionPaymentStatus.Paid => "#DCFCE7",
        SubscriptionPaymentStatus.Expired or SubscriptionPaymentStatus.Cancelled => "#FEE2E2",
        SubscriptionPaymentStatus.LinkCreated => "#FEF3C7",
        _ => "#F1F5F9"
    };

    private static string StatusFg(SubscriptionPaymentStatus status) => status switch
    {
        SubscriptionPaymentStatus.Paid => "#166534",
        SubscriptionPaymentStatus.Expired or SubscriptionPaymentStatus.Cancelled => "#991B1B",
        SubscriptionPaymentStatus.LinkCreated => "#92400E",
        _ => "#475569"
    };
}
